
&НаКлиенте
Перем ПодборЗначения;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПомечатьНепроведенные = Истина;
	УдалятьПриПервойВозможности = Ложь;
	ЗаполнитьСпискиОтбора();
	УстановитьУсловноеОформление();
	ИтогОперации = "Укажите границу даты и отборы. Проверка ничего не записывает. Удаление выполняется только с включенным флагом.";
	
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
	
	Если Не ГраницаПодтверждена(Истина) Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Проверка цепочек заказов покупателей...");
	
	Попытка
		ВыполнитьНаСервере(Истина);
	Исключение
		Предупреждение(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУдаление(Команда)
	
	Если Не ГраницаПодтверждена(Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	Если УдалятьПриПервойВозможности Тогда
		Ответ = Вопрос("Удалить помеченные заказы и связанные объекты, у которых нет внешних ссылок?", РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли ПомечатьНепроведенные Тогда
		Ответ = Вопрос("Пометить непроведенные документы без движений, которые ссылаются на найденные заказы?", РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Предупреждение("Включите пометку непроведенных документов или удаление доступных цепочек.");
		Возврат;
	КонецЕсли;
	
	Состояние("Обработка помеченных заказов покупателей...");
	
	Попытка
		ВыполнитьНаСервере(Ложь);
	Исключение
		Предупреждение(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ГраницаПодтверждена(ТолькоПроверка)
	
	Если ЗначениеЗаполнено(ГраницаДаты) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Текст = "Граница даты не задана. Будут обработаны помеченные заказы без ограничения по дате.";
	Если Не ТолькоПроверка Тогда
		Текст = Текст + " Продолжить?";
		Ответ = Вопрос(Текст, РежимДиалогаВопрос.ДаНет);
		Возврат Ответ = КодВозвратаДиалога.Да;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ВыполнитьНаСервере(ТолькоПроверка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатВыполнения = ОбработкаОбъект.ВыполнитьОбработку(ОтборыДляВызова(), ГраницаДаты, ПомечатьНепроведенные, УдалятьПриПервойВозможности, ТолькоПроверка);
	ЗначениеВДанныеФормы(РезультатВыполнения.Таблица, Результат);
	ИтогОперации = РезультатВыполнения.Сообщение;
	
КонецПроцедуры

&НаСервере
Функция ОтборыДляВызова()
	
	ОтборыВызова = Новый Массив;
	Для Каждого СтрокаОтбора Из Отборы Цикл
		Если Не ЗначениеЗаполнено(СтрокаОтбора.Поле) И Не ЗначениеЗаполнено(СтрокаОтбора.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаОтбора.Поле) Тогда
			ВызватьИсключение "В отборе укажите поле заказа.";
		КонецЕсли;
		Вид = СтрокаОтбора.ВидСравнения;
		Если Не ЗначениеЗаполнено(Вид) Тогда
			Вид = "Равно";
		КонецЕсли;
		ЗначениеОтбора = СтрокаОтбора.Значение;
		Если ЗначениеЗаполнено(СтрокаОтбора.ЗначениеКлюч) Тогда
			ЗначениеОтбора = СтрокаОтбора.ЗначениеКлюч;
		КонецЕсли;
		ОтборыВызова.Добавить(Новый Структура("Поле, ВидСравнения, Значение", СокрЛП(СтрокаОтбора.Поле), Вид, ЗначениеОтбора));
	КонецЦикла;
	Возврат ОтборыВызова;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСпискиОтбора()
	
	Элементы.ОтборыВидСравнения.СписокВыбора.Очистить();
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Равно");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Не равно");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Больше");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Больше или равно");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Меньше");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Меньше или равно");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Содержит");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("В списке");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Не в списке");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Заполнено");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Не заполнено");
	
	Элементы.ОтборыПоле.СписокВыбора.Очистить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Для Каждого ИмяПоля Из ОбработкаОбъект.ИменаПолейОтбора() Цикл
		Элементы.ОтборыПоле.СписокВыбора.Добавить(ИмяПоля);
	КонецЦикла;
	
	Элементы.ОтборДействие.СписокВыбора.Очистить();
	Элементы.ОтборДействие.СписокВыбора.Добавить("Удален");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Будет удален");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Можно удалить");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Помечен");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Будет помечен");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Оставлен");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Блокирует");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Удалена запись");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Будет удалена запись");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Можно удалить запись");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Исправлена корректировка");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Будет исправлена корректировка");
	Элементы.ОтборДействие.СписокВыбора.Добавить("Можно исправить корректировку");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыПолеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ВыбратьЗначениеКолонки(Элемент, Элементы.ОтборыПоле.СписокВыбора, "Поле", СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыВидСравненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ВыбратьЗначениеКолонки(Элемент, Элементы.ОтборыВидСравнения.СписокВыбора, "ВидСравнения", СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыПолеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Отборы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.ЗначениеКлюч = "";
	УстановитьОграничениеТипаЗначения();
	ТекущиеДанные.Значение = Элементы.ОтборыЗначение.ОграничениеТипа.ПривестиЗначение(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыВидСравненияПриИзменении(Элемент)
	
	УстановитьОграничениеТипаЗначения();
	ПривестиТекущееЗначениеКТипу();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыПриАктивизацииСтроки(Элемент)
	
	УстановитьОграничениеТипаЗначения();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОграничениеТипаЗначения()
	
	ТекущиеДанные = Элементы.Отборы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Поле) Тогда
		Элементы.ОтборыЗначение.ОграничениеТипа = Новый ОписаниеТипов("Строка");
		Возврат;
	КонецЕсли;
	
	Элементы.ОтборыЗначение.ОграничениеТипа = ОграничениеТипаЗначенияНаСервере(ТекущиеДанные.Поле, ТекущиеДанные.ВидСравнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПривестиТекущееЗначениеКТипу()
	
	ТекущиеДанные = Элементы.Отборы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ограничение = Элементы.ОтборыЗначение.ОграничениеТипа;
	Если Ограничение.Типы().Количество() > 0 И Не Ограничение.СодержитТип(ТипЗнч(ТекущиеДанные.Значение)) Тогда
		ТекущиеДанные.Значение = Ограничение.ПривестиЗначение(Неопределено);
		ТекущиеДанные.ЗначениеКлюч = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОграничениеТипаЗначенияНаСервере(ИмяПоля, ВидСравнения)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ОграничениеТипаЗначенияОтбора(ИмяПоля, ВидСравнения);
	
КонецФункции

&НаКлиенте
Процедура ОтборыЗначениеПриИзменении(Элемент)
	
	Если ПодборЗначения = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.Отборы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ЗначениеКлюч = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Отборы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Поле) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеПоля = ОписаниеПоляОтбораНаСервере(ТекущиеДанные.Поле);
	Если Не ОписаниеПоля.ЭтоСсылка Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ПодобратьСсылкуОтбора(ТекущиеДанные, ОписаниеПоля);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗначениеКолонки(Элемент, Список, ИмяКолонки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Выбранный = ВыбратьИзСписка(Список, Элемент);
	ТекущиеДанные = Элементы.Отборы.ТекущиеДанные;
	Если Выбранный = Неопределено Или ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные[ИмяКолонки] = Выбранный.Значение;
	Если ИмяКолонки = "Поле" Тогда
		ТекущиеДанные.ЗначениеКлюч = "";
		УстановитьОграничениеТипаЗначения();
		ТекущиеДанные.Значение = Элементы.ОтборыЗначение.ОграничениеТипа.ПривестиЗначение(Неопределено);
	ИначеЕсли ИмяКолонки = "ВидСравнения" Тогда
		УстановитьОграничениеТипаЗначения();
		ПривестиТекущееЗначениеКТипу();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьСсылкуОтбора(СтрокаОтбора, ОписаниеПоля)
	
	Типы = Новый Массив;
	Для Каждого ИмяТипа Из ОписаниеПоля.ИменаТипов Цикл
		Типы.Добавить(Тип(ИмяТипа));
	КонецЦикла;
	Если Типы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеТипов = Новый ОписаниеТипов(Типы);
	ЭтоСписок = ВидСравненияЗадаетСписок(СтрокаОтбора.ВидСравнения);
	Ключи = Новый Массив;
	Представления = Новый Массив;
	Выбранное = ОписаниеТипов.ПривестиЗначение(Неопределено);
	
	Если ЭтоСписок Тогда
		Пока ВвестиЗначение(Выбранное, "Добавьте ссылку в список. Отмена завершает подбор.", ОписаниеТипов) Цикл
			Если ЗначениеЗаполнено(Выбранное) Тогда
				Ключи.Добавить(КанонСсылкиНаСервере(Выбранное));
				Представления.Добавить(Строка(Выбранное));
			КонецЕсли;
			Выбранное = ОписаниеТипов.ПривестиЗначение(Неопределено);
		КонецЦикла;
		Если Ключи.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ПодборЗначения = Истина;
		СтрокаОтбора.Значение = СоединитьСтрокиКлиент(Представления, "; ");
		СтрокаОтбора.ЗначениеКлюч = СоединитьСтрокиКлиент(Ключи, ";");
		ПодборЗначения = Ложь;
	Иначе
		Если Не ВвестиЗначение(Выбранное, "Выберите значение", ОписаниеТипов) Или Не ЗначениеЗаполнено(Выбранное) Тогда
			Возврат;
		КонецЕсли;
		ПодборЗначения = Истина;
		СтрокаОтбора.Значение = Строка(Выбранное);
		СтрокаОтбора.ЗначениеКлюч = КанонСсылкиНаСервере(Выбранное);
		ПодборЗначения = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВидСравненияЗадаетСписок(ВидСравнения)
	
	Ключ = НРег(СокрЛП(ВидСравнения));
	Возврат Ключ = "в списке" Или Ключ = "не в списке";
	
КонецФункции

&НаКлиенте
Функция СоединитьСтрокиКлиент(Части, Разделитель)
	
	Текст = "";
	Индекс = 0;
	Для Каждого Часть Из Части Цикл
		Если Индекс > 0 Тогда
			Текст = Текст + Разделитель;
		КонецЕсли;
		Текст = Текст + Часть;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция ОписаниеПоляОтбораНаСервере(ИмяПоля)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ОписаниеПоляОтбора(ИмяПоля);
	
КонецФункции

&НаСервере
Функция КанонСсылкиНаСервере(Ссылка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.КанонСсылки(Ссылка);
	
КонецФункции

&НаКлиенте
Процедура ОтборДействиеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ОтборДействие) Тогда
		Элементы.Результат.ОтборСтрок = Новый ФиксированнаяСтруктура("Действие", ОтборДействие);
	Иначе
		Элементы.Результат.ОтборСтрок = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	ДобавитьОформление("Удален", WebЦвета.Зеленый);
	ДобавитьОформление("Будет удален", WebЦвета.СветлоЖелтый);
	ДобавитьОформление("Можно удалить", WebЦвета.СветлоЖелтый);
	ДобавитьОформление("Помечен", WebЦвета.Голубой);
	ДобавитьОформление("Будет помечен", WebЦвета.Голубой);
	ДобавитьОформление("Оставлен", WebЦвета.ТусклоРозовый);
	ДобавитьОформление("Блокирует", WebЦвета.Лосось);
	ДобавитьОформление("Удалена запись", WebЦвета.Зеленый);
	ДобавитьОформление("Будет удалена запись", WebЦвета.СветлоЖелтый);
	ДобавитьОформление("Можно удалить запись", WebЦвета.СветлоЖелтый);
	ДобавитьОформление("Исправлена корректировка", WebЦвета.Зеленый);
	ДобавитьОформление("Будет исправлена корректировка", WebЦвета.СветлоЖелтый);
	ДобавитьОформление("Можно исправить корректировку", WebЦвета.СветлоЖелтый);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформление(Действие, ЦветФона)
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Результат");
	Поле.Использование = Истина;
	
