// Сравнение ссылочных объектов двух баз УТ 10.3.
// В одной базе выбранные объекты выгружаются в XML, во второй сравниваются с этим файлом.
// Ключ объекта — UUID ссылки. Сравнивается каждая колонка шапки и каждая колонка строки табличной части.
// Ссылки сравниваются по типу XML и UUID. Период ограничивает только документы.
// Отбор с пустым объектом применяется ко всем выбранным типам, у которых есть такое поле.
//
// Код рассчитан на режим совместимости 8.2.13.

Перем ОписанияТиповСсылок;
Перем КэшСсылочныхТипов;

Функция Выгрузить(ПолныеИмена, Отборы, НачалоПериода, КонецПериода) Экспорт
	
	Если ПолныеИмена.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны ссылочные объекты.";
	КонецЕсли;
	
	Если Отборы = Неопределено Тогда
		Отборы = Новый Массив;
	КонецЕсли;
	
	ИнициализироватьКэшТипов();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Статистика = НоваяСтатистика();
	Предупреждения = Новый Массив;
	КоличествоОбъектов = 0;
	
	Попытка
		КоличествоОбъектов = ЗаписатьФайлВыгрузки(ИмяФайла, ПолныеИмена, Отборы, НачалоПериода, КонецПериода, Статистика, Предупреждения);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьВременныйФайл(ИмяФайла);
	
	Сообщение = "Выгружено объектов: " + ФорматЧисла(КоличествоОбъектов) + "."
		+ Символы.ПС + "Период документов: " + ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Типов в файле: " + ФорматЧисла(Статистика.Количество()) + "."
		+ Символы.ПС + "Отборов: " + ФорматЧисла(КоличествоЗаданныхОтборов(Отборы)) + "."
		+ Символы.ПС + "Данные этой базы не изменялись.";
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = "Выгрузка завершена с ошибками." + Символы.ПС + Сообщение
			+ Символы.ПС + ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Сравнить(АдресФайла, ПолныеИмена, Отборы, НачалоПериода, КонецПериода) Экспорт
	
	Если ПолныеИмена.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны ссылочные объекты.";
	КонецЕсли;
	
	Если Отборы = Неопределено Тогда
		Отборы = Новый Массив;
	КонецЕсли;
	
	ИнициализироватьКэшТипов();
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл сравнения.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ИмяФайла);
	
	Попытка
		КэшФайла = ПрочитатьФайлВыгрузки(ИмяФайла, ПолныеИмена);
	Исключение
		УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьВременныйФайл(ИмяФайла);
	
	Отличия = НоваяТаблицаОтличий();
	Статистика = НоваяСтатистика();
	Предупреждения = КэшФайла.Предупреждения;
	Обрезано = Ложь;
	ВсегоОтличий = 0;
	
	Если ДатаВАтрибут(НачалоПериода) <> ДатаВАтрибут(КэшФайла.ПериодНачало)
		Или ДатаВАтрибут(КонецПериода) <> ДатаВАтрибут(КэшФайла.ПериодКонец) Тогда
		Предупреждения.Добавить("Период документов на форме (" + ТекстПериодаСравнения(НачалоПериода, КонецПериода)
			+ ") отличается от периода файла (" + ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец)
			+ "). Объекты этой базы отобраны по периоду формы.");
	КонецЕсли;
	
	ТекстОтбораФормы = ТекстXML(ТекстОтборов(Отборы));
	Если ТекстОтбораФормы <> КэшФайла.ТекстОтборов Тогда
		Предупреждения.Добавить("Отборы на форме отличаются от отборов файла. Объекты этой базы отобраны по отборам формы.");
	КонецЕсли;
	
	Если КэшФайла.Конфигурация <> "" И КэшФайла.Конфигурация <> Метаданные.Имя Тогда
		Предупреждения.Добавить("Файл выгружен из конфигурации """ + КэшФайла.Конфигурация
			+ """, текущая конфигурация """ + Метаданные.Имя + """.");
	КонецЕсли;
	
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		СравнитьОбъектМетаданных(ПолноеИмя, Отборы, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано);
	КонецЦикла;
	
	Отличия.Сортировать("Объект, Ссылка, ИмяПоля");
	
	ВсегоВБазе = 0;
	ВсегоВФайле = 0;
	ТолькоВБазе = 0;
	ТолькоВФайле = 0;
	Расхождений = 0;
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		ВсегоВБазе = ВсегоВБазе + СтрокаСтатистики.ЗаписейВБазе;
		ВсегоВФайле = ВсегоВФайле + СтрокаСтатистики.ЗаписейВФайле;
		ТолькоВБазе = ТолькоВБазе + СтрокаСтатистики.ТолькоВБазе;
		ТолькоВФайле = ТолькоВФайле + СтрокаСтатистики.ТолькоВФайле;
		Расхождений = Расхождений + СтрокаСтатистики.Расхождений;
	КонецЦикла;
	
	Сообщение = "Период документов: " + ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Период файла: " + ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец) + "."
		+ Символы.ПС + "Объектов в этой базе: " + ФорматЧисла(ВсегоВБазе) + ", в файле: " + ФорматЧисла(ВсегоВФайле) + "."
		+ Символы.ПС + "Только в этой базе: " + ФорматЧисла(ТолькоВБазе)
		+ ", только в файле: " + ФорматЧисла(ТолькоВФайле)
		+ ", расхождений по колонкам: " + ФорматЧисла(Расхождений) + ".";
	
	Если ВсегоОтличий = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Отличий не найдено.";
	КонецЕсли;
	
	Если Обрезано Тогда
		Сообщение = Сообщение + Символы.ПС + "В таблицу выведены первые " + ФорматЧисла(МаксимальноеКоличествоСтрокРезультата())
			+ " строк отличий из " + ФорматЧисла(ВсегоОтличий) + ".";
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отличия", Отличия);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция ТаблицаМетаданных() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЕстьВБазе", Новый ОписаниеТипов("Булево"));
	
	ДобавитьКоллекциюМетаданных(Таблица, Метаданные.Справочники, "Справочник");
	ДобавитьКоллекциюМетаданных(Таблица, Метаданные.Документы, "Документ");
	ДобавитьКоллекциюМетаданных(Таблица, Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик");
	ДобавитьКоллекциюМетаданных(Таблица, Метаданные.ПланыСчетов, "ПланСчетов");
	ДобавитьКоллекциюМетаданных(Таблица, Метаданные.ПланыВидовРасчета, "ПланВидовРасчета");
	ДобавитьКоллекциюМетаданных(Таблица, Метаданные.ПланыОбмена, "ПланОбмена");
	ДобавитьКоллекциюМетаданных(Таблица, Метаданные.БизнесПроцессы, "БизнесПроцесс");
	ДобавитьКоллекциюМетаданных(Таблица, Метаданные.Задачи, "Задача");
	
	Таблица.Сортировать("Вид, Имя");
	Возврат Таблица;
	
КонецФункции

Функция ИменаПолейОтбора(ПолноеИмя) Экспорт
	
	ИнициализироватьКэшТипов();
	Описание = ОписаниеОбъекта(ПолноеИмя);
	Имена = Новый Массив;
	
	Для Каждого Поле Из Описание.Поля Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
		Для Каждого Поле Из ТабличнаяЧасть.Поля Цикл
			Имена.Добавить(ТабличнаяЧасть.Имя + "." + Поле.Имя);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

Функция ЗаписатьФайлВыгрузки(ИмяФайла, ПолныеИмена, Отборы, НачалоПериода, КонецПериода, Статистика, Предупреждения)
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьКомментарий("Ключ объекта: UUID ссылки. Ссылки сравниваются по типу XML и UUID. Строки табличных частей сопоставляются по номеру строки.");
	Запись.ЗаписатьНачалоЭлемента("ReferenceObjectComparison");
	Запись.ЗаписатьАтрибут("formatVersion", "1");
	Запись.ЗаписатьАтрибут("configuration", Метаданные.Имя);
	Запись.ЗаписатьАтрибут("configurationVersion", Метаданные.Версия);
	Запись.ЗаписатьАтрибут("exportedAt", XMLСтрока(ТекущаяДата()));
	Запись.ЗаписатьАтрибут("periodFrom", ДатаВАтрибут(НачалоПериода));
	Запись.ЗаписатьАтрибут("periodTo", ДатаВАтрибут(КонецПериода));
	Запись.ЗаписатьАтрибут("filterText", ТекстXML(ТекстОтборов(Отборы)));
	
	ПредупредитьОНевыбранныхОтборах(ПолныеИмена, Отборы, Предупреждения);
	
	КоличествоОбъектов = 0;
	
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		
		Попытка
			Описание = ОписаниеОбъекта(ПолноеИмя);
			КоличествоТипа = ЗаписатьОбъектыТипа(Запись, Описание, Отборы, НачалоПериода, КонецПериода);
		Исключение
			ТекстОшибки = КраткийТекстОшибки(ОписаниеОшибки());
			ЗаписатьОшибку(Запись, ПолноеИмя, ТекстОшибки);
			Предупреждения.Добавить(ПолноеИмя + ": " + ТекстОшибки);
			ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, 0, 0, 0, 0, 0);
			Продолжить;
		КонецПопытки;
		
		КоличествоОбъектов = КоличествоОбъектов + КоличествоТипа;
		ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, КоличествоТипа, 0, 0, 0, 0);
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	Возврат КоличествоОбъектов;
	
КонецФункции

Функция ЗаписатьОбъектыТипа(Запись, Описание, Отборы, НачалоПериода, КонецПериода)
	
	Подготовка = ПодготовитьЗапрос(Описание, Отборы, НачалоПериода, КонецПериода);
	СтрокиТабличныхЧастей = ПрочитатьСтрокиТабличныхЧастей(Описание, Подготовка.Запрос, Подготовка.ТекстГде);
	
	Подготовка.Запрос.Текст = ТекстЗапросаШапки(Описание, Подготовка.ТекстГде);
	Выборка = Подготовка.Запрос.Выполнить().Выбрать();
	
	Запись.ЗаписатьНачалоЭлемента("Metadata");
	Запись.ЗаписатьАтрибут("name", Описание.ПолноеИмя);
	Запись.ЗаписатьАтрибут("synonym", ТекстXML(Описание.Синоним));
	
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = XMLСтрока(Выборка.Ссылка);
		ЗаписатьОбъект(Запись, Выборка, Описание, Ключ, СтрокиТабличныхЧастей.Получить(Ключ));
		Количество = Количество + 1;
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Возврат Количество;
	
КонецФункции

Процедура ЗаписатьОбъект(Запись, Выборка, Описание, Ключ, СтрокиОбъекта)
	
	ЗначенияШапки = КартаЗначенийВыборки(Выборка, Описание.Поля);
	Представление = ПредставлениеОбъекта(ЗначенияШапки, Ключ);
	
	Запись.ЗаписатьНачалоЭлемента("Object");
	Запись.ЗаписатьАтрибут("uuid", Ключ);
	Запись.ЗаписатьАтрибут("presentation", ТекстXML(Представление));
	
	ЗаписатьКартуПолей(Запись, Описание.Поля, ЗначенияШапки);
	
	Если СтрокиОбъекта <> Неопределено Тогда
		Для Каждого ЭлементСтроки Из СтрокиОбъекта Цикл
			СтрокаТаблицы = ЭлементСтроки.Значение;
			Запись.ЗаписатьНачалоЭлемента("Row");
			Запись.ЗаписатьАтрибут("table", СтрокаТаблицы.ИмяТаблицы);
			Запись.ЗаписатьАтрибут("line", ФорматЧисла(СтрокаТаблицы.НомерСтроки));
			ЗаписатьКартуПолей(Запись, СтрокаТаблицы.ПорядокПолей, СтрокаТаблицы.Поля);
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
	КонецЕсли;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ЗаписатьКартуПолей(Запись, ПорядокПолей, КартаПолей)
	
	Для Каждого Поле Из ПорядокПолей Цикл
		ИмяПоля = ИмяЭлементаПорядка(Поле);
		ЗначениеПоля = КартаПолей.Получить(ИмяПоля);
		Если ЗначениеПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьНачалоЭлемента("Field");
		Запись.ЗаписатьАтрибут("name", ИмяПоля);
		Запись.ЗаписатьАтрибут("canonical", ЗначениеПоля.Канон);
		Запись.ЗаписатьАтрибут("presentation", ЗначениеПоля.Представление);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяЭлементаПорядка(Поле)
	
	Если ТипЗнч(Поле) = Тип("Строка") Тогда
		Возврат Поле;
	КонецЕсли;
	
	Возврат Поле.Имя;
	
КонецФункции

Функция ПрочитатьСтрокиТабличныхЧастей(Описание, Запрос, ТекстГде)
	
	Результат = Новый Соответствие;
	
	Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
		Запрос.Текст = ТекстЗапросаТабличнойЧасти(Описание, ТабличнаяЧасть, ТекстГде);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			КлючОбъекта = XMLСтрока(Выборка.Ссылка);
			СтрокиОбъекта = Результат.Получить(КлючОбъекта);
			Если СтрокиОбъекта = Неопределено Тогда
				СтрокиОбъекта = Новый Соответствие;
				Результат.Вставить(КлючОбъекта, СтрокиОбъекта);
			КонецЕсли;
			КлючСтроки = ТабличнаяЧасть.Имя + "|" + ФорматЧисла(Выборка.НомерСтроки);
			СтрокаТаблицы = НоваяСтрокаТаблицы(ТабличнаяЧасть.Имя, Выборка.НомерСтроки);
			ЗаполнитьКартуВыборки(Выборка, ТабличнаяЧасть.Поля, СтрокаТаблицы.Поля, СтрокаТаблицы.ПорядокПолей);
			СтрокиОбъекта.Вставить(КлючСтроки, СтрокаТаблицы);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьЗапрос(Описание, Отборы, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Условия = Новый Массив;
	Счетчик = Новый Структура("Номер", 0);
	ОтборыОбъекта = ОтборыЭтогоОбъекта(Описание, Отборы);
	
	Для Каждого Отбор Из ОтборыОбъекта Цикл
		Условия.Добавить(ТекстУсловияОтбора(Описание, Отбор, Запрос, Счетчик));
	КонецЦикла;
	
	Если Описание.Вид = "Документ" Тогда
		Если ЗначениеЗаполнено(НачалоПериода) Тогда
			Условия.Добавить("Объект.Дата >= &НачалоПериода");
		КонецЕсли;
		Если ЗначениеЗаполнено(КонецПериода) Тогда
			Условия.Добавить("Объект.Дата <= &КонецПериода");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("Запрос, ТекстГде", Запрос, ТекстГде(Условия));
	
КонецФункции

Функция ТекстЗапросаШапки(Описание, ТекстГде)
	
	Возврат "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + ТекстПолейВыборки(Описание.Поля, "Объект", "Объект.Ссылка КАК Ссылка")
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + Описание.ПолноеИмя + " КАК Объект"
		+ ТекстГде;
	
КонецФункции

Функция ТекстЗапросаТабличнойЧасти(Описание, ТабличнаяЧасть, ТекстГде)
	
	Возврат "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + ТекстПолейВыборки(ТабличнаяЧасть.Поля, "СтрокаТЧ", "СтрокаТЧ.Ссылка КАК Ссылка")
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + Описание.ПолноеИмя + "." + ТабличнаяЧасть.Имя + " КАК СтрокаТЧ"
		+ Символы.ПС + Символы.Таб + "ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + Описание.ПолноеИмя + " КАК Объект"
		+ Символы.ПС + Символы.Таб + "ПО СтрокаТЧ.Ссылка = Объект.Ссылка"
		+ ТекстГде;
	
КонецФункции

Функция ТекстПолейВыборки(Поля, Префикс, ПервоеПоле)
	
	Части = Новый Массив;
	Части.Добавить(ПервоеПоле);
	Для Каждого Поле Из Поля Цикл
		Части.Добавить(Префикс + "." + Поле.Имя + " КАК " + Поле.Имя);
	КонецЦикла;
	Возврат СоединитьСтроки(Части, "," + Символы.ПС + Символы.Таб);
	
КонецФункции

Функция ТекстГде(Условия)
	
	Если Условия.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб + СоединитьСтроки(Условия, Символы.ПС + Символы.Таб + "И ");
	
КонецФункции

Функция ОписаниеОбъекта(ПолноеИмя)
	
	Мета = МетаданныеПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет объекта " + ПолноеИмя + ".";
	КонецЕсли;
	
	Вид = ВидПоПолномуИмени(ПолноеИмя);
	Синоним = Строка(Мета.Синоним);
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("ПолноеИмя", ПолноеИмя);
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Вид", Вид);
	Описание.Вставить("Синоним", Синоним);
	Описание.Вставить("Поля", Новый Массив);
	Описание.Вставить("ТабличныеЧасти", Новый Массив);
	
	ДобавитьСтандартныеПоля(Мета, Описание);
	
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		ДобавитьПоле(Описание.Поля, Реквизит.Имя, "Реквизит", Реквизит.Тип, "");
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из Мета.ТабличныеЧасти Цикл
		Поля = Новый Массив;
		ДобавитьПоле(Поля, "НомерСтроки", "Стандартный", Новый ОписаниеТипов("Число"), "");
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			ДобавитьПоле(Поля, Реквизит.Имя, "Реквизит", Реквизит.Тип, "");
		КонецЦикла;
		Описание.ТабличныеЧасти.Добавить(Новый Структура("Имя, Поля", ТабличнаяЧасть.Имя, Поля));
	КонецЦикла;
	
	ДобавитьСтандартныеТабличныеЧасти(Мета, Описание);
	Возврат Описание;
	
КонецФункции

Процедура ДобавитьСтандартныеПоля(Мета, Описание)
	
	ДобавитьПоле(Описание.Поля, "ПометкаУдаления", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	
	Если Описание.Вид = "Справочник" Или Описание.Вид = "ПланВидовХарактеристик" Тогда
		ДобавитьКодИНаименование(Мета, Описание.Поля);
		ДобавитьПоляИерархии(Мета, Описание);
		ДобавитьПолеВладельца(Мета, Описание.Поля);
		ДобавитьПоле(Описание.Поля, "Предопределенный", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "Документ" Тогда
		ДобавитьПоле(Описание.Поля, "Дата", "Стандартный", Новый ОписаниеТипов("Дата"), "");
		ДобавитьПолеНомера(Мета, Описание.Поля);
		ДобавитьПоле(Описание.Поля, "Проведен", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "ПланСчетов" Тогда
		ДобавитьКодИНаименование(Мета, Описание.Поля);
		ДобавитьПоляИерархии(Мета, Описание);
		ДобавитьПоле(Описание.Поля, "Вид", "Стандартный", Неопределено, "AccountType");
		ДобавитьПоле(Описание.Поля, "Забалансовый", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		ДобавитьПоле(Описание.Поля, "Порядок", "Стандартный", Новый ОписаниеТипов("Строка"), "");
		ДобавитьПоле(Описание.Поля, "Предопределенный", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "ПланВидовРасчета" Тогда
		ДобавитьКодИНаименование(Мета, Описание.Поля);
		ДобавитьПоле(Описание.Поля, "Предопределенный", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "ПланОбмена" Тогда
		ДобавитьКодИНаименование(Мета, Описание.Поля);
		ДобавитьПоле(Описание.Поля, "НомерОтправленного", "Стандартный", Новый ОписаниеТипов("Число"), "");
		ДобавитьПоле(Описание.Поля, "НомерПринятого", "Стандартный", Новый ОписаниеТипов("Число"), "");
		ДобавитьПоле(Описание.Поля, "Предопределенный", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "БизнесПроцесс" Тогда
		ДобавитьПоле(Описание.Поля, "Дата", "Стандартный", Новый ОписаниеТипов("Дата"), "");
		ДобавитьПолеНомера(Мета, Описание.Поля);
		ДобавитьПоле(Описание.Поля, "Стартован", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		ДобавитьПоле(Описание.Поля, "Завершен", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		ДобавитьПоле(Описание.Поля, "ВедущаяЗадача", "Стандартный", Неопределено, "");
	ИначеЕсли Описание.Вид = "Задача" Тогда
		ДобавитьПоле(Описание.Поля, "Дата", "Стандартный", Новый ОписаниеТипов("Дата"), "");
		ДобавитьПолеНомера(Мета, Описание.Поля);
		Если Мета.ДлинаНаименования > 0 Тогда
			ДобавитьПоле(Описание.Поля, "Наименование", "Стандартный", Новый ОписаниеТипов("Строка"), "");
		КонецЕсли;
		ДобавитьПоле(Описание.Поля, "Выполнена", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		ДобавитьПоле(Описание.Поля, "БизнесПроцесс", "Стандартный", Неопределено, "");
		ДобавитьПоле(Описание.Поля, "ТочкаМаршрута", "Стандартный", Неопределено, "");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПолеНомера(Мета, Поля)
	
	Если Мета.ДлинаНомера = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Мета.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Число Тогда
		ДобавитьПоле(Поля, "Номер", "Стандартный", Новый ОписаниеТипов("Число"), "");
	Иначе
		ДобавитьПоле(Поля, "Номер", "Стандартный", Новый ОписаниеТипов("Строка"), "");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКодИНаименование(Мета, Поля)
	
	Если Мета.ДлинаКода > 0 Тогда
		ДобавитьПоле(Поля, "Код", "Стандартный", Новый ОписаниеТипов("Строка"), "");
	КонецЕсли;
	
	Если Мета.ДлинаНаименования > 0 Тогда
		ДобавитьПоле(Поля, "Наименование", "Стандартный", Новый ОписаниеТипов("Строка"), "");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоляИерархии(Мета, Описание)
	
	Если Не Мета.Иерархический Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьПоле(Описание.Поля, "Родитель", "Стандартный", ТипСсылкиЭтогоОбъекта(Описание), "");
	
	Если Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		ДобавитьПоле(Описание.Поля, "ЭтоГруппа", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПолеВладельца(Мета, Поля)
	
	Если Мета.Владельцы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Типы = Новый Массив;
	Для Каждого Владелец Из Мета.Владельцы Цикл
		Типы.Добавить(Тип(ИмяТипаСсылкиМетаданных(Владелец)));
	КонецЦикла;
	
	ДобавитьПоле(Поля, "Владелец", "Стандартный", Новый ОписаниеТипов(Типы), "");
	
КонецПроцедуры

Процедура ДобавитьСтандартныеТабличныеЧасти(Мета, Описание)
	
	Если Описание.Вид <> "ПланСчетов" И Описание.Вид <> "ПланВидовРасчета" Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТабличнаяЧасть Из Мета.СтандартныеТабличныеЧасти Цикл
		Поля = ПоляСтандартнойТабличнойЧасти(Мета, ТабличнаяЧасть.Имя);
		Если Поля <> Неопределено Тогда
			Описание.ТабличныеЧасти.Добавить(Новый Структура("Имя, Поля", ТабличнаяЧасть.Имя, Поля));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПоляСтандартнойТабличнойЧасти(Мета, Имя)
	
	Поля = Новый Массив;
	ДобавитьПоле(Поля, "НомерСтроки", "Стандартный", Новый ОписаниеТипов("Число"), "");
	
	Если Имя = "ВидыСубконто" Тогда
		Если Мета.ВидыСубконто = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ДобавитьПоле(Поля, "ВидСубконто", "Стандартный", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка." + Мета.ВидыСубконто.Имя), "");
		ДобавитьПоле(Поля, "Предопределенное", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		ДобавитьПоле(Поля, "ТолькоОбороты", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		Возврат Поля;
	КонецЕсли;
	
	Если Имя = "БазовыеВидыРасчета" Или Имя = "ВедущиеВидыРасчета" Или Имя = "ВытесняющиеВидыРасчета" Тогда
		ДобавитьПоле(Поля, "ВидРасчета", "Стандартный", Новый ОписаниеТипов("ПланВидовРасчетаСсылка." + Мета.Имя), "");
		Возврат Поля;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьПоле(Поля, Имя, Роль, ОписаниеТипов, ИмяТипаXML)
	
	Поля.Добавить(Новый Структура("Имя, Роль, ОписаниеТипов, ИмяТипаXML", Имя, Роль, ОписаниеТипов, ИмяТипаXML));
	
КонецПроцедуры

Функция ТипСсылкиЭтогоОбъекта(Описание)
	
	Возврат Новый ОписаниеТипов(Описание.Вид + "Ссылка." + Описание.Имя);
	
КонецФункции

Функция ОтборыЭтогоОбъекта(Описание, Отборы)
	
	Результат = Новый Массив;
	
	Для Каждого Отбор Из Отборы Цикл
		Если Не ЗначениеЗаполнено(Отбор.Поле) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Отбор.ПолноеИмя) И Отбор.ПолноеИмя <> Описание.ПолноеИмя Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Отбор.ПолноеИмя) И НайтиПолеОтбора(Описание, Отбор.Поле, Ложь) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Отбор);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстУсловияОтбора(Описание, Отбор, Запрос, Счетчик)
	
	Найденное = НайтиПолеОтбора(Описание, Отбор.Поле, Истина);
	Вид = НормализоватьВидСравнения(Отбор.ВидСравнения);
	Путь = ПутьПоляОтбора(Отбор.Поле);
	ИмяПараметра = "Отбор" + ФорматЧисла(Счетчик.Номер);
	Счетчик.Номер = Счетчик.Номер + 1;
	
	Если Вид = "заполнено" Тогда
		УсловиеПоля = ТекстУсловияЗаполнено(Путь, Найденное.Поле);
	ИначеЕсли Вид = "не заполнено" Тогда
		УсловиеПоля = "НЕ (" + ТекстУсловияЗаполнено(Путь, Найденное.Поле) + ")";
	ИначеЕсли Вид = "содержит" Тогда
		ПроверитьСтроковоеПоле(Найденное.Поле, Отбор.Поле);
		Запрос.УстановитьПараметр(ИмяПараметра, "%" + СокрЛП(Строка(Отбор.Значение)) + "%");
		УсловиеПоля = Путь + " ПОДОБНО &" + ИмяПараметра;
	ИначеЕсли Вид = "в списке" Или Вид = "не в списке" Тогда
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначенияСписка(Найденное.Поле, Отбор.Значение));
		Если Вид = "в списке" Тогда
			УсловиеПоля = Путь + " В (&" + ИмяПараметра + ")";
		Иначе
			УсловиеПоля = "НЕ (" + Путь + " В (&" + ИмяПараметра + "))";
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеПоляОтбора(Найденное.Поле, Отбор.Значение));
		УсловиеПоля = Путь + " " + Вид + " &" + ИмяПараметра;
	КонецЕсли;
	
	Если Найденное.ИмяТабличнойЧасти = "" Тогда
		Возврат УсловиеПоля;
	КонецЕсли;
	
	Возврат "СУЩЕСТВУЕТ (ВЫБРАТЬ 1 ИЗ " + Описание.ПолноеИмя + "." + Найденное.ИмяТабличнойЧасти
		+ " КАК СтрокаТЧ ГДЕ СтрокаТЧ.Ссылка = Объект.Ссылка И " + УсловиеПоля + ")";
	
КонецФункции

Функция ПутьПоляОтбора(ИмяПоля)
	
	Позиция = Найти(ИмяПоля, ".");
	Если Позиция = 0 Тогда
		Возврат "Объект." + СокрЛП(ИмяПоля);
	КонецЕсли;
	
	Возврат "СтрокаТЧ." + СокрЛП(Сред(ИмяПоля, Позиция + 1));
	
КонецФункции

Функция НайтиПолеОтбора(Описание, ИмяПоля, Обязательно)
	
	ИмяПоля = СокрЛП(ИмяПоля);
	Позиция = Найти(ИмяПоля, ".");
	
	Если Позиция = 0 Тогда
		Для Каждого Поле Из Описание.Поля Цикл
			Если Поле.Имя = ИмяПоля Тогда
				Возврат Новый Структура("Поле, ИмяТабличнойЧасти", Поле, "");
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИмяТаблицы = Лев(ИмяПоля, Позиция - 1);
		ИмяРеквизита = СокрЛП(Сред(ИмяПоля, Позиция + 1));
		Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
			Если ТабличнаяЧасть.Имя <> ИмяТаблицы Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Поле Из ТабличнаяЧасть.Поля Цикл
				Если Поле.Имя = ИмяРеквизита Тогда
					Возврат Новый Структура("Поле, ИмяТабличнойЧасти", Поле, ИмяТаблицы);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если Обязательно Тогда
		ВызватьИсключение Описание.ПолноеИмя + ": нет поля отбора """ + ИмяПоля + """.";
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НормализоватьВидСравнения(Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Если Ключ = "" Или Ключ = "равно" Или Ключ = "=" Тогда
		Возврат "=";
	ИначеЕсли Ключ = "не равно" Или Ключ = "<>" Тогда
		Возврат "<>";
	ИначеЕсли Ключ = "больше" Или Ключ = ">" Тогда
		Возврат ">";
	ИначеЕсли Ключ = "больше или равно" Или Ключ = ">=" Тогда
		Возврат ">=";
	ИначеЕсли Ключ = "меньше" Или Ключ = "<" Тогда
		Возврат "<";
	ИначеЕсли Ключ = "меньше или равно" Или Ключ = "<=" Тогда
		Возврат "<=";
	ИначеЕсли Ключ = "содержит" Тогда
		Возврат "содержит";
	ИначеЕсли Ключ = "в списке" Тогда
		Возврат "в списке";
	ИначеЕсли Ключ = "не в списке" Тогда
		Возврат "не в списке";
	ИначеЕсли Ключ = "заполнено" Тогда
		Возврат "заполнено";
	ИначеЕсли Ключ = "не заполнено" Тогда
		Возврат "не заполнено";
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный вид сравнения """ + Текст + """.";
	
КонецФункции

Функция ТекстУсловияЗаполнено(Путь, Поле)
	
	Если Поле.ИмяТипаXML = "AccountType" Тогда
		Возврат Путь + " <> НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	Если Поле.ОписаниеТипов = Неопределено Тогда
		Возврат Путь + " <> НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого ТипЗначения Из Поле.ОписаниеТипов.Типы() Цикл
		Фрагмент = ТекстЗаполненоТипа(Путь, ТипЗначения);
		Если Фрагмент <> "" Тогда
			Части.Добавить(Фрагмент);
		КонецЕсли;
	КонецЦикла;
	
	Если Части.Количество() = 0 Тогда
		Возврат Путь + " <> НЕОПРЕДЕЛЕНО";
	ИначеЕсли Части.Количество() = 1 Тогда
		Возврат Части[0];
	КонецЕсли;
	
	Возврат "(" + СоединитьСтроки(Части, " ИЛИ ") + ")";
	
КонецФункции

Функция ТекстЗаполненоТипа(Путь, ТипЗначения)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Путь + " <> """"";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Путь + " <> 0";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Путь + " <> ДАТАВРЕМЯ(1, 1, 1)";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Путь + " = ИСТИНА";
	КонецЕсли;
	
	ИмяТаблицы = ИмяТаблицыПоТипу(ТипЗначения);
	Если ИмяТаблицы = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "(" + Путь + " ССЫЛКА " + ИмяТаблицы + " И " + Путь + " <> ЗНАЧЕНИЕ(" + ИмяТаблицы + ".ПустаяСсылка))";
	
КонецФункции

Процедура ПроверитьСтроковоеПоле(Поле, ИмяПоля)
	
	Если Поле.ОписаниеТипов = Неопределено Или Не Поле.ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		ВызватьИсключение "Сравнение «Содержит» доступно только для строки. Поле: " + ИмяПоля + ".";
	КонецЕсли;
	
КонецПроцедуры

Функция ЗначенияСписка(Поле, Текст)
	
	Части = РазделитьСтроку(Строка(Текст), ";");
	Значения = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если СокрЛП(Часть) = "" Тогда
			Продолжить;
		КонецЕсли;
		Значения.Добавить(ЗначениеПоляОтбора(Поле, Часть));
	КонецЦикла;
	
	Если Значения.Количество() = 0 Тогда
		ВызватьИсключение "Для сравнения «В списке» укажите хотя бы одно значение.";
	КонецЕсли;
	
	Возврат Значения;
	
КонецФункции

Функция ЗначениеПоляОтбора(Поле, Текст)
	
	Текст = СокрЛП(Строка(Текст));
	
	Если Поле.ИмяТипаXML = "AccountType" Тогда
		Если Текст = "" Тогда
			ВызватьИсключение "Для вида счета укажите Активный, Пассивный или АктивноПассивный.";
		КонецЕсли;
		Возврат ЗначениеВидаСчета(Текст);
	КонецЕсли;
	
	Если ЭтоЯвноеЗначениеXML(Текст, Поле.ОписаниеТипов) Тогда
		Возврат ЗначениеИзXMLТекста(Текст);
	КонецЕсли;
	
	Если Поле.ОписаниеТипов = Неопределено Тогда
		ВызватьИсключение "Для поля составного типа укажите значение в виде ИмяТипаXML:значение.";
	КонецЕсли;
	
	Типы = Поле.ОписаниеТипов.Типы();
	Если Типы.Количество() <> 1 Тогда
		Если Текст = "" Тогда
			ВызватьИсключение "Для поля составного типа укажите значение в виде ИмяТипаXML:значение.";
		КонецЕсли;
		ВызватьИсключение "У поля несколько типов. Укажите значение в виде ИмяТипаXML:значение, например CatalogRef.Контрагенты:uuid или string:текст.";
	КонецЕсли;
	
	Если Текст = "" Тогда
		Возврат ПустоеЗначениеТипа(Типы[0]);
	КонецЕсли;
	
	Возврат ЗначениеОдногоТипа(Типы[0], Текст);
	
КонецФункции

Функция ЭтоЯвноеЗначениеXML(Текст, ОписаниеТипов)
	
	Позиция = Найти(Текст, ":");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОписаниеТипов <> Неопределено И ОписаниеТипов.Типы().Количество() = 1 И ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяТипа = Лев(Текст, Позиция - 1);
	Если ИмяТипа = "string" Или ИмяТипа = "decimal" Или ИмяТипа = "boolean" Или ИмяТипа = "dateTime" Или Найти(ИмяТипа, ".") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗначениеИзXMLТекста(Текст)
	
	Позиция = Найти(Текст, ":");
	ИмяТипа = Лев(Текст, Позиция - 1);
	Тело = Сред(Текст, Позиция + 1);
	
	Если ИмяТипа = "string" Тогда
		Возврат Тело;
	ИначеЕсли ИмяТипа = "boolean" Тогда
		Возврат БулевоИзТекста(Тело);
	ИначеЕсли ИмяТипа = "decimal" Тогда
		Возврат ЧислоИзТекста(Тело);
	ИначеЕсли ИмяТипа = "dateTime" Тогда
		Возврат ДатаИзТекста(Тело);
	КонецЕсли;
	
	ТипЗначения = ИзXMLТипа(ИмяТипа, "");
	Если ТипЗначения = Неопределено Тогда
		ВызватьИсключение "Неизвестный тип значения отбора " + ИмяТипа + ".";
	КонецЕсли;
	
	Возврат XMLЗначение(ТипЗначения, Тело);
	
КонецФункции

Функция ЗначениеОдногоТипа(ТипЗначения, Текст)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Текст;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ЧислоИзТекста(Текст);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ДатаИзТекста(Текст);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат БулевоИзТекста(Текст);
	КонецЕсли;
	
	ИмяТаблицы = ИмяТаблицыПоТипу(ТипЗначения);
	Если ЛевИмениТипа(ТипЗначения) = "EnumRef" Тогда
		Возврат ЗначениеПеречисления(ТипЗначения, Текст);
	КонецЕсли;
	
	Если ИмяТаблицы <> "" Тогда
		Возврат XMLЗначение(ТипЗначения, Текст);
	КонецЕсли;
	
	ВызватьИсключение "Нельзя разобрать значение отбора """ + Текст + """.";
	
КонецФункции

Функция ПустоеЗначениеТипа(ТипЗначения)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат 0;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат '00010101';
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЛевИмениТипа(ТипЗначения) = "EnumRef" Тогда
		Имя = ИмяОбъектаТипа(ТипЗначения);
		Возврат Перечисления[Имя].ПустаяСсылка();
	КонецЕсли;
	
	ИмяТаблицы = ИмяТаблицыПоТипу(ТипЗначения);
	Если ИмяТаблицы <> "" Тогда
		Возврат XMLЗначение(ТипЗначения, "00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗначениеПеречисления(ТипЗначения, Текст)
	
	Имя = ИмяОбъектаТипа(ТипЗначения);
	ИмяЗначения = СокрЛП(Текст);
	Позиция = Найти(ИмяЗначения, ".");
	Если Позиция > 0 Тогда
		Части = РазделитьСтроку(ИмяЗначения, ".");
		ИмяЗначения = Части[Части.Количество() - 1];
	КонецЕсли;
	
	Попытка
		Возврат Перечисления[Имя][ИмяЗначения];
	Исключение
		ВызватьИсключение "Нет значения перечисления " + Имя + "." + ИмяЗначения + ".";
	КонецПопытки;
	
КонецФункции

Функция ЗначениеВидаСчета(Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Ключ = СтрЗаменить(Ключ, " ", "");
	Ключ = СтрЗаменить(Ключ, "-", "");
	
	Если Ключ = "активный" Или Ключ = "active" Тогда
		Возврат ВидСчета.Активный;
	ИначеЕсли Ключ = "пассивный" Или Ключ = "passive" Тогда
		Возврат ВидСчета.Пассивный;
	ИначеЕсли Ключ = "активнопассивный" Или Ключ = "activepassive" Тогда
		Возврат ВидСчета.АктивноПассивный;
	КонецЕсли;
	
	ВызватьИсключение "Некорректный вид счета """ + Текст + """. Укажите Активный, Пассивный или АктивноПассивный.";
	
КонецФункции

Функция БулевоИзТекста(Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Если Ключ = "истина" Или Ключ = "да" Или Ключ = "true" Или Ключ = "1" Тогда
		Возврат Истина;
	ИначеЕсли Ключ = "ложь" Или Ключ = "нет" Или Ключ = "false" Или Ключ = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВызватьИсключение "Некорректное булево значение """ + Текст + """.";
	
КонецФункции

Функция ЧислоИзТекста(Текст)
	
	Нормализованный = СтрЗаменить(СокрЛП(Текст), " ", "");
	Нормализованный = СтрЗаменить(Нормализованный, Символ(160), "");
	Нормализованный = СтрЗаменить(Нормализованный, ",", ".");
	
	Попытка
		Возврат XMLЗначение(Тип("Число"), Нормализованный);
	Исключение
		ВызватьИсключение "Некорректное число """ + Текст + """.";
	КонецПопытки;
	
КонецФункции

Функция ДатаИзТекста(Текст)
	
	Текст = СокрЛП(Текст);
	Если Текст = "" Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Если Найти(Текст, "-") > 0 Тогда
		Нормализованный = Текст;
		Если Найти(Нормализованный, "T") = 0 И СтрДлина(Нормализованный) >= 10 Тогда
			Нормализованный = Лев(Нормализованный, 10) + "T00:00:00";
		КонецЕсли;
		Попытка
			Возврат XMLЗначение(Тип("Дата"), Нормализованный);
		Исключение
			ВызватьИсключение "Некорректная дата """ + Текст + """.";
		КонецПопытки;
	КонецЕсли;
	
	ТекстДаты = Текст;
	ТекстВремени = "";
	ПозицияПробела = Найти(Текст, " ");
	Если ПозицияПробела > 0 Тогда
		ТекстДаты = Лев(Текст, ПозицияПробела - 1);
		ТекстВремени = СокрЛП(Сред(Текст, ПозицияПробела + 1));
	КонецЕсли;
	
	ЧастиДаты = РазделитьСтроку(ТекстДаты, ".");
	Если ЧастиДаты.Количество() <> 3 Тогда
		ВызватьИсключение "Некорректная дата """ + Текст + """. Укажите ДД.ММ.ГГГГ или ГГГГ-ММ-ДД.";
	КонецЕсли;
	
	Час = 0;
	Минута = 0;
	Секунда = 0;
	Если ТекстВремени <> "" Тогда
		ЧастиВремени = РазделитьСтроку(ТекстВремени, ":");
		Час = Число(ЧастиВремени[0]);
		Если ЧастиВремени.Количество() > 1 Тогда
			Минута = Число(ЧастиВремени[1]);
		КонецЕсли;
		Если ЧастиВремени.Количество() > 2 Тогда
			Секунда = Число(ЧастиВремени[2]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Дата(Число(ЧастиДаты[2]), Число(ЧастиДаты[1]), Число(ЧастиДаты[0]), Час, Минута, Секунда);
	
КонецФункции

Функция ИмяТаблицыПоТипу(ТипЗначения)
	
	Префикс = ЛевИмениТипа(ТипЗначения);
	Имя = ИмяОбъектаТипа(ТипЗначения);
	Если Префикс = "" Или Имя = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Если Префикс = "CatalogRef" Тогда
		Возврат "Справочник." + Имя;
	ИначеЕсли Префикс = "DocumentRef" Тогда
		Возврат "Документ." + Имя;
	ИначеЕсли Префикс = "EnumRef" Тогда
		Возврат "Перечисление." + Имя;
	ИначеЕсли Префикс = "ChartOfCharacteristicTypesRef" Тогда
		Возврат "ПланВидовХарактеристик." + Имя;
	ИначеЕсли Префикс = "ChartOfAccountsRef" Тогда
		Возврат "ПланСчетов." + Имя;
	ИначеЕсли Префикс = "ChartOfCalculationTypesRef" Тогда
		Возврат "ПланВидовРасчета." + Имя;
	ИначеЕсли Префикс = "ExchangePlanRef" Тогда
		Возврат "ПланОбмена." + Имя;
	ИначеЕсли Префикс = "BusinessProcessRef" Тогда
		Возврат "БизнесПроцесс." + Имя;
	ИначеЕсли Префикс = "TaskRef" Тогда
		Возврат "Задача." + Имя;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ЛевИмениТипа(ТипЗначения)
	
	ТипXML = XMLТип(ТипЗначения);
	Если ТипXML = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Позиция = Найти(ТипXML.ИмяТипа, ".");
	Если Позиция = 0 Тогда
		Возврат ТипXML.ИмяТипа;
	КонецЕсли;
	
	Возврат Лев(ТипXML.ИмяТипа, Позиция - 1);
	
КонецФункции

Функция ИмяОбъектаТипа(ТипЗначения)
	
	ТипXML = XMLТип(ТипЗначения);
	Если ТипXML = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Позиция = Найти(ТипXML.ИмяТипа, ".");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(ТипXML.ИмяТипа, Позиция + 1);
	
КонецФункции

Процедура СравнитьОбъектМетаданных(ПолноеИмя, Отборы, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано)
	
	ТекстОшибкиФайла = КэшФайла.Ошибки.Получить(ПолноеИмя);
	Если ТекстОшибкиФайла <> Неопределено Тогда
		ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, 0, 0, 0, 0, 0);
		ДобавитьОтличие(Отличия, ПолноеИмя, "Ошибка", "", "(выгрузка)", "", ТекстОшибкиФайла, ВсегоОтличий, Обрезано);
		Возврат;
	КонецЕсли;
	
	Если КэшФайла.Виденные.Получить(ПолноеИмя) = Неопределено Тогда
		Предупреждения.Добавить(ПолноеИмя + ": объекта нет в файле выгрузки. Данные файла приняты пустыми.");
	КонецЕсли;
	
	ОбъектыФайла = КэшФайла.Объекты.Получить(ПолноеИмя);
	Если ОбъектыФайла = Неопределено Тогда
		ОбъектыФайла = Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Описание = ОписаниеОбъекта(ПолноеИмя);
		Подготовка = ПодготовитьЗапрос(Описание, Отборы, НачалоПериода, КонецПериода);
		СтрокиБазы = ПрочитатьСтрокиТабличныхЧастей(Описание, Подготовка.Запрос, Подготовка.ТекстГде);
		Подготовка.Запрос.Текст = ТекстЗапросаШапки(Описание, Подготовка.ТекстГде);
		Выборка = Подготовка.Запрос.Выполнить().Выбрать();
	Исключение
		ТекстОшибки = КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(ПолноеИмя + ": " + ТекстОшибки);
		ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, 0, ОбъектыФайла.Количество(), 0, 0, 0);
		ДобавитьОтличие(Отличия, ПолноеИмя, "Ошибка", "", "(запрос)", "", ТекстОшибки, ВсегоОтличий, Обрезано);
		Возврат;
	КонецПопытки;
	
	СтрокаСтатистики = ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, 0, ОбъектыФайла.Количество(), 0, 0, 0);
	КоличествоБазы = 0;
	
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоБазы = КоличествоБазы + 1;
		Ключ = XMLСтрока(Выборка.Ссылка);
		ЗначенияШапки = КартаЗначенийВыборки(Выборка, Описание.Поля);
		Представление = ПредставлениеОбъекта(ЗначенияШапки, Ключ);
		ОбъектФайла = ОбъектыФайла.Получить(Ключ);
		
		Если ОбъектФайла = Неопределено Тогда
			СтрокаСтатистики.ТолькоВБазе = СтрокаСтатистики.ТолькоВБазе + 1;
			ДобавитьОтличие(Отличия, ПолноеИмя, "Только в этой базе", Представление, "(весь объект)", ПредставлениеКарты(Описание.Поля, ЗначенияШапки), "", ВсегоОтличий, Обрезано);
			Продолжить;
		КонецЕсли;
		
		СравнитьКартыПолей(Описание.Поля, ЗначенияШапки, ОбъектФайла.Поля, "", ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано);
		
		СтрокиОбъекта = Неопределено;
		Если СтрокиБазы <> Неопределено Тогда
			СтрокиОбъекта = СтрокиБазы.Получить(Ключ);
		КонецЕсли;
		СравнитьСтрокиОбъекта(СтрокиОбъекта, ОбъектФайла.Строки, ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано);
		ОбъектыФайла.Удалить(Ключ);
	КонецЦикла;
	
	СтрокаСтатистики.ЗаписейВБазе = КоличествоБазы;
	
	Для Каждого ЭлементОбъекта Из ОбъектыФайла Цикл
		ОбъектФайла = ЭлементОбъекта.Значение;
		СтрокаСтатистики.ТолькоВФайле = СтрокаСтатистики.ТолькоВФайле + 1;
		ДобавитьОтличие(Отличия, ПолноеИмя, "Только в файле", ОбъектФайла.Представление, "(весь объект)", "", ПредставлениеКарты(ОбъектФайла.ПорядокПолей, ОбъектФайла.Поля), ВсегоОтличий, Обрезано);
	КонецЦикла;
	
КонецПроцедуры

Процедура СравнитьСтрокиОбъекта(СтрокиБазы, СтрокиФайла, ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано)
	
	Если СтрокиБазы = Неопределено Тогда
		СтрокиБазы = Новый Соответствие;
	КонецЕсли;
	Если СтрокиФайла = Неопределено Тогда
		СтрокиФайла = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого ЭлементСтроки Из СтрокиБазы Цикл
		СтрокаБазы = ЭлементСтроки.Значение;
		СтрокаФайла = СтрокиФайла.Получить(ЭлементСтроки.Ключ);
		ИмяСтроки = СтрокаБазы.ИмяТаблицы + "[" + ФорматЧисла(СтрокаБазы.НомерСтроки) + "]";
		
		Если СтрокаФайла = Неопределено Тогда
			СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
			ДобавитьОтличие(Отличия, ПолноеИмя, "Расхождение", Представление, ИмяСтроки, ПредставлениеКарты(СтрокаБазы.ПорядокПолей, СтрокаБазы.Поля), "(нет строки)", ВсегоОтличий, Обрезано);
			Продолжить;
		КонецЕсли;
		
		СравнитьКартыПолей(СтрокаБазы.ПорядокПолей, СтрокаБазы.Поля, СтрокаФайла.Поля, ИмяСтроки + ".", ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано);
		СтрокиФайла.Удалить(ЭлементСтроки.Ключ);
	КонецЦикла;
	
	Для Каждого ЭлементСтроки Из СтрокиФайла Цикл
		СтрокаФайла = ЭлементСтроки.Значение;
		ИмяСтроки = СтрокаФайла.ИмяТаблицы + "[" + ФорматЧисла(СтрокаФайла.НомерСтроки) + "]";
		СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
		ДобавитьОтличие(Отличия, ПолноеИмя, "Расхождение", Представление, ИмяСтроки, "(нет строки)", ПредставлениеКарты(СтрокаФайла.ПорядокПолей, СтрокаФайла.Поля), ВсегоОтличий, Обрезано);
	КонецЦикла;
	
КонецПроцедуры

Процедура СравнитьКартыПолей(ПорядокБазы, КартаБазы, КартаФайла, Префикс, ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано)
	
	Виденные = Новый Соответствие;
	
	Для Каждого Поле Из ПорядокБазы Цикл
		ИмяПоля = ИмяЭлементаПорядка(Поле);
		Виденные.Вставить(ИмяПоля, Истина);
		ЗначениеБазы = КартаБазы.Получить(ИмяПоля);
		КанонБазы = "";
		ПредставлениеБазы = "";
		Если ЗначениеБазы <> Неопределено Тогда
			КанонБазы = ЗначениеБазы.Канон;
			ПредставлениеБазы = ЗначениеБазы.Представление;
		КонецЕсли;
		
		ЗначениеФайла = Неопределено;
		Если КартаФайла <> Неопределено Тогда
			ЗначениеФайла = КартаФайла.Получить(ИмяПоля);
		КонецЕсли;
		
		Если ЗначениеФайла = Неопределено Тогда
			КанонФайла = "<нет поля>";
			ПредставлениеФайла = "";
		Иначе
			КанонФайла = ЗначениеФайла.Канон;
			ПредставлениеФайла = ЗначениеФайла.Представление;
		КонецЕсли;
		
		Если НормализоватьКанон(КанонБазы) <> НормализоватьКанон(КанонФайла) Тогда
			СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
			ДобавитьОтличие(Отличия, ПолноеИмя, "Расхождение", Представление, Префикс + ИмяПоля, ПредставлениеБазы, ПредставлениеФайла, ВсегоОтличий, Обрезано);
		КонецЕсли;
	КонецЦикла;
	
	Если КартаФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементПоля Из КартаФайла Цикл
		Если Виденные.Получить(ЭлементПоля.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
		ДобавитьОтличие(Отличия, ПолноеИмя, "Расхождение", Представление, Префикс + ЭлементПоля.Ключ, "", ЭлементПоля.Значение.Представление, ВсегоОтличий, Обрезано);
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьФайлВыгрузки(ИмяФайла, ПолныеИмена)
	
	Выбранные = Новый Соответствие;
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Выбранные.Вставить(ПолноеИмя, Истина);
	КонецЦикла;
	
	Кэш = Новый Структура;
	Кэш.Вставить("ВерсияФормата", "");
	Кэш.Вставить("Конфигурация", "");
	Кэш.Вставить("ПериодНачало", '00010101');
	Кэш.Вставить("ПериодКонец", '00010101');
	Кэш.Вставить("ТекстОтборов", "");
	Кэш.Вставить("Объекты", Новый Соответствие);
	Кэш.Вставить("Ошибки", Новый Соответствие);
	Кэш.Вставить("Виденные", Новый Соответствие);
	Кэш.Вставить("Предупреждения", Новый Массив);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ТекущиеОбъекты = Неопределено;
	ТекущийОбъект = Неопределено;
	ТекущаяСтрока = Неопределено;
	КореньНайден = Ложь;
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Row" Тогда
			ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Object" Тогда
			ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			ЗафиксироватьОбъект(ТекущиеОбъекты, ТекущийОбъект);
			ТекущийОбъект = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = Чтение.Имя;
		
		Если ИмяУзла = "ReferenceObjectComparison" Тогда
			
			КореньНайден = Истина;
			Кэш.ВерсияФормата = Атрибут(Чтение, "formatVersion");
			Если Кэш.ВерсияФормата <> "1" Тогда
				ВызватьИсключение "Неподдерживаемая версия файла сравнения: " + Кэш.ВерсияФормата + ".";
			КонецЕсли;
			Кэш.Конфигурация = Атрибут(Чтение, "configuration");
			Кэш.ПериодНачало = ДатаИзАтрибута(Атрибут(Чтение, "periodFrom"));
			Кэш.ПериодКонец = ДатаИзАтрибута(Атрибут(Чтение, "periodTo"));
			Кэш.ТекстОтборов = Атрибут(Чтение, "filterText");
			
		ИначеЕсли ИмяУзла = "Metadata" Тогда
			
			ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			ЗафиксироватьОбъект(ТекущиеОбъекты, ТекущийОбъект);
			ТекущийОбъект = Неопределено;
			ИмяМетаданных = Атрибут(Чтение, "name");
			Кэш.Виденные.Вставить(ИмяМетаданных, Истина);
			Если Выбранные.Получить(ИмяМетаданных) <> Неопределено Тогда
				ТекущиеОбъекты = Новый Соответствие;
				Кэш.Объекты.Вставить(ИмяМетаданных, ТекущиеОбъекты);
			Иначе
				ТекущиеОбъекты = Неопределено;
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Object" Тогда
			
			ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			ЗафиксироватьОбъект(ТекущиеОбъекты, ТекущийОбъект);
			ТекущийОбъект = Неопределено;
			Если ТекущиеОбъекты <> Неопределено Тогда
				ТекущийОбъект = НовыйОбъектФайла(Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Row" Тогда
			
			ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			Если ТекущийОбъект <> Неопределено Тогда
				ТекущаяСтрока = НоваяСтрокаТаблицы(Атрибут(Чтение, "table"), ЧислоАтрибута(Атрибут(Чтение, "line")));
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Field" Тогда
			
			Если ТекущаяСтрока <> Неопределено Тогда
				ДобавитьПолеФайла(ТекущаяСтрока.Поля, ТекущаяСтрока.ПорядокПолей, Чтение);
			ИначеЕсли ТекущийОбъект <> Неопределено Тогда
				ДобавитьПолеФайла(ТекущийОбъект.Поля, ТекущийОбъект.ПорядокПолей, Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Error" Тогда
			
			ИмяМетаданных = Атрибут(Чтение, "meta");
			ТекстОшибки = Атрибут(Чтение, "text");
			Кэш.Виденные.Вставить(ИмяМетаданных, Истина);
			Кэш.Ошибки.Вставить(ИмяМетаданных, ТекстОшибки);
			Кэш.Предупреждения.Добавить(ИмяМетаданных + ": " + ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
	ЗафиксироватьОбъект(ТекущиеОбъекты, ТекущийОбъект);
	Чтение.Закрыть();
	
	Если Не КореньНайден Тогда
		ВызватьИсключение "Файл не является выгрузкой сравнения ссылочных объектов.";
	КонецЕсли;
	
	Возврат Кэш;
	
КонецФункции

Функция НовыйОбъектФайла(Чтение)
	
	ОбъектФайла = Новый Структура;
	ОбъектФайла.Вставить("Ключ", Атрибут(Чтение, "uuid"));
	ОбъектФайла.Вставить("Представление", Атрибут(Чтение, "presentation"));
	ОбъектФайла.Вставить("Поля", Новый Соответствие);
	ОбъектФайла.Вставить("ПорядокПолей", Новый Массив);
	ОбъектФайла.Вставить("Строки", Новый Соответствие);
	Возврат ОбъектФайла;
	
КонецФункции

Функция НоваяСтрокаТаблицы(ИмяТаблицы, НомерСтроки)
	
	СтрокаТаблицы = Новый Структура;
	СтрокаТаблицы.Вставить("ИмяТаблицы", ИмяТаблицы);
	СтрокаТаблицы.Вставить("НомерСтроки", НомерСтроки);
	СтрокаТаблицы.Вставить("Поля", Новый Соответствие);
	СтрокаТаблицы.Вставить("ПорядокПолей", Новый Массив);
	Возврат СтрокаТаблицы;
	
КонецФункции

Процедура ДобавитьПолеФайла(КартаПолей, ПорядокПолей, Чтение)
	
	ИмяПоля = Атрибут(Чтение, "name");
	КартаПолей.Вставить(ИмяПоля, Новый Структура("Канон, Представление", НормализоватьКанон(Атрибут(Чтение, "canonical")), Атрибут(Чтение, "presentation")));
	ПорядокПолей.Добавить(ИмяПоля);
	
КонецПроцедуры

Процедура ЗафиксироватьСтроку(ОбъектФайла, СтрокаТаблицы)
	
	Если ОбъектФайла = Неопределено Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючСтроки = СтрокаТаблицы.ИмяТаблицы + "|" + ФорматЧисла(СтрокаТаблицы.НомерСтроки);
	ОбъектФайла.Строки.Вставить(КлючСтроки, СтрокаТаблицы);
	
КонецПроцедуры

Процедура ЗафиксироватьОбъект(ОбъектыФайла, ОбъектФайла)
	
	Если ОбъектыФайла = Неопределено Или ОбъектФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектыФайла.Вставить(ОбъектФайла.Ключ, ОбъектФайла);
	
КонецПроцедуры

Функция КартаЗначенийВыборки(Выборка, Поля)
	
	Карта = Новый Соответствие;
	Порядок = Новый Массив;
	ЗаполнитьКартуВыборки(Выборка, Поля, Карта, Порядок);
	Возврат Карта;
	
КонецФункции

Процедура ЗаполнитьКартуВыборки(Выборка, Поля, Карта, Порядок)
	
	Для Каждого Поле Из Поля Цикл
		ЗначениеПоля = Новый Структура("Канон, Представление", КаноническоеЗначение(Выборка[Поле.Имя]), ТекстXML(ПредставлениеЗначения(Выборка[Поле.Имя])));
		Карта.Вставить(Поле.Имя, ЗначениеПоля);
		Порядок.Добавить(Поле.Имя);
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеОбъекта(ЗначенияШапки, Ключ)
	
	Части = Новый Массив;
	ДобавитьЧастьПредставления(Части, ЗначенияШапки, "Номер");
	ДобавитьЧастьПредставления(Части, ЗначенияШапки, "Дата");
	ДобавитьЧастьПредставления(Части, ЗначенияШапки, "Код");
	ДобавитьЧастьПредставления(Части, ЗначенияШапки, "Наименование");
	
	Если Части.Количество() = 0 Тогда
		Возврат Ключ;
	КонецЕсли;
	
	Возврат СоединитьСтроки(Части, " ") + " | " + Ключ;
	
КонецФункции

Процедура ДобавитьЧастьПредставления(Части, ЗначенияШапки, ИмяПоля)
	
	ЗначениеПоля = ЗначенияШапки.Получить(ИмяПоля);
	Если ЗначениеПоля = Неопределено Или Не ЗначениеЗаполнено(ЗначениеПоля.Представление) Тогда
		Возврат;
	КонецЕсли;
	
	Части.Добавить(ЗначениеПоля.Представление);
	
КонецПроцедуры

Функция ПредставлениеКарты(ПорядокПолей, КартаПолей)
	
	Части = Новый Массив;
	Для Каждого Поле Из ПорядокПолей Цикл
		ИмяПоля = ИмяЭлементаПорядка(Поле);
		ЗначениеПоля = КартаПолей.Получить(ИмяПоля);
		Если ЗначениеПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(ИмяПоля + " = " + ЗначениеПоля.Представление);
	КонецЦикла;
	
	Текст = СоединитьСтроки(Части, "; ");
	Если СтрДлина(Текст) > 1000 Тогда
		Возврат Лев(Текст, 1000) + "...";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция КаноническоеЗначение(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "undef";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Null") Тогда
		Возврат "null";
	КонецЕсли;
	
	Если ЭтоСсылочныйТип(ТипЗначения) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат ТипXML.ИмяТипа + ":" + XMLСтрока(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "string:" + ТекстXML(Значение);
	КонецЕсли;
	
	Попытка
		ТипXML = XMLТип(ТипЗначения);
		Если ТипXML = Неопределено Тогда
			Возврат ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		КонецЕсли;
		Возврат НормализоватьКанон(ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	Исключение
		Попытка
			Возврат ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		Исключение
			Возврат ТекстXML("string:" + Строка(Значение));
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

Функция ПредставлениеЗначения(Значение)
	
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + ТекстXML(Значение) + """";
	КонецЕсли;
	
	Если ЭтоСсылочныйТип(ТипЗнч(Значение)) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат ТекстXML(Строка(Значение) + " | " + ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	КонецЕсли;
	
	Возврат ТекстXML(Строка(Значение) + " | " + КаноническоеЗначение(Значение));
	
КонецФункции

Функция НормализоватьКанон(Канон)
	
	Префикс = "decimal:";
	Если Лев(Канон, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Канон;
	КонецЕсли;
	
	Текст = СокрЛП(Сред(Канон, СтрДлина(Префикс) + 1));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, Символ(8239), "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если Лев(Текст, 1) = "+" Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	ПозицияТочки = Найти(Текст, ".");
	Если ПозицияТочки > 0 Тогда
		Целая = Лев(Текст, ПозицияТочки - 1);
		Дробная = Сред(Текст, ПозицияТочки + 1);
		Пока Прав(Дробная, 1) = "0" И Дробная <> "" Цикл
			Дробная = Лев(Дробная, СтрДлина(Дробная) - 1);
		КонецЦикла;
		Если Дробная = "" Тогда
			Текст = Целая;
		Иначе
			Текст = Целая + "." + Дробная;
		КонецЕсли;
	КонецЕсли;
	
	Если Текст = "" Или Текст = "-" Или Текст = "-0" Тогда
		Текст = "0";
	КонецЕсли;
	
	Возврат Префикс + Текст;
	
КонецФункции

Процедура ИнициализироватьКэшТипов()
	
	Если ОписанияТиповСсылок <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписанияТиповСсылок = Новый Массив;
	ОписанияТиповСсылок.Добавить(Справочники.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(Документы.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(ПланыСчетов.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(ПланыВидовРасчета.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(ПланыОбмена.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(БизнесПроцессы.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(Задачи.ТипВсеСсылки());
	КэшСсылочныхТипов = Новый Соответствие;
	
КонецПроцедуры

Функция ЭтоСсылочныйТип(ТипЗначения)
	
	Если ОписанияТиповСсылок = Неопределено Тогда
		ИнициализироватьКэшТипов();
	КонецЕсли;
	
	Признак = КэшСсылочныхТипов.Получить(ТипЗначения);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;
	
	Признак = Ложь;
	Для Каждого ОписаниеТипа Из ОписанияТиповСсылок Цикл
		Если ОписаниеТипа.СодержитТип(ТипЗначения) Тогда
			Признак = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	КэшСсылочныхТипов.Вставить(ТипЗначения, Признак);
	Возврат Признак;
	
КонецФункции

