Функция КраткийТекстОшибки(Текст)
	
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Возврат Лев(СокрЛП(Текст), 1000);
	
КонецФункции

Функция ТекстПредупреждений(Предупреждения)
	
	Показано = Новый Массив;
	Лимит = 20;
	Индекс = 0;
	Для Каждого Часть Из Предупреждения Цикл
		Если Индекс >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Показано.Добавить(Часть);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Текст = "Предупреждения:" + Символы.ПС + СоединитьСтроки(Показано, Символы.ПС);
	Если Предупреждения.Количество() > Лимит Тогда
		Текст = Текст + Символы.ПС + "И еще " + ФорматЧисла(Предупреждения.Количество() - Лимит) + ".";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ТекстXML(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Если Не СимволДопустимВXML(КодСимвола(Текст, Номер)) Тогда
			Возврат ТекстXMLСЗаменой(Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция ТекстXMLСЗаменой(Текст)
	
	Результат = "";
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Код = КодСимвола(Текст, Номер);
		Если СимволДопустимВXML(Код) Тогда
			Результат = Результат + Символ(Код);
		Иначе
			Результат = Результат + "#x" + ФорматЧисла(Код) + "#";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СимволДопустимВXML(Код)
	
	Если Код = 9 Или Код = 10 Или Код = 13 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 32 И Код <= 55295 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 57344 И Код <= 65533 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция СоединитьСтроки(Части, Разделитель)
	
	Результат = "";
	Индекс = 0;
	Для Каждого Часть Из Части Цикл
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Часть;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РазделитьСтроку(Текст, Разделитель)
	
	Части = Новый Массив;
	Остаток = Строка(Текст);
	ДлинаРазделителя = СтрДлина(Разделитель);
	Позиция = Найти(Остаток, Разделитель);
	Пока Позиция > 0 Цикл
		Части.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + ДлинаРазделителя);
		Позиция = Найти(Остаток, Разделитель);
	КонецЦикла;
	Части.Добавить(Остаток);
	Возврат Части;
	
КонецФункции

Функция ФорматЧисла(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

Процедура УдалитьВременныйФайл(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры
