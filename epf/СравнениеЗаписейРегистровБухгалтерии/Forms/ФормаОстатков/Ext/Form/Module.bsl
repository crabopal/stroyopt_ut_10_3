
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаОстатков = НачалоДня(ТекущаяДата());
	ЗаполнитьРегистрыПоУмолчанию();
	ЗаполнитьСпискиОтбора();
	УстановитьУсловноеОформление();
	ИтогСравнения = "Укажите дату, отметьте регистры бухгалтерии и выгрузите файл в первой базе либо сравните файл во второй.";
	
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		Предупреждение("Укажите дату остатков.");
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьВыбранныеРегистры() Тогда
		Предупреждение("Выберите хотя бы один регистр бухгалтерии.");
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить файл остатков";
	Диалог.Фильтр = "XML-файл остатков (*.xml)|*.xml";
	Диалог.Расширение = "xml";
	Диалог.ПолноеИмяФайла = "СравнениеОстатковРегистровБухгалтерии.xml";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Выгрузка остатков регистров бухгалтерии...");
	
	Попытка
		Адрес = ВыгрузитьНаСервере();
	Исключение
		Предупреждение(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если Не ПолучитьФайл(Адрес, Диалог.ПолноеИмяФайла, Ложь) Тогда
		Предупреждение("Не удалось сохранить файл.");
		Возврат;
	КонецЕсли;
	
	ИтогСравнения = ИтогСравнения + Символы.ПС + "Файл: " + Диалог.ПолноеИмяФайла;
	
КонецПроцедуры

&НаКлиенте
Процедура Сравнить(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		Предупреждение("Укажите дату остатков.");
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьВыбранныеРегистры() Тогда
		Предупреждение("Выберите хотя бы один регистр бухгалтерии.");
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл остатков";
	Диалог.Фильтр = "XML-файл остатков (*.xml)|*.xml";
	Диалог.Расширение = "xml";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = "";
	Если Не ПоместитьФайл(Адрес, Диалог.ПолноеИмяФайла, , Ложь) Тогда
		Предупреждение("Не удалось передать файл для сравнения.");
		Возврат;
	КонецЕсли;
	
	Состояние("Сравнение остатков регистров бухгалтерии...");
	
	Попытка
		СравнитьНаСервере(Адрес);
	Исключение
		Предупреждение(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ОтборПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	УстановитьПометки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	УстановитьПометки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРегистр(Команда)
	
	Список = СписокРегистровДляДобавления();
	Если Список.Количество() = 0 Тогда
		Предупреждение("Все регистры бухгалтерии конфигурации уже есть в списке.");
		Возврат;
	КонецЕсли;
	
	Выбранный = Список.ВыбратьЭлемент("Добавить регистр бухгалтерии");
	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьРегистрНаСервере(Выбранный.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписиЗаПериод(Команда)
	
	ОткрытьСоседнююФорму("Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(ОтборРегистр) Тогда
		Отбор.Вставить("Регистр", ОтборРегистр);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборВид) Тогда
		Отбор.Вставить("ВидОтличия", ОтборВид);
	КонецЕсли;
	
	Если Отбор.Количество() = 0 Тогда
		Элементы.Результат.ОтборСтрок = Неопределено;
	Иначе
		Элементы.Результат.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрыВыбранПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Регистры.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ТекущиеДанные.Выбран Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекущиеДанные.ЕстьВБазе Тогда
		ТекущиеДанные.Выбран = Ложь;
		Предупреждение("Регистр """ + ТекущиеДанные.Имя + """ отсутствует в конфигурации.");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьВыбранныеРегистры()
	
	Для Каждого СтрокаРегистра Из Регистры Цикл
		Если СтрокаРегистра.Выбран Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометки(Пометка)
	
	Для Каждого СтрокаРегистра Из Регистры Цикл
		Если Пометка И СтрокаРегистра.ЕстьВБазе Тогда
			СтрокаРегистра.Выбран = Истина;
		Иначе
			СтрокаРегистра.Выбран = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСоседнююФорму(ИмяФормыНазначения)
	
	Попытка
		ОткрытьФорму(ИмяСоседнейФормы(ИмяФормыНазначения));
	Исключение
		Предупреждение(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ИмяСоседнейФормы(ИмяФормыНазначения)
	
	ИмяТекущей = ЭтаФорма.ИмяФормы;
	Маркер = ".Форма.";
	Позиция = Найти(ИмяТекущей, Маркер);
	Если Позиция = 0 Тогда
		Маркер = ".Form.";
		Позиция = Найти(ИмяТекущей, Маркер);
	КонецЕсли;
	
	Если Позиция = 0 Тогда
		ВызватьИсключение "Не удалось определить имя формы " + ИмяФормыНазначения + ". Текущая форма: " + ИмяТекущей + ".";
	КонецЕсли;
	
	Возврат Лев(ИмяТекущей, Позиция + СтрДлина(Маркер) - 1) + ИмяФормыНазначения;
	
КонецФункции

&НаСервере
Функция ВыгрузитьНаСервере()
	
	СброситьСтатистику();
	Результат.Очистить();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатВыгрузки = ОбработкаОбъект.ВыгрузитьОстатки(ВыбранныеИменаРегистров(), ДатаОстатков);
	ПрименитьСтатистику(РезультатВыгрузки.Статистика);
	ИтогСравнения = РезультатВыгрузки.Сообщение;
	
	Возврат ПоместитьВоВременноеХранилище(РезультатВыгрузки.Данные, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура СравнитьНаСервере(АдресФайла)
	
	СброситьСтатистику();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатСравнения = ОбработкаОбъект.СравнитьОстатки(АдресФайла, ДатаОстатков, ВыбранныеИменаРегистров());
	ЗначениеВДанныеФормы(РезультатСравнения.Отличия, Результат);
	ПрименитьСтатистику(РезультатСравнения.Статистика);
	ИтогСравнения = РезультатСравнения.Сообщение;
	
КонецПроцедуры

&НаСервере
Функция ВыбранныеИменаРегистров()
	
	Имена = Новый Массив;
	Для Каждого СтрокаРегистра Из Регистры Цикл
		Если СтрокаРегистра.Выбран Тогда
			Имена.Добавить(СтрокаРегистра.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРегистрыПоУмолчанию()
	
	Регистры.Очистить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Для Каждого ИмяРегистра Из ОбработкаОбъект.ИменаРегистровПоУмолчанию() Цикл
		ДобавитьСтрокуРегистра(ИмяРегистра);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРегистрНаСервере(ИмяРегистра)
	
	Найденные = Регистры.НайтиСтроки(Новый Структура("Имя", ИмяРегистра));
	Если Найденные.Количество() > 0 Тогда
		Если Найденные[0].ЕстьВБазе Тогда
			Найденные[0].Выбран = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ДобавитьСтрокуРегистра(ИмяРегистра);
	Элементы.ОтборРегистр.СписокВыбора.Добавить(ИмяРегистра, Регистры[Регистры.Количество() - 1].Синоним);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуРегистра(ИмяРегистра)
	
	СтрокаРегистра = Регистры.Добавить();
	СтрокаРегистра.Имя = ИмяРегистра;
	СтрокаРегистра.ЗаписейВБазе = 0;
	СтрокаРегистра.ЗаписейВФайле = 0;
	СтрокаРегистра.ТолькоВБазе = 0;
	СтрокаРегистра.ТолькоВФайле = 0;
	СтрокаРегистра.Расхождений = 0;
	СтрокаРегистра.Выбран = Ложь;
	СтрокаРегистра.ЕстьВБазе = Ложь;
	СтрокаРегистра.ВидРегистра = "";
	
	Мета = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		СтрокаРегистра.Синоним = "нет в конфигурации";
		Возврат;
	КонецЕсли;
	
	СтрокаРегистра.ЕстьВБазе = Истина;
	Синоним = Строка(Мета.Синоним);
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	СтрокаРегистра.Синоним = Синоним;
	СтрокаРегистра.Выбран = Истина;
	ПланСчетов = Мета.ПланСчетов;
	Если ПланСчетов = Неопределено Тогда
		СтрокаРегистра.ВидРегистра = "";
	Иначе
		СтрокаРегистра.ВидРегистра = ПланСчетов.Имя;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СписокРегистровДляДобавления()
	
	УжеЕсть = Новый Соответствие;
	Для Каждого СтрокаРегистра Из Регистры Цикл
		УжеЕсть.Вставить(СтрокаРегистра.Имя, Истина);
	КонецЦикла;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Список = Новый СписокЗначений;
	Для Каждого Мета Из Метаданные.РегистрыБухгалтерии Цикл
		Если УжеЕсть.Получить(Мета.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ОбработкаОбъект.РегистрВедетОстатки(Мета.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Синоним = Строка(Мета.Синоним);
		Если Не ЗначениеЗаполнено(Синоним) Тогда
			Синоним = Мета.Имя;
		КонецЕсли;
		Список.Добавить(Мета.Имя, Синоним + " (" + Мета.Имя + ")");
	КонецЦикла;
	
	Список.СортироватьПоПредставлению();
	Возврат Список;
	
КонецФункции

&НаСервере
Процедура СброситьСтатистику()
	
	Для Каждого СтрокаРегистра Из Регистры Цикл
		СтрокаРегистра.ЗаписейВБазе = 0;
		СтрокаРегистра.ЗаписейВФайле = 0;
		СтрокаРегистра.ТолькоВБазе = 0;
		СтрокаРегистра.ТолькоВФайле = 0;
		СтрокаРегистра.Расхождений = 0;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьСтатистику(Статистика)
	
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		Найденные = Регистры.НайтиСтроки(Новый Структура("Имя", СтрокаСтатистики.Имя));
		Для Каждого СтрокаРегистра Из Найденные Цикл
			ЗаполнитьЗначенияСвойств(СтрокаРегистра, СтрокаСтатистики);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиОтбора()
	
	Элементы.ОтборВид.СписокВыбора.Очистить();
	Элементы.ОтборВид.СписокВыбора.Добавить("Расхождение");
	Элементы.ОтборВид.СписокВыбора.Добавить("Только в этой базе");
	Элементы.ОтборВид.СписокВыбора.Добавить("Только в файле");
	Элементы.ОтборВид.СписокВыбора.Добавить("Ошибка");
	
	Элементы.ОтборРегистр.СписокВыбора.Очистить();
	Для Каждого СтрокаРегистра Из Регистры Цикл
		Элементы.ОтборРегистр.СписокВыбора.Добавить(СтрокаРегистра.Имя, СтрокаРегистра.Синоним);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ДобавитьОформлениеРезультата("Расхождение", WebЦвета.СветлоЖелтый);
	ДобавитьОформлениеРезультата("Только в этой базе", WebЦвета.ТусклоРозовый);
	ДобавитьОформлениеРезультата("Только в файле", WebЦвета.Голубой);
	ДобавитьОформлениеРезультата("Ошибка", WebЦвета.Лосось);
	ДобавитьОформлениеРегистровСОтличиями();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеРезультата(ВидОтличия, ЦветФона)
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Результат");
	Поле.Использование = Истина;
	
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Результат.ВидОтличия");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = ВидОтличия;
	Отбор.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеРегистровСОтличиями()
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Регистры");
	Поле.Использование = Истина;
	
	Группа = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	Группа.Использование = Истина;
	
	ДобавитьОтборБольшеНоля(Группа, "Регистры.ТолькоВБазе");
	ДобавитьОтборБольшеНоля(Группа, "Регистры.ТолькоВФайле");
	ДобавитьОтборБольшеНоля(Группа, "Регистры.Расхождений");
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоЖелтый);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборБольшеНоля(Группа, ИмяПоля)
	
	Отбор = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Отбор.ПравоеЗначение = 0;
	Отбор.Использование = Истина;
	
КонецПроцедуры
