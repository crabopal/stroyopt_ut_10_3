// Внешняя обработка «Инструменты базы УТ».
// Форма «Меню» открывает один из инструментов: сравнение регистров накопления,
// сравнение регистров бухгалтерии, сравнение ссылочных объектов,
// перенос регистрации обмена УТ-БП и удаление помеченных заказов покупателей.
// Процедуры инструментов разделены префиксами, чтобы одинаковые имена не пересекались.
//
// Сборка EPF из каталога epf (платформа 8.3, режим совместимости конфигурации 8.2.13):
// 1cv8 DESIGNER /F "<база>" /DisableStartupDialogs /LoadExternalDataProcessorOrReportFromFiles "<каталог epf>" "<путь к epf>"
//
// Код рассчитан на режим совместимости 8.2.13: без методов платформы 8.3.6 и новее.

Перем Накоп_ОписанияТиповСсылок;
Перем Накоп_КэшСсылочныхТипов;
Перем Бух_ОписанияТиповСсылок;
Перем Бух_КэшСсылочныхТипов;
Перем Ссыл_ОписанияТиповСсылок;
Перем Ссыл_КэшСсылочныхТипов;
Перем Обмен_ОписанияТиповСсылок;
Перем Обмен_КэшСсылочныхТипов;
Перем Удал_ОписаниеЗаказа;
Перем Удал_ОписанияТиповСсылок;
Перем Удал_КэшСсылочныхТипов;

// --- Сравнение записей и остатков регистров накопления ---
// Внешняя обработка сравнения записей регистров накопления УТ 10.3.
//
// В одной базе записи выбранных регистров за период выгружаются в XML-файл.
// В другой базе файл читается и сравнивается с записями этой базы за период на форме.
// Строка регистра сопоставляется по идентификатору регистратора и номеру строки.
// Ссылочные значения сравниваются по типу XML и UUID, без кода, номера и наименования.
// Сравнивается каждая колонка записи: период, активность, вид движения, измерения, ресурсы, реквизиты.
//
// Форма «ФормаОстатков» сравнивает остатки на конец выбранного дня по регистрам того же списка
// с видом Остатки. Строка остатка сопоставляется по каноническим значениям всех измерений.
// Сравнивается каждая колонка остатка: измерения и ресурсы. Реквизиты в виртуальную таблицу остатков не входят.
//
// Сборка EPF из каталога epf (платформа 8.3, режим совместимости конфигурации 8.2.13):
// 1cv8 DESIGNER /F "<база>" /DisableStartupDialogs /LoadExternalDataProcessorOrReportFromFiles "<каталог epf>" "<путь к epf>"
//
// Код рассчитан на режим совместимости 8.2.13: без методов платформы 8.3.6 и новее.


Функция Накоп_ИменаРегистровПоУмолчанию() Экспорт
	
	Имена = Новый Массив;
	Имена.Добавить("ВзаиморасчетыСКонтрагентами");
	Имена.Добавить("ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов");
	Имена.Добавить("ДенежныеСредства");
	Имена.Добавить("ДенежныеСредстваКПолучению");
	Имена.Добавить("ДенежныеСредстваКСписанию");
	Имена.Добавить("ЗаказыПокупателей");
	Имена.Добавить("ЗаказыПоставщикам");
	Имена.Добавить("НДСНачисленный");
	Имена.Добавить("НДСПредъявленный");
	Имена.Добавить("НДСРасчетыСПокупателями");
	Имена.Добавить("НДСРасчетыСПоставщиками");
	Имена.Добавить("НДСРеализация0");
	Имена.Добавить("ПартииТоваровНаСкладах");
	Имена.Добавить("РазмещениеЗаказовПокупателей");
	Имена.Добавить("РасчетыСКонтрагентами");
	Имена.Добавить("РозничнаяВыручка");
	Имена.Добавить("ТоварыВРезервеНаСкладах");
	Имена.Добавить("ТоварыКПередачеОрганизаций");
	Имена.Добавить("ТоварыКПередачеСоСкладов");
	Имена.Добавить("ТоварыНаСкладах");
	Имена.Добавить("ТоварыОрганизаций");
	Возврат Имена;
	
КонецФункции

Функция Накоп_Выгрузить(ИменаРегистров, НачалоПериода, КонецПериода) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры накопления.";
	КонецЕсли;
	
	Накоп_ИнициализироватьКэшТипов();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Статистика = Накоп_НоваяСтатистика();
	Предупреждения = Новый Массив;
	КоличествоЗаписей = 0;
	
	Попытка
		КоличествоЗаписей = Накоп_ЗаписатьФайлВыгрузки(ИмяФайла, ИменаРегистров, НачалоПериода, КонецПериода, Статистика, Предупреждения);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		Накоп_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Накоп_УдалитьВременныйФайл(ИмяФайла);
	
	Сообщение = "Выгружено записей: " + Накоп_ФорматЧисла(КоличествоЗаписей) + "."
		+ Символы.ПС + "Период: " + Накоп_ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Регистров в файле: " + Накоп_ФорматЧисла(Статистика.Количество()) + ".";
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = "Выгрузка завершена с ошибками." + Символы.ПС + Сообщение
			+ Символы.ПС + Накоп_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Накоп_Сравнить(АдресФайла, НачалоПериода, КонецПериода, ИменаРегистров) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры накопления.";
	КонецЕсли;
	
	Накоп_ИнициализироватьКэшТипов();
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл сравнения.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ИмяФайла);
	
	Попытка
		КэшФайла = Накоп_ПрочитатьФайлВыгрузки(ИмяФайла, ИменаРегистров);
	Исключение
		Накоп_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Накоп_УдалитьВременныйФайл(ИмяФайла);
	
	Отличия = Накоп_НоваяТаблицаОтличий();
	Статистика = Накоп_НоваяСтатистика();
	Предупреждения = КэшФайла.Предупреждения;
	Обрезано = Ложь;
	ВсегоОтличий = 0;
	
	Если Накоп_ДатаВАтрибут(НачалоПериода) <> Накоп_ДатаВАтрибут(КэшФайла.ПериодНачало)
		Или Накоп_ДатаВАтрибут(КонецПериода) <> Накоп_ДатаВАтрибут(КэшФайла.ПериодКонец) Тогда
		Предупреждения.Добавить("Период на форме (" + Накоп_ТекстПериодаСравнения(НачалоПериода, КонецПериода)
			+ ") отличается от периода файла (" + Накоп_ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец)
			+ "). Записи этой базы отобраны за период на форме.");
	КонецЕсли;
	
	Если КэшФайла.Конфигурация <> "" И КэшФайла.Конфигурация <> Метаданные.Имя Тогда
		Предупреждения.Добавить("Файл выгружен из конфигурации """ + КэшФайла.Конфигурация
			+ """, текущая конфигурация """ + Метаданные.Имя + """.");
	КонецЕсли;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Накоп_СравнитьРегистр(ИмяРегистра, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано);
	КонецЦикла;
	
	Отличия.Сортировать("Регистр, Регистратор, НомерСтроки, ИмяПоля");
	
	ВсегоВБазе = 0;
	ВсегоВФайле = 0;
	ТолькоВБазе = 0;
	ТолькоВФайле = 0;
	Расхождений = 0;
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		ВсегоВБазе = ВсегоВБазе + СтрокаСтатистики.ЗаписейВБазе;
		ВсегоВФайле = ВсегоВФайле + СтрокаСтатистики.ЗаписейВФайле;
		ТолькоВБазе = ТолькоВБазе + СтрокаСтатистики.ТолькоВБазе;
		ТолькоВФайле = ТолькоВФайле + СтрокаСтатистики.ТолькоВФайле;
		Расхождений = Расхождений + СтрокаСтатистики.Расхождений;
	КонецЦикла;
	
	Сообщение = "Период сравнения: " + Накоп_ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Период файла: " + Накоп_ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец) + "."
		+ Символы.ПС + "Записей в этой базе: " + Накоп_ФорматЧисла(ВсегоВБазе) + ", в файле: " + Накоп_ФорматЧисла(ВсегоВФайле) + "."
		+ Символы.ПС + "Только в этой базе: " + Накоп_ФорматЧисла(ТолькоВБазе)
		+ ", только в файле: " + Накоп_ФорматЧисла(ТолькоВФайле)
		+ ", расхождений по колонкам: " + Накоп_ФорматЧисла(Расхождений) + ".";
	
	Если ВсегоОтличий = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Отличий не найдено.";
	КонецЕсли;
	
	Если Обрезано Тогда
		Сообщение = Сообщение + Символы.ПС + "В таблицу выведены первые " + Накоп_ФорматЧисла(Накоп_МаксимальноеКоличествоСтрокРезультата())
			+ " строк отличий из " + Накоп_ФорматЧисла(ВсегоОтличий) + ".";
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + Накоп_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отличия", Отличия);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Накоп_ЗаписатьФайлВыгрузки(ИмяФайла, ИменаРегистров, НачалоПериода, КонецПериода, Статистика, Предупреждения)
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьКомментарий("Ключ записи: тип и UUID регистратора и номер строки. Ссылки сравниваются по типу XML и UUID.");
	Запись.ЗаписатьНачалоЭлемента("AccumulationRegisterComparison");
	Запись.ЗаписатьАтрибут("formatVersion", "1");
	Запись.ЗаписатьАтрибут("configuration", Метаданные.Имя);
	Запись.ЗаписатьАтрибут("configurationVersion", Метаданные.Версия);
	Запись.ЗаписатьАтрибут("exportedAt", XMLСтрока(ТекущаяДата()));
	Запись.ЗаписатьАтрибут("periodFrom", Накоп_ДатаВАтрибут(НачалоПериода));
	Запись.ЗаписатьАтрибут("periodTo", Накоп_ДатаВАтрибут(КонецПериода));
	
	КоличествоЗаписей = 0;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		
		Попытка
			Описание = Накоп_ОписаниеРегистра(ИмяРегистра);
			Выборка = Накоп_ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода);
		Исключение
			ТекстОшибки = Накоп_КраткийТекстОшибки(ОписаниеОшибки());
			Накоп_ЗаписатьОшибку(Запись, ИмяРегистра, ТекстОшибки);
			Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			Накоп_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
			Продолжить;
		КонецПопытки;
		
		КоличествоРегистра = Накоп_ЗаписатьРегистр(Запись, Описание, Выборка);
		КоличествоЗаписей = КоличествоЗаписей + КоличествоРегистра;
		Накоп_ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, КоличествоРегистра, 0, 0, 0, 0);
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	
	Возврат КоличествоЗаписей;
	
КонецФункции

Функция Накоп_ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = Накоп_ТекстЗапроса(Описание, НачалоПериода, КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция Накоп_ЗаписатьРегистр(Запись, Описание, Выборка)
	
	Запись.ЗаписатьНачалоЭлемента("Register");
	Запись.ЗаписатьАтрибут("name", Описание.Имя);
	Запись.ЗаписатьАтрибут("synonym", Накоп_ТекстXML(Описание.Синоним));
	
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Накоп_ЗаписатьЗаписьРегистра(Запись, Выборка, Описание.Поля);
		Количество = Количество + 1;
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Возврат Количество;
	
КонецФункции

Процедура Накоп_ЗаписатьЗаписьРегистра(Запись, Выборка, Поля)
	
	Ключ = Накоп_КлючЗаписи(Выборка.Регистратор, Выборка.НомерСтроки);
	Запись.ЗаписатьНачалоЭлемента("Record");
	Запись.ЗаписатьАтрибут("key", Ключ);
	Запись.ЗаписатьАтрибут("line", Накоп_ФорматЧисла(Выборка.НомерСтроки));
	Запись.ЗаписатьАтрибут("recorder", Накоп_ПредставлениеЗначения(Выборка.Регистратор));
	
	Для Каждого Поле Из Поля Цикл
		Значение = Выборка[Поле.Имя];
		Запись.ЗаписатьНачалоЭлемента("Field");
		Запись.ЗаписатьАтрибут("name", Поле.Имя);
		Запись.ЗаписатьАтрибут("role", Поле.Роль);
		Запись.ЗаписатьАтрибут("canonical", Накоп_КаноническоеЗначение(Значение));
		Запись.ЗаписатьАтрибут("presentation", Накоп_ПредставлениеЗначения(Значение));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура Накоп_ЗаписатьОшибку(Запись, ИмяРегистра, ТекстОшибки)
	
	Запись.ЗаписатьНачалоЭлемента("Error");
	Запись.ЗаписатьАтрибут("register", Накоп_ТекстXML(ИмяРегистра));
	Запись.ЗаписатьАтрибут("text", Накоп_ТекстXML(ТекстОшибки));
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция Накоп_ПрочитатьФайлВыгрузки(ИмяФайла, ИменаРегистров)
	
	Выбранные = Новый Соответствие;
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Выбранные.Вставить(ИмяРегистра, Истина);
	КонецЦикла;
	
	Кэш = Новый Структура;
	Кэш.Вставить("ВерсияФормата", "");
	Кэш.Вставить("Конфигурация", "");
	Кэш.Вставить("ВерсияКонфигурации", "");
	Кэш.Вставить("ПериодНачало", '00010101');
	Кэш.Вставить("ПериодКонец", '00010101');
	Кэш.Вставить("Регистры", Новый Соответствие);
	Кэш.Вставить("Ошибки", Новый Соответствие);
	Кэш.Вставить("Виденные", Новый Соответствие);
	Кэш.Вставить("Предупреждения", Новый Массив);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ТекущиеЗаписи = Неопределено;
	ТекущаяЗапись = Неопределено;
	ЧитатьЗаписи = Ложь;
	КореньНайден = Ложь;
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Record" Тогда
			Накоп_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = Чтение.Имя;
		
		Если ИмяУзла = "AccumulationRegisterComparison" Тогда
			
			КореньНайден = Истина;
			Кэш.ВерсияФормата = Накоп_Атрибут(Чтение, "formatVersion");
			Если Кэш.ВерсияФормата <> "1" Тогда
				ВызватьИсключение "Неподдерживаемая версия файла сравнения: " + Кэш.ВерсияФормата + ".";
			КонецЕсли;
			Кэш.Конфигурация = Накоп_Атрибут(Чтение, "configuration");
			Кэш.ВерсияКонфигурации = Накоп_Атрибут(Чтение, "configurationVersion");
			Кэш.ПериодНачало = Накоп_ДатаИзАтрибута(Накоп_Атрибут(Чтение, "periodFrom"));
			Кэш.ПериодКонец = Накоп_ДатаИзАтрибута(Накоп_Атрибут(Чтение, "periodTo"));
			
		ИначеЕсли ИмяУзла = "Register" Тогда
			
			Накоп_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			ИмяРегистра = Накоп_Атрибут(Чтение, "name");
			Кэш.Виденные.Вставить(ИмяРегистра, Истина);
			ЧитатьЗаписи = Выбранные.Получить(ИмяРегистра) <> Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущиеЗаписи = Новый Соответствие;
				Кэш.Регистры.Вставить(ИмяРегистра, ТекущиеЗаписи);
			Иначе
				ТекущиеЗаписи = Неопределено;
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Record" Тогда
			
			Накоп_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущаяЗапись = Накоп_НоваяЗаписьФайла(Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Field" Тогда
			
			Если ТекущаяЗапись <> Неопределено Тогда
				ИмяПоля = Накоп_Атрибут(Чтение, "name");
				Поле = Новый Структура("Канон, Представление", Накоп_НормализоватьКанон(Накоп_Атрибут(Чтение, "canonical")), Накоп_Атрибут(Чтение, "presentation"));
				ТекущаяЗапись.Поля.Вставить(ИмяПоля, Поле);
				ТекущаяЗапись.ПорядокПолей.Добавить(ИмяПоля);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Error" Тогда
			
			ИмяРегистра = Накоп_Атрибут(Чтение, "register");
			ТекстОшибки = Накоп_Атрибут(Чтение, "text");
			Кэш.Виденные.Вставить(ИмяРегистра, Истина);
			Кэш.Ошибки.Вставить(ИмяРегистра, ТекстОшибки);
			Кэш.Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Накоп_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
	ТекущаяЗапись = Неопределено;
	Чтение.Закрыть();
	
	Если Не КореньНайден Тогда
		ВызватьИсключение "Файл не является выгрузкой сравнения регистров накопления.";
	КонецЕсли;
	
	Возврат Кэш;
	
КонецФункции

Процедура Накоп_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись)
	
	Если ТекущаяЗапись = Неопределено Или ТекущиеЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеЗаписи.Вставить(ТекущаяЗапись.Ключ, ТекущаяЗапись);
	
КонецПроцедуры

Функция Накоп_НоваяЗаписьФайла(Чтение)
	
	ЗаписьФайла = Новый Структура;
	ЗаписьФайла.Вставить("Ключ", Накоп_НормализоватьКлючЗаписи(Накоп_Атрибут(Чтение, "key")));
	ЗаписьФайла.Вставить("НомерСтроки", Накоп_ЧислоАтрибута(Накоп_Атрибут(Чтение, "line")));
	ЗаписьФайла.Вставить("Регистратор", Накоп_Атрибут(Чтение, "recorder"));
	ЗаписьФайла.Вставить("Поля", Новый Соответствие);
	ЗаписьФайла.Вставить("ПорядокПолей", Новый Массив);
	Возврат ЗаписьФайла;
	
КонецФункции

Процедура Накоп_СравнитьРегистр(ИмяРегистра, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано)
	
	ТекстОшибкиФайла = КэшФайла.Ошибки.Получить(ИмяРегистра);
	Если ТекстОшибкиФайла <> Неопределено Тогда
		Накоп_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
		Накоп_ДобавитьОтличие(Отличия, ИмяРегистра, "Ошибка", "", 0, "(выгрузка)", "", ТекстОшибкиФайла, ВсегоОтличий, Обрезано);
		Возврат;
	КонецЕсли;
	
	Если КэшФайла.Виденные.Получить(ИмяРегистра) = Неопределено Тогда
		Предупреждения.Добавить(ИмяРегистра + ": регистр отсутствует в файле выгрузки. Записи файла приняты пустыми.");
	КонецЕсли;
	
	ЗаписиФайла = КэшФайла.Регистры.Получить(ИмяРегистра);
	Если ЗаписиФайла = Неопределено Тогда
		ЗаписиФайла = Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Описание = Накоп_ОписаниеРегистра(ИмяРегистра);
	Исключение
		ТекстОшибки = Накоп_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
		Накоп_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, ЗаписиФайла.Количество(), 0, 0, 0);
		Накоп_ДобавитьОтличие(Отличия, ИмяРегистра, "Ошибка", "", 0, "(метаданные)", "", ТекстОшибки, ВсегоОтличий, Обрезано);
		Возврат;
	КонецПопытки;
	
	СтрокаСтатистики = Накоп_ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, 0, ЗаписиФайла.Количество(), 0, 0, 0);
	ИменаПолейБазы = Новый Соответствие;
	Для Каждого Поле Из Описание.Поля Цикл
		ИменаПолейБазы.Вставить(Поле.Имя, Истина);
	КонецЦикла;
	
	Попытка
		Выборка = Накоп_ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода);
	Исключение
		ТекстОшибки = Накоп_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(Описание.Имя + ": " + ТекстОшибки);
		Накоп_ДобавитьОтличие(Отличия, Описание.Имя, "Ошибка", "", 0, "(запрос)", "", ТекстОшибки, ВсегоОтличий, Обрезано);
		Возврат;
	КонецПопытки;
	
	КоличествоБазы = 0;
	Пока Выборка.Следующий() Цикл
		
		КоличествоБазы = КоличествоБазы + 1;
		Ключ = Накоп_КлючЗаписи(Выборка.Регистратор, Выборка.НомерСтроки);
		ЗаписьФайла = ЗаписиФайла.Получить(Ключ);
		ПредставлениеРегистратора = Накоп_ПредставлениеЗначения(Выборка.Регистратор);
		
		Если ЗаписьФайла = Неопределено Тогда
			СтрокаСтатистики.ТолькоВБазе = СтрокаСтатистики.ТолькоВБазе + 1;
			Накоп_ДобавитьОтличие(Отличия, Описание.Имя, "Только в этой базе", ПредставлениеРегистратора, Выборка.НомерСтроки,
				"(вся запись)", Накоп_ПредставлениеВыборки(Выборка, Описание.Поля), "", ВсегоОтличий, Обрезано);
			Продолжить;
		КонецЕсли;
		
		Для Каждого Поле Из Описание.Поля Цикл
			КанонБазы = Накоп_КаноническоеЗначение(Выборка[Поле.Имя]);
			ПолеФайла = ЗаписьФайла.Поля.Получить(Поле.Имя);
			Если ПолеФайла = Неопределено Тогда
				КанонФайла = "<нет поля>";
				ПредставлениеФайла = "";
			Иначе
				КанонФайла = ПолеФайла.Канон;
				ПредставлениеФайла = ПолеФайла.Представление;
			КонецЕсли;
			
			Если Накоп_НормализоватьКанон(КанонБазы) <> Накоп_НормализоватьКанон(КанонФайла) Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				Накоп_ДобавитьОтличие(Отличия, Описание.Имя, "Расхождение", ПредставлениеРегистратора, Выборка.НомерСтроки,
					Поле.Имя, Накоп_ПредставлениеЗначения(Выборка[Поле.Имя]), ПредставлениеФайла, ВсегоОтличий, Обрезано);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлементПоля Из ЗаписьФайла.Поля Цикл
			Если ИменаПолейБазы.Получить(ЭлементПоля.Ключ) = Неопределено Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				Накоп_ДобавитьОтличие(Отличия, Описание.Имя, "Расхождение", ПредставлениеРегистратора, Выборка.НомерСтроки,
					ЭлементПоля.Ключ, "", ЭлементПоля.Значение.Представление, ВсегоОтличий, Обрезано);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписиФайла.Удалить(Ключ);
		
	КонецЦикла;
	
	СтрокаСтатистики.ЗаписейВБазе = КоличествоБазы;
	
	Для Каждого ЭлементЗаписи Из ЗаписиФайла Цикл
		ЗаписьФайла = ЭлементЗаписи.Значение;
		СтрокаСтатистики.ТолькоВФайле = СтрокаСтатистики.ТолькоВФайле + 1;
		Накоп_ДобавитьОтличие(Отличия, Описание.Имя, "Только в файле", ЗаписьФайла.Регистратор, ЗаписьФайла.НомерСтроки,
			"(вся запись)", "", Накоп_ПредставлениеЗаписиФайла(ЗаписьФайла), ВсегоОтличий, Обрезано);
	КонецЦикла;
	
КонецПроцедуры

Функция Накоп_ОписаниеРегистра(ИмяРегистра)
	
	Мета = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		ВызватьИсключение "Регистр накопления """ + ИмяРегистра + """ не найден в конфигурации.";
	КонецЕсли;
	
	Поля = Новый Массив;
	Накоп_ДобавитьПоле(Поля, "Период", "Стандартное");
	Накоп_ДобавитьПоле(Поля, "Регистратор", "Стандартное");
	Накоп_ДобавитьПоле(Поля, "НомерСтроки", "Стандартное");
	Накоп_ДобавитьПоле(Поля, "Активность", "Стандартное");
	
	Если Мета.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
		Накоп_ДобавитьПоле(Поля, "ВидДвижения", "Стандартное");
	КонецЕсли;
	
	Для Каждого Измерение Из Мета.Измерения Цикл
		Накоп_ДобавитьПоле(Поля, Измерение.Имя, "Измерение");
	КонецЦикла;
	
	Для Каждого Ресурс Из Мета.Ресурсы Цикл
		Накоп_ДобавитьПоле(Поля, Ресурс.Имя, "Ресурс");
	КонецЦикла;
	
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Накоп_ДобавитьПоле(Поля, Реквизит.Имя, "Реквизит");
	КонецЦикла;
	
	Синоним = Строка(Мета.Синоним);
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Синоним", Синоним);
	Описание.Вставить("Поля", Поля);
	Возврат Описание;
	
КонецФункции

Процедура Накоп_ДобавитьПоле(Поля, Имя, Роль)
	
	Поле = Новый Структура("Имя, Роль", Имя, Роль);
	Поля.Добавить(Поле);
	
КонецПроцедуры

Функция Накоп_ТекстЗапроса(Описание, НачалоПериода, КонецПериода)
	
	ЧастиПолей = Новый Массив;
	Для Каждого Поле Из Описание.Поля Цикл
		ЧастиПолей.Добавить("Регистр." + Поле.Имя + " КАК " + Поле.Имя);
	КонецЦикла;
	
	Текст = "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + Накоп_СоединитьСтроки(ЧастиПолей, "," + Символы.ПС + Символы.Таб)
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + "РегистрНакопления." + Описание.Имя + " КАК Регистр";
	
	Условия = Новый Массив;
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Условия.Добавить("Регистр.Период >= &НачалоПериода");
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		Условия.Добавить("Регистр.Период <= &КонецПериода");
	КонецЕсли;
	
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб + Накоп_СоединитьСтроки(Условия, Символы.ПС + Символы.Таб + "И ");
	КонецЕсли;
	
	Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО"
		+ Символы.ПС + Символы.Таб + "Регистр.Регистратор,"
		+ Символы.ПС + Символы.Таб + "Регистр.НомерСтроки";
	
	Возврат Текст;
	
КонецФункции

Функция Накоп_КлючЗаписи(Регистратор, НомерСтроки)
	
	Возврат Накоп_КаноническоеЗначение(Регистратор) + "|" + Накоп_КаноническоеЗначение(НомерСтроки);
	
КонецФункции

Функция Накоп_КаноническоеЗначение(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "undef";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Null") Тогда
		Возврат "null";
	КонецЕсли;
	
	Если Накоп_ЭтоСсылочныйТип(ТипЗначения) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат ТипXML.ИмяТипа + ":" + XMLСтрока(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "string:" + Накоп_ТекстXML(Значение);
	КонецЕсли;
	
	Попытка
		ТипXML = XMLТип(ТипЗначения);
		Если ТипXML = Неопределено Тогда
			Возврат Накоп_ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		КонецЕсли;
		Возврат Накоп_НормализоватьКанон(ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	Исключение
		Попытка
			Возврат Накоп_ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		Исключение
			Возврат Накоп_ТекстXML("string:" + Строка(Значение));
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

Функция Накоп_ПредставлениеЗначения(Значение)
	
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + Накоп_ТекстXML(Значение) + """";
	КонецЕсли;
	
	Если Накоп_ЭтоСсылочныйТип(ТипЗнч(Значение)) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат Накоп_ТекстXML(Строка(Значение) + " | " + ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	КонецЕсли;
	
	Возврат Накоп_ТекстXML(Строка(Значение) + " | " + Накоп_КаноническоеЗначение(Значение));
	
КонецФункции

Функция Накоп_НормализоватьКанон(Канон)
	
	Префикс = "decimal:";
	Если Лев(Канон, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Канон;
	КонецЕсли;
	
	Текст = СокрЛП(Сред(Канон, СтрДлина(Префикс) + 1));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, Символ(8239), "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если Лев(Текст, 1) = "+" Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	ПозицияТочки = Найти(Текст, ".");
	Если ПозицияТочки > 0 Тогда
		Целая = Лев(Текст, ПозицияТочки - 1);
		Дробная = Сред(Текст, ПозицияТочки + 1);
		Пока Прав(Дробная, 1) = "0" Цикл
			Дробная = Лев(Дробная, СтрДлина(Дробная) - 1);
		КонецЦикла;
		Если Дробная = "" Тогда
			Текст = Целая;
		Иначе
			Текст = Целая + "." + Дробная;
		КонецЕсли;
	КонецЕсли;
	
	Если Текст = "" Или Текст = "-" Или Текст = "-0" Тогда
		Текст = "0";
	КонецЕсли;
	
	Возврат Префикс + Текст;
	
КонецФункции

Функция Накоп_НормализоватьКлючЗаписи(Ключ)
	
	Части = Новый Массив;
	Остаток = Ключ;
	Позиция = Найти(Остаток, "|");
	Пока Позиция > 0 Цикл
		Части.Добавить(Накоп_НормализоватьКанон(Лев(Остаток, Позиция - 1)));
		Остаток = Сред(Остаток, Позиция + 1);
		Позиция = Найти(Остаток, "|");
	КонецЦикла;
	Части.Добавить(Накоп_НормализоватьКанон(Остаток));
	Возврат Накоп_СоединитьСтроки(Части, "|");
	
КонецФункции

Функция Накоп_НормализоватьКлючОстатка(Ключ)
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат Ключ;
	КонецЕсли;
	
	Части = Новый Массив;
	Остаток = Ключ;
	
	Пока ЗначениеЗаполнено(Остаток) Цикл
		Позиция = Найти(Остаток, ":");
		Если Позиция = 0 Тогда
			Возврат Ключ;
		КонецЕсли;
		
		ДлинаТекста = 0;
		Попытка
			ДлинаТекста = Число(Лев(Остаток, Позиция - 1));
		Исключение
			Возврат Ключ;
		КонецПопытки;
		
		Если ДлинаТекста < 0 Или Позиция + ДлинаТекста > СтрДлина(Остаток) Тогда
			Возврат Ключ;
		КонецЕсли;
		
		Канон = Накоп_НормализоватьКанон(Сред(Остаток, Позиция + 1, ДлинаТекста));
		Части.Добавить(Накоп_ФорматЧисла(СтрДлина(Канон)) + ":" + Канон);
		Остаток = Сред(Остаток, Позиция + 1 + ДлинаТекста);
		Если Лев(Остаток, 1) = ";" Тогда
			Остаток = Сред(Остаток, 2);
		ИначеЕсли Остаток <> "" Тогда
			Возврат Ключ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Накоп_СоединитьСтроки(Части, ";");
	
КонецФункции

Функция Накоп_ПредставлениеВыборки(Выборка, Поля)
	
	Части = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Части.Добавить(Поле.Имя + " = " + Накоп_ПредставлениеЗначения(Выборка[Поле.Имя]));
	КонецЦикла;
	Возврат Накоп_СоединитьСтроки(Части, "; ");
	
КонецФункции

Функция Накоп_ПредставлениеЗаписиФайла(ЗаписьФайла)
	
	Части = Новый Массив;
	Для Каждого ИмяПоля Из ЗаписьФайла.ПорядокПолей Цикл
		Поле = ЗаписьФайла.Поля.Получить(ИмяПоля);
		Части.Добавить(ИмяПоля + " = " + Поле.Представление);
	КонецЦикла;
	Возврат Накоп_СоединитьСтроки(Части, "; ");
	
КонецФункции

Процедура Накоп_ИнициализироватьКэшТипов()
	
	Если Накоп_ОписанияТиповСсылок <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Накоп_ОписанияТиповСсылок = Новый Массив;
	Накоп_ОписанияТиповСсылок.Добавить(Справочники.ТипВсеСсылки());
	Накоп_ОписанияТиповСсылок.Добавить(Документы.ТипВсеСсылки());
	Накоп_ОписанияТиповСсылок.Добавить(Перечисления.ТипВсеСсылки());
	Накоп_ОписанияТиповСсылок.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки());
	Накоп_ОписанияТиповСсылок.Добавить(ПланыСчетов.ТипВсеСсылки());
	Накоп_ОписанияТиповСсылок.Добавить(ПланыВидовРасчета.ТипВсеСсылки());
	Накоп_ОписанияТиповСсылок.Добавить(БизнесПроцессы.ТипВсеСсылки());
	Накоп_ОписанияТиповСсылок.Добавить(Задачи.ТипВсеСсылки());
	Накоп_КэшСсылочныхТипов = Новый Соответствие;
	
КонецПроцедуры

Функция Накоп_ЭтоСсылочныйТип(ТипЗначения)
	
	Если Накоп_ОписанияТиповСсылок = Неопределено Тогда
		Накоп_ИнициализироватьКэшТипов();
	КонецЕсли;
	
	Признак = Накоп_КэшСсылочныхТипов.Получить(ТипЗначения);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;
	
	Признак = Ложь;
	Для Каждого ОписаниеТипа Из Накоп_ОписанияТиповСсылок Цикл
		Если ОписаниеТипа.СодержитТип(ТипЗначения) Тогда
			Признак = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Накоп_КэшСсылочныхТипов.Вставить(ТипЗначения, Признак);
	Возврат Признак;
	
КонецФункции

Функция Накоп_НоваяТаблицаОтличий()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Регистр", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ВидОтличия", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Регистратор", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВБазе", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
	
КонецФункции

Функция Накоп_НоваяСтатистика()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗаписейВБазе", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ЗаписейВФайле", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ТолькоВБазе", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ТолькоВФайле", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Расхождений", Новый ОписаниеТипов("Число"));
	Возврат Таблица;
	
КонецФункции

Функция Накоп_ДобавитьСтрокуСтатистики(Статистика, Имя, ЗаписейВБазе, ЗаписейВФайле, ТолькоВБазе, ТолькоВФайле, Расхождений)
	
	СтрокаСтатистики = Статистика.Добавить();
	СтрокаСтатистики.Имя = Имя;
	СтрокаСтатистики.ЗаписейВБазе = ЗаписейВБазе;
	СтрокаСтатистики.ЗаписейВФайле = ЗаписейВФайле;
	СтрокаСтатистики.ТолькоВБазе = ТолькоВБазе;
	СтрокаСтатистики.ТолькоВФайле = ТолькоВФайле;
	СтрокаСтатистики.Расхождений = Расхождений;
	Возврат СтрокаСтатистики;
	
КонецФункции

Процедура Накоп_ДобавитьОтличие(Отличия, Регистр, ВидОтличия, Регистратор, НомерСтроки, ИмяПоля, ЗначениеВБазе, ЗначениеВФайле, ВсегоОтличий, Обрезано)
	
	ВсегоОтличий = ВсегоОтличий + 1;
	Если Отличия.Количество() >= Накоп_МаксимальноеКоличествоСтрокРезультата() Тогда
		Обрезано = Истина;
		Возврат;
	КонецЕсли;
	
	СтрокаОтличия = Отличия.Добавить();
	СтрокаОтличия.Регистр = Регистр;
	СтрокаОтличия.ВидОтличия = ВидОтличия;
	СтрокаОтличия.Регистратор = Регистратор;
	СтрокаОтличия.НомерСтроки = НомерСтроки;
	СтрокаОтличия.ИмяПоля = ИмяПоля;
	СтрокаОтличия.ЗначениеВБазе = ЗначениеВБазе;
	СтрокаОтличия.ЗначениеВФайле = ЗначениеВФайле;
	
КонецПроцедуры

Функция Накоп_МаксимальноеКоличествоСтрокРезультата()
	
	Возврат 100000;
	
КонецФункции

Функция Накоп_ТекстПериодаСравнения(НачалоПериода, КонецПериода)
	
	Если Не ЗначениеЗаполнено(НачалоПериода) И Не ЗначениеЗаполнено(КонецПериода) Тогда
		Возврат "без ограничения";
	КонецЕсли;
	
	Возврат Формат(НачалоПериода, "ДЛФ=DT") + " — " + Формат(КонецПериода, "ДЛФ=DT");
	
КонецФункции

Функция Накоп_ДатаВАтрибут(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(Дата);
	
КонецФункции

Функция Накоп_ДатаИзАтрибута(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Возврат XMLЗначение(Тип("Дата"), Текст);
	
КонецФункции

Функция Накоп_Атрибут(Чтение, Имя)
	
	Значение = Чтение.ПолучитьАтрибут(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция Накоп_ЧислоАтрибута(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Число(Текст);
	
КонецФункции

Функция Накоп_КраткийТекстОшибки(Текст)
	
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Возврат Лев(СокрЛП(Текст), 1000);
	
КонецФункции

Функция Накоп_ТекстПредупреждений(Предупреждения)
	
	Возврат "Предупреждения:" + Символы.ПС + Накоп_СоединитьСтроки(Предупреждения, Символы.ПС);
	
КонецФункции

Функция Накоп_ТекстXML(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Если Не Накоп_СимволДопустимВXML(КодСимвола(Текст, Номер)) Тогда
			Возврат Накоп_ТекстXMLСЗаменой(Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция Накоп_ТекстXMLСЗаменой(Текст)
	
	Результат = "";
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Код = КодСимвола(Текст, Номер);
		Если Накоп_СимволДопустимВXML(Код) Тогда
			Результат = Результат + Символ(Код);
		Иначе
			Результат = Результат + "#x" + Накоп_ФорматЧисла(Код) + "#";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Накоп_СимволДопустимВXML(Код)
	
	Если Код = 9 Или Код = 10 Или Код = 13 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 32 И Код <= 55295 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 57344 И Код <= 65533 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция Накоп_СоединитьСтроки(Части, Разделитель)
	
	Результат = "";
	Индекс = 0;
	Для Каждого Часть Из Части Цикл
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Часть;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Накоп_ФорматЧисла(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

Процедура Накоп_УдалитьВременныйФайл(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

Функция Накоп_РегистрВедетОстатки(ИмяРегистра) Экспорт
	
	Мета = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Мета.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
	
КонецФункции

Функция Накоп_ВыгрузитьОстатки(ИменаРегистров, ДатаОстатков) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры накопления.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		ВызватьИсключение "Укажите дату остатков.";
	КонецЕсли;
	
	Накоп_ИнициализироватьКэшТипов();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Статистика = Накоп_НоваяСтатистика();
	Предупреждения = Новый Массив;
	КоличествоСтрок = 0;
	
	Попытка
		КоличествоСтрок = Накоп_ЗаписатьФайлОстатков(ИмяФайла, ИменаРегистров, ДатаОстатков, Статистика, Предупреждения);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		Накоп_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Накоп_УдалитьВременныйФайл(ИмяФайла);
	
	Сообщение = "Выгружено строк остатков: " + Накоп_ФорматЧисла(КоличествоСтрок) + "."
		+ Символы.ПС + "Дата остатков: " + Накоп_ТекстДатыОстатков(ДатаОстатков) + "."
		+ Символы.ПС + "Регистров в файле: " + Накоп_ФорматЧисла(Статистика.Количество()) + ".";
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = "Выгрузка завершена с ошибками." + Символы.ПС + Сообщение
			+ Символы.ПС + Накоп_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Накоп_СравнитьОстатки(АдресФайла, ДатаОстатков, ИменаРегистров) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры накопления.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		ВызватьИсключение "Укажите дату остатков.";
	КонецЕсли;
	
	Накоп_ИнициализироватьКэшТипов();
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл сравнения остатков.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ИмяФайла);
	
	Попытка
		КэшФайла = Накоп_ПрочитатьФайлОстатков(ИмяФайла, ИменаРегистров);
	Исключение
		Накоп_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Накоп_УдалитьВременныйФайл(ИмяФайла);
	
	Отличия = Накоп_НоваяТаблицаОтличийОстатков();
	Статистика = Накоп_НоваяСтатистика();
	Предупреждения = КэшФайла.Предупреждения;
	Счетчик = Новый Структура("Всего, Обрезано", 0, Ложь);
	
	Если Накоп_ДатаВАтрибут(ДатаОстатков) <> Накоп_ДатаВАтрибут(КэшФайла.ДатаОстатков) Тогда
		Предупреждения.Добавить("Дата остатков на форме (" + Накоп_ТекстДатыОстатков(ДатаОстатков)
			+ ") отличается от даты файла (" + Накоп_ТекстДатыОстатков(КэшФайла.ДатаОстатков)
			+ "). Остатки этой базы рассчитаны на дату формы.");
	КонецЕсли;
	
	Если КэшФайла.Конфигурация <> "" И КэшФайла.Конфигурация <> Метаданные.Имя Тогда
		Предупреждения.Добавить("Файл выгружен из конфигурации """ + КэшФайла.Конфигурация
			+ """, текущая конфигурация """ + Метаданные.Имя + """.");
	КонецЕсли;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Накоп_СравнитьОстаткиРегистра(ИмяРегистра, ДатаОстатков, КэшФайла, Отличия, Статистика, Предупреждения, Счетчик);
	КонецЦикла;
	
	Отличия.Сортировать("Регистр, Измерения, ИмяПоля");
	
	ВсегоВБазе = 0;
	ВсегоВФайле = 0;
	ТолькоВБазе = 0;
	ТолькоВФайле = 0;
	Расхождений = 0;
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		ВсегоВБазе = ВсегоВБазе + СтрокаСтатистики.ЗаписейВБазе;
		ВсегоВФайле = ВсегоВФайле + СтрокаСтатистики.ЗаписейВФайле;
		ТолькоВБазе = ТолькоВБазе + СтрокаСтатистики.ТолькоВБазе;
		ТолькоВФайле = ТолькоВФайле + СтрокаСтатистики.ТолькоВФайле;
		Расхождений = Расхождений + СтрокаСтатистики.Расхождений;
	КонецЦикла;
	
	Сообщение = "Дата остатков: " + Накоп_ТекстДатыОстатков(ДатаОстатков) + "."
		+ Символы.ПС + "Дата файла: " + Накоп_ТекстДатыОстатков(КэшФайла.ДатаОстатков) + "."
		+ Символы.ПС + "Строк остатков в этой базе: " + Накоп_ФорматЧисла(ВсегоВБазе) + ", в файле: " + Накоп_ФорматЧисла(ВсегоВФайле) + "."
		+ Символы.ПС + "Только в этой базе: " + Накоп_ФорматЧисла(ТолькоВБазе)
		+ ", только в файле: " + Накоп_ФорматЧисла(ТолькоВФайле)
		+ ", расхождений по колонкам: " + Накоп_ФорматЧисла(Расхождений) + ".";
	
	Если Счетчик.Всего = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Отличий не найдено.";
	КонецЕсли;
	
	Если Счетчик.Обрезано Тогда
		Сообщение = Сообщение + Символы.ПС + "В таблицу выведены первые " + Накоп_ФорматЧисла(Накоп_МаксимальноеКоличествоСтрокРезультата())
			+ " строк отличий из " + Накоп_ФорматЧисла(Счетчик.Всего) + ".";
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + Накоп_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отличия", Отличия);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Накоп_ЗаписатьФайлОстатков(ИмяФайла, ИменаРегистров, ДатаОстатков, Статистика, Предупреждения)
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьКомментарий("Остатки на конец дня. Ключ строки: канонические значения измерений. Ссылки: тип XML и UUID.");
	Запись.ЗаписатьНачалоЭлемента("AccumulationRegisterBalanceComparison");
	Запись.ЗаписатьАтрибут("formatVersion", "1");
	Запись.ЗаписатьАтрибут("configuration", Метаданные.Имя);
	Запись.ЗаписатьАтрибут("configurationVersion", Метаданные.Версия);
	Запись.ЗаписатьАтрибут("exportedAt", XMLСтрока(ТекущаяДата()));
	Запись.ЗаписатьАтрибут("balanceDate", Накоп_ДатаВАтрибут(ДатаОстатков));
	
	КоличествоСтрок = 0;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		
		Попытка
			Описание = Накоп_ОписаниеОстатков(ИмяРегистра);
			Выборка = Накоп_ВыбратьОстатки(Описание, ДатаОстатков);
		Исключение
			ТекстОшибки = Накоп_КраткийТекстОшибки(ОписаниеОшибки());
			Накоп_ЗаписатьОшибку(Запись, ИмяРегистра, ТекстОшибки);
			Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			Накоп_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
			Продолжить;
		КонецПопытки;
		
		КоличествоРегистра = Накоп_ЗаписатьОстаткиРегистра(Запись, Описание, Выборка, Предупреждения);
		КоличествоСтрок = КоличествоСтрок + КоличествоРегистра;
		Накоп_ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, КоличествоРегистра, 0, 0, 0, 0);
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	
	Возврат КоличествоСтрок;
	
КонецФункции

Функция Накоп_ОписаниеОстатков(ИмяРегистра)
	
	Мета = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		ВызватьИсключение "Регистр накопления """ + ИмяРегистра + """ не найден в конфигурации.";
	КонецЕсли;
	
	Если Мета.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
		ВызватьИсключение "Регистр """ + ИмяРегистра + """ имеет вид Обороты. Остатки по нему не рассчитываются.";
	КонецЕсли;
	
	Поля = Новый Массив;
	Измерения = Новый Массив;
	
	Для Каждого Измерение Из Мета.Измерения Цикл
		Накоп_ДобавитьПоле(Поля, Измерение.Имя, "Измерение");
		Накоп_ДобавитьПоле(Измерения, Измерение.Имя, "Измерение");
	КонецЦикла;
	
	Для Каждого Ресурс Из Мета.Ресурсы Цикл
		Накоп_ДобавитьПоле(Поля, Ресурс.Имя, "Ресурс");
	КонецЦикла;
	
	Если Поля.Количество() = 0 Тогда
		ВызватьИсключение "У регистра """ + ИмяРегистра + """ нет колонок остатка.";
	КонецЕсли;
	
	Синоним = Строка(Мета.Синоним);
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Синоним", Синоним);
	Описание.Вставить("Поля", Поля);
	Описание.Вставить("Измерения", Измерения);
	Возврат Описание;
	
КонецФункции

Функция Накоп_ВыбратьОстатки(Описание, ДатаОстатков)
	
	Запрос = Новый Запрос;
	Запрос.Текст = Накоп_ТекстЗапросаОстатков(Описание);
	Запрос.УстановитьПараметр("Момент", Накоп_МоментОстатков(ДатаОстатков));
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция Накоп_ТекстЗапросаОстатков(Описание)
	
	ЧастиПолей = Новый Массив;
	Для Каждого Поле Из Описание.Поля Цикл
		ИмяПоляТаблицы = Поле.Имя;
		Если Поле.Роль = "Ресурс" Тогда
			ИмяПоляТаблицы = Поле.Имя + "Остаток";
		КонецЕсли;
		ЧастиПолей.Добавить("Остатки." + ИмяПоляТаблицы + " КАК " + Поле.Имя);
	КонецЦикла;
	
	Текст = "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + Накоп_СоединитьСтроки(ЧастиПолей, "," + Символы.ПС + Символы.Таб)
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + "РегистрНакопления." + Описание.Имя + ".Остатки(&Момент, ) КАК Остатки";
	
	Если Описание.Измерения.Количество() > 0 Тогда
		ЧастиПорядка = Новый Массив;
		Для Каждого Поле Из Описание.Измерения Цикл
			ЧастиПорядка.Добавить("Остатки." + Поле.Имя);
		КонецЦикла;
		Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО"
			+ Символы.ПС + Символы.Таб + Накоп_СоединитьСтроки(ЧастиПорядка, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция Накоп_МоментОстатков(ДатаОстатков)
	
	Возврат Новый Граница(КонецДня(ДатаОстатков), ВидГраницы.Включая);
	
КонецФункции

Функция Накоп_ЗаписатьОстаткиРегистра(Запись, Описание, Выборка, Предупреждения)
	
	Запись.ЗаписатьНачалоЭлемента("Register");
	Запись.ЗаписатьАтрибут("name", Описание.Имя);
	Запись.ЗаписатьАтрибут("synonym", Накоп_ТекстXML(Описание.Синоним));
	
	Ключи = Новый Соответствие;
	Количество = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Ключ = Накоп_КлючОстатка(Выборка, Описание.Измерения);
		Если Ключи.Получить(Ключ) <> Неопределено Тогда
			Предупреждения.Добавить(Описание.Имя + ": повторяющаяся строка остатка, в файл записана первая.");
			Продолжить;
		КонецЕсли;
		
		Ключи.Вставить(Ключ, Истина);
		Накоп_ЗаписатьСтрокуОстатка(Запись, Выборка, Описание, Ключ);
		Количество = Количество + 1;
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Возврат Количество;
	
КонецФункции

Процедура Накоп_ЗаписатьСтрокуОстатка(Запись, Выборка, Описание, Ключ)
	
	Запись.ЗаписатьНачалоЭлемента("Record");
	Запись.ЗаписатьАтрибут("key", Ключ);
	Запись.ЗаписатьАтрибут("dimensions", Накоп_ПредставлениеИзмеренийВыборки(Выборка, Описание.Измерения));
	
	Для Каждого Поле Из Описание.Поля Цикл
		Значение = Выборка[Поле.Имя];
		Запись.ЗаписатьНачалоЭлемента("Field");
		Запись.ЗаписатьАтрибут("name", Поле.Имя);
		Запись.ЗаписатьАтрибут("role", Поле.Роль);
		Запись.ЗаписатьАтрибут("canonical", Накоп_КаноническоеЗначение(Значение));
		Запись.ЗаписатьАтрибут("presentation", Накоп_ПредставлениеЗначения(Значение));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция Накоп_КлючОстатка(Выборка, Измерения)
	
	Части = Новый Массив;
	Для Каждого Поле Из Измерения Цикл
		Канон = Накоп_КаноническоеЗначение(Выборка[Поле.Имя]);
		Части.Добавить(Накоп_ФорматЧисла(СтрДлина(Канон)) + ":" + Канон);
	КонецЦикла;
	
	Возврат Накоп_СоединитьСтроки(Части, ";");
	
КонецФункции

Функция Накоп_ПредставлениеИзмеренийВыборки(Выборка, Измерения)
	
	Если Измерения.Количество() = 0 Тогда
		Возврат "(без измерений)";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого Поле Из Измерения Цикл
		Части.Добавить(Поле.Имя + " = " + Накоп_ПредставлениеЗначения(Выборка[Поле.Имя]));
	КонецЦикла;
	
	Возврат Накоп_СоединитьСтроки(Части, "; ");
	
КонецФункции

Функция Накоп_ПрочитатьФайлОстатков(ИмяФайла, ИменаРегистров)
	
	Выбранные = Новый Соответствие;
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Выбранные.Вставить(ИмяРегистра, Истина);
	КонецЦикла;
	
	Кэш = Новый Структура;
	Кэш.Вставить("ВерсияФормата", "");
	Кэш.Вставить("Конфигурация", "");
	Кэш.Вставить("ВерсияКонфигурации", "");
	Кэш.Вставить("ДатаОстатков", '00010101');
	Кэш.Вставить("Регистры", Новый Соответствие);
	Кэш.Вставить("Ошибки", Новый Соответствие);
	Кэш.Вставить("Виденные", Новый Соответствие);
	Кэш.Вставить("Предупреждения", Новый Массив);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ТекущиеЗаписи = Неопределено;
	ТекущаяЗапись = Неопределено;
	ТекущийРегистр = "";
	ЧитатьЗаписи = Ложь;
	КореньНайден = Ложь;
	
	Попытка
		
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Record" Тогда
			Накоп_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ТекущийРегистр, Кэш.Предупреждения);
			ТекущаяЗапись = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = Чтение.Имя;
		
		Если ИмяУзла = "AccumulationRegisterBalanceComparison" Тогда
			
			КореньНайден = Истина;
			Кэш.ВерсияФормата = Накоп_Атрибут(Чтение, "formatVersion");
			Если Кэш.ВерсияФормата <> "1" Тогда
				ВызватьИсключение "Неподдерживаемая версия файла остатков: " + Кэш.ВерсияФормата + ".";
			КонецЕсли;
			Кэш.Конфигурация = Накоп_Атрибут(Чтение, "configuration");
			Кэш.ВерсияКонфигурации = Накоп_Атрибут(Чтение, "configurationVersion");
			Кэш.ДатаОстатков = Накоп_ДатаИзАтрибута(Накоп_Атрибут(Чтение, "balanceDate"));
			
		ИначеЕсли ИмяУзла = "AccumulationRegisterComparison" Тогда
			
			ВызватьИсключение "Этот файл содержит записи регистров за период, а не остатки на дату.";
			
		ИначеЕсли ИмяУзла = "Register" Тогда
			
			Накоп_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ТекущийРегистр, Кэш.Предупреждения);
			ТекущаяЗапись = Неопределено;
			ТекущийРегистр = Накоп_Атрибут(Чтение, "name");
			Кэш.Виденные.Вставить(ТекущийРегистр, Истина);
			ЧитатьЗаписи = Выбранные.Получить(ТекущийРегистр) <> Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущиеЗаписи = Новый Соответствие;
				Кэш.Регистры.Вставить(ТекущийРегистр, ТекущиеЗаписи);
			Иначе
				ТекущиеЗаписи = Неопределено;
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Record" Тогда
			
			Накоп_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ТекущийРегистр, Кэш.Предупреждения);
			ТекущаяЗапись = Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущаяЗапись = Накоп_НоваяЗаписьОстатка(Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Field" Тогда
			
			Если ТекущаяЗапись <> Неопределено Тогда
				ИмяПоля = Накоп_Атрибут(Чтение, "name");
				Поле = Новый Структура("Канон, Представление", Накоп_НормализоватьКанон(Накоп_Атрибут(Чтение, "canonical")), Накоп_Атрибут(Чтение, "presentation"));
				ТекущаяЗапись.Поля.Вставить(ИмяПоля, Поле);
				ТекущаяЗапись.ПорядокПолей.Добавить(ИмяПоля);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Error" Тогда
			
			ИмяРегистра = Накоп_Атрибут(Чтение, "register");
			ТекстОшибки = Накоп_Атрибут(Чтение, "text");
			Кэш.Виденные.Вставить(ИмяРегистра, Истина);
			Кэш.Ошибки.Вставить(ИмяРегистра, ТекстОшибки);
			Кэш.Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Накоп_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ТекущийРегистр, Кэш.Предупреждения);
	Чтение.Закрыть();
	
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если Не КореньНайден Тогда
		ВызватьИсключение "Файл не является выгрузкой остатков регистров накопления.";
	КонецЕсли;
	
	Возврат Кэш;
	
КонецФункции

Функция Накоп_НоваяЗаписьОстатка(Чтение)
	
	ЗаписьФайла = Новый Структура;
	ЗаписьФайла.Вставить("Ключ", Накоп_НормализоватьКлючОстатка(Накоп_Атрибут(Чтение, "key")));
	ЗаписьФайла.Вставить("Измерения", Накоп_Атрибут(Чтение, "dimensions"));
	ЗаписьФайла.Вставить("Поля", Новый Соответствие);
	ЗаписьФайла.Вставить("ПорядокПолей", Новый Массив);
	Возврат ЗаписьФайла;
	
КонецФункции

Процедура Накоп_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ИмяРегистра, Предупреждения)
	
	Если ТекущаяЗапись = Неопределено Или ТекущиеЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеЗаписи.Получить(ТекущаяЗапись.Ключ) <> Неопределено Тогда
		Предупреждения.Добавить(ИмяРегистра + ": повторяющаяся строка остатка в файле, оставлена первая.");
		Возврат;
	КонецЕсли;
	
	ТекущиеЗаписи.Вставить(ТекущаяЗапись.Ключ, ТекущаяЗапись);
	
КонецПроцедуры

Процедура Накоп_СравнитьОстаткиРегистра(ИмяРегистра, ДатаОстатков, КэшФайла, Отличия, Статистика, Предупреждения, Счетчик)
	
	ТекстОшибкиФайла = КэшФайла.Ошибки.Получить(ИмяРегистра);
	Если ТекстОшибкиФайла <> Неопределено Тогда
		Накоп_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
		Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, ИмяРегистра, "Ошибка", "", "(выгрузка)", "", ТекстОшибкиФайла);
		Возврат;
	КонецЕсли;
	
	Если КэшФайла.Виденные.Получить(ИмяРегистра) = Неопределено Тогда
		Предупреждения.Добавить(ИмяРегистра + ": регистр отсутствует в файле выгрузки. Строки файла приняты пустыми.");
	КонецЕсли;
	
	ЗаписиФайла = КэшФайла.Регистры.Получить(ИмяРегистра);
	Если ЗаписиФайла = Неопределено Тогда
		ЗаписиФайла = Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Описание = Накоп_ОписаниеОстатков(ИмяРегистра);
	Исключение
		ТекстОшибки = Накоп_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
		Накоп_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, ЗаписиФайла.Количество(), 0, 0, 0);
		Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, ИмяРегистра, "Ошибка", "", "(метаданные)", "", ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	СтрокаСтатистики = Накоп_ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, 0, ЗаписиФайла.Количество(), 0, 0, 0);
	ИменаПолейБазы = Новый Соответствие;
	Для Каждого Поле Из Описание.Поля Цикл
		ИменаПолейБазы.Вставить(Поле.Имя, Истина);
	КонецЦикла;
	
	Попытка
		Выборка = Накоп_ВыбратьОстатки(Описание, ДатаОстатков);
	Исключение
		ТекстОшибки = Накоп_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(Описание.Имя + ": " + ТекстОшибки);
		Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Ошибка", "", "(запрос)", "", ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	КоличествоБазы = 0;
	ВиденныеКлючи = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Ключ = Накоп_КлючОстатка(Выборка, Описание.Измерения);
		ПредставлениеИзмерений = Накоп_ПредставлениеИзмеренийВыборки(Выборка, Описание.Измерения);
		
		Если ВиденныеКлючи.Получить(Ключ) <> Неопределено Тогда
			Предупреждения.Добавить(Описание.Имя + ": повторяющаяся строка остатка в этой базе.");
			Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Ошибка", ПредставлениеИзмерений, "(ключ)", ПредставлениеИзмерений, "");
			Продолжить;
		КонецЕсли;
		ВиденныеКлючи.Вставить(Ключ, Истина);
		
		КоличествоБазы = КоличествоБазы + 1;
		ЗаписьФайла = ЗаписиФайла.Получить(Ключ);
		
		Если ЗаписьФайла = Неопределено Тогда
			СтрокаСтатистики.ТолькоВБазе = СтрокаСтатистики.ТолькоВБазе + 1;
			Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Только в этой базе", ПредставлениеИзмерений,
				"(вся строка)", Накоп_ПредставлениеВыборки(Выборка, Описание.Поля), "");
			Продолжить;
		КонецЕсли;
		
		Для Каждого Поле Из Описание.Поля Цикл
			КанонБазы = Накоп_КаноническоеЗначение(Выборка[Поле.Имя]);
			ПолеФайла = ЗаписьФайла.Поля.Получить(Поле.Имя);
			Если ПолеФайла = Неопределено Тогда
				КанонФайла = "<нет поля>";
				ПредставлениеФайла = "";
			Иначе
				КанонФайла = ПолеФайла.Канон;
				ПредставлениеФайла = ПолеФайла.Представление;
			КонецЕсли;
			
			Если Накоп_НормализоватьКанон(КанонБазы) <> Накоп_НормализоватьКанон(КанонФайла) Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Расхождение", ПредставлениеИзмерений,
					Поле.Имя, Накоп_ПредставлениеЗначения(Выборка[Поле.Имя]), ПредставлениеФайла);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлементПоля Из ЗаписьФайла.Поля Цикл
			Если ИменаПолейБазы.Получить(ЭлементПоля.Ключ) = Неопределено Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Расхождение", ПредставлениеИзмерений,
					ЭлементПоля.Ключ, "", ЭлементПоля.Значение.Представление);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписиФайла.Удалить(Ключ);
		
	КонецЦикла;
	
	СтрокаСтатистики.ЗаписейВБазе = КоличествоБазы;
	
	Для Каждого ЭлементЗаписи Из ЗаписиФайла Цикл
		ЗаписьФайла = ЭлементЗаписи.Значение;
		СтрокаСтатистики.ТолькоВФайле = СтрокаСтатистики.ТолькоВФайле + 1;
		Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Только в файле", ЗаписьФайла.Измерения,
			"(вся строка)", "", Накоп_ПредставлениеЗаписиФайла(ЗаписьФайла));
	КонецЦикла;
	
КонецПроцедуры

Функция Накоп_НоваяТаблицаОтличийОстатков()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Регистр", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ВидОтличия", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Измерения", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВБазе", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
	
КонецФункции

Процедура Накоп_ДобавитьОтличиеОстатка(Отличия, Счетчик, Регистр, ВидОтличия, Измерения, ИмяПоля, ЗначениеВБазе, ЗначениеВФайле)
	
	Счетчик.Всего = Счетчик.Всего + 1;
	Если Отличия.Количество() >= Накоп_МаксимальноеКоличествоСтрокРезультата() Тогда
		Счетчик.Обрезано = Истина;
		Возврат;
	КонецЕсли;
	
	СтрокаОтличия = Отличия.Добавить();
	СтрокаОтличия.Регистр = Регистр;
	СтрокаОтличия.ВидОтличия = ВидОтличия;
	СтрокаОтличия.Измерения = Измерения;
	СтрокаОтличия.ИмяПоля = ИмяПоля;
	СтрокаОтличия.ЗначениеВБазе = ЗначениеВБазе;
	СтрокаОтличия.ЗначениеВФайле = ЗначениеВФайле;
	
КонецПроцедуры

Функция Накоп_ТекстДатыОстатков(ДатаОстатков)
	
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		Возврат "не задана";
	КонецЕсли;
	
	Возврат Формат(ДатаОстатков, "ДЛФ=D") + ", конец дня";
	
КонецФункции

// --- Сравнение записей и остатков регистров бухгалтерии ---
// Внешняя обработка сравнения записей регистров бухгалтерии.
//
// В одной базе записи выбранных регистров за период выгружаются в XML-файл.
// В другой базе файл читается и сравнивается с записями этой базы за период на форме.
// Строка регистра сопоставляется по идентификатору регистратора и номеру строки.
// Ссылочные значения сравниваются по типу XML и UUID, без кода, номера и наименования.
// Сравнивается каждая колонка записи: период, активность, счета, субконто, измерения, ресурсы, реквизиты.
// У регистра с корреспонденцией счета, субконто, небалансовые измерения и ресурсы выгружаются парой Дт и Кт.
// Субконто читаются из виртуальной таблицы ДвиженияССубконто: в основной таблице регистра этих полей нет.
//
// Форма «ФормаОстатков» сравнивает остатки на конец выбранного дня.
// Строка остатка сопоставляется по счету, субконто и балансовым измерениям.
// Сравниваются остаток, остаток Дт и Кт и развернутый остаток каждого ресурса.
// Порядок колонок субконто — порядок видов субконто на счете. Список видов в запрос не передается.
//
// Имена регистров читаются из метаданных текущей конфигурации.
// Корень файла отличается от выгрузки регистров накопления, эти файлы между собой не сравниваются.
//
// Сборка EPF из каталога epf (платформа 8.3, режим совместимости конфигурации 8.2.13):
// 1cv8 DESIGNER /F "<база>" /DisableStartupDialogs /LoadExternalDataProcessorOrReportFromFiles "<каталог epf>" "<путь к epf>"
//
// Код рассчитан на режим совместимости 8.2.13: без методов платформы 8.3.6 и новее.


Функция Бух_ИменаРегистровПоУмолчанию() Экспорт
	
	Имена = Новый Массив;
	Для Каждого Мета Из Метаданные.РегистрыБухгалтерии Цикл
		Имена.Добавить(Мета.Имя);
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

Функция Бух_Выгрузить(ИменаРегистров, НачалоПериода, КонецПериода) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры бухгалтерии.";
	КонецЕсли;
	
	Бух_ИнициализироватьКэшТипов();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Статистика = Бух_НоваяСтатистика();
	Предупреждения = Новый Массив;
	КоличествоЗаписей = 0;
	
	Попытка
		КоличествоЗаписей = Бух_ЗаписатьФайлВыгрузки(ИмяФайла, ИменаРегистров, НачалоПериода, КонецПериода, Статистика, Предупреждения);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		Бух_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Бух_УдалитьВременныйФайл(ИмяФайла);
	
	Сообщение = "Выгружено записей: " + Бух_ФорматЧисла(КоличествоЗаписей) + "."
		+ Символы.ПС + "Период: " + Бух_ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Регистров в файле: " + Бух_ФорматЧисла(Статистика.Количество()) + ".";
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = "Выгрузка завершена с ошибками." + Символы.ПС + Сообщение
			+ Символы.ПС + Бух_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Бух_Сравнить(АдресФайла, НачалоПериода, КонецПериода, ИменаРегистров) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры бухгалтерии.";
	КонецЕсли;
	
	Бух_ИнициализироватьКэшТипов();
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл сравнения.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ИмяФайла);
	
	Попытка
		КэшФайла = Бух_ПрочитатьФайлВыгрузки(ИмяФайла, ИменаРегистров);
	Исключение
		Бух_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Бух_УдалитьВременныйФайл(ИмяФайла);
	
	Отличия = Бух_НоваяТаблицаОтличий();
	Статистика = Бух_НоваяСтатистика();
	Предупреждения = КэшФайла.Предупреждения;
	Обрезано = Ложь;
	ВсегоОтличий = 0;
	
	Если Бух_ДатаВАтрибут(НачалоПериода) <> Бух_ДатаВАтрибут(КэшФайла.ПериодНачало)
		Или Бух_ДатаВАтрибут(КонецПериода) <> Бух_ДатаВАтрибут(КэшФайла.ПериодКонец) Тогда
		Предупреждения.Добавить("Период на форме (" + Бух_ТекстПериодаСравнения(НачалоПериода, КонецПериода)
			+ ") отличается от периода файла (" + Бух_ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец)
			+ "). Записи этой базы отобраны за период на форме.");
	КонецЕсли;
	
	Если КэшФайла.Конфигурация <> "" И КэшФайла.Конфигурация <> Метаданные.Имя Тогда
		Предупреждения.Добавить("Файл выгружен из конфигурации """ + КэшФайла.Конфигурация
			+ """, текущая конфигурация """ + Метаданные.Имя + """.");
	КонецЕсли;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Бух_СравнитьРегистр(ИмяРегистра, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано);
	КонецЦикла;
	
	Отличия.Сортировать("Регистр, Регистратор, НомерСтроки, ИмяПоля");
	
	ВсегоВБазе = 0;
	ВсегоВФайле = 0;
	ТолькоВБазе = 0;
	ТолькоВФайле = 0;
	Расхождений = 0;
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		ВсегоВБазе = ВсегоВБазе + СтрокаСтатистики.ЗаписейВБазе;
		ВсегоВФайле = ВсегоВФайле + СтрокаСтатистики.ЗаписейВФайле;
		ТолькоВБазе = ТолькоВБазе + СтрокаСтатистики.ТолькоВБазе;
		ТолькоВФайле = ТолькоВФайле + СтрокаСтатистики.ТолькоВФайле;
		Расхождений = Расхождений + СтрокаСтатистики.Расхождений;
	КонецЦикла;
	
	Сообщение = "Период сравнения: " + Бух_ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Период файла: " + Бух_ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец) + "."
		+ Символы.ПС + "Записей в этой базе: " + Бух_ФорматЧисла(ВсегоВБазе) + ", в файле: " + Бух_ФорматЧисла(ВсегоВФайле) + "."
		+ Символы.ПС + "Только в этой базе: " + Бух_ФорматЧисла(ТолькоВБазе)
		+ ", только в файле: " + Бух_ФорматЧисла(ТолькоВФайле)
		+ ", расхождений по колонкам: " + Бух_ФорматЧисла(Расхождений) + ".";
	
	Если ВсегоОтличий = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Отличий не найдено.";
	КонецЕсли;
	
	Если Обрезано Тогда
		Сообщение = Сообщение + Символы.ПС + "В таблицу выведены первые " + Бух_ФорматЧисла(Бух_МаксимальноеКоличествоСтрокРезультата())
			+ " строк отличий из " + Бух_ФорматЧисла(ВсегоОтличий) + ".";
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + Бух_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отличия", Отличия);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Бух_ЗаписатьФайлВыгрузки(ИмяФайла, ИменаРегистров, НачалоПериода, КонецПериода, Статистика, Предупреждения)
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьКомментарий("Ключ записи: тип и UUID регистратора и номер строки. Ссылки сравниваются по типу XML и UUID.");
	Запись.ЗаписатьНачалоЭлемента("AccountingRegisterComparison");
	Запись.ЗаписатьАтрибут("formatVersion", "1");
	Запись.ЗаписатьАтрибут("configuration", Метаданные.Имя);
	Запись.ЗаписатьАтрибут("configurationVersion", Метаданные.Версия);
	Запись.ЗаписатьАтрибут("exportedAt", XMLСтрока(ТекущаяДата()));
	Запись.ЗаписатьАтрибут("periodFrom", Бух_ДатаВАтрибут(НачалоПериода));
	Запись.ЗаписатьАтрибут("periodTo", Бух_ДатаВАтрибут(КонецПериода));
	
	КоличествоЗаписей = 0;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		
		Попытка
			Описание = Бух_ОписаниеРегистра(ИмяРегистра);
			Выборка = Бух_ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода);
		Исключение
			ТекстОшибки = Бух_КраткийТекстОшибки(ОписаниеОшибки());
			Бух_ЗаписатьОшибку(Запись, ИмяРегистра, ТекстОшибки);
			Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			Бух_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
			Продолжить;
		КонецПопытки;
		
		КоличествоРегистра = Бух_ЗаписатьРегистр(Запись, Описание, Выборка);
		КоличествоЗаписей = КоличествоЗаписей + КоличествоРегистра;
		Бух_ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, КоличествоРегистра, 0, 0, 0, 0);
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	
	Возврат КоличествоЗаписей;
	
КонецФункции

Функция Бух_ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = Бух_ТекстЗапроса(Описание, НачалоПериода, КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция Бух_ЗаписатьРегистр(Запись, Описание, Выборка)
	
	Запись.ЗаписатьНачалоЭлемента("Register");
	Запись.ЗаписатьАтрибут("name", Описание.Имя);
	Запись.ЗаписатьАтрибут("synonym", Бух_ТекстXML(Описание.Синоним));
	
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Бух_ЗаписатьЗаписьРегистра(Запись, Выборка, Описание.Поля);
		Количество = Количество + 1;
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Возврат Количество;
	
КонецФункции

Процедура Бух_ЗаписатьЗаписьРегистра(Запись, Выборка, Поля)
	
	Ключ = Бух_КлючЗаписи(Выборка.Регистратор, Выборка.НомерСтроки);
	Запись.ЗаписатьНачалоЭлемента("Record");
	Запись.ЗаписатьАтрибут("key", Ключ);
	Запись.ЗаписатьАтрибут("line", Бух_ФорматЧисла(Выборка.НомерСтроки));
	Запись.ЗаписатьАтрибут("recorder", Бух_ПредставлениеЗначения(Выборка.Регистратор));
	
	Для Каждого Поле Из Поля Цикл
		Значение = Выборка[Поле.Имя];
		Запись.ЗаписатьНачалоЭлемента("Field");
		Запись.ЗаписатьАтрибут("name", Поле.Имя);
		Запись.ЗаписатьАтрибут("role", Поле.Роль);
		Запись.ЗаписатьАтрибут("canonical", Бух_КаноническоеЗначение(Значение));
		Запись.ЗаписатьАтрибут("presentation", Бух_ПредставлениеЗначения(Значение));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура Бух_ЗаписатьОшибку(Запись, ИмяРегистра, ТекстОшибки)
	
	Запись.ЗаписатьНачалоЭлемента("Error");
	Запись.ЗаписатьАтрибут("register", Бух_ТекстXML(ИмяРегистра));
	Запись.ЗаписатьАтрибут("text", Бух_ТекстXML(ТекстОшибки));
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция Бух_ПрочитатьФайлВыгрузки(ИмяФайла, ИменаРегистров)
	
	Выбранные = Новый Соответствие;
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Выбранные.Вставить(ИмяРегистра, Истина);
	КонецЦикла;
	
	Кэш = Новый Структура;
	Кэш.Вставить("ВерсияФормата", "");
	Кэш.Вставить("Конфигурация", "");
	Кэш.Вставить("ВерсияКонфигурации", "");
	Кэш.Вставить("ПериодНачало", '00010101');
	Кэш.Вставить("ПериодКонец", '00010101');
	Кэш.Вставить("Регистры", Новый Соответствие);
	Кэш.Вставить("Ошибки", Новый Соответствие);
	Кэш.Вставить("Виденные", Новый Соответствие);
	Кэш.Вставить("Предупреждения", Новый Массив);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ТекущиеЗаписи = Неопределено;
	ТекущаяЗапись = Неопределено;
	ЧитатьЗаписи = Ложь;
	КореньНайден = Ложь;
	
	Попытка
		
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Record" Тогда
			Бух_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = Чтение.Имя;
		
		Если ИмяУзла = "AccountingRegisterComparison" Тогда
			
			КореньНайден = Истина;
			Кэш.ВерсияФормата = Бух_Атрибут(Чтение, "formatVersion");
			Если Кэш.ВерсияФормата <> "1" Тогда
				ВызватьИсключение "Неподдерживаемая версия файла сравнения: " + Кэш.ВерсияФормата + ".";
			КонецЕсли;
			Кэш.Конфигурация = Бух_Атрибут(Чтение, "configuration");
			Кэш.ВерсияКонфигурации = Бух_Атрибут(Чтение, "configurationVersion");
			Кэш.ПериодНачало = Бух_ДатаИзАтрибута(Бух_Атрибут(Чтение, "periodFrom"));
			Кэш.ПериодКонец = Бух_ДатаИзАтрибута(Бух_Атрибут(Чтение, "periodTo"));
			
		ИначеЕсли ИмяУзла = "AccountingRegisterBalanceComparison" Тогда
			
			ВызватьИсключение "Этот файл содержит остатки регистров бухгалтерии, а не записи за период.";
			
		ИначеЕсли ИмяУзла = "AccumulationRegisterComparison" Или ИмяУзла = "AccumulationRegisterBalanceComparison" Тогда
			
			ВызватьИсключение "Этот файл выгружен обработкой сравнения регистров накопления.";
			
		ИначеЕсли ИмяУзла = "Register" Тогда
			
			Бух_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			ИмяРегистра = Бух_Атрибут(Чтение, "name");
			Кэш.Виденные.Вставить(ИмяРегистра, Истина);
			ЧитатьЗаписи = Выбранные.Получить(ИмяРегистра) <> Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущиеЗаписи = Новый Соответствие;
				Кэш.Регистры.Вставить(ИмяРегистра, ТекущиеЗаписи);
			Иначе
				ТекущиеЗаписи = Неопределено;
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Record" Тогда
			
			Бух_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущаяЗапись = Бух_НоваяЗаписьФайла(Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Field" Тогда
			
			Если ТекущаяЗапись <> Неопределено Тогда
				ИмяПоля = Бух_Атрибут(Чтение, "name");
				Поле = Новый Структура("Канон, Представление", Бух_НормализоватьКанон(Бух_Атрибут(Чтение, "canonical")), Бух_Атрибут(Чтение, "presentation"));
				ТекущаяЗапись.Поля.Вставить(ИмяПоля, Поле);
				ТекущаяЗапись.ПорядокПолей.Добавить(ИмяПоля);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Error" Тогда
			
			ИмяРегистра = Бух_Атрибут(Чтение, "register");
			ТекстОшибки = Бух_Атрибут(Чтение, "text");
			Кэш.Виденные.Вставить(ИмяРегистра, Истина);
			Кэш.Ошибки.Вставить(ИмяРегистра, ТекстОшибки);
			Кэш.Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Бух_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
	ТекущаяЗапись = Неопределено;
	Чтение.Закрыть();
	
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если Не КореньНайден Тогда
		ВызватьИсключение "Файл не является выгрузкой сравнения регистров бухгалтерии.";
	КонецЕсли;
	
	Возврат Кэш;
	
КонецФункции

Процедура Бух_ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись)
	
	Если ТекущаяЗапись = Неопределено Или ТекущиеЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеЗаписи.Вставить(ТекущаяЗапись.Ключ, ТекущаяЗапись);
	
КонецПроцедуры

Функция Бух_НоваяЗаписьФайла(Чтение)
	
	ЗаписьФайла = Новый Структура;
	ЗаписьФайла.Вставить("Ключ", Бух_НормализоватьКлючЗаписи(Бух_Атрибут(Чтение, "key")));
	ЗаписьФайла.Вставить("НомерСтроки", Бух_ЧислоАтрибута(Бух_Атрибут(Чтение, "line")));
	ЗаписьФайла.Вставить("Регистратор", Бух_Атрибут(Чтение, "recorder"));
	ЗаписьФайла.Вставить("Поля", Новый Соответствие);
	ЗаписьФайла.Вставить("ПорядокПолей", Новый Массив);
	Возврат ЗаписьФайла;
	
КонецФункции

Процедура Бух_СравнитьРегистр(ИмяРегистра, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано)
	
	ТекстОшибкиФайла = КэшФайла.Ошибки.Получить(ИмяРегистра);
	Если ТекстОшибкиФайла <> Неопределено Тогда
		Бух_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
		Бух_ДобавитьОтличие(Отличия, ИмяРегистра, "Ошибка", "", 0, "(выгрузка)", "", ТекстОшибкиФайла, ВсегоОтличий, Обрезано);
		Возврат;
	КонецЕсли;
	
	Если КэшФайла.Виденные.Получить(ИмяРегистра) = Неопределено Тогда
		Предупреждения.Добавить(ИмяРегистра + ": регистр отсутствует в файле выгрузки. Записи файла приняты пустыми.");
	КонецЕсли;
	
	ЗаписиФайла = КэшФайла.Регистры.Получить(ИмяРегистра);
	Если ЗаписиФайла = Неопределено Тогда
		ЗаписиФайла = Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Описание = Бух_ОписаниеРегистра(ИмяРегистра);
	Исключение
		ТекстОшибки = Бух_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
		Бух_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, ЗаписиФайла.Количество(), 0, 0, 0);
		Бух_ДобавитьОтличие(Отличия, ИмяРегистра, "Ошибка", "", 0, "(метаданные)", "", ТекстОшибки, ВсегоОтличий, Обрезано);
		Возврат;
	КонецПопытки;
	
	СтрокаСтатистики = Бух_ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, 0, ЗаписиФайла.Количество(), 0, 0, 0);
	ИменаПолейБазы = Новый Соответствие;
	Для Каждого Поле Из Описание.Поля Цикл
		ИменаПолейБазы.Вставить(Поле.Имя, Истина);
	КонецЦикла;
	
	Попытка
		Выборка = Бух_ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода);
	Исключение
		ТекстОшибки = Бух_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(Описание.Имя + ": " + ТекстОшибки);
		Бух_ДобавитьОтличие(Отличия, Описание.Имя, "Ошибка", "", 0, "(запрос)", "", ТекстОшибки, ВсегоОтличий, Обрезано);
		Возврат;
	КонецПопытки;
	
	КоличествоБазы = 0;
	Пока Выборка.Следующий() Цикл
		
		КоличествоБазы = КоличествоБазы + 1;
		Ключ = Бух_КлючЗаписи(Выборка.Регистратор, Выборка.НомерСтроки);
		ЗаписьФайла = ЗаписиФайла.Получить(Ключ);
		ПредставлениеРегистратора = Бух_ПредставлениеЗначения(Выборка.Регистратор);
		
		Если ЗаписьФайла = Неопределено Тогда
			СтрокаСтатистики.ТолькоВБазе = СтрокаСтатистики.ТолькоВБазе + 1;
			Бух_ДобавитьОтличие(Отличия, Описание.Имя, "Только в этой базе", ПредставлениеРегистратора, Выборка.НомерСтроки,
				"(вся запись)", Бух_ПредставлениеВыборки(Выборка, Описание.Поля), "", ВсегоОтличий, Обрезано);
			Продолжить;
		КонецЕсли;
		
		Для Каждого Поле Из Описание.Поля Цикл
			КанонБазы = Бух_КаноническоеЗначение(Выборка[Поле.Имя]);
			ПолеФайла = ЗаписьФайла.Поля.Получить(Поле.Имя);
			Если ПолеФайла = Неопределено Тогда
				КанонФайла = "<нет поля>";
				ПредставлениеФайла = "";
			Иначе
				КанонФайла = ПолеФайла.Канон;
				ПредставлениеФайла = ПолеФайла.Представление;
			КонецЕсли;
			
			Если Бух_НормализоватьКанон(КанонБазы) <> Бух_НормализоватьКанон(КанонФайла) Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				Бух_ДобавитьОтличие(Отличия, Описание.Имя, "Расхождение", ПредставлениеРегистратора, Выборка.НомерСтроки,
					Поле.Имя, Бух_ПредставлениеЗначения(Выборка[Поле.Имя]), ПредставлениеФайла, ВсегоОтличий, Обрезано);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлементПоля Из ЗаписьФайла.Поля Цикл
			Если ИменаПолейБазы.Получить(ЭлементПоля.Ключ) = Неопределено Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				Бух_ДобавитьОтличие(Отличия, Описание.Имя, "Расхождение", ПредставлениеРегистратора, Выборка.НомерСтроки,
					ЭлементПоля.Ключ, "", ЭлементПоля.Значение.Представление, ВсегоОтличий, Обрезано);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписиФайла.Удалить(Ключ);
		
	КонецЦикла;
	
	СтрокаСтатистики.ЗаписейВБазе = КоличествоБазы;
	
	Для Каждого ЭлементЗаписи Из ЗаписиФайла Цикл
		ЗаписьФайла = ЭлементЗаписи.Значение;
		СтрокаСтатистики.ТолькоВФайле = СтрокаСтатистики.ТолькоВФайле + 1;
		Бух_ДобавитьОтличие(Отличия, Описание.Имя, "Только в файле", ЗаписьФайла.Регистратор, ЗаписьФайла.НомерСтроки,
			"(вся запись)", "", Бух_ПредставлениеЗаписиФайла(ЗаписьФайла), ВсегоОтличий, Обрезано);
	КонецЦикла;
	
КонецПроцедуры

Функция Бух_ОписаниеРегистра(ИмяРегистра)
	
	Мета = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		ВызватьИсключение "Регистр бухгалтерии """ + ИмяРегистра + """ не найден в конфигурации.";
	КонецЕсли;
	
	Поля = Новый Массив;
	Бух_ДобавитьПоле(Поля, "Период", "Стандартное");
	Бух_ДобавитьПоле(Поля, "Регистратор", "Стандартное");
	Бух_ДобавитьПоле(Поля, "НомерСтроки", "Стандартное");
	Бух_ДобавитьПоле(Поля, "Активность", "Стандартное");
	Бух_ДобавитьПоляСчетов(Поля, Мета);
	Бух_ДобавитьПоляИзмеренийДвижения(Поля, Мета);
	Бух_ДобавитьПоляРесурсовДвижения(Поля, Мета);
	
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Бух_ДобавитьПоле(Поля, Реквизит.Имя, "Реквизит");
	КонецЦикла;
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Синоним", Бух_СинонимМетаданных(Мета));
	Описание.Вставить("Поля", Поля);
	Возврат Описание;
	
КонецФункции

Процедура Бух_ДобавитьПоляСчетов(Поля, Мета)
	
	КоличествоСубконто = Бух_МаксимальноеКоличествоСубконто(Мета);
	
	Если Мета.Корреспонденция Тогда
		Бух_ДобавитьПоле(Поля, "СчетДт", "Счет");
		Бух_ДобавитьПоле(Поля, "СчетКт", "Счет");
		Для Номер = 1 По КоличествоСубконто Цикл
			Бух_ДобавитьПоле(Поля, "СубконтоДт" + Бух_ФорматЧисла(Номер), "Субконто");
			Бух_ДобавитьПоле(Поля, "СубконтоКт" + Бух_ФорматЧисла(Номер), "Субконто");
		КонецЦикла;
	Иначе
		Бух_ДобавитьПоле(Поля, "Счет", "Счет");
		Для Номер = 1 По КоличествоСубконто Цикл
			Бух_ДобавитьПоле(Поля, "Субконто" + Бух_ФорматЧисла(Номер), "Субконто");
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Бух_ДобавитьПоляИзмеренийДвижения(Поля, Мета)
	
	Для Каждого Измерение Из Мета.Измерения Цикл
		Если Мета.Корреспонденция И Не Измерение.Балансовый Тогда
			Бух_ДобавитьПоле(Поля, Измерение.Имя + "Дт", "Измерение");
			Бух_ДобавитьПоле(Поля, Измерение.Имя + "Кт", "Измерение");
		Иначе
			Бух_ДобавитьПоле(Поля, Измерение.Имя, "Измерение");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Бух_ДобавитьПоляРесурсовДвижения(Поля, Мета)
	
	Для Каждого Ресурс Из Мета.Ресурсы Цикл
		Если Мета.Корреспонденция И Не Ресурс.Балансовый Тогда
			Бух_ДобавитьПоле(Поля, Ресурс.Имя + "Дт", "Ресурс");
			Бух_ДобавитьПоле(Поля, Ресурс.Имя + "Кт", "Ресурс");
		Иначе
			Бух_ДобавитьПоле(Поля, Ресурс.Имя, "Ресурс");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Бух_МаксимальноеКоличествоСубконто(Мета)
	
	ПланСчетов = Мета.ПланСчетов;
	Если ПланСчетов = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Количество = ПланСчетов.МаксКоличествоСубконто;
	Если Количество = Неопределено Или Количество < 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Количество;
	
КонецФункции

Функция Бух_СинонимМетаданных(Мета)
	
	Синоним = Строка(Мета.Синоним);
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	
	Возврат Синоним;
	
КонецФункции

Процедура Бух_ДобавитьПоле(Поля, Имя, Роль)
	
	Поле = Новый Структура("Имя, Роль", Имя, Роль);
	Поля.Добавить(Поле);
	
КонецПроцедуры

Функция Бух_ТекстЗапроса(Описание, НачалоПериода, КонецПериода)
	
	ЧастиПолей = Новый Массив;
	Для Каждого Поле Из Описание.Поля Цикл
		ЧастиПолей.Добавить("Регистр." + Поле.Имя + " КАК " + Поле.Имя);
	КонецЦикла;
	
	Текст = "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + Бух_СоединитьСтроки(ЧастиПолей, "," + Символы.ПС + Символы.Таб)
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + "РегистрБухгалтерии." + Описание.Имя + ".ДвиженияССубконто(, , , ) КАК Регистр";
	
	Условия = Новый Массив;
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Условия.Добавить("Регистр.Период >= &НачалоПериода");
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		Условия.Добавить("Регистр.Период <= &КонецПериода");
	КонецЕсли;
	
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб + Бух_СоединитьСтроки(Условия, Символы.ПС + Символы.Таб + "И ");
	КонецЕсли;
	
	Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО"
		+ Символы.ПС + Символы.Таб + "Регистр.Регистратор,"
		+ Символы.ПС + Символы.Таб + "Регистр.НомерСтроки";
	
	Возврат Текст;
	
КонецФункции

Функция Бух_КлючЗаписи(Регистратор, НомерСтроки)
	
	Возврат Бух_КаноническоеЗначение(Регистратор) + "|" + Бух_КаноническоеЗначение(НомерСтроки);
	
КонецФункции

Функция Бух_КаноническоеЗначение(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "undef";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Null") Тогда
		Возврат "null";
	КонецЕсли;
	
	Если Бух_ЭтоСсылочныйТип(ТипЗначения) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат ТипXML.ИмяТипа + ":" + XMLСтрока(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "string:" + Бух_ТекстXML(Значение);
	КонецЕсли;
	
	Попытка
		ТипXML = XMLТип(ТипЗначения);
		Если ТипXML = Неопределено Тогда
			Возврат Бух_ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		КонецЕсли;
		Возврат Бух_НормализоватьКанон(ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	Исключение
		Попытка
			Возврат Бух_ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		Исключение
			Возврат Бух_ТекстXML("string:" + Строка(Значение));
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

Функция Бух_ПредставлениеЗначения(Значение)
	
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + Бух_ТекстXML(Значение) + """";
	КонецЕсли;
	
	Если Бух_ЭтоСсылочныйТип(ТипЗнч(Значение)) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат Бух_ТекстXML(Строка(Значение) + " | " + ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	КонецЕсли;
	
	Возврат Бух_ТекстXML(Строка(Значение) + " | " + Бух_КаноническоеЗначение(Значение));
	
КонецФункции

Функция Бух_НормализоватьКанон(Канон)
	
	Префикс = "decimal:";
	Если Лев(Канон, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Канон;
	КонецЕсли;
	
	Текст = СокрЛП(Сред(Канон, СтрДлина(Префикс) + 1));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, Символ(8239), "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если Лев(Текст, 1) = "+" Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	ПозицияТочки = Найти(Текст, ".");
	Если ПозицияТочки > 0 Тогда
		Целая = Лев(Текст, ПозицияТочки - 1);
		Дробная = Сред(Текст, ПозицияТочки + 1);
		Пока Прав(Дробная, 1) = "0" Цикл
			Дробная = Лев(Дробная, СтрДлина(Дробная) - 1);
		КонецЦикла;
		Если Дробная = "" Тогда
			Текст = Целая;
		Иначе
			Текст = Целая + "." + Дробная;
		КонецЕсли;
	КонецЕсли;
	
	Если Текст = "" Или Текст = "-" Или Текст = "-0" Тогда
		Текст = "0";
	КонецЕсли;
	
	Возврат Префикс + Текст;
	
КонецФункции

Функция Бух_НормализоватьКлючЗаписи(Ключ)
	
	Части = Новый Массив;
	Остаток = Ключ;
	Позиция = Найти(Остаток, "|");
	Пока Позиция > 0 Цикл
		Части.Добавить(Бух_НормализоватьКанон(Лев(Остаток, Позиция - 1)));
		Остаток = Сред(Остаток, Позиция + 1);
		Позиция = Найти(Остаток, "|");
	КонецЦикла;
	Части.Добавить(Бух_НормализоватьКанон(Остаток));
	Возврат Бух_СоединитьСтроки(Части, "|");
	
КонецФункции

Функция Бух_НормализоватьКлючОстатка(Ключ)
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат Ключ;
	КонецЕсли;
	
	Части = Новый Массив;
	Остаток = Ключ;
	
	Пока ЗначениеЗаполнено(Остаток) Цикл
		Позиция = Найти(Остаток, ":");
		Если Позиция = 0 Тогда
			Возврат Ключ;
		КонецЕсли;
		
		ДлинаТекста = 0;
		Попытка
			ДлинаТекста = Число(Лев(Остаток, Позиция - 1));
		Исключение
			Возврат Ключ;
		КонецПопытки;
		
		Если ДлинаТекста < 0 Или Позиция + ДлинаТекста > СтрДлина(Остаток) Тогда
			Возврат Ключ;
		КонецЕсли;
		
		Канон = Бух_НормализоватьКанон(Сред(Остаток, Позиция + 1, ДлинаТекста));
		Части.Добавить(Бух_ФорматЧисла(СтрДлина(Канон)) + ":" + Канон);
		Остаток = Сред(Остаток, Позиция + 1 + ДлинаТекста);
		Если Лев(Остаток, 1) = ";" Тогда
			Остаток = Сред(Остаток, 2);
		ИначеЕсли Остаток <> "" Тогда
			Возврат Ключ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Бух_СоединитьСтроки(Части, ";");
	
КонецФункции

Функция Бух_ПредставлениеВыборки(Выборка, Поля)
	
	Части = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Части.Добавить(Поле.Имя + " = " + Бух_ПредставлениеЗначения(Выборка[Поле.Имя]));
	КонецЦикла;
	Возврат Бух_СоединитьСтроки(Части, "; ");
	
КонецФункции

Функция Бух_ПредставлениеЗаписиФайла(ЗаписьФайла)
	
	Части = Новый Массив;
	Для Каждого ИмяПоля Из ЗаписьФайла.ПорядокПолей Цикл
		Поле = ЗаписьФайла.Поля.Получить(ИмяПоля);
		Части.Добавить(ИмяПоля + " = " + Поле.Представление);
	КонецЦикла;
	Возврат Бух_СоединитьСтроки(Части, "; ");
	
КонецФункции

Процедура Бух_ИнициализироватьКэшТипов()
	
	Если Бух_ОписанияТиповСсылок <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Бух_ОписанияТиповСсылок = Новый Массив;
	Бух_ОписанияТиповСсылок.Добавить(Справочники.ТипВсеСсылки());
	Бух_ОписанияТиповСсылок.Добавить(Документы.ТипВсеСсылки());
	Бух_ОписанияТиповСсылок.Добавить(Перечисления.ТипВсеСсылки());
	Бух_ОписанияТиповСсылок.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки());
	Бух_ОписанияТиповСсылок.Добавить(ПланыСчетов.ТипВсеСсылки());
	Бух_ОписанияТиповСсылок.Добавить(ПланыВидовРасчета.ТипВсеСсылки());
	Бух_ОписанияТиповСсылок.Добавить(БизнесПроцессы.ТипВсеСсылки());
	Бух_ОписанияТиповСсылок.Добавить(Задачи.ТипВсеСсылки());
	Бух_КэшСсылочныхТипов = Новый Соответствие;
	
КонецПроцедуры

Функция Бух_ЭтоСсылочныйТип(ТипЗначения)
	
	Если Бух_ОписанияТиповСсылок = Неопределено Тогда
		Бух_ИнициализироватьКэшТипов();
	КонецЕсли;
	
	Признак = Бух_КэшСсылочныхТипов.Получить(ТипЗначения);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;
	
	Признак = Ложь;
	Для Каждого ОписаниеТипа Из Бух_ОписанияТиповСсылок Цикл
		Если ОписаниеТипа.СодержитТип(ТипЗначения) Тогда
			Признак = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Бух_КэшСсылочныхТипов.Вставить(ТипЗначения, Признак);
	Возврат Признак;
	
КонецФункции

