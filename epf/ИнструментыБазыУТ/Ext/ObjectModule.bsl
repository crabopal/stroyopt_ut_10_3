КонецФункции

Функция Ссыл_ЧислоАтрибута(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Число(Текст);
	
КонецФункции

Функция Ссыл_КраткийТекстОшибки(Текст)
	
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Возврат Лев(СокрЛП(Текст), 1000);
	
КонецФункции

Функция Ссыл_ТекстПредупреждений(Предупреждения)
	
	Показано = Новый Массив;
	Лимит = 20;
	Индекс = 0;
	Для Каждого Часть Из Предупреждения Цикл
		Если Индекс >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Показано.Добавить(Часть);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Текст = "Предупреждения:" + Символы.ПС + Ссыл_СоединитьСтроки(Показано, Символы.ПС);
	Если Предупреждения.Количество() > Лимит Тогда
		Текст = Текст + Символы.ПС + "И еще " + Ссыл_ФорматЧисла(Предупреждения.Количество() - Лимит) + ".";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция Ссыл_ТекстXML(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Если Не Ссыл_СимволДопустимВXML(КодСимвола(Текст, Номер)) Тогда
			Возврат Ссыл_ТекстXMLСЗаменой(Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция Ссыл_ТекстXMLСЗаменой(Текст)
	
	Результат = "";
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Код = КодСимвола(Текст, Номер);
		Если Ссыл_СимволДопустимВXML(Код) Тогда
			Результат = Результат + Символ(Код);
		Иначе
			Результат = Результат + "#x" + Ссыл_ФорматЧисла(Код) + "#";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Ссыл_РаскрытьПереводыСтрок(Текст)
	
	Текст = СтрЗаменить(Текст, "#x13#", Символ(13));
	Текст = СтрЗаменить(Текст, "#x10#", Символ(10));
	Текст = СтрЗаменить(Текст, "#x9#", Символ(9));
	Возврат Текст;
	
КонецФункции

Функция Ссыл_СимволДопустимВXML(Код)
	
	Если Код >= 32 И Код <= 55295 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 57344 И Код <= 65533 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция Ссыл_СоединитьСтроки(Части, Разделитель)
	
	Результат = "";
	Индекс = 0;
	Для Каждого Часть Из Части Цикл
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Часть;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Ссыл_РазделитьСтроку(Текст, Разделитель)
	
	Части = Новый Массив;
	Остаток = Строка(Текст);
	ДлинаРазделителя = СтрДлина(Разделитель);
	Позиция = Найти(Остаток, Разделитель);
	Пока Позиция > 0 Цикл
		Части.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + ДлинаРазделителя);
		Позиция = Найти(Остаток, Разделитель);
	КонецЦикла;
	Части.Добавить(Остаток);
	Возврат Части;
	
КонецФункции

Функция Ссыл_ФорматЧисла(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

Процедура Ссыл_УдалитьВременныйФайл(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

// --- Перенос регистрации изменений обмена УТ-БП ---
// Перенос регистрации изменений узла плана обмена
// ОбменУправлениеТорговлей103БухгалтерияПредприятия30 между двумя базами УТ 10.3.
//
// В одной базе в файл выгружается очередь изменений выбранного узла
// и номера отправленного и принятого сообщения этого узла.
// В другой базе регистрация этого узла сначала полностью очищается, затем записывается из файла.
// Номера сообщения записываются на узел приемника.
// Данные объектов не переносятся: ссылки сопоставляются по типу и UUID.
// После загрузки изменения зарегистрированы как еще не попавшие в сообщение обмена.
// Выгрузка не снимает регистрацию в базе-источнике.
//
// Код рассчитан на режим совместимости 8.2.13.


Функция Обмен_ИмяПланаОбмена() Экспорт
	
	Возврат "ОбменУправлениеТорговлей103БухгалтерияПредприятия30";
	
КонецФункции

Функция Обмен_ЭтоТекущийУзел(Узел)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Узел = ПланыОбмена[Обмен_ИмяПланаОбмена()].ЭтотУзел();
	
КонецФункции

Функция Обмен_ОписаниеВыбранногоУзла(Узел) Экспорт
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат "Узел не выбран.";
	КонецЕсли;
	
	Если Узел.ПолучитьОбъект() = Неопределено Тогда
		Возврат "Узел не найден в этой базе.";
	КонецЕсли;
	
	Текст = "Код: " + Узел.Код + ", наименование: " + Узел.Наименование + ". "
		+ Обмен_ТекстНомеровСообщений(Узел.НомерОтправленного, Узел.НомерПринятого);
	Если Обмен_ЭтоТекущийУзел(Узел) Тогда
		Текст = Текст + " Это текущий узел информационной базы. Для него изменения не регистрируются.";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция Обмен_Выгрузить(Узел) Экспорт
	
	Обмен_ПроверитьУзелИсточника(Узел);
	Обмен_ИнициализироватьКэшТипов();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Статистика = Обмен_НоваяСтатистика();
	Предупреждения = Новый Массив;
	Количество = 0;
	
	Попытка
		Количество = Обмен_ЗаписатьФайлРегистрации(ИмяФайла, Узел, Статистика, Предупреждения);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		Обмен_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Обмен_УдалитьВременныйФайл(ИмяФайла);
	
	Сообщение = "Узел: " + Узел.Код + " " + Узел.Наименование + "."
		+ Символы.ПС + "Выгружено регистраций: " + Обмен_ФорматЧисла(Количество) + "."
		+ Символы.ПС + Обмен_ТекстНомеровСообщений(Узел.НомерОтправленного, Узел.НомерПринятого)
		+ Символы.ПС + "Регистрация и номера сообщения в этой базе не изменялись.";
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + Обмен_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Обмен_ПроверитьФайл(АдресФайла, УзелФормы) Экспорт
	
	Обмен_ИнициализироватьКэшТипов();
	ИмяФайла = Обмен_ФайлИзХранилища(АдресФайла);
	
	Попытка
		Итог = Обмен_РазобратьФайл(ИмяФайла, УзелФормы, Истина);
	Исключение
		Обмен_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Обмен_УдалитьВременныйФайл(ИмяФайла);
	
	Если Итог.Успех Тогда
		Итог.Сообщение = "Узел: " + Итог.ПредставлениеУзла + "."
			+ Символы.ПС + "Сейчас зарегистрировано изменений: " + Обмен_ФорматЧисла(Итог.ЗарегистрированоСейчас) + "."
			+ Символы.ПС + "Будет зарегистрировано из файла: " + Обмен_ФорматЧисла(Итог.Количество) + ".";
		Если Итог.Пропущено > 0 Тогда
			Итог.Сообщение = Итог.Сообщение + Символы.ПС + "Пропущено, нет в конфигурации: " + Обмен_ФорматЧисла(Итог.Пропущено) + ".";
		КонецЕсли;
		Итог.Сообщение = Итог.Сообщение
			+ Символы.ПС + Обмен_ТекстПереносаНомеров(Итог)
			+ Символы.ПС + "Вся текущая регистрация изменений этого узла будет удалена, затем записаны изменения из файла."
			+ Символы.ПС + "Они будут отмечены как еще не выгруженные в сообщение обмена."
			+ Символы.ПС + "Продолжить?";
		Если Итог.Предупреждения.Количество() > 0 Тогда
			Итог.Сообщение = Итог.Сообщение + Символы.ПС + Обмен_ТекстПредупреждений(Итог.Предупреждения);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

Функция Обмен_Загрузить(АдресФайла, УзелФормы) Экспорт
	
	Обмен_ИнициализироватьКэшТипов();
	ИмяФайла = Обмен_ФайлИзХранилища(АдресФайла);
	
	Попытка
		Итог = Обмен_РазобратьФайл(ИмяФайла, УзелФормы, Ложь);
	Исключение
		Обмен_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Обмен_УдалитьВременныйФайл(ИмяФайла);
	
	Если Не Итог.Успех Тогда
		ВызватьИсключение Итог.Сообщение;
	КонецЕсли;
	
	Итог.Сообщение = "Узел: " + Итог.ПредставлениеУзла + "."
		+ Символы.ПС + "Прежняя регистрация удалена."
		+ Символы.ПС + "Зарегистрировано изменений: " + Обмен_ФорматЧисла(Итог.Количество) + "."
		+ Символы.ПС + "Изменения отмечены как еще не выгруженные в сообщение обмена.";
	Если Итог.ЕстьНомераСообщений Тогда
		Итог.Сообщение = Итог.Сообщение + Символы.ПС + Обмен_ТекстНомеровСообщений(Итог.НомерОтправленного, Итог.НомерПринятого);
	Иначе
		Итог.Сообщение = Итог.Сообщение + Символы.ПС + "Номера отправленного и принятого в файле не было, они не изменялись.";
	КонецЕсли;
	Если Итог.Пропущено > 0 Тогда
		Итог.Сообщение = Итог.Сообщение + Символы.ПС + "Пропущено: " + Обмен_ФорматЧисла(Итог.Пропущено) + ".";
	КонецЕсли;
	Если Итог.Предупреждения.Количество() > 0 Тогда
		Итог.Сообщение = Итог.Сообщение + Символы.ПС + Обмен_ТекстПредупреждений(Итог.Предупреждения);
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

Функция Обмен_ЗаписатьФайлРегистрации(ИмяФайла, Узел, Статистика, Предупреждения)
	
	План = Обмен_МетаданныеПлана();
	ТипУзла = XMLТипЗнч(Узел);
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьКомментарий("Регистрация изменений узла. Ссылки: тип XML и UUID. Данные объектов в файл не входят.");
	Запись.ЗаписатьНачалоЭлемента("ExchangeChangeRegistration");
	Запись.ЗаписатьАтрибут("formatVersion", "1");
	Запись.ЗаписатьАтрибут("exchangePlan", План.Имя);
	Запись.ЗаписатьАтрибут("nodeType", ТипУзла.ИмяТипа);
	Запись.ЗаписатьАтрибут("nodeNamespace", ТипУзла.URIПространстваИмен);
	Запись.ЗаписатьАтрибут("nodeUuid", XMLСтрока(Узел));
	Запись.ЗаписатьАтрибут("nodeCode", Обмен_ТекстXML(Узел.Код));
	Запись.ЗаписатьАтрибут("nodeDescription", Обмен_ТекстXML(Узел.Наименование));
	Запись.ЗаписатьАтрибут("sentNo", XMLСтрока(Узел.НомерОтправленного));
	Запись.ЗаписатьАтрибут("receivedNo", XMLСтрока(Узел.НомерПринятого));
	Запись.ЗаписатьАтрибут("exportedAt", XMLСтрока(ТекущаяДата()));
	
	Количество = 0;
	
	Для Каждого ЭлементСостава Из План.Состав Цикл
		
		Попытка
			Описание = Обмен_ОписаниеОбъектаСостава(ЭлементСостава.Метаданные);
			КоличествоОбъекта = Обмен_ЗаписатьИзмененияОбъекта(Запись, Узел, Описание, Статистика);
			Количество = Количество + КоличествоОбъекта;
		Исключение
			ТекстОшибки = Обмен_КраткийТекстОшибки(ОписаниеОшибки());
			Предупреждения.Добавить(ЭлементСостава.Метаданные.ПолноеИмя() + ": " + ТекстОшибки);
			Обмен_ДобавитьСтрокуСтатистики(Статистика, ЭлементСостава.Метаданные.ПолноеИмя(), Строка(ЭлементСостава.Метаданные.Синоним), "", 0, 0, 0, ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	Возврат Количество;
	
КонецФункции

Функция Обмен_ЗаписатьИзмененияОбъекта(Запись, Узел, Описание, Статистика)
	
	Запрос = Новый Запрос;
	Запрос.Текст = Обмен_ТекстЗапросаИзменений(Описание.ПолноеИмя, Описание.Поля);
	Запрос.УстановитьПараметр("Узел", Узел);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Количество = 0;
	НеВыгружалось = 0;
	УжеВыгружалось = 0;
	МетаданныеЗаписаны = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Если Описание.Вид = "Metadata" И МетаданныеЗаписаны Тогда
			Продолжить;
		КонецЕсли;
		
		Запись.ЗаписатьНачалоЭлемента("Change");
		Запись.ЗаписатьАтрибут("meta", Описание.ПолноеИмя);
		Запись.ЗаписатьАтрибут("kind", Описание.Вид);
		Если Выборка.УжеВыгружалось Тогда
			Запись.ЗаписатьАтрибут("sent", "true");
			УжеВыгружалось = УжеВыгружалось + 1;
		Иначе
			Запись.ЗаписатьАтрибут("sent", "false");
			НеВыгружалось = НеВыгружалось + 1;
		КонецЕсли;
		
		Если Описание.Вид = "Reference" Тогда
			Обмен_ЗаписатьЗначение(Запись, "Data", "", Выборка.Ссылка);
		ИначеЕсли Описание.Вид = "RecordSet" Тогда
			Для Каждого ИмяПоля Из Описание.Поля Цикл
				Обмен_ЗаписатьЗначение(Запись, "Field", ИмяПоля, Выборка[ИмяПоля]);
			КонецЦикла;
		КонецЕсли;
		
		Запись.ЗаписатьКонецЭлемента();
		Количество = Количество + 1;
		МетаданныеЗаписаны = Истина;
		
	КонецЦикла;
	
	Если Количество > 0 Тогда
		Обмен_ДобавитьСтрокуСтатистики(Статистика, Описание.ПолноеИмя, Описание.Представление, Обмен_ПредставлениеВида(Описание.Вид), Количество, НеВыгружалось, УжеВыгружалось, "");
	КонецЕсли;
	
	Возврат Количество;
	
КонецФункции

Функция Обмен_РазобратьФайл(ИмяФайла, УзелФормы, ТолькоПроверка)
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	Итог = Обмен_НовыйИтогРазбора();
	Узел = Неопределено;
	Пакет = Новый Структура("Ссылки, Мета, Пропустить", Новый Массив, "", Ложь);
	ТекущийВид = "";
	ТекущаяМета = "";
	ТекущиеПоля = Новый Массив;
	ТекущийУжеВыгружалось = Ложь;
	КореньНайден = Ложь;
	ТранзакцияОткрыта = Ложь;
	
	Попытка
		
		Пока Чтение.Прочитать() Цикл
			
			Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Change" Тогда
				Обмен_ЗавершитьИзменение(Узел, ТекущийВид, ТекущаяМета, ТекущиеПоля, ТекущийУжеВыгружалось, Пакет, Итог, ТолькоПроверка);
				ТекущийВид = "";
				Продолжить;
			КонецЕсли;
			
			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			
			Если Чтение.Имя = "ExchangeChangeRegistration" Тогда
				
				КореньНайден = Истина;
				Если Обмен_Атрибут(Чтение, "formatVersion") <> "1" Тогда
					ВызватьИсключение "Неподдерживаемая версия файла регистрации.";
				КонецЕсли;
				Если Обмен_Атрибут(Чтение, "exchangePlan") <> Обмен_ИмяПланаОбмена() Тогда
					ВызватьИсключение "Файл относится к другому плану обмена: " + Обмен_Атрибут(Чтение, "exchangePlan") + ".";
				КонецЕсли;
				Узел = Обмен_УзелИзШапки(Чтение);
				Обмен_ПроверитьУзелПриемника(Узел, УзелФормы);
				Итог.ПредставлениеУзла = Узел.Код + " " + Узел.Наименование;
				Итог.ЗарегистрированоСейчас = Обмен_КоличествоЗарегистрированных(Узел);
				Обмен_ПрочитатьНомераСообщений(Чтение, Узел, Итог);
				Если Не ТолькоПроверка Тогда
					НачатьТранзакцию();
					ТранзакцияОткрыта = Истина;
					ПланыОбмена.УдалитьРегистрациюИзменений(Узел);
				КонецЕсли;
				
			ИначеЕсли Чтение.Имя = "Change" Тогда
				
				Если Узел = Неопределено Тогда
					ВызватьИсключение "В файле нет описания узла.";
				КонецЕсли;
				ТекущийВид = Обмен_Атрибут(Чтение, "kind");
				ТекущаяМета = Обмен_Атрибут(Чтение, "meta");
				ТекущиеПоля = Новый Массив;
				ТекущийУжеВыгружалось = Обмен_Атрибут(Чтение, "sent") = "true";
				
			ИначеЕсли Чтение.Имя = "Field" Тогда
				
				Поле = Новый Структура("Имя, Значение", Обмен_Атрибут(Чтение, "name"), Обмен_ПрочитатьЗначение(Чтение));
				ТекущиеПоля.Добавить(Поле);
				
			ИначеЕсли Чтение.Имя = "Data" Тогда
				
				Обмен_ДобавитьСсылкуПакета(Обмен_ПрочитатьЗначение(Чтение), ТекущаяМета, ТекущийУжеВыгружалось, Пакет, Узел, Итог, ТолькоПроверка);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Обмен_СброситьПакетСсылок(Узел, Пакет, Итог, ТолькоПроверка);
		Чтение.Закрыть();
		
		Если Не КореньНайден Тогда
			ВызватьИсключение "Файл не является выгрузкой регистрации изменений.";
		КонецЕсли;
		
		Если ТранзакцияОткрыта Тогда
			Если Итог.ЕстьНомераСообщений Тогда
				Обмен_ЗаписатьНомераСообщенийУзла(Узел, Итог.НомерОтправленного, Итог.НомерПринятого);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
			ТранзакцияОткрыта = Ложь;
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		Если ТранзакцияОткрыта Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	Итог.Статистика = Обмен_СтатистикаИзСчетчиков(Итог.Счетчики);
	Итог.Вставить("Узел", Узел);
	Итог.Успех = Истина;
	Возврат Итог;
	
КонецФункции

Процедура Обмен_ДобавитьСсылкуПакета(Ссылка, ПолноеИмя, УжеВыгружалось, Пакет, Узел, Итог, ТолькоПроверка)
	
	Если Пакет.Мета <> ПолноеИмя Тогда
		Если Пакет.Мета <> "" Тогда
			Обмен_СброситьПакетСсылок(Узел, Пакет, Итог, ТолькоПроверка);
		КонецЕсли;
		Пакет.Пропустить = Ложь;
	КонецЕсли;
	
	Пакет.Мета = ПолноеИмя;
	Обмен_УчестьСтроку(Итог, ПолноеИмя, "Объект", УжеВыгружалось);
	
	Если Обмен_МетаданныеПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
		Итог.Пропущено = Итог.Пропущено + 1;
		Обмен_ЗапомнитьПропуск(Итог, ПолноеИмя);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Итог.Предупреждения.Добавить(ПолноеИмя + ": пропущена пустая ссылка.");
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПроверка Тогда
		Пакет.Ссылки.Добавить(Ссылка);
		Если Пакет.Ссылки.Количество() >= 500 Тогда
			Обмен_СброситьПакетСсылок(Узел, Пакет, Итог, Ложь);
		КонецЕсли;
	КонецЕсли;
	
	Итог.Количество = Итог.Количество + 1;
	
КонецПроцедуры

Процедура Обмен_ЗавершитьИзменение(Узел, ТекущийВид, ТекущаяМета, ТекущиеПоля, УжеВыгружалось, Пакет, Итог, ТолькоПроверка)
	
	Если ТекущийВид = "" Или ТекущийВид = "Reference" Тогда
		Возврат;
	КонецЕсли;
	
	Обмен_СброситьПакетСсылок(Узел, Пакет, Итог, ТолькоПроверка);
	Пакет.Мета = "";
	Пакет.Пропустить = Ложь;
	Обмен_УчестьСтроку(Итог, ТекущаяМета, Обмен_ПредставлениеВида(ТекущийВид), УжеВыгружалось);
	
	Мета = Обмен_МетаданныеПоПолномуИмени(ТекущаяМета);
	Если Мета = Неопределено Тогда
		Итог.Пропущено = Итог.Пропущено + 1;
		Обмен_ЗапомнитьПропуск(Итог, ТекущаяМета);
		Возврат;
	КонецЕсли;
	
	Если Не ТолькоПроверка Тогда
		Если ТекущийВид = "RecordSet" Тогда
			Обмен_ЗарегистрироватьНабор(Узел, Мета, ТекущиеПоля);
		Иначе
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Мета);
		КонецЕсли;
	КонецЕсли;
	
	Итог.Количество = Итог.Количество + 1;
	
КонецПроцедуры

Процедура Обмен_СброситьПакетСсылок(Узел, Пакет, Итог, ТолькоПроверка)
	
	Если ТолькоПроверка Или Пакет.Ссылки.Количество() = 0 Тогда
		Пакет.Ссылки.Очистить();
		Возврат;
	КонецЕсли;
	
	Если Пакет.Пропустить Тогда
		Обмен_ОтметитьНезарегистрированные(Итог, Пакет.Мета, Пакет.Ссылки.Количество());
		Пакет.Ссылки.Очистить();
		Возврат;
	КонецЕсли;
	
	// На 8.2.13 второй параметр ЗарегистрироватьИзменения не может быть массивом:
	// платформа сообщает «Недопустимое значение параметра (параметр номер '2')».
	Индекс = 0;
	Пропущено = 0;
	ОтказовПодряд = 0;
	Пока Индекс < Пакет.Ссылки.Количество() Цикл
		Ссылка = Пакет.Ссылки[Индекс];
		Попытка
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Ссылка);
			Если ОтказовПодряд = 1 Тогда
				Итог.Предупреждения.Добавить(Пакет.Мета + ": пропущена ссылка, узел ее не принял.");
			КонецЕсли;
			ОтказовПодряд = 0;
		Исключение
			ТекстОшибки = Обмен_КраткийТекстОшибки(ОписаниеОшибки());
			Если Не Обмен_ЭтоОтказРегистрации(ТекстОшибки) Тогда
				ВызватьИсключение Пакет.Мета + ": " + ТекстОшибки;
			КонецЕсли;
			Пропущено = Пропущено + 1;
			ОтказовПодряд = ОтказовПодряд + 1;
			Если ОтказовПодряд >= 2 Тогда
				Пакет.Пропустить = Истина;
				Пропущено = Пропущено + (Пакет.Ссылки.Количество() - Индекс - 1);
				Обмен_ЗапомнитьОтказРегистрации(Итог, Пакет.Мета);
				Прервать;
			КонецЕсли;
		КонецПопытки;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Если ОтказовПодряд = 1 Тогда
		Итог.Предупреждения.Добавить(Пакет.Мета + ": пропущена ссылка, узел ее не принял.");
	КонецЕсли;
	
	Если Пропущено > 0 Тогда
		Обмен_ОтметитьНезарегистрированные(Итог, Пакет.Мета, Пропущено);
	КонецЕсли;
	
	Пакет.Ссылки.Очистить();
	
КонецПроцедуры

Функция Обмен_ЭтоОтказРегистрации(ТекстОшибки)
	
	Возврат Найти(ТекстОшибки, "Недопустимое значение параметра") > 0;
	
КонецФункции

Процедура Обмен_ОтметитьНезарегистрированные(Итог, ПолноеИмя, Количество)
	
	Итог.Количество = Итог.Количество - Количество;
	Итог.Пропущено = Итог.Пропущено + Количество;
	Счетчик = Итог.Счетчики.Получить(ПолноеИмя);
	Если Счетчик <> Неопределено Тогда
		Счетчик.Пропущено = Счетчик.Пропущено + Количество;
	КонецЕсли;
	
КонецПроцедуры

Процедура Обмен_ЗапомнитьОтказРегистрации(Итог, ПолноеИмя)
	
	Счетчик = Итог.Счетчики.Получить(ПолноеИмя);
	Если Счетчик <> Неопределено И Счетчик.ОтказСообщен Тогда
		Возврат;
	КонецЕсли;
	Если Счетчик <> Неопределено Тогда
		Счетчик.ОтказСообщен = Истина;
	КонецЕсли;
	Итог.Предупреждения.Добавить(ПолноеИмя + ": регистрация пропущена, узел не принимает ссылки этого объекта.");
	
КонецПроцедуры

Процедура Обмен_ЗарегистрироватьНабор(Узел, Мета, Поля)
	
	Набор = Обмен_СоздатьНаборЗаписей(Мета);
	Для Каждого Поле Из Поля Цикл
		Набор.Отбор[Поле.Имя].Установить(Поле.Значение);
	КонецЦикла;
	ПланыОбмена.ЗарегистрироватьИзменения(Узел, Набор);
	
КонецПроцедуры

Функция Обмен_СоздатьНаборЗаписей(Мета)
	
	Если Метаданные.РегистрыСведений.Содержит(Мета) Тогда
		Возврат РегистрыСведений[Мета.Имя].СоздатьНаборЗаписей();
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(Мета) Тогда
		Возврат РегистрыНакопления[Мета.Имя].СоздатьНаборЗаписей();
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(Мета) Тогда
		Возврат РегистрыБухгалтерии[Мета.Имя].СоздатьНаборЗаписей();
	ИначеЕсли Метаданные.РегистрыРасчета.Содержит(Мета) Тогда
		Возврат РегистрыРасчета[Мета.Имя].СоздатьНаборЗаписей();
	ИначеЕсли Метаданные.Последовательности.Содержит(Мета) Тогда
		Возврат Последовательности[Мета.Имя].СоздатьНаборЗаписей();
	КонецЕсли;
	
	ВызватьИсключение "Нельзя создать набор записей для " + Мета.ПолноеИмя();
	
КонецФункции

Функция Обмен_УзелИзШапки(Чтение)
	
	ТипУзла = ИзXMLТипа(Обмен_Атрибут(Чтение, "nodeType"), Обмен_Атрибут(Чтение, "nodeNamespace"));
	Если ТипУзла = Неопределено Тогда
		ВызватьИсключение "В этой базе нет типа узла " + Обмен_Атрибут(Чтение, "nodeType") + ".";
	КонецЕсли;
	
	Узел = XMLЗначение(ТипУзла, Обмен_Атрибут(Чтение, "nodeUuid"));
	Если Узел.ПолучитьОбъект() = Неопределено Тогда
		ВызватьИсключение "Узел обмена не найден в этой базе. Код файла: " + Обмен_Атрибут(Чтение, "nodeCode")
			+ ", наименование: " + Обмен_Атрибут(Чтение, "nodeDescription")
			+ ", идентификатор: " + Обмен_Атрибут(Чтение, "nodeUuid") + ".";
	КонецЕсли;
	
	Возврат Узел;
	
КонецФункции

Процедура Обмен_ПрочитатьНомераСообщений(Чтение, Узел, Итог)
	
	НомерОтправленного = Обмен_НомерСообщенияИзФайла(Чтение, "sentNo");
	НомерПринятого = Обмен_НомерСообщенияИзФайла(Чтение, "receivedNo");
	Итог.НомерОтправленногоСейчас = Узел.НомерОтправленного;
	Итог.НомерПринятогоСейчас = Узел.НомерПринятого;
	
	Если НомерОтправленного = Неопределено И НомерПринятого = Неопределено Тогда
		Итог.ЕстьНомераСообщений = Ложь;
		Возврат;
	КонецЕсли;
	
	Если НомерОтправленного = Неопределено Или НомерПринятого = Неопределено Тогда
		ВызватьИсключение "В файле должны быть оба номера сообщения: отправленного и принятого.";
	КонецЕсли;
	
	Итог.ЕстьНомераСообщений = Истина;
	Итог.НомерОтправленного = НомерОтправленного;
	Итог.НомерПринятого = НомерПринятого;
	
КонецПроцедуры

Функция Обмен_НомерСообщенияИзФайла(Чтение, ИмяАтрибута)
	
	Текст = Обмен_Атрибут(Чтение, ИмяАтрибута);
	Если Текст = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Номер = XMLЗначение(Тип("Число"), Текст);
	Исключение
		ВызватьИсключение "В файле некорректное значение " + ИмяАтрибута + ".";
	КонецПопытки;
	
	Если Номер < 0 Или Номер <> Цел(Номер) Тогда
		ВызватьИсключение "В файле некорректный номер сообщения: " + Текст + ".";
	КонецЕсли;
	
	Возврат Номер;
	
КонецФункции

Процедура Обмен_ЗаписатьНомераСообщенийУзла(Узел, НомерОтправленного, НомерПринятого)
	
	УзелОбъект = Узел.ПолучитьОбъект();
	Если УзелОбъект = Неопределено Тогда
		ВызватьИсключение "Узел обмена не найден в этой базе.";
	КонецЕсли;
	
	УзелОбъект.НомерОтправленного = НомерОтправленного;
	УзелОбъект.НомерПринятого = НомерПринятого;
	УзелОбъект.ОбменДанными.Загрузка = Истина;
	УзелОбъект.Записать();
	
КонецПроцедуры

Функция Обмен_ТекстНомеровСообщений(НомерОтправленного, НомерПринятого)
	
	Возврат "Номер отправленного: " + Обмен_ФорматЧисла(НомерОтправленного)
		+ ", номер принятого: " + Обмен_ФорматЧисла(НомерПринятого) + ".";
	
КонецФункции

Функция Обмен_ТекстПереносаНомеров(Итог)
	
	Если Не Итог.ЕстьНомераСообщений Тогда
		Возврат "Номера отправленного и принятого в файле нет, в этой базе они не изменятся.";
	КонецЕсли;
	
	Возврат "Номер отправленного: сейчас " + Обмен_ФорматЧисла(Итог.НомерОтправленногоСейчас)
		+ ", будет " + Обмен_ФорматЧисла(Итог.НомерОтправленного) + "."
		+ Символы.ПС + "Номер принятого: сейчас " + Обмен_ФорматЧисла(Итог.НомерПринятогоСейчас)
		+ ", будет " + Обмен_ФорматЧисла(Итог.НомерПринятого) + ".";
	
КонецФункции

Процедура Обмен_ПроверитьУзелИсточника(Узел)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		ВызватьИсключение "Выберите узел плана обмена.";
	КонецЕсли;
	
	Если ТипЗнч(Узел) <> Тип("ПланОбменаСсылка." + Обмен_ИмяПланаОбмена()) Тогда
		ВызватьИсключение "Нужен узел плана обмена " + Обмен_ИмяПланаОбмена() + ".";
	КонецЕсли;
	
	Если Узел.ПолучитьОбъект() = Неопределено Тогда
		ВызватьИсключение "Выбранный узел не найден в этой базе.";
	КонецЕсли;
	
	Если Обмен_ЭтоТекущийУзел(Узел) Тогда
		ВызватьИсключение "Для текущего узла этой базы изменения не регистрируются. Выберите узел корреспондента.";
	КонецЕсли;
	
КонецПроцедуры

Процедура Обмен_ПроверитьУзелПриемника(Узел, УзелФормы)
	
	Если Обмен_ЭтоТекущийУзел(Узел) Тогда
		ВызватьИсключение "В файле указан текущий узел этой базы. Для него регистрация изменений невозможна.";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УзелФормы) И УзелФормы <> Узел Тогда
		ВызватьИсключение "Выбранный на форме узел не совпадает с узлом файла (" + Узел.Код + " " + Узел.Наименование + ").";
	КонецЕсли;
	
КонецПроцедуры

Функция Обмен_КоличествоЗарегистрированных(Узел)
	
	План = Обмен_МетаданныеПлана();
	Количество = 0;
	
	Для Каждого ЭлементСостава Из План.Состав Цикл
		ПолноеИмя = ЭлементСостава.Метаданные.ПолноеИмя();
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + ПолноеИмя + ".Изменения КАК Изменения ГДЕ Изменения.Узел = &Узел";
		Запрос.УстановитьПараметр("Узел", Узел);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Количество = Количество + Выборка.Количество;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

Функция Обмен_МетаданныеПлана()
	
	План = Метаданные.ПланыОбмена.Найти(Обмен_ИмяПланаОбмена());
	Если План = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет плана обмена " + Обмен_ИмяПланаОбмена() + ".";
	КонецЕсли;
	Возврат План;
	
КонецФункции

Функция Обмен_ОписаниеОбъектаСостава(Мета)
	
	Описание = Новый Структура;
	Описание.Вставить("ПолноеИмя", Мета.ПолноеИмя());
	Описание.Вставить("Представление", Строка(Мета.Синоним));
	Описание.Вставить("Поля", Новый Массив);
	Описание.Вставить("Вид", "");
	
	Если Не ЗначениеЗаполнено(Описание.Представление) Тогда
		Описание.Представление = Мета.Имя;
	КонецЕсли;
	
	Если Обмен_ЭтоСсылочныйОбъектМетаданных(Мета) Тогда
		Описание.Вид = "Reference";
		Описание.Поля.Добавить("Ссылка");
	ИначеЕсли Метаданные.Константы.Содержит(Мета) Тогда
		Описание.Вид = "Constant";
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(Мета) Тогда
		Обмен_ЗаполнитьПоляРегистраСведений(Мета, Описание);
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(Мета)
		Или Метаданные.РегистрыБухгалтерии.Содержит(Мета)
		Или Метаданные.РегистрыРасчета.Содержит(Мета)
		Или Метаданные.Последовательности.Содержит(Мета) Тогда
		Описание.Вид = "RecordSet";
		Описание.Поля.Добавить("Регистратор");
	Иначе
		ВызватьИсключение "Объект состава не поддерживается: " + Мета.ПолноеИмя();
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Процедура Обмен_ЗаполнитьПоляРегистраСведений(Мета, Описание)
	
	Если Мета.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		Описание.Вид = "RecordSet";
		Описание.Поля.Добавить("Регистратор");
		Возврат;
	КонецЕсли;
	
	Для Каждого Измерение Из Мета.Измерения Цикл
		Если Измерение.ОсновнойОтбор Тогда
			Описание.Поля.Добавить(Измерение.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если Мета.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический
		И Мета.ОсновнойОтборПоПериоду Тогда
		Описание.Поля.Добавить("Период");
	КонецЕсли;
	
	Если Описание.Поля.Количество() = 0 Тогда
		Описание.Вид = "Metadata";
	Иначе
		Описание.Вид = "RecordSet";
	КонецЕсли;
	
КонецПроцедуры

Функция Обмен_ЭтоСсылочныйОбъектМетаданных(Мета)
	
	Возврат Метаданные.Справочники.Содержит(Мета)
		Или Метаданные.Документы.Содержит(Мета)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(Мета)
		Или Метаданные.ПланыСчетов.Содержит(Мета)
		Или Метаданные.ПланыВидовРасчета.Содержит(Мета)
		Или Метаданные.ПланыОбмена.Содержит(Мета)
		Или Метаданные.БизнесПроцессы.Содержит(Мета)
		Или Метаданные.Задачи.Содержит(Мета);
	
КонецФункции

Функция Обмен_МетаданныеПоПолномуИмени(ПолноеИмя)
	
	Позиция = Найти(ПолноеИмя, ".");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Вид = Лев(ПолноеИмя, Позиция - 1);
	Имя = Сред(ПолноеИмя, Позиция + 1);
	Коллекция = Неопределено;
	
	Если Вид = "Справочник" Тогда
		Коллекция = Метаданные.Справочники;
	ИначеЕсли Вид = "Документ" Тогда
		Коллекция = Метаданные.Документы;
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Коллекция = Метаданные.ПланыВидовХарактеристик;
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Коллекция = Метаданные.ПланыСчетов;
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Коллекция = Метаданные.ПланыВидовРасчета;
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Коллекция = Метаданные.ПланыОбмена;
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Коллекция = Метаданные.БизнесПроцессы;
	ИначеЕсли Вид = "Задача" Тогда
		Коллекция = Метаданные.Задачи;
	ИначеЕсли Вид = "Константа" Тогда
		Коллекция = Метаданные.Константы;
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Коллекция = Метаданные.РегистрыСведений;
	ИначеЕсли Вид = "РегистрНакопления" Тогда
		Коллекция = Метаданные.РегистрыНакопления;
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Коллекция = Метаданные.РегистрыБухгалтерии;
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Коллекция = Метаданные.РегистрыРасчета;
	ИначеЕсли Вид = "Последовательность" Тогда
		Коллекция = Метаданные.Последовательности;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Коллекция.Найти(Имя);
	
КонецФункции

Функция Обмен_ТекстЗапросаИзменений(ПолноеИмя, ИменаПолей)
	
	ТекстПолей = "ВЫБОР КОГДА Изменения.НомерСообщения ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК УжеВыгружалось";
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ТекстПолей = ТекстПолей + "," + Символы.ПС + Символы.Таб + "Изменения." + ИмяПоля + " КАК " + ИмяПоля;
	КонецЦикла;
	
	Возврат "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + ТекстПолей
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + ПолноеИмя + ".Изменения КАК Изменения"
		+ Символы.ПС + "ГДЕ"
		+ Символы.ПС + Символы.Таб + "Изменения.Узел = &Узел";
	
КонецФункции

Процедура Обмен_ЗаписатьЗначение(Запись, ИмяЭлемента, ИмяПоля, Значение)
	
	Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	Если ЗначениеЗаполнено(ИмяПоля) Тогда
		Запись.ЗаписатьАтрибут("name", ИмяПоля);
	КонецЕсли;
	
	Если Значение = Неопределено Тогда
		Запись.ЗаписатьАтрибут("kind", "undef");
	ИначеЕсли ТипЗнч(Значение) = Тип("Null") Тогда
		Запись.ЗаписатьАтрибут("kind", "null");
	Иначе
		Если Обмен_ЭтоСсылочныйТип(ТипЗнч(Значение)) Тогда
			ТипXML = XMLТипЗнч(Значение);
		Иначе
			ТипXML = XMLТип(ТипЗнч(Значение));
		КонецЕсли;
		Запись.ЗаписатьАтрибут("kind", "value");
		Запись.ЗаписатьАтрибут("t", ТипXML.ИмяТипа);
		Запись.ЗаписатьАтрибут("ns", ТипXML.URIПространстваИмен);
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Запись.ЗаписатьАтрибут("v", Обмен_ТекстXML(Значение));
		Иначе
			Запись.ЗаписатьАтрибут("v", XMLСтрока(Значение));
		КонецЕсли;
	КонецЕсли;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция Обмен_ПрочитатьЗначение(Чтение)
	
	Вид = Обмен_Атрибут(Чтение, "kind");
	Если Вид = "null" Тогда
		Возврат NULL;
	КонецЕсли;
	Если Вид = "undef" Или Вид = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Вид = "internal" Тогда
		Возврат ЗначениеИзСтрокиВнутр(Обмен_Атрибут(Чтение, "v"));
	КонецЕсли;
	
	ТипЗначения = ИзXMLТипа(Обмен_Атрибут(Чтение, "t"), Обмен_Атрибут(Чтение, "ns"));
	Если ТипЗначения = Неопределено Тогда
		ВызватьИсключение "Неизвестный тип значения " + Обмен_Атрибут(Чтение, "t") + ".";
	КонецЕсли;
	
	Возврат XMLЗначение(ТипЗначения, Обмен_Атрибут(Чтение, "v"));
	
КонецФункции

Функция Обмен_НовыйИтогРазбора()
	
	Итог = Новый Структура;
	Итог.Вставить("Успех", Ложь);
	Итог.Вставить("Сообщение", "");
	Итог.Вставить("ПредставлениеУзла", "");
	Итог.Вставить("ЗарегистрированоСейчас", 0);
	Итог.Вставить("Количество", 0);
	Итог.Вставить("Пропущено", 0);
	Итог.Вставить("ЕстьНомераСообщений", Ложь);
	Итог.Вставить("НомерОтправленного", 0);
	Итог.Вставить("НомерПринятого", 0);
	Итог.Вставить("НомерОтправленногоСейчас", 0);
	Итог.Вставить("НомерПринятогоСейчас", 0);
	Итог.Вставить("Предупреждения", Новый Массив);
	Итог.Вставить("Счетчики", Новый Соответствие);
	Итог.Вставить("Статистика", Обмен_НоваяСтатистика());
	Возврат Итог;
	
КонецФункции

Процедура Обмен_УчестьСтроку(Итог, ПолноеИмя, Вид, УжеВыгружалось)
	
	Счетчик = Итог.Счетчики.Получить(ПолноеИмя);
	Если Счетчик = Неопределено Тогда
		Счетчик = Новый Структура("Вид, Количество, НеВыгружалось, УжеВыгружалось, Комментарий, Пропущено, ОтказСообщен", Вид, 0, 0, 0, "", 0, Ложь);
		Итог.Счетчики.Вставить(ПолноеИмя, Счетчик);
	КонецЕсли;
	Счетчик.Количество = Счетчик.Количество + 1;
	Если УжеВыгружалось Тогда
		Счетчик.УжеВыгружалось = Счетчик.УжеВыгружалось + 1;
	Иначе
		Счетчик.НеВыгружалось = Счетчик.НеВыгружалось + 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура Обмен_ЗапомнитьПропуск(Итог, ПолноеИмя)
	
	Счетчик = Итог.Счетчики.Получить(ПолноеИмя);
	Если Счетчик <> Неопределено И Не ЗначениеЗаполнено(Счетчик.Комментарий) Тогда
		Счетчик.Комментарий = "Нет в конфигурации этой базы, регистрация пропущена.";
		Итог.Предупреждения.Добавить(ПолноеИмя + ": нет в конфигурации этой базы, регистрация пропущена.");
	КонецЕсли;
	
КонецПроцедуры

Функция Обмен_СтатистикаИзСчетчиков(Счетчики)
	
	Таблица = Обмен_НоваяСтатистика();
	Для Каждого Элемент Из Счетчики Цикл
		Счетчик = Элемент.Значение;
		Представление = Элемент.Ключ;
		Мета = Обмен_МетаданныеПоПолномуИмени(Элемент.Ключ);
		Если Мета <> Неопределено И ЗначениеЗаполнено(Строка(Мета.Синоним)) Тогда
			Представление = Строка(Мета.Синоним);
		КонецЕсли;
		Комментарий = Счетчик.Комментарий;
		Если Счетчик.Пропущено > 0 Тогда
			ТекстПропуска = "Не зарегистрировано: " + Обмен_ФорматЧисла(Счетчик.Пропущено) + ".";
			Если ЗначениеЗаполнено(Комментарий) Тогда
				Комментарий = Комментарий + " " + ТекстПропуска;
			Иначе
				Комментарий = ТекстПропуска;
			КонецЕсли;
		КонецЕсли;
		Обмен_ДобавитьСтрокуСтатистики(Таблица, Элемент.Ключ, Представление, Счетчик.Вид, Счетчик.Количество, Счетчик.НеВыгружалось, Счетчик.УжеВыгружалось, Комментарий);
	КонецЦикла;
	Таблица.Сортировать("ПолноеИмя");
	Возврат Таблица;
	
КонецФункции

Функция Обмен_НоваяСтатистика()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("НеВыгружалось", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("УжеВыгружалось", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
	
КонецФункции

Процедура Обмен_ДобавитьСтрокуСтатистики(Таблица, ПолноеИмя, Представление, Вид, Количество, НеВыгружалось, УжеВыгружалось, Комментарий)
	
	СтрокаТаблицы = Таблица.Добавить();
	СтрокаТаблицы.ПолноеИмя = ПолноеИмя;
	СтрокаТаблицы.Представление = Представление;
	СтрокаТаблицы.Вид = Вид;
	СтрокаТаблицы.Количество = Количество;
	СтрокаТаблицы.НеВыгружалось = НеВыгружалось;
	СтрокаТаблицы.УжеВыгружалось = УжеВыгружалось;
	СтрокаТаблицы.Комментарий = Комментарий;
	
КонецПроцедуры

Функция Обмен_ПредставлениеВида(Вид)
	
	Если Вид = "Reference" Тогда
		Возврат "Объект";
	ИначеЕсли Вид = "RecordSet" Тогда
		Возврат "Набор записей";
	ИначеЕсли Вид = "Constant" Тогда
		Возврат "Константа";
	ИначеЕсли Вид = "Metadata" Тогда
		Возврат "Все записи";
	КонецЕсли;
	Возврат Вид;
	
КонецФункции

Процедура Обмен_ИнициализироватьКэшТипов()
	
	Если Обмен_ОписанияТиповСсылок <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Обмен_ОписанияТиповСсылок = Новый Массив;
	Обмен_ОписанияТиповСсылок.Добавить(Справочники.ТипВсеСсылки());
	Обмен_ОписанияТиповСсылок.Добавить(Документы.ТипВсеСсылки());
	Обмен_ОписанияТиповСсылок.Добавить(Перечисления.ТипВсеСсылки());
	Обмен_ОписанияТиповСсылок.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки());
	Обмен_ОписанияТиповСсылок.Добавить(ПланыСчетов.ТипВсеСсылки());
	Обмен_ОписанияТиповСсылок.Добавить(ПланыВидовРасчета.ТипВсеСсылки());
	Обмен_ОписанияТиповСсылок.Добавить(ПланыОбмена.ТипВсеСсылки());
	Обмен_ОписанияТиповСсылок.Добавить(БизнесПроцессы.ТипВсеСсылки());
	Обмен_ОписанияТиповСсылок.Добавить(Задачи.ТипВсеСсылки());
	Обмен_КэшСсылочныхТипов = Новый Соответствие;
	
КонецПроцедуры

Функция Обмен_ЭтоСсылочныйТип(ТипЗначения)
	
	Если Обмен_ОписанияТиповСсылок = Неопределено Тогда
		Обмен_ИнициализироватьКэшТипов();
	КонецЕсли;
	
	Признак = Обмен_КэшСсылочныхТипов.Получить(ТипЗначения);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;
	
	Признак = Ложь;
	Для Каждого ОписаниеТипа Из Обмен_ОписанияТиповСсылок Цикл
		Если ОписаниеТипа.СодержитТип(ТипЗначения) Тогда
			Признак = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Обмен_КэшСсылочныхТипов.Вставить(ТипЗначения, Признак);
	Возврат Признак;
	
КонецФункции

Функция Обмен_ФайлИзХранилища(АдресФайла)
	
	Данные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл регистрации.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Данные.Записать(ИмяФайла);
	Возврат ИмяФайла;
	
КонецФункции

Функция Обмен_Атрибут(Чтение, ИмяАтрибута)
	
	Значение = Чтение.ПолучитьАтрибут(ИмяАтрибута);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

Функция Обмен_КраткийТекстОшибки(Текст)
	
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Возврат Лев(СокрЛП(Текст), 1000);
	
КонецФункции

Функция Обмен_ТекстПредупреждений(Предупреждения)
	
	Показано = Новый Массив;
	Лимит = 15;
	Индекс = 0;
	Для Каждого Часть Из Предупреждения Цикл
		Если Индекс >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Показано.Добавить(Часть);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Текст = "Предупреждения:" + Символы.ПС + Обмен_СоединитьСтроки(Показано, Символы.ПС);
	Если Предупреждения.Количество() > Лимит Тогда
		Текст = Текст + Символы.ПС + "И еще " + Обмен_ФорматЧисла(Предупреждения.Количество() - Лимит) + ".";
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

Функция Обмен_СоединитьСтроки(Части, Разделитель)
	
	Результат = "";
	Индекс = 0;
	Для Каждого Часть Из Части Цикл
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Часть;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция Обмен_ТекстXML(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Если Не Обмен_СимволДопустимВXML(КодСимвола(Текст, Номер)) Тогда
			Возврат Обмен_ТекстXMLСЗаменой(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
	
КонецФункции

Функция Обмен_ТекстXMLСЗаменой(Текст)
	
	Результат = "";
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Код = КодСимвола(Текст, Номер);
		Если Обмен_СимволДопустимВXML(Код) Тогда
			Результат = Результат + Символ(Код);
		Иначе
			Результат = Результат + "#x" + Обмен_ФорматЧисла(Код) + "#";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция Обмен_СимволДопустимВXML(Код)
	
	Если Код = 9 Или Код = 10 Или Код = 13 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Код >= 32 И Код <= 55295 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Код >= 57344 И Код <= 65533 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция Обмен_ФорматЧисла(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

Процедура Обмен_УдалитьВременныйФайл(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

// --- Удаление помеченных заказов покупателей ---
// Удаление помеченных на удаление документов ЗаказПокупателя и объектов,
// которые ссылаются на них, с контролем ссылочной целостности.
// Не использует модули БСП: поиск ссылок выполняет платформенный метод НайтиПоСсылкам.
// Удаление идет без монопольного режима: объекты цепочки блокируются и удаляются по одному.
//
// Цепочка удаляется только целиком: все найденные ссылки должны указывать
// на объекты этой же цепочки (или на движения документов цепочки).
// Непроведенный документ без движений помечается на удаление и входит в цепочку.
// Документ с датой позже границы не удаляется и не помечается.
// Запись регистров параметров доставки с полем Дата позже границы тоже блокирует удаление.
//
// Код рассчитан на режим совместимости 8.2.13.


Функция Удал_ИмяДокументаЗаказа() Экспорт
	
	Возврат "ЗаказПокупателя";
	
КонецФункции

Функция Удал_ОграничениеТипаЗначенияОтбора(ИмяПоля, ВидСравнения) Экспорт
	
	Ключ = НРег(СокрЛП(ВидСравнения));
	Если Ключ = "в списке" Или Ключ = "не в списке" Или Ключ = "содержит" Тогда
		Возврат Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	Удал_ИнициализироватьКэшТипов();
	Найденное = Удал_НайтиПолеОтбора(Удал_ОписаниеДокументаЗаказа(), ИмяПоля);
	ОписаниеТипов = Найденное.Поле.ОписаниеТипов;
	Если ОписаниеТипов = Неопределено Тогда
		Возврат Новый ОписаниеТипов("Строка");
	КонецЕсли;
	
	Для Каждого ТипЗначения Из ОписаниеТипов.Типы() Цикл
		Если Удал_ЭтоСсылочныйТип(ТипЗначения) Тогда
			Возврат Новый ОписаниеТипов("Строка");
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОписаниеТипов;
	
КонецФункции

Функция Удал_ОписаниеПоляОтбора(ИмяПоля) Экспорт
	
	Удал_ИнициализироватьКэшТипов();
	Найденное = Удал_НайтиПолеОтбора(Удал_ОписаниеДокументаЗаказа(), ИмяПоля);
	ИменаТипов = Новый Массив;
	ЭтоСсылка = Ложь;
	
	Если Найденное.Поле.ОписаниеТипов <> Неопределено Тогда
		Для Каждого ТипЗначения Из Найденное.Поле.ОписаниеТипов.Типы() Цикл
			Если Не Удал_ЭтоСсылочныйТип(ТипЗначения) Тогда
				Продолжить;
			КонецЕсли;
			ИмяТипа = Удал_ИмяТипаСсылкиПоТипу(ТипЗначения);
			Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
				Продолжить;
			КонецЕсли;
			ЭтоСсылка = Истина;
			ИменаТипов.Добавить(ИмяТипа);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Новый Структура("ЭтоСсылка, ИменаТипов", ЭтоСсылка, ИменаТипов);
	
КонецФункции

Функция Удал_КанонСсылки(Ссылка) Экспорт
	
	ТипXML = XMLТипЗнч(Ссылка);
	Возврат ТипXML.ИмяТипа + ":" + XMLСтрока(Ссылка);
	
КонецФункции

Функция Удал_ИмяТипаСсылкиПоТипу(ТипЗначения)
	
	ИмяТаблицы = Удал_ИмяТаблицыПоТипу(ТипЗначения);
	Позиция = Найти(ИмяТаблицы, ".");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Лев(ИмяТаблицы, Позиция - 1) + "Ссылка." + Сред(ИмяТаблицы, Позиция + 1);
	
КонецФункции

Функция Удал_ИменаПолейОтбора() Экспорт
	
	Описание = Удал_ОписаниеДокументаЗаказа();
	Имена = Новый Массив;
	
	Для Каждого Поле Из Описание.Поля Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
		Для Каждого Поле Из ТабличнаяЧасть.Поля Цикл
			Имена.Добавить(ТабличнаяЧасть.Имя + "." + Поле.Имя);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

Функция Удал_ВыполнитьОбработку(Отборы, ГраницаДаты, ПомечатьНепроведенные, УдалятьПриПервойВозможности, ТолькоПроверка) Экспорт
	
	Если Метаданные.Документы.Найти(Удал_ИмяДокументаЗаказа()) = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет документа " + Удал_ИмяДокументаЗаказа() + ".";
	КонецЕсли;
	
	Если Отборы = Неопределено Тогда
		Отборы = Новый Массив;
	КонецЕсли;
	
	Удал_ИнициализироватьКэшТипов();
	Граница = '00010101';
	Если ЗначениеЗаполнено(ГраницаДаты) Тогда
		Граница = КонецДня(ГраницаДаты);
	КонецЕсли;
	
	Контекст = Удал_НовыйКонтекст(Граница, ПомечатьНепроведенные, УдалятьПриПервойВозможности, ТолькоПроверка);
	Заказы = Удал_НайтиЗаказы(Отборы, Граница);
	Удал_ПостроитьЦепочки(Контекст, Заказы);
	Удал_ПроверитьДатыДоставки(Контекст);
	
	Если Не ТолькоПроверка Тогда
		Удал_ПометитьНепроведенные(Контекст);
		Если УдалятьПриПервойВозможности Тогда
			Удал_УдалитьДоступныеЦепочки(Контекст);
		КонецЕсли;
	КонецЕсли;
	
	Таблица = Удал_СобратьРезультат(Контекст);
	Сводка = Удал_СобратьСводку(Контекст);
	Сообщение = Удал_ТекстИтога(Контекст, Заказы.Количество(), Таблица);
	
	Результат = Новый Структура;
	Результат.Вставить("Таблица", Таблица);
	Результат.Вставить("Сводка", Сводка);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Удал_НовыйКонтекст(Граница, ПомечатьНепроведенные, УдалятьПриПервойВозможности, ТолькоПроверка)
	
	Контекст = Новый Структура;
	Контекст.Вставить("Граница", Граница);
	Контекст.Вставить("ПомечатьНепроведенные", ПомечатьНепроведенные);
	Контекст.Вставить("УдалятьПриПервойВозможности", УдалятьПриПервойВозможности);
	Контекст.Вставить("ТолькоПроверка", ТолькоПроверка);
	Контекст.Вставить("Узлы", Новый Соответствие);
	Контекст.Вставить("Родители", Новый Соответствие);
	Контекст.Вставить("Блокировки", Новый Соответствие);
	Контекст.Вставить("Искали", Новый Соответствие);
	Контекст.Вставить("ЗаписиВедущие", Новый Массив);
	Контекст.Вставить("КлючиЗаписей", Новый Соответствие);
	Контекст.Вставить("Корректировки", Новый Соответствие);
	Контекст.Вставить("Помечено", 0);
	Контекст.Вставить("Удалено", 0);
	Контекст.Вставить("УдаленоЗаписей", 0);
	Контекст.Вставить("ИсправленоКорректировок", 0);
	Контекст.Вставить("ОшибокУдаления", 0);
	Возврат Контекст;
	
КонецФункции

Функция Удал_НайтиЗаказы(Отборы, Граница)
	
	Описание = Удал_ОписаниеДокументаЗаказа();
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Условия.Добавить("Объект.ПометкаУдаления");
	Счетчик = Новый Структура("Номер", 0);
	
	Для Каждого Отбор Из Отборы Цикл
		Если Не ЗначениеЗаполнено(Отбор.Поле) Тогда
			Продолжить;
		КонецЕсли;
		Условия.Добавить(Удал_ТекстУсловияОтбора(Описание, Отбор, Запрос, Счетчик));
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Граница) Тогда
		Условия.Добавить("Объект.Дата <= &ГраницаДаты");
		Запрос.УстановитьПараметр("ГраницаДаты", Граница);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + "Объект.Ссылка КАК Ссылка"
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + "Документ." + Удал_ИмяДокументаЗаказа() + " КАК Объект"
		+ Символы.ПС + "ГДЕ"
		+ Символы.ПС + Символы.Таб + Удал_СоединитьСтроки(Условия, Символы.ПС + Символы.Таб + "И ");
	
	Заказы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Заказы.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Заказы;
	
КонецФункции

Процедура Удал_ПостроитьЦепочки(Контекст, Заказы)
	
	Очередь = Новый Массив;
	Для Каждого Заказ Из Заказы Цикл
		Узел = Удал_ОбеспечитьУзел(Контекст, Заказ);
		Узел.Включен = Истина;
		Узел.ЭтоЗаказ = Истина;
		Очередь.Добавить(Заказ);
	КонецЦикла;
	
	Индекс = 0;
	Пока Индекс < Очередь.Количество() Цикл
		
		Если Контекст.Узлы.Количество() > Удал_МаксимумОбъектовЦепочки() Тогда
			Удал_ДобавитьБлокировку(Контекст, Очередь[Индекс], "Цепочка больше " + Удал_ФорматЧисла(Удал_МаксимумОбъектовЦепочки()) + " объектов, поиск остановлен.");
			Прервать;
		КонецЕсли;
		
		Порция = Новый Массив;
		Пока Индекс < Очередь.Количество() И Порция.Количество() < 50 Цикл
			Ссылка = Очередь[Индекс];
			Индекс = Индекс + 1;
			Если Контекст.Искали.Получить(Ссылка) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Контекст.Искали.Вставить(Ссылка, Истина);
			Порция.Добавить(Ссылка);
		КонецЦикла;
		
		Если Порция.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеСсылки = НайтиПоСсылкам(Порция);
		Для Каждого СтрокаНайденных Из НайденныеСсылки Цикл
			Удал_ОбработатьНайденнуюСсылку(Контекст, СтрокаНайденных, Очередь);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Удал_ОбработатьНайденнуюСсылку(Контекст, СтрокаНайденных, Очередь)
	
	Цель = СтрокаНайденных.Ссылка;
	Если Контекст.Узлы.Получить(Цель) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВедущееИзмерение = Удал_ВедущееИзмерениеРегистраСведений(СтрокаНайденных, Цель);
	Если ВедущееИзмерение <> Неопределено Тогда
		РегистраторЗаписи = Удал_РегистраторНайденныхДанных(СтрокаНайденных);
		Если Удал_ЭтоКорректировкаЗаписейРегистров(РегистраторЗаписи) Тогда
			Удал_ДобавитьКорректировку(Контекст, РегистраторЗаписи, Цель);
		Иначе
			Удал_ДобавитьЗаписьВедущего(Контекст, СтрокаНайденных, Цель, ВедущееИзмерение);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Источник = Удал_ИсточникСсылки(СтрокаНайденных);
	Если Удал_ЭтоКорректировкаЗаписейРегистров(Источник) Тогда
		Удал_ДобавитьКорректировку(Контекст, Источник, Цель);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Источник) Или Источник = Цель Тогда
		Если Не ЗначениеЗаполнено(Источник) И Не Удал_ЭтоДвижениеОбъектаЦепочки(СтрокаНайденных, Цель) Тогда
			Удал_ДобавитьБлокировку(Контекст, Цель, "Внешняя ссылка: " + Удал_ПредставлениеМеста(СтрокаНайденных));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Узел = Контекст.Узлы.Получить(Источник);
	Если Узел = Неопределено Тогда
		Узел = Удал_ОбеспечитьУзел(Контекст, Источник);
	КонецЕсли;
	
	Если Узел.Включен Тогда
		Удал_Объединить(Контекст, Цель, Источник);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Узел.Причина) Тогда
		Удал_ДобавитьБлокировку(Контекст, Цель, Узел.Причина);
		Возврат;
	КонецЕсли;
	
	Причина = Удал_ПричинаОтказа(Контекст, Узел);
	Если Причина = "" Тогда
		Узел.Включен = Истина;
		Удал_Объединить(Контекст, Цель, Источник);
		Очередь.Добавить(Источник);
	Иначе
		Узел.Причина = Причина;
		Удал_ДобавитьБлокировку(Контекст, Цель, Причина);
	КонецЕсли;
	
КонецПроцедуры

Функция Удал_ИсточникСсылки(СтрокаНайденных)
	
	Данные = СтрокаНайденных.Данные;
	Если Удал_ЭтоСсылочныйТип(ТипЗнч(Данные)) Тогда
		Возврат Данные;
	КонецЕсли;
	
	Попытка
		Регистратор = Данные.Регистратор;
		Если Удал_ЭтоСсылочныйТип(ТипЗнч(Регистратор)) И ЗначениеЗаполнено(Регистратор) Тогда
			Возврат Регистратор;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция Удал_РегистраторНайденныхДанных(СтрокаНайденных)
	
	Попытка
		Регистратор = СтрокаНайденных.Данные.Регистратор;
		Если Удал_ЭтоСсылочныйТип(ТипЗнч(Регистратор)) И ЗначениеЗаполнено(Регистратор) Тогда
			Возврат Регистратор;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция Удал_ЭтоДвижениеОбъектаЦепочки(СтрокаНайденных, Цель)
	
	Источник = Неопределено;
	Попытка
		Источник = СтрокаНайденных.Данные.Регистратор;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Источник = Цель;
	
КонецФункции

Функция Удал_ВедущееИзмерениеРегистраСведений(СтрокаНайденных, Цель)
	
	МетаПоля = СтрокаНайденных.Метаданные;
	Если МетаПоля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Регистр = Неопределено;
	ИзмерениеМета = Неопределено;
	Если Метаданные.РегистрыСведений.Содержит(МетаПоля) Тогда
		Регистр = МетаПоля;
	Иначе
		Родитель = Удал_РодительМетаданных(МетаПоля);
		Если Родитель <> Неопределено И Метаданные.РегистрыСведений.Содержит(Родитель) Тогда
			Регистр = Родитель;
			ИзмерениеМета = МетаПоля;
		КонецЕсли;
	КонецЕсли;
	
	Если Регистр = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИзмерениеМета <> Неопределено Тогда
		Если Удал_ИзмерениеВедущее(ИзмерениеМета) Тогда
			Возврат Новый Структура("Регистр, Имя", Регистр, ИзмерениеМета.Имя);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
	УдалосьПрочитатьКлюч = Ложь;
	Для Каждого Измерение Из Регистр.Измерения Цикл
		Если Не Измерение.Тип.СодержитТип(ТипЗнч(Цель)) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЗначениеИзмерения = СтрокаНайденных.Данные[Измерение.Имя];
			УдалосьПрочитатьКлюч = Истина;
		Исключение
			Продолжить;
		КонецПопытки;
		КлючЗначения = Удал_XMLСтрокаБезопасно(ЗначениеИзмерения);
		КлючЦели = Удал_XMLСтрокаБезопасно(Цель);
		Если Удал_ИзмерениеВедущее(Измерение) И (ЗначениеИзмерения = Цель Или (КлючЗначения <> "" И КлючЗначения = КлючЦели)) Тогда
			Возврат Новый Структура("Регистр, Имя", Регистр, Измерение.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если УдалосьПрочитатьКлюч Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// НайтиПоСсылкам часто возвращает сам регистр, а ключ записи не отдает поля.
	// Если ссылка может лежать только в ведущем измерении, запись удаляется по нему.
	ПодходящееИмя = "";
	Для Каждого Измерение Из Регистр.Измерения Цикл
		Если Не Удал_ИзмерениеВедущее(Измерение) Или Не Измерение.Тип.СодержитТип(ТипЗнч(Цель)) Тогда
			Продолжить;
		КонецЕсли;
		Если ПодходящееИмя <> "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		ПодходящееИмя = Измерение.Имя;
	КонецЦикла;
	
	Если ПодходящееИмя = "" Или Удал_ЕстьНеведущееПолеТипа(Регистр, ТипЗнч(Цель)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("Регистр, Имя", Регистр, ПодходящееИмя);
	
КонецФункции

Функция Удал_РодительМетаданных(МетаПоля)
	
	Попытка
		Возврат МетаПоля.Родитель();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция Удал_ИзмерениеВедущее(Измерение)
	
	Попытка
		Возврат Измерение.Ведущее = Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция Удал_XMLСтрокаБезопасно(Значение)
	
	Попытка
		Возврат XMLСтрока(Значение);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция Удал_ЕстьНеведущееПолеТипа(Регистр, ТипЗначения)
	
	Для Каждого Измерение Из Регистр.Измерения Цикл
		Если Не Удал_ИзмерениеВедущее(Измерение) И Измерение.Тип.СодержитТип(ТипЗначения) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Ресурс Из Регистр.Ресурсы Цикл
		Если Ресурс.Тип.СодержитТип(ТипЗначения) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из Регистр.Реквизиты Цикл
		Если Реквизит.Тип.СодержитТип(ТипЗначения) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура Удал_ДобавитьЗаписьВедущего(Контекст, СтрокаНайденных, Цель, ВедущееИзмерение)
	
	Регистр = ВедущееИзмерение.Регистр;
	Ключ = Регистр.Имя + "|" + ВедущееИзмерение.Имя + "|" + XMLСтрока(Цель);
	Если Контекст.КлючиЗаписей.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Контекст.КлючиЗаписей.Вставить(Ключ, Истина);
	ЗаписьВедущая = Новый Структура;
	ЗаписьВедущая.Вставить("ИмяРегистра", Регистр.Имя);
	ЗаписьВедущая.Вставить("ИмяИзмерения", ВедущееИзмерение.Имя);
	ЗаписьВедущая.Вставить("Представление", "Регистр сведений " + Строка(Регистр) + ", измерение " + ВедущееИзмерение.Имя);
	ЗаписьВедущая.Вставить("Данные", СтрокаНайденных.Данные);
	ЗаписьВедущая.Вставить("Цель", Цель);
	ЗаписьВедущая.Вставить("Удалена", Ложь);
	Контекст.ЗаписиВедущие.Добавить(ЗаписьВедущая);
	
КонецПроцедуры

Функция Удал_ЭтоКорректировкаЗаписейРегистров(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Ссылка.Метаданные().Имя = "КорректировкаЗаписейРегистров";
	
КонецФункции

Процедура Удал_ДобавитьКорректировку(Контекст, Ссылка, Цель)
	
	Описание = Контекст.Корректировки.Получить(Ссылка);
	Если Описание = Неопределено Тогда
		Описание = Новый Структура("Ссылка, Цели, ОбработанныеКорни", Ссылка, Новый Массив, Новый Соответствие);
		Контекст.Корректировки.Вставить(Ссылка, Описание);
	КонецЕсли;
	
	Для Каждого ЦельИзСписка Из Описание.Цели Цикл
		Если ЦельИзСписка = Цель Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Описание.Цели.Добавить(Цель);
	
КонецПроцедуры

Процедура Удал_УдалитьВедущиеЗаписиКомпонента(Контекст, КореньКомпонента)
	
	Для Каждого ЗаписьВедущая Из Контекст.ЗаписиВедущие Цикл
		Если ЗаписьВедущая.Удалена Тогда
			Продолжить;
		КонецЕсли;
		Если Удал_Корень(Контекст, ЗаписьВедущая.Цель) <> КореньКомпонента Тогда
			Продолжить;
		КонецЕсли;
		Удал_УдалитьЗаписьВедущего(ЗаписьВедущая);
		ЗаписьВедущая.Удалена = Истина;
		Контекст.УдаленоЗаписей = Контекст.УдаленоЗаписей + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура Удал_УдалитьЗаписьВедущего(ЗаписьВедущая)
	
	Мета = Метаданные.РегистрыСведений[ЗаписьВедущая.ИмяРегистра];
	Если Мета.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		Удал_УдалитьПодчиненнуюЗаписьВедущего(Мета, ЗаписьВедущая.Данные);
		Возврат;
	КонецЕсли;
	
	Набор = РегистрыСведений[Мета.Имя].СоздатьНаборЗаписей();
	Набор.Отбор[ЗаписьВедущая.ИмяИзмерения].Установить(ЗаписьВедущая.Цель);
	Набор.Записать();
	
КонецПроцедуры

Процедура Удал_УдалитьПодчиненнуюЗаписьВедущего(Мета, Данные)
	
	Менеджер = РегистрыСведений[Мета.Имя].СоздатьМенеджерЗаписи();
	Для Каждого Измерение Из Мета.Измерения Цикл
		Менеджер[Измерение.Имя] = Данные[Измерение.Имя];
	КонецЦикла;
	
	Если Мета.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Менеджер.Период = Данные.Период;
	КонецЕсли;
	Менеджер.Регистратор = Данные.Регистратор;
	Менеджер.Удалить();
	
КонецПроцедуры

Процедура Удал_ИсправитьКорректировкиКомпонента(Контекст, УзлыКомпонента, КореньКомпонента)
	
	Множество = Новый Соответствие;
	Для Каждого Узел Из УзлыКомпонента Цикл
		Множество.Вставить(Узел.Ссылка, Истина);
	КонецЦикла;
	
	Для Каждого Элемент Из Контекст.Корректировки Цикл
		Описание = Элемент.Значение;
		Если Описание.ОбработанныеКорни.Получить(КореньКомпонента) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не Удал_КорректировкаОтноситсяККомпоненту(Контекст, Описание, КореньКомпонента) Тогда
			Продолжить;
		КонецЕсли;
		Удал_ИсправитьКорректировку(Описание.Ссылка, Множество);
		Описание.ОбработанныеКорни.Вставить(КореньКомпонента, Истина);
		Контекст.ИсправленоКорректировок = Контекст.ИсправленоКорректировок + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция Удал_КорректировкаОтноситсяККомпоненту(Контекст, Описание, КореньКомпонента)
	
	Для Каждого Цель Из Описание.Цели Цикл
		Если Удал_Корень(Контекст, Цель) = КореньКомпонента Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Процедура Удал_ИсправитьКорректировку(Ссылка, МножествоУдаляемых)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Изменена = Удал_УдалитьСтрокиЗаполненияДвижений(Объект, МножествоУдаляемых);
	
	ИменаРегистров = Удал_ИменаРегистровКорректировки(Объект);
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Набор = Удал_ПрочитатьНаборРегистратора(ИмяРегистра, Ссылка);
		Если Набор = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УдаленоСтрок = Удал_УдалитьСтрокиНабора(Набор, ИмяРегистра, МножествоУдаляемых);
		Если УдаленоСтрок > 0 Тогда
			Набор.Записать();
			Изменена = Истина;
		КонецЕсли;
		Если Набор.Количество() = 0 И Удал_УдалитьРегистрИзТаблиц(Объект, ИмяРегистра) Тогда
			Изменена = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Изменена Тогда
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
КонецПроцедуры

Функция Удал_УдалитьСтрокиЗаполненияДвижений(Объект, МножествоУдаляемых)
	
	ТабличнаяЧасть = Неопределено;
	Попытка
		ТабличнаяЧасть = Объект.ЗаполнениеДвижений;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Изменена = Ложь;
	Индекс = ТабличнаяЧасть.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ДокументДвижения = Неопределено;
		Попытка
			ДокументДвижения = ТабличнаяЧасть[Индекс].Документ;
		Исключение
		КонецПопытки;
		Если МножествоУдаляемых.Получить(ДокументДвижения) <> Неопределено Тогда
			ТабличнаяЧасть.Удалить(Индекс);
			Изменена = Истина;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Изменена;
	
КонецФункции

Функция Удал_ИменаРегистровКорректировки(Объект)
	
	Имена = Новый Соответствие;
	Удал_ДобавитьИменаРегистровТаблицы(Объект, "ТаблицаРегистровНакопления", Имена);
	Удал_ДобавитьИменаРегистровТаблицы(Объект, "ТаблицаРегистровСведений", Имена);
	Удал_ДобавитьИменаРегистровТаблицы(Объект, "ТаблицаРегистровБухгалтерии", Имена);
	Удал_ДобавитьИменаРегистровТаблицы(Объект, "ТаблицаРегистровРасчета", Имена);
	
	Попытка
		Для Каждого Движение Из Объект.Метаданные().Движения Цикл
			Имена.Вставить(Движение.Имя, Истина);
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Список = Новый Массив;
	Для Каждого Элемент Из Имена Цикл
		Список.Добавить(Элемент.Ключ);
	КонецЦикла;
	Возврат Список;
	
КонецФункции

Процедура Удал_ДобавитьИменаРегистровТаблицы(Объект, ИмяТаблицы, Имена)
	
	ТабличнаяЧасть = Неопределено;
	Попытка
		ТабличнаяЧасть = Объект[ИмяТаблицы];
	Исключение
		Возврат;
	КонецПопытки;
	
	Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
		ИмяРегистра = "";
		Попытка
			ИмяРегистра = СокрЛП(СтрокаТаблицы.Имя);
		Исключение
		КонецПопытки;
		Если ЗначениеЗаполнено(ИмяРегистра) Тогда
			Имена.Вставить(ИмяРегистра, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Удал_ПрочитатьНаборРегистратора(ИмяРегистра, Регистратор)
	
	Набор = Неопределено;
	Если Метаданные.РегистрыНакопления.Найти(ИмяРегистра) <> Неопределено Тогда
		Набор = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
	ИначеЕсли Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено Тогда
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра) <> Неопределено Тогда
		Набор = РегистрыБухгалтерии[ИмяРегистра].СоздатьНаборЗаписей();
	ИначеЕсли Метаданные.РегистрыРасчета.Найти(ИмяРегистра) <> Неопределено Тогда
		Набор = РегистрыРасчета[ИмяРегистра].СоздатьНаборЗаписей();
	КонецЕсли;
	
	Если Набор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Набор.Отбор.Регистратор.Установить(Регистратор);
		Набор.Прочитать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Набор;
	
КонецФункции

Функция Удал_УдалитьСтрокиНабора(Набор, ИмяРегистра, МножествоУдаляемых)
	
	Мета = Удал_МетаданныеРегистра(ИмяРегистра);
	Если Мета = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	ИменаПолей = Удал_ИменаПолейЗаписиРегистра(Мета);
	Удалено = 0;
	Индекс = Набор.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Удал_ЗаписьСсылаетсяНаМножество(Набор[Индекс], ИменаПолей, МножествоУдаляемых) Тогда
			Набор.Удалить(Индекс);
			Удалено = Удалено + 1;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Удалено;
	
КонецФункции

Функция Удал_МетаданныеРегистра(ИмяРегистра)
	
	Мета = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если Мета <> Неопределено Тогда
		Возврат Мета;
	КонецЕсли;
	Мета = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если Мета <> Неопределено Тогда
		Возврат Мета;
	КонецЕсли;
	Мета = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
	Если Мета <> Неопределено Тогда
		Возврат Мета;
	КонецЕсли;
	Возврат Метаданные.РегистрыРасчета.Найти(ИмяРегистра);
	
КонецФункции

Функция Удал_ИменаПолейЗаписиРегистра(Мета)
	
	Имена = Новый Массив;
	Для Каждого Поле Из Мета.Измерения Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Для Каждого Поле Из Мета.Ресурсы Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Для Каждого Поле Из Мета.Реквизиты Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

Функция Удал_ЗаписьСсылаетсяНаМножество(Запись, ИменаПолей, МножествоУдаляемых)
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Значение = Неопределено;
		Попытка
			Значение = Запись[ИмяПоля];
		Исключение
			Продолжить;
		КонецПопытки;
		Если МножествоУдаляемых.Получить(Значение) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Функция Удал_УдалитьРегистрИзТаблиц(Объект, ИмяРегистра)
	
	Изменена = Ложь;
	Изменена = Удал_УдалитьРегистрИзТаблицы(Объект, "ТаблицаРегистровНакопления", ИмяРегистра) Или Изменена;
	Изменена = Удал_УдалитьРегистрИзТаблицы(Объект, "ТаблицаРегистровСведений", ИмяРегистра) Или Изменена;
	Изменена = Удал_УдалитьРегистрИзТаблицы(Объект, "ТаблицаРегистровБухгалтерии", ИмяРегистра) Или Изменена;
	Изменена = Удал_УдалитьРегистрИзТаблицы(Объект, "ТаблицаРегистровРасчета", ИмяРегистра) Или Изменена;
	Возврат Изменена;
	
КонецФункции

Функция Удал_УдалитьРегистрИзТаблицы(Объект, ИмяТаблицы, ИмяРегистра)
	
	ТабличнаяЧасть = Неопределено;
	Попытка
		ТабличнаяЧасть = Объект[ИмяТаблицы];
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Изменена = Ложь;
	Индекс = ТабличнаяЧасть.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ИмяВСтроке = "";
		Попытка
			ИмяВСтроке = СокрЛП(ТабличнаяЧасть[Индекс].Имя);
		Исключение
		КонецПопытки;
		Если ИмяВСтроке = ИмяРегистра Тогда
			ТабличнаяЧасть.Удалить(Индекс);
			Изменена = Истина;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Изменена;
	
КонецФункции

Процедура Удал_ПроверитьДатыДоставки(Контекст)
	
	Если Не ЗначениеЗаполнено(Контекст.Граница) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыЦепочки = Новый Массив;
	МножествоДокументов = Новый Соответствие;
	Для Каждого Элемент Из Контекст.Узлы Цикл
		Узел = Элемент.Значение;
		Если Не Узел.Включен Или Не Узел.ЭтоДокумент Тогда
			Продолжить;
		КонецЕсли;
		ДокументыЦепочки.Добавить(Узел.Ссылка);
		МножествоДокументов.Вставить(Узел.Ссылка, Истина);
	КонецЦикла;
	
	Если ДокументыЦепочки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРегистров = Новый Массив;
	ИменаРегистров.Добавить("ПараметрыДоставкиПоДокументу");
	ИменаРегистров.Добавить("ПараметрыДоставкиТоваровПоДокументу");
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Удал_ПроверитьРегистрДатыДоставки(Контекст, ИмяРегистра, ДокументыЦепочки, МножествоДокументов);
	КонецЦикла;
	
КонецПроцедуры

Процедура Удал_ПроверитьРегистрДатыДоставки(Контекст, ИмяРегистра, ДокументыЦепочки, МножествоДокументов)
	
	Мета = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		Удал_ЗаблокироватьДокументыДоставки(Контекст, ДокументыЦепочки, "В конфигурации нет регистра сведений " + ИмяРегистра + ".");
		Возврат;
	КонецЕсли;
	
	Если Мета.Измерения.Найти("Документ") = Неопределено Тогда
		Удал_ЗаблокироватьДокументыДоставки(Контекст, ДокументыЦепочки, "У регистра сведений " + ИмяРегистра + " нет измерения Документ.");
		Возврат;
	КонецЕсли;
	
	Если Мета.Ресурсы.Найти("Дата") = Неопределено И Мета.Реквизиты.Найти("Дата") = Неопределено Тогда
		Удал_ЗаблокироватьДокументыДоставки(Контекст, ДокументыЦепочки, "У регистра сведений " + ИмяРегистра + " нет поля Дата.");
		Возврат;
	КонецЕсли;
	
	ПодчиненРегистратору = Мета.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;
	ПредставлениеРегистра = Мета.Синоним;
	Если Не ЗначениеЗаполнено(ПредставлениеРегистра) Тогда
		ПредставлениеРегистра = Мета.Имя;
	КонецЕсли;
	
	Индекс = 0;
	Пока Индекс < ДокументыЦепочки.Количество() Цикл
		Порция = Новый Массив;
		Пока Индекс < ДокументыЦепочки.Количество() И Порция.Количество() < 50 Цикл
			Порция.Добавить(ДокументыЦепочки[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		
		Попытка
			Удал_ДобавитьБлокировкиДатыДоставки(Контекст, ИмяРегистра, ПредставлениеРегистра, Порция, МножествоДокументов, ПодчиненРегистратору);
		Исключение
			Удал_ЗаблокироватьДокументыДоставки(Контекст, Порция, "Не удалось проверить даты регистра " + ПредставлениеРегистра + ": " + Удал_КраткийТекстОшибки(ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура Удал_ДобавитьБлокировкиДатыДоставки(Контекст, ИмяРегистра, ПредставлениеРегистра, Порция, МножествоДокументов, ПодчиненРегистратору)
	
	Поля = "Записи.Документ КАК Документ";
	Группировка = "Записи.Документ";
	УсловиеСвязи = "Записи.Документ В (&Документы)";
	Если ПодчиненРегистратору Тогда
		Поля = Поля + "," + Символы.ПС + Символы.Таб + "Записи.Регистратор КАК Регистратор";
		Группировка = Группировка + "," + Символы.ПС + Символы.Таб + "Записи.Регистратор";
		УсловиеСвязи = "(Записи.Документ В (&Документы) ИЛИ Записи.Регистратор В (&Документы))";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + Поля + ","
		+ Символы.ПС + Символы.Таб + "МАКСИМУМ(Записи.Дата) КАК Дата"
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + "РегистрСведений." + ИмяРегистра + " КАК Записи"
		+ Символы.ПС + "ГДЕ"
		+ Символы.ПС + Символы.Таб + УсловиеСвязи
		+ Символы.ПС + Символы.Таб + "И Записи.Дата > &Граница"
		+ Символы.ПС + "СГРУППИРОВАТЬ ПО"
		+ Символы.ПС + Символы.Таб + Группировка;
	Запрос.УстановитьПараметр("Документы", Порция);
	Запрос.УстановитьПараметр("Граница", Контекст.Граница);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СсылкаБлокировки = Удал_СсылкаБлокировкиДоставки(Выборка, МножествоДокументов, ПодчиненРегистратору);
		Если Не ЗначениеЗаполнено(СсылкаБлокировки) Тогда
			Продолжить;
		КонецЕсли;
		Текст = "Дата доставки " + Формат(Выборка.Дата, "ДЛФ=D")
			+ " позже границы, регистр " + ПредставлениеРегистра
			+ ", документ " + Строка(СсылкаБлокировки);
		Удал_ДобавитьБлокировку(Контекст, СсылкаБлокировки, Текст);
	КонецЦикла;
	
КонецПроцедуры

Функция Удал_СсылкаБлокировкиДоставки(Выборка, МножествоДокументов, ПодчиненРегистратору)
	
	Если МножествоДокументов.Получить(Выборка.Документ) <> Неопределено Тогда
		Возврат Выборка.Документ;
	КонецЕсли;
	
	Если ПодчиненРегистратору И МножествоДокументов.Получить(Выборка.Регистратор) <> Неопределено Тогда
		Возврат Выборка.Регистратор;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура Удал_ЗаблокироватьДокументыДоставки(Контекст, ДокументыЦепочки, Текст)
	
	Для Каждого Ссылка Из ДокументыЦепочки Цикл
		Удал_ДобавитьБлокировку(Контекст, Ссылка, Текст);
	КонецЦикла;
	
КонецПроцедуры

Функция Удал_ПричинаОтказа(Контекст, Узел)
	
	Если Узел.НовееГраницы Тогда
		Возврат "Документ позже границы даты: " + Узел.Представление;
	КонецЕсли;
	
	Если Узел.Помечен Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не Узел.ЭтоДокумент Тогда
		Возврат "Объект не помечен на удаление: " + Узел.Представление;
	КонецЕсли;
	
	Если Узел.Проведен Тогда
		Возврат "Проведенный документ не помечен на удаление: " + Узел.Представление;
	КонецЕсли;
	
	Если Узел.ЕстьДвижения = Неопределено Тогда
		Узел.ЕстьДвижения = Удал_ДокументИмеетДвижения(Узел.Ссылка);
	КонецЕсли;
	
	Если Узел.ЕстьДвижения Тогда
		Возврат "Непроведенный документ имеет движения и не помечен: " + Узел.Представление;
	КонецЕсли;
	
	Если Контекст.ПомечатьНепроведенные Тогда
		Узел.МожноПометитьАвто = Истина;
		Возврат "";
	КонецЕсли;
	
	Возврат "Непроведенный документ без движений не помечен, флаг пометки выключен: " + Узел.Представление;
	
КонецФункции

Функция Удал_ОбеспечитьУзел(Контекст, Ссылка)
	
	Узел = Контекст.Узлы.Получить(Ссылка);
	Если Узел <> Неопределено Тогда
		Возврат Узел;
	КонецЕсли;
	
	Узел = Новый Структура;
	Узел.Вставить("Ссылка", Ссылка);
	Узел.Вставить("Представление", Строка(Ссылка));
	Узел.Вставить("ЭтоДокумент", Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка)));
	Узел.Вставить("Помечен", Ссылка.ПометкаУдаления);
	Узел.Вставить("Проведен", Ложь);
	Узел.Вставить("Дата", '00010101');
	Узел.Вставить("НовееГраницы", Ложь);
	Узел.Вставить("ЕстьДвижения", Неопределено);
	Узел.Вставить("МожноПометитьАвто", Ложь);
	Узел.Вставить("ПометилиСейчас", Ложь);
	Узел.Вставить("Удален", Ложь);
	Узел.Вставить("ЭтоЗаказ", Ложь);
	Узел.Вставить("Включен", Ложь);
	Узел.Вставить("Причина", "");
	
	Если Узел.ЭтоДокумент Тогда
		Узел.Дата = Ссылка.Дата;
		Узел.Проведен = Ссылка.Проведен;
		Узел.НовееГраницы = ЗначениеЗаполнено(Контекст.Граница) И Ссылка.Дата > Контекст.Граница;
	КонецЕсли;
	
	Контекст.Узлы.Вставить(Ссылка, Узел);
	Контекст.Родители.Вставить(Ссылка, Ссылка);
	Возврат Узел;
	
КонецФункции

Функция Удал_ДокументИмеетДвижения(Ссылка)
	
	Мета = Ссылка.Метаданные();
	Для Каждого Движение Из Мета.Движения Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1"
			+ Символы.ПС + Символы.Таб + "ИСТИНА КАК ЕстьЗапись"
			+ Символы.ПС + "ИЗ"
			+ Символы.ПС + Символы.Таб + Движение.ПолноеИмя() + " КАК Движения"
			+ Символы.ПС + "ГДЕ"
			+ Символы.ПС + Символы.Таб + "Движения.Регистратор = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Если Не Запрос.Выполнить().Пустой() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура Удал_ПометитьНепроведенные(Контекст)
	
	Если Не Контекст.ПомечатьНепроведенные Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Контекст.Узлы Цикл
		Узел = Элемент.Значение;
		Если Не Узел.Включен Или Не Узел.МожноПометитьАвто Или Узел.Помечен Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Удал_ПометитьНаУдаление(Узел.Ссылка);
			Узел.Помечен = Истина;
			Узел.ПометилиСейчас = Истина;
			Контекст.Помечено = Контекст.Помечено + 1;
		Исключение
			Узел.МожноПометитьАвто = Ложь;
			Узел.Причина = "Не удалось пометить: " + Удал_КраткийТекстОшибки(ОписаниеОшибки());
			Удал_ДобавитьБлокировку(Контекст, Узел.Ссылка, Узел.Представление + ": " + Узел.Причина);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура Удал_ПометитьНаУдаление(Ссылка)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение "Объект уже удален.";
	КонецЕсли;
	
	Объект.ПометкаУдаления = Истина;
	Объект.Записать();
	
КонецПроцедуры

Процедура Удал_УдалитьДоступныеЦепочки(Контекст)
	
	Компоненты = Удал_СобратьКомпоненты(Контекст);
	Для Каждого Элемент Из Компоненты Цикл
		Удал_Корень = Элемент.Ключ;
		УзлыКомпонента = Элемент.Значение;
		Если Удал_ЕстьБлокировки(Контекст, Удал_Корень) Тогда
			Продолжить;
		КонецЕсли;
		Удал_УдалитьКомпонент(Контекст, УзлыКомпонента, Удал_Корень);
	КонецЦикла;
	
КонецПроцедуры

Процедура Удал_УдалитьКомпонент(Контекст, УзлыКомпонента, Удал_Корень)
	
	Ссылки = Новый Массив;
	Для Каждого Узел Из УзлыКомпонента Цикл
		Если Узел.Помечен И Не Узел.Удален Тогда
			Ссылки.Добавить(Узел.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если Ссылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Удал_ЗаблокироватьСсылки(Ссылки);
		ТекстНовойСсылки = Удал_ТекстНовойВнешнейСсылки(Контекст, Ссылки);
		Если ЗначениеЗаполнено(ТекстНовойСсылки) Тогда
			ОтменитьТранзакцию();
			Удал_ДобавитьБлокировку(Контекст, Удал_Корень, ТекстНовойСсылки);
			Контекст.ОшибокУдаления = Контекст.ОшибокУдаления + 1;
			Возврат;
		КонецЕсли;
		
		Удал_УдалитьВедущиеЗаписиКомпонента(Контекст, Удал_Корень);
		Удал_ИсправитьКорректировкиКомпонента(Контекст, УзлыКомпонента, Удал_Корень);
		Удал_УдалитьСсылкиБезМонопольногоРежима(Ссылки);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Удал_ДобавитьБлокировку(Контекст, Удал_Корень, "Ошибка удаления: " + Удал_КраткийТекстОшибки(ОписаниеОшибки()));
		Контекст.ОшибокУдаления = Контекст.ОшибокУдаления + 1;
		Возврат;
	КонецПопытки;
	
	Для Каждого Узел Из УзлыКомпонента Цикл
		Если Узел.Помечен Тогда
			Узел.Удален = Истина;
			Контекст.Удалено = Контекст.Удалено + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Удал_ЗаблокироватьСсылки(Ссылки)
	
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Ссылка Из Ссылки Цикл
		ЭлементБлокировки = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	КонецЦикла;
	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура Удал_УдалитьСсылкиБезМонопольногоРежима(Ссылки)
	
	Для Каждого Ссылка Из Ссылки Цикл
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Объект.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Функция Удал_ТекстНовойВнешнейСсылки(Контекст, Ссылки)
	
	Множество = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Множество.Вставить(Ссылка, Истина);
	КонецЦикла;
	
	Индекс = 0;
	Пока Индекс < Ссылки.Количество() Цикл
		Порция = Новый Массив;
		Пока Индекс < Ссылки.Количество() И Порция.Количество() < 50 Цикл
			Порция.Добавить(Ссылки[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		
		НайденныеСсылки = НайтиПоСсылкам(Порция);
		Для Каждого СтрокаНайденных Из НайденныеСсылки Цикл
			Текст = Удал_ТекстВнешнейСсылкиДляУдаления(Контекст, СтрокаНайденных, Множество);
			Если ЗначениеЗаполнено(Текст) Тогда
				Возврат Текст;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция Удал_ТекстВнешнейСсылкиДляУдаления(Контекст, СтрокаНайденных, Множество)
	
	Цель = СтрокаНайденных.Ссылка;
	ВедущееИзмерение = Удал_ВедущееИзмерениеРегистраСведений(СтрокаНайденных, Цель);
	Если ВедущееИзмерение <> Неопределено Тогда
		РегистраторЗаписи = Удал_РегистраторНайденныхДанных(СтрокаНайденных);
		Если Удал_ЭтоКорректировкаЗаписейРегистров(РегистраторЗаписи) Тогда
			Удал_ДобавитьКорректировку(Контекст, РегистраторЗаписи, Цель);
		Иначе
			Удал_ДобавитьЗаписьВедущего(Контекст, СтрокаНайденных, Цель, ВедущееИзмерение);
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	
	Источник = Удал_ИсточникСсылки(СтрокаНайденных);
	Если Удал_ЭтоКорректировкаЗаписейРегистров(Источник) Тогда
		Удал_ДобавитьКорректировку(Контекст, Источник, Цель);
		Возврат "";
	КонецЕсли;
	
	Если Множество.Получить(Источник) <> Неопределено Или Источник = Цель Тогда
		Возврат "";
	КонецЕсли;
	
	Регистратор = Удал_РегистраторНайденныхДанных(СтрокаНайденных);
	Если Множество.Получить(Регистратор) <> Неопределено Или Регистратор = Цель Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник) Тогда
		Возврат "Появилась ссылка из " + Строка(Источник) + ".";
	КонецЕсли;
	
	Возврат "Появилась внешняя ссылка: " + Удал_ПредставлениеМеста(СтрокаНайденных) + ".";
	
КонецФункции

Функция Удал_СобратьКомпоненты(Контекст)
	
	Компоненты = Новый Соответствие;
	Для Каждого Элемент Из Контекст.Узлы Цикл
		Узел = Элемент.Значение;
		Если Не Узел.Включен Тогда
			Продолжить;
		КонецЕсли;
		Удал_Корень = Удал_Корень(Контекст, Узел.Ссылка);
		Список = Компоненты.Получить(Удал_Корень);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Компоненты.Вставить(Удал_Корень, Список);
		КонецЕсли;
		Список.Добавить(Узел);
	КонецЦикла;
	Возврат Компоненты;
	
КонецФункции

Функция Удал_СобратьРезультат(Контекст)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Заказ", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Объект", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	
	Компоненты = Удал_СобратьКомпоненты(Контекст);
	Для Каждого Элемент Из Компоненты Цикл
		Удал_Корень = Элемент.Ключ;
		УзлыКомпонента = Элемент.Значение;
		ПредставлениеЗаказа = Удал_ПредставлениеЗаказов(УзлыКомпонента);
		Блокировки = Контекст.Блокировки.Получить(Удал_Корень);
		ЕстьПрепятствия = Блокировки <> Неопределено И Блокировки.Количество() > 0;
		
		Для Каждого Узел Из УзлыКомпонента Цикл
			СтрокаРезультата = Таблица.Добавить();
			СтрокаРезультата.Заказ = ПредставлениеЗаказа;
			СтрокаРезультата.Объект = Узел.Представление;
			СтрокаРезультата.Действие = Удал_ДействиеУзла(Контекст, Узел, ЕстьПрепятствия);
			СтрокаРезультата.Причина = Удал_ПричинаУзла(Узел, ЕстьПрепятствия);
		КонецЦикла;
		
		Если Блокировки <> Неопределено Тогда
			Для Каждого Текст Из Блокировки Цикл
				СтрокаРезультата = Таблица.Добавить();
				СтрокаРезультата.Заказ = ПредставлениеЗаказа;
				СтрокаРезультата.Объект = Текст;
				СтрокаРезультата.Действие = "Блокирует";
				СтрокаРезультата.Причина = Текст;
			КонецЦикла;
		КонецЕсли;
		
		Если Не ЕстьПрепятствия Тогда
			Удал_ДобавитьСтрокиВедущихЗаписей(Таблица, Контекст, Удал_Корень, ПредставлениеЗаказа);
			Удал_ДобавитьСтрокиКорректировок(Таблица, Контекст, Удал_Корень, ПредставлениеЗаказа);
		КонецЕсли;
	КонецЦикла;
	
	Таблица.Сортировать("Заказ, Действие, Объект");
	Возврат Таблица;
	
КонецФункции

Процедура Удал_ДобавитьСтрокиВедущихЗаписей(Таблица, Контекст, КореньКомпонента, ПредставлениеЗаказа)
	
	Для Каждого ЗаписьВедущая Из Контекст.ЗаписиВедущие Цикл
		Если Удал_Корень(Контекст, ЗаписьВедущая.Цель) <> КореньКомпонента Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРезультата = Таблица.Добавить();
		СтрокаРезультата.Заказ = ПредставлениеЗаказа;
		СтрокаРезультата.Объект = ЗаписьВедущая.Представление;
		СтрокаРезультата.Действие = Удал_ДействиеВедущейЗаписи(Контекст, ЗаписьВедущая);
		Если ЗаписьВедущая.Удалена Тогда
			СтрокаРезультата.Причина = "Запись регистра сведений по ведущему измерению удалена";
		ИначеЕсли Контекст.УдалятьПриПервойВозможности И Контекст.ТолькоПроверка Тогда
			СтрокаРезультата.Причина = "Ведущее измерение регистра сведений, запись будет удалена вместе с объектом";
		Иначе
			СтрокаРезультата.Причина = "Ведущее измерение регистра сведений не мешает удалению объекта";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Удал_ДобавитьСтрокиКорректировок(Таблица, Контекст, КореньКомпонента, ПредставлениеЗаказа)
	
	Для Каждого Элемент Из Контекст.Корректировки Цикл
		Описание = Элемент.Значение;
		Если Не Удал_КорректировкаОтноситсяККомпоненту(Контекст, Описание, КореньКомпонента) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРезультата = Таблица.Добавить();
		СтрокаРезультата.Заказ = ПредставлениеЗаказа;
		СтрокаРезультата.Объект = Строка(Описание.Ссылка);
		Если Описание.ОбработанныеКорни.Получить(КореньКомпонента) <> Неопределено И Не Контекст.ТолькоПроверка Тогда
			СтрокаРезультата.Действие = "Исправлена корректировка";
			СтрокаРезультата.Причина = "Из корректировки записей регистров удалены движения по удаляемым документам";
		ИначеЕсли Контекст.УдалятьПриПервойВозможности И Контекст.ТолькоПроверка Тогда
			СтрокаРезультата.Действие = "Будет исправлена корректировка";
			СтрокаРезультата.Причина = "Из списка движений будут удалены строки по удаляемым документам";
		Иначе
			СтрокаРезультата.Действие = "Можно исправить корректировку";
			СтрокаРезультата.Причина = "Корректировка записей регистров ссылается на цепочку, документ не удаляется";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Удал_СобратьСводку(Контекст)
	
	Счетчики = Новый Соответствие;
	Компоненты = Удал_СобратьКомпоненты(Контекст);
	Для Каждого Элемент Из Компоненты Цикл
		Удал_Корень = Элемент.Ключ;
		УзлыКомпонента = Элемент.Значение;
		Блокировки = Контекст.Блокировки.Получить(Удал_Корень);
		ЕстьПрепятствия = Блокировки <> Неопределено И Блокировки.Количество() > 0;
		
		Для Каждого Узел Из УзлыКомпонента Цикл
			Если Не Удал_ДействиеОзначаетУдаление(Удал_ДействиеУзла(Контекст, Узел, ЕстьПрепятствия)) Тогда
				Продолжить;
			КонецЕсли;
			Мета = Узел.Ссылка.Метаданные();
			Удал_УвеличитьСводку(Счетчики, Мета.ПолноеИмя(), Удал_ПредставлениеТипаМетаданных(Мета));
		КонецЦикла;
		
		Если ЕстьПрепятствия Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ЗаписьВедущая Из Контекст.ЗаписиВедущие Цикл
			Если Удал_Корень(Контекст, ЗаписьВедущая.Цель) <> Удал_Корень Тогда
				Продолжить;
			КонецЕсли;
			Если Не Удал_ДействиеОзначаетУдаление(Удал_ДействиеВедущейЗаписи(Контекст, ЗаписьВедущая)) Тогда
				Продолжить;
			КонецЕсли;
			МетаРегистра = Метаданные.РегистрыСведений.Найти(ЗаписьВедущая.ИмяРегистра);
			Если МетаРегистра = Неопределено Тогда
				Удал_УвеличитьСводку(Счетчики, "РегистрСведений." + ЗаписьВедущая.ИмяРегистра, "Регистр сведений. " + ЗаписьВедущая.ИмяРегистра);
			Иначе
				Удал_УвеличитьСводку(Счетчики, МетаРегистра.ПолноеИмя(), Удал_ПредставлениеТипаМетаданных(МетаРегистра));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	
	Итого = 0;
	Для Каждого Элемент Из Счетчики Цикл
		СтрокаСводки = Таблица.Добавить();
		СтрокаСводки.Тип = Элемент.Значение.Представление;
		СтрокаСводки.Количество = Элемент.Значение.Количество;
		Итого = Итого + Элемент.Значение.Количество;
	КонецЦикла;
	
	Таблица.Сортировать("Тип");
	Если Таблица.Количество() > 0 Тогда
		СтрокаСводки = Таблица.Добавить();
		СтрокаСводки.Тип = "Всего";
		СтрокаСводки.Количество = Итого;
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Процедура Удал_УвеличитьСводку(Счетчики, Ключ, Представление)
	
	СтрокаСчетчика = Счетчики.Получить(Ключ);
	Если СтрокаСчетчика = Неопределено Тогда
		СтрокаСчетчика = Новый Структура("Представление, Количество", Представление, 0);
		Счетчики.Вставить(Ключ, СтрокаСчетчика);
	КонецЕсли;
	СтрокаСчетчика.Количество = СтрокаСчетчика.Количество + 1;
	
КонецПроцедуры

Функция Удал_ПредставлениеТипаМетаданных(Мета)
	
	ПолноеИмя = Мета.ПолноеИмя();
	Позиция = Найти(ПолноеИмя, ".");
	Вид = ПолноеИмя;
	Если Позиция > 0 Тогда
		Вид = Лев(ПолноеИмя, Позиция - 1);
	КонецЕсли;
	
	Синоним = Мета.Синоним;
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	
	Возврат Удал_ПредставлениеВидаМетаданных(Вид) + ". " + Синоним;
	
КонецФункции

Функция Удал_ПредставлениеВидаМетаданных(Вид)
	
	Если Вид = "РегистрСведений" Тогда
		Возврат "Регистр сведений";
	ИначеЕсли Вид = "РегистрНакопления" Тогда
		Возврат "Регистр накопления";
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Возврат "Регистр бухгалтерии";
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Возврат "Регистр расчета";
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат "План видов характеристик";
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат "План счетов";
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат "План видов расчета";
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат "План обмена";
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат "Бизнес-процесс";
	КонецЕсли;
	
	Возврат Вид;
	
КонецФункции

Функция Удал_ДействиеВедущейЗаписи(Контекст, ЗаписьВедущая)
	
	Если ЗаписьВедущая.Удалена Тогда
		Возврат "Удалена запись";
	ИначеЕсли Контекст.УдалятьПриПервойВозможности И Контекст.ТолькоПроверка Тогда
		Возврат "Будет удалена запись";
	КонецЕсли;
	
	Возврат "Можно удалить запись";
	
КонецФункции

Функция Удал_ДействиеОзначаетУдаление(Действие)
	
	Возврат Действие = "Удален"
		Или Действие = "Будет удален"
		Или Действие = "Можно удалить"
		Или Действие = "Удалена запись"
		Или Действие = "Будет удалена запись"
		Или Действие = "Можно удалить запись";
	
КонецФункции

Функция Удал_ДействиеУзла(Контекст, Узел, ЕстьПрепятствия)
	
	Если Узел.Удален Тогда
		Возврат "Удален";
	КонецЕсли;
	
	Если Узел.ПометилиСейчас И (ЕстьПрепятствия Или Не Контекст.УдалятьПриПервойВозможности) Тогда
		Возврат "Помечен";
	КонецЕсли;
	
	Если ЕстьПрепятствия Тогда
		Возврат "Оставлен";
	КонецЕсли;
	
	Если Контекст.УдалятьПриПервойВозможности Тогда
		Если Контекст.ТолькоПроверка Тогда
			Возврат "Будет удален";
		КонецЕсли;
		Возврат "Оставлен";
	КонецЕсли;
	
	Если Узел.МожноПометитьАвто И Контекст.ТолькоПроверка Тогда
		Возврат "Будет помечен";
	КонецЕсли;
	
	Возврат "Можно удалить";
	
КонецФункции

Функция Удал_ПричинаУзла(Узел, ЕстьПрепятствия)
	
	Если Узел.Удален Тогда
		Возврат "Цепочка удалена";
	КонецЕсли;
	
	Если Узел.ПометилиСейчас Тогда
		Возврат "Непроведенный документ без движений помечен на удаление";
	КонецЕсли;
	
	Если Узел.МожноПометитьАвто Тогда
		Возврат "Непроведенный документ без движений";
	КонецЕсли;
	
	Если ЕстьПрепятствия Тогда
		Возврат "В цепочке есть внешние ссылки, документы или даты доставки позже границы";
	КонецЕсли;
	
	Если Узел.ЭтоЗаказ Тогда
		Возврат "Помеченный заказ";
	КонецЕсли;
	
	Возврат "Помеченный связанный объект";
	
КонецФункции

Функция Удал_ПредставлениеЗаказов(УзлыКомпонента)
	
	Части = Новый Массив;
	Для Каждого Узел Из УзлыКомпонента Цикл
		Если Узел.ЭтоЗаказ Тогда
			Части.Добавить(Узел.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Текст = Удал_СоединитьСтроки(Части, "; ");
	Если СтрДлина(Текст) > 500 Тогда
		Возврат Лев(Текст, 500) + "...";
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

Функция Удал_ТекстИтога(Контекст, КоличествоЗаказов, Таблица)
	
	МожноУдалить = 0;
	БудетУдален = 0;
	Оставлен = 0;
	Блокирует = 0;
	Помечен = 0;
	БудетПомечен = 0;
	Для Каждого СтрокаРезультата Из Таблица Цикл
		Если СтрокаРезультата.Действие = "Можно удалить" Или СтрокаРезультата.Действие = "Будет удален" Или СтрокаРезультата.Действие = "Удален" Тогда
			МожноУдалить = МожноУдалить + 1;
		КонецЕсли;
		Если СтрокаРезультата.Действие = "Будет удален" Тогда
			БудетУдален = БудетУдален + 1;
		КонецЕсли;
		Если СтрокаРезультата.Действие = "Оставлен" Тогда
			Оставлен = Оставлен + 1;
		КонецЕсли;
		Если СтрокаРезультата.Действие = "Блокирует" Тогда
			Блокирует = Блокирует + 1;
		КонецЕсли;
		Если СтрокаРезультата.Действие = "Помечен" Тогда
			Помечен = Помечен + 1;
		КонецЕсли;
		Если СтрокаРезультата.Действие = "Будет помечен" Тогда
			БудетПомечен = БудетПомечен + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекстГраницы = "без ограничения";
	Если ЗначениеЗаполнено(Контекст.Граница) Тогда
		ТекстГраницы = "не позже " + Формат(Контекст.Граница, "ДЛФ=D");
	КонецЕсли;
	
	Сообщение = "Заказов в отборе: " + Удал_ФорматЧисла(КоличествоЗаказов) + "."
		+ Символы.ПС + "Граница даты документов: " + ТекстГраницы + "."
		+ Символы.ПС + "Удалено объектов: " + Удал_ФорматЧисла(Контекст.Удалено) + "."
		+ Символы.ПС + "Помечено непроведенных: " + Удал_ФорматЧисла(Контекст.Помечено) + "."
		+ Символы.ПС + "Удалено ведущих записей регистров сведений: " + Удал_ФорматЧисла(Контекст.УдаленоЗаписей) + "."
		+ Символы.ПС + "Исправлено корректировок записей регистров: " + Удал_ФорматЧисла(Контекст.ИсправленоКорректировок) + ".";
	
	Если Контекст.ТолькоПроверка Тогда
		Сообщение = Сообщение + Символы.ПС + "Проверка без записи."
			+ Символы.ПС + "Будет удалено: " + Удал_ФорматЧисла(БудетУдален)
			+ ", можно удалить: " + Удал_ФорматЧисла(МожноУдалить)
			+ ", будет помечено: " + Удал_ФорматЧисла(БудетПомечен) + ".";
	КонецЕсли;
	
	Если Оставлен > 0 Или Блокирует > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Оставлено в цепочках с препятствиями: " + Удал_ФорматЧисла(Оставлен)
			+ ", препятствий: " + Удал_ФорматЧисла(Блокирует) + ".";
	КонецЕсли;
	
	Если Контекст.ОшибокУдаления > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Цепочек не удалено из-за ошибки или оставшихся ссылок: " + Удал_ФорматЧисла(Контекст.ОшибокУдаления) + ".";
	КонецЕсли;
	
	Если КоличествоЗаказов = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Помеченных заказов по отбору нет.";
	КонецЕсли;
	
	Возврат Сообщение;
	
КонецФункции

Функция Удал_Корень(Контекст, Ссылка)
	
	Текущий = Ссылка;
	Пока Истина Цикл
		Родитель = Контекст.Родители.Получить(Текущий);
		Если Родитель = Неопределено Или Родитель = Текущий Тогда
			Прервать;
		КонецЕсли;
		Текущий = Родитель;
	КонецЦикла;
	
	Узел = Ссылка;
	Пока Узел <> Текущий Цикл
		Следующий = Контекст.Родители.Получить(Узел);
		Контекст.Родители.Вставить(Узел, Текущий);
		Если Следующий = Неопределено Или Следующий = Узел Тогда
			Прервать;
		КонецЕсли;
		Узел = Следующий;
	КонецЦикла;
	
	Контекст.Родители.Вставить(Текущий, Текущий);
	Возврат Текущий;
	
КонецФункции

Процедура Удал_Объединить(Контекст, Ссылка1, Ссылка2)
	
	Корень1 = Удал_Корень(Контекст, Ссылка1);
	Корень2 = Удал_Корень(Контекст, Ссылка2);
	Если Корень1 = Корень2 Тогда
		Возврат;
	КонецЕсли;
	
	Контекст.Родители.Вставить(Корень2, Корень1);
	Удал_ПеренестиБлокировки(Контекст, Корень2, Корень1);
	
КонецПроцедуры

Процедура Удал_ДобавитьБлокировку(Контекст, Ссылка, Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Удал_ДобавитьТекстБлокировки(Контекст, Удал_Корень(Контекст, Ссылка), Текст);
	
КонецПроцедуры

Процедура Удал_ДобавитьТекстБлокировки(Контекст, КореньСсылки, Текст)
	
	Список = Контекст.Блокировки.Получить(КореньСсылки);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Контекст.Блокировки.Вставить(КореньСсылки, Список);
	КонецЕсли;
	
	Если Список.Количество() >= 30 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Список Цикл
		Если Элемент = Текст Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Список.Добавить(Текст);
	
КонецПроцедуры

Процедура Удал_ПеренестиБлокировки(Контекст, Откуда, Куда)
	
	Список = Контекст.Блокировки.Получить(Откуда);
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Текст Из Список Цикл
		Удал_ДобавитьТекстБлокировки(Контекст, Куда, Текст);
	КонецЦикла;
	Контекст.Блокировки.Удалить(Откуда);
	
КонецПроцедуры

Функция Удал_ЕстьБлокировки(Контекст, КореньСсылки)
	
	Список = Контекст.Блокировки.Получить(Удал_Корень(Контекст, КореньСсылки));
	Возврат Список <> Неопределено И Список.Количество() > 0;
	
КонецФункции

Функция Удал_ПредставлениеМеста(СтрокаНайденных)
	
	Попытка
		Возврат Строка(СтрокаНайденных.Метаданные);
	Исключение
		Возврат Строка(СтрокаНайденных.Данные);
	КонецПопытки;
	
КонецФункции

Функция Удал_ПервыеСтроки(Строки, Количество)
	
	Результат = Новый Массив;
	Индекс = 0;
	Для Каждого Строка Из Строки Цикл
		Если Индекс >= Количество Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Строка);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция Удал_МаксимумОбъектовЦепочки()
	
	Возврат 5000;
	
КонецФункции

Функция Удал_ОписаниеДокументаЗаказа()
	
	Если Удал_ОписаниеЗаказа <> Неопределено Тогда
		Возврат Удал_ОписаниеЗаказа;
	КонецЕсли;
	
	Мета = Метаданные.Документы[Удал_ИмяДокументаЗаказа()];
	Описание = Новый Структура;
	Описание.Вставить("ПолноеИмя", "Документ." + Мета.Имя);
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Поля", Новый Массив);
	Описание.Вставить("ТабличныеЧасти", Новый Массив);
	
	Удал_ДобавитьПоле(Описание.Поля, "Ссылка", Новый ОписаниеТипов("ДокументСсылка." + Мета.Имя));
	Удал_ДобавитьПоле(Описание.Поля, "ПометкаУдаления", Новый ОписаниеТипов("Булево"));
	Удал_ДобавитьПоле(Описание.Поля, "Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Удал_ДобавитьПоле(Описание.Поля, "Номер", Новый ОписаниеТипов("Строка"));
	Удал_ДобавитьПоле(Описание.Поля, "Проведен", Новый ОписаниеТипов("Булево"));
	
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Удал_ДобавитьПоле(Описание.Поля, Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из Мета.ТабличныеЧасти Цикл
		Поля = Новый Массив;
		Удал_ДобавитьПоле(Поля, "НомерСтроки", Новый ОписаниеТипов("Число"));
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			Удал_ДобавитьПоле(Поля, Реквизит.Имя, Реквизит.Тип);
		КонецЦикла;
		Описание.ТабличныеЧасти.Добавить(Новый Структура("Имя, Поля", ТабличнаяЧасть.Имя, Поля));
	КонецЦикла;
	
	Удал_ОписаниеЗаказа = Описание;
	Возврат Удал_ОписаниеЗаказа;
	
КонецФункции

Процедура Удал_ДобавитьПоле(Поля, Имя, ОписаниеТипов)
	
	Поля.Добавить(Новый Структура("Имя, ОписаниеТипов", Имя, ОписаниеТипов));
	
КонецПроцедуры

Функция Удал_ТекстУсловияОтбора(Описание, Отбор, Запрос, Счетчик)
	
	Найденное = Удал_НайтиПолеОтбора(Описание, Отбор.Поле);
	Вид = Удал_НормализоватьВидСравнения(Отбор.ВидСравнения);
	Путь = Удал_ПутьПоляОтбора(Отбор.Поле);
	ИмяПараметра = "Отбор" + Удал_ФорматЧисла(Счетчик.Номер);
	Счетчик.Номер = Счетчик.Номер + 1;
	
	Если Вид = "заполнено" Тогда
		УсловиеПоля = Удал_ТекстУсловияЗаполнено(Путь, Найденное.Поле);
	ИначеЕсли Вид = "не заполнено" Тогда
		УсловиеПоля = "НЕ (" + Удал_ТекстУсловияЗаполнено(Путь, Найденное.Поле) + ")";
	ИначеЕсли Вид = "содержит" Тогда
		Если Найденное.Поле.ОписаниеТипов = Неопределено Или Не Найденное.Поле.ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
			ВызватьИсключение "Сравнение «Содержит» доступно только для строки. Поле: " + Отбор.Поле + ".";
		КонецЕсли;
		Запрос.УстановитьПараметр(ИмяПараметра, "%" + СокрЛП(Строка(Отбор.Значение)) + "%");
		УсловиеПоля = Путь + " ПОДОБНО &" + ИмяПараметра;
	ИначеЕсли Вид = "в списке" Или Вид = "не в списке" Тогда
		Запрос.УстановитьПараметр(ИмяПараметра, Удал_ЗначенияСписка(Найденное.Поле, Отбор.Значение));
		Если Вид = "в списке" Тогда
			УсловиеПоля = Путь + " В (&" + ИмяПараметра + ")";
		Иначе
			УсловиеПоля = "НЕ (" + Путь + " В (&" + ИмяПараметра + "))";
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр(ИмяПараметра, Удал_ЗначениеПоляОтбора(Найденное.Поле, Отбор.Значение));
		УсловиеПоля = Путь + " " + Вид + " &" + ИмяПараметра;
	КонецЕсли;
	
	Если Найденное.ИмяТабличнойЧасти = "" Тогда
		Возврат УсловиеПоля;
	КонецЕсли;
	
	Возврат "СУЩЕСТВУЕТ (ВЫБРАТЬ 1 ИЗ Документ." + Описание.Имя + "." + Найденное.ИмяТабличнойЧасти
		+ " КАК СтрокаТЧ ГДЕ СтрокаТЧ.Ссылка = Объект.Ссылка И " + УсловиеПоля + ")";
	
КонецФункции

Функция Удал_ПутьПоляОтбора(ИмяПоля)
	
	Позиция = Найти(ИмяПоля, ".");
	Если Позиция = 0 Тогда
		Возврат "Объект." + СокрЛП(ИмяПоля);
	КонецЕсли;
	
	Возврат "СтрокаТЧ." + СокрЛП(Сред(ИмяПоля, Позиция + 1));
	
КонецФункции

Функция Удал_НайтиПолеОтбора(Описание, ИмяПоля)
	
	ИмяПоля = СокрЛП(ИмяПоля);
	Позиция = Найти(ИмяПоля, ".");
	
	Если Позиция = 0 Тогда
		Для Каждого Поле Из Описание.Поля Цикл
			Если Поле.Имя = ИмяПоля Тогда
				Возврат Новый Структура("Поле, ИмяТабличнойЧасти", Поле, "");
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИмяТаблицы = Лев(ИмяПоля, Позиция - 1);
		ИмяРеквизита = СокрЛП(Сред(ИмяПоля, Позиция + 1));
		Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
			Если ТабличнаяЧасть.Имя <> ИмяТаблицы Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Поле Из ТабличнаяЧасть.Поля Цикл
				Если Поле.Имя = ИмяРеквизита Тогда
					Возврат Новый Структура("Поле, ИмяТабличнойЧасти", Поле, ИмяТаблицы);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ВызватьИсключение "У заказа покупателя нет поля """ + ИмяПоля + """.";
	
КонецФункции

Функция Удал_НормализоватьВидСравнения(Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Если Ключ = "" Или Ключ = "равно" Или Ключ = "=" Тогда
		Возврат "=";
	ИначеЕсли Ключ = "не равно" Или Ключ = "<>" Тогда
		Возврат "<>";
	ИначеЕсли Ключ = "больше" Или Ключ = ">" Тогда
		Возврат ">";
	ИначеЕсли Ключ = "больше или равно" Или Ключ = ">=" Тогда
		Возврат ">=";
	ИначеЕсли Ключ = "меньше" Или Ключ = "<" Тогда
		Возврат "<";
	ИначеЕсли Ключ = "меньше или равно" Или Ключ = "<=" Тогда
		Возврат "<=";
	ИначеЕсли Ключ = "содержит" Тогда
		Возврат "содержит";
	ИначеЕсли Ключ = "в списке" Тогда
		Возврат "в списке";
	ИначеЕсли Ключ = "не в списке" Тогда
		Возврат "не в списке";
	ИначеЕсли Ключ = "заполнено" Тогда
		Возврат "заполнено";
	ИначеЕсли Ключ = "не заполнено" Тогда
		Возврат "не заполнено";
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный вид сравнения """ + Текст + """.";
	
КонецФункции

Функция Удал_ТекстУсловияЗаполнено(Путь, Поле)
	
	Если Поле.ОписаниеТипов = Неопределено Тогда
		Возврат Путь + " <> НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого ТипЗначения Из Поле.ОписаниеТипов.Типы() Цикл
		Фрагмент = Удал_ТекстЗаполненоТипа(Путь, ТипЗначения);
		Если Фрагмент <> "" Тогда
			Части.Добавить(Фрагмент);
		КонецЕсли;
	КонецЦикла;
	
	Если Части.Количество() = 0 Тогда
		Возврат Путь + " <> НЕОПРЕДЕЛЕНО";
	ИначеЕсли Части.Количество() = 1 Тогда
		Возврат Части[0];
	КонецЕсли;
	
	Возврат "(" + Удал_СоединитьСтроки(Части, " ИЛИ ") + ")";
	
КонецФункции

Функция Удал_ТекстЗаполненоТипа(Путь, ТипЗначения)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Путь + " <> """"";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Путь + " <> 0";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Путь + " <> ДАТАВРЕМЯ(1, 1, 1)";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Путь + " = ИСТИНА";
	КонецЕсли;
	
	ИмяТаблицы = Удал_ИмяТаблицыПоТипу(ТипЗначения);
	Если ИмяТаблицы = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "(" + Путь + " ССЫЛКА " + ИмяТаблицы + " И " + Путь + " <> ЗНАЧЕНИЕ(" + ИмяТаблицы + ".ПустаяСсылка))";
	
КонецФункции

Функция Удал_ЗначенияСписка(Поле, Текст)
	
	Части = Удал_РазделитьСтроку(Строка(Текст), ";");
	Значения = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если СокрЛП(Часть) = "" Тогда
			Продолжить;
		КонецЕсли;
		Значения.Добавить(Удал_ЗначениеПоляОтбора(Поле, Часть));
	КонецЦикла;
	
	Если Значения.Количество() = 0 Тогда
		ВызватьИсключение "Для сравнения «В списке» укажите хотя бы одно значение.";
	КонецЕсли;
	
	Возврат Значения;
	
КонецФункции

Функция Удал_ЗначениеПоляОтбора(Поле, Значение)
	
	Если Поле.ОписаниеТипов <> Неопределено
		И ТипЗнч(Значение) <> Тип("Строка")
		И Поле.ОписаниеТипов.СодержитТип(ТипЗнч(Значение)) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Текст = СокрЛП(Строка(Значение));
	Если Удал_ЭтоЯвноеЗначениеXML(Текст, Поле.ОписаниеТипов) Тогда
		Возврат Удал_ЗначениеИзXMLТекста(Текст);
	КонецЕсли;
	
	Если Поле.ОписаниеТипов = Неопределено Тогда
		ВызватьИсключение "Для поля составного типа укажите значение в виде ИмяТипаXML:значение.";
	КонецЕсли;
	
	Типы = Поле.ОписаниеТипов.Типы();
	Если Типы.Количество() <> 1 Тогда
		ВызватьИсключение "У поля несколько типов. Укажите значение в виде ИмяТипаXML:значение, например CatalogRef.Контрагенты:uuid.";
	КонецЕсли;
	
	Если Текст = "" Тогда
		Возврат Удал_ПустоеЗначениеТипа(Типы[0]);
	КонецЕсли;
	
	Возврат Удал_ЗначениеОдногоТипа(Типы[0], Текст);
	
КонецФункции

Функция Удал_ЭтоЯвноеЗначениеXML(Текст, ОписаниеТипов)
	
	Позиция = Найти(Текст, ":");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОписаниеТипов <> Неопределено И ОписаниеТипов.Типы().Количество() = 1 И ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяТипа = Лев(Текст, Позиция - 1);
	Если ИмяТипа = "string" Или ИмяТипа = "decimal" Или ИмяТипа = "boolean" Или ИмяТипа = "dateTime" Или Найти(ИмяТипа, ".") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция Удал_ЗначениеИзXMLТекста(Текст)
	
	Позиция = Найти(Текст, ":");
	ИмяТипа = Лев(Текст, Позиция - 1);
	Тело = Сред(Текст, Позиция + 1);
	
	Если ИмяТипа = "string" Тогда
		Возврат Тело;
	ИначеЕсли ИмяТипа = "boolean" Тогда
		Возврат Удал_БулевоИзТекста(Тело);
	ИначеЕсли ИмяТипа = "decimal" Тогда
		Возврат Удал_ЧислоИзТекста(Тело);
	ИначеЕсли ИмяТипа = "dateTime" Тогда
		Возврат Удал_ДатаИзТекста(Тело);
	КонецЕсли;
	
	ТипЗначения = ИзXMLТипа(ИмяТипа, "");
	Если ТипЗначения = Неопределено Тогда
		ВызватьИсключение "Неизвестный тип значения отбора " + ИмяТипа + ".";
	КонецЕсли;
	
	Возврат XMLЗначение(ТипЗначения, Тело);
	
КонецФункции

Функция Удал_ЗначениеОдногоТипа(ТипЗначения, Текст)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Текст;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Удал_ЧислоИзТекста(Текст);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Удал_ДатаИзТекста(Текст);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Удал_БулевоИзТекста(Текст);
	КонецЕсли;
	
	Если Удал_ЛевИмениТипа(ТипЗначения) = "EnumRef" Тогда
		Возврат Удал_ЗначениеПеречисления(ТипЗначения, Текст);
	КонецЕсли;
	
	Если Удал_ИмяТаблицыПоТипу(ТипЗначения) <> "" Тогда
		Возврат XMLЗначение(ТипЗначения, Текст);
	КонецЕсли;
	
	ВызватьИсключение "Нельзя разобрать значение отбора """ + Текст + """.";
	
КонецФункции

Функция Удал_ПустоеЗначениеТипа(ТипЗначения)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат 0;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат '00010101';
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Удал_ЛевИмениТипа(ТипЗначения) = "EnumRef" Тогда
		Возврат Перечисления[Удал_ИмяОбъектаТипа(ТипЗначения)].ПустаяСсылка();
	КонецЕсли;
	
	Если Удал_ИмяТаблицыПоТипу(ТипЗначения) <> "" Тогда
		Возврат XMLЗначение(ТипЗначения, "00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция Удал_ЗначениеПеречисления(ТипЗначения, Текст)
	
	Имя = Удал_ИмяОбъектаТипа(ТипЗначения);
	ИмяЗначения = СокрЛП(Текст);
	Позиция = Найти(ИмяЗначения, ".");
	Если Позиция > 0 Тогда
		Части = Удал_РазделитьСтроку(ИмяЗначения, ".");
		ИмяЗначения = Части[Части.Количество() - 1];
	КонецЕсли;
	
	Попытка
		Возврат Перечисления[Имя][ИмяЗначения];
	Исключение
		ВызватьИсключение "Нет значения перечисления " + Имя + "." + ИмяЗначения + ".";
	КонецПопытки;
	
КонецФункции

Функция Удал_БулевоИзТекста(Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Если Ключ = "истина" Или Ключ = "да" Или Ключ = "true" Или Ключ = "1" Тогда
		Возврат Истина;
	ИначеЕсли Ключ = "ложь" Или Ключ = "нет" Или Ключ = "false" Или Ключ = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВызватьИсключение "Некорректное булево значение """ + Текст + """.";
	
КонецФункции

Функция Удал_ЧислоИзТекста(Текст)
	
	Нормализованный = СтрЗаменить(СокрЛП(Текст), " ", "");
	Нормализованный = СтрЗаменить(Нормализованный, Символ(160), "");
	Нормализованный = СтрЗаменить(Нормализованный, ",", ".");
	
	Попытка
		Возврат XMLЗначение(Тип("Число"), Нормализованный);
	Исключение
		ВызватьИсключение "Некорректное число """ + Текст + """.";
	КонецПопытки;
	
КонецФункции

Функция Удал_ДатаИзТекста(Текст)
	
	Текст = СокрЛП(Текст);
	Если Текст = "" Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Если Найти(Текст, "-") > 0 Тогда
		Нормализованный = Текст;
		Если Найти(Нормализованный, "T") = 0 И СтрДлина(Нормализованный) >= 10 Тогда
			Нормализованный = Лев(Нормализованный, 10) + "T00:00:00";
		КонецЕсли;
		Попытка
			Возврат XMLЗначение(Тип("Дата"), Нормализованный);
		Исключение
			ВызватьИсключение "Некорректная дата """ + Текст + """.";
		КонецПопытки;
	КонецЕсли;
	
	ТекстДаты = Текст;
	ТекстВремени = "";
	ПозицияПробела = Найти(Текст, " ");
	Если ПозицияПробела > 0 Тогда
		ТекстДаты = Лев(Текст, ПозицияПробела - 1);
		ТекстВремени = СокрЛП(Сред(Текст, ПозицияПробела + 1));
	КонецЕсли;
	
	ФрагментыДаты = Удал_РазделитьСтроку(ТекстДаты, ".");
	Если ФрагментыДаты.Количество() <> 3 Тогда
		ВызватьИсключение "Некорректная дата """ + Текст + """. Укажите ДД.ММ.ГГГГ или ГГГГ-ММ-ДД.";
	КонецЕсли;
	
	Час = 0;
	Минута = 0;
	Секунда = 0;
	Если ТекстВремени <> "" Тогда
		ЧастиВремени = Удал_РазделитьСтроку(ТекстВремени, ":");
		Час = Число(ЧастиВремени[0]);
		Если ЧастиВремени.Количество() > 1 Тогда
			Минута = Число(ЧастиВремени[1]);
		КонецЕсли;
		Если ЧастиВремени.Количество() > 2 Тогда
			Секунда = Число(ЧастиВремени[2]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Дата(Число(ФрагментыДаты[2]), Число(ФрагментыДаты[1]), Число(ФрагментыДаты[0]), Час, Минута, Секунда);
	
КонецФункции

Функция Удал_ИмяТаблицыПоТипу(ТипЗначения)
	
	Префикс = Удал_ЛевИмениТипа(ТипЗначения);
	Имя = Удал_ИмяОбъектаТипа(ТипЗначения);
	Если Префикс = "" Или Имя = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Если Префикс = "CatalogRef" Тогда
		Возврат "Справочник." + Имя;
	ИначеЕсли Префикс = "DocumentRef" Тогда
		Возврат "Документ." + Имя;
	ИначеЕсли Префикс = "EnumRef" Тогда
		Возврат "Перечисление." + Имя;
	ИначеЕсли Префикс = "ChartOfCharacteristicTypesRef" Тогда
		Возврат "ПланВидовХарактеристик." + Имя;
	ИначеЕсли Префикс = "ChartOfAccountsRef" Тогда
		Возврат "ПланСчетов." + Имя;
	ИначеЕсли Префикс = "ChartOfCalculationTypesRef" Тогда
		Возврат "ПланВидовРасчета." + Имя;
	ИначеЕсли Префикс = "ExchangePlanRef" Тогда
		Возврат "ПланОбмена." + Имя;
	ИначеЕсли Префикс = "BusinessProcessRef" Тогда
		Возврат "БизнесПроцесс." + Имя;
	ИначеЕсли Префикс = "TaskRef" Тогда
		Возврат "Задача." + Имя;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция Удал_ЛевИмениТипа(ТипЗначения)
	
	ТипXML = XMLТип(ТипЗначения);
	Если ТипXML = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Позиция = Найти(ТипXML.ИмяТипа, ".");
	Если Позиция = 0 Тогда
		Возврат ТипXML.ИмяТипа;
	КонецЕсли;
	
	Возврат Лев(ТипXML.ИмяТипа, Позиция - 1);
	
КонецФункции

Функция Удал_ИмяОбъектаТипа(ТипЗначения)
	
	ТипXML = XMLТип(ТипЗначения);
	Если ТипXML = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Позиция = Найти(ТипXML.ИмяТипа, ".");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(ТипXML.ИмяТипа, Позиция + 1);
	
КонецФункции

Процедура Удал_ИнициализироватьКэшТипов()
	
	Если Удал_ОписанияТиповСсылок <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Удал_ОписанияТиповСсылок = Новый Массив;
	Удал_ОписанияТиповСсылок.Добавить(Справочники.ТипВсеСсылки());
	Удал_ОписанияТиповСсылок.Добавить(Документы.ТипВсеСсылки());
	Удал_ОписанияТиповСсылок.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки());
	Удал_ОписанияТиповСсылок.Добавить(ПланыСчетов.ТипВсеСсылки());
	Удал_ОписанияТиповСсылок.Добавить(ПланыВидовРасчета.ТипВсеСсылки());
	Удал_ОписанияТиповСсылок.Добавить(ПланыОбмена.ТипВсеСсылки());
	Удал_ОписанияТиповСсылок.Добавить(БизнесПроцессы.ТипВсеСсылки());
	Удал_ОписанияТиповСсылок.Добавить(Задачи.ТипВсеСсылки());
	Удал_КэшСсылочныхТипов = Новый Соответствие;
	
КонецПроцедуры

Функция Удал_ЭтоСсылочныйТип(ТипЗначения)
	
	Если Удал_ОписанияТиповСсылок = Неопределено Тогда
		Удал_ИнициализироватьКэшТипов();
	КонецЕсли;
	
	Признак = Удал_КэшСсылочныхТипов.Получить(ТипЗначения);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;
	
	Признак = Ложь;
	Для Каждого ОписаниеТипа Из Удал_ОписанияТиповСсылок Цикл
		Если ОписаниеТипа.СодержитТип(ТипЗначения) Тогда
			Признак = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Удал_КэшСсылочныхТипов.Вставить(ТипЗначения, Признак);
	Возврат Признак;
	
КонецФункции

Функция Удал_КраткийТекстОшибки(Текст)
	
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Возврат Лев(СокрЛП(Текст), 1000);
	
КонецФункции

Функция Удал_СоединитьСтроки(Части, Разделитель)
	
	Результат = "";
	Индекс = 0;
	Для Каждого Часть Из Части Цикл
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Часть;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Удал_РазделитьСтроку(Текст, Разделитель)
	
	Части = Новый Массив;
	Остаток = Строка(Текст);
	ДлинаРазделителя = СтрДлина(Разделитель);
	Позиция = Найти(Остаток, Разделитель);
	Пока Позиция > 0 Цикл
		Части.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + ДлинаРазделителя);
		Позиция = Найти(Остаток, Разделитель);
	КонецЦикла;
	Части.Добавить(Остаток);
	Возврат Части;
	
КонецФункции

Функция Удал_ФорматЧисла(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции
