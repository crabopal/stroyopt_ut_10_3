КонецФункции

Функция Бух_ТекстXML(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Если Не Бух_СимволДопустимВXML(КодСимвола(Текст, Номер)) Тогда
			Возврат Бух_ТекстXMLСЗаменой(Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция Бух_ТекстXMLСЗаменой(Текст)
	
	Результат = "";
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Код = КодСимвола(Текст, Номер);
		Если Бух_СимволДопустимВXML(Код) Тогда
			Результат = Результат + Символ(Код);
		Иначе
			Результат = Результат + "#x" + Бух_ФорматЧисла(Код) + "#";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Бух_СимволДопустимВXML(Код)
	
	Если Код = 9 Или Код = 10 Или Код = 13 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 32 И Код <= 55295 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 57344 И Код <= 65533 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция Бух_СоединитьСтроки(Части, Разделитель)
	
	Результат = "";
	Индекс = 0;
	Для Каждого Часть Из Части Цикл
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Часть;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Бух_ФорматЧисла(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

Процедура Бух_УдалитьВременныйФайл(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

Функция Бух_РегистрВедетОстатки(ИмяРегистра) Экспорт
	
	Мета = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
	Возврат Мета <> Неопределено;
	
КонецФункции

Функция Бух_ВыгрузитьОстатки(ИменаРегистров, ДатаОстатков) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры бухгалтерии.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		ВызватьИсключение "Укажите дату остатков.";
	КонецЕсли;
	
	Бух_ИнициализироватьКэшТипов();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Статистика = Бух_НоваяСтатистика();
	Предупреждения = Новый Массив;
	КоличествоСтрок = 0;
	
	Попытка
		КоличествоСтрок = Бух_ЗаписатьФайлОстатков(ИмяФайла, ИменаРегистров, ДатаОстатков, Статистика, Предупреждения);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		Бух_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Бух_УдалитьВременныйФайл(ИмяФайла);
	
	Сообщение = "Выгружено строк остатков: " + Бух_ФорматЧисла(КоличествоСтрок) + "."
		+ Символы.ПС + "Дата остатков: " + Бух_ТекстДатыОстатков(ДатаОстатков) + "."
		+ Символы.ПС + "Регистров в файле: " + Бух_ФорматЧисла(Статистика.Количество()) + ".";
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = "Выгрузка завершена с ошибками." + Символы.ПС + Сообщение
			+ Символы.ПС + Бух_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Бух_СравнитьОстатки(АдресФайла, ДатаОстатков, ИменаРегистров) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры бухгалтерии.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		ВызватьИсключение "Укажите дату остатков.";
	КонецЕсли;
	
	Бух_ИнициализироватьКэшТипов();
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл сравнения остатков.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ИмяФайла);
	
	Попытка
		КэшФайла = Бух_ПрочитатьФайлОстатков(ИмяФайла, ИменаРегистров);
	Исключение
		Бух_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Бух_УдалитьВременныйФайл(ИмяФайла);
	
	Отличия = Бух_НоваяТаблицаОтличийОстатков();
	Статистика = Бух_НоваяСтатистика();
	Предупреждения = КэшФайла.Предупреждения;
	Счетчик = Новый Структура("Всего, Обрезано", 0, Ложь);
	
	Если Бух_ДатаВАтрибут(ДатаОстатков) <> Бух_ДатаВАтрибут(КэшФайла.ДатаОстатков) Тогда
		Предупреждения.Добавить("Дата остатков на форме (" + Бух_ТекстДатыОстатков(ДатаОстатков)
			+ ") отличается от даты файла (" + Бух_ТекстДатыОстатков(КэшФайла.ДатаОстатков)
			+ "). Остатки этой базы рассчитаны на дату формы.");
	КонецЕсли;
	
	Если КэшФайла.Конфигурация <> "" И КэшФайла.Конфигурация <> Метаданные.Имя Тогда
		Предупреждения.Добавить("Файл выгружен из конфигурации """ + КэшФайла.Конфигурация
			+ """, текущая конфигурация """ + Метаданные.Имя + """.");
	КонецЕсли;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Бух_СравнитьОстаткиРегистра(ИмяРегистра, ДатаОстатков, КэшФайла, Отличия, Статистика, Предупреждения, Счетчик);
	КонецЦикла;
	
	Отличия.Сортировать("Регистр, Измерения, ИмяПоля");
	
	ВсегоВБазе = 0;
	ВсегоВФайле = 0;
	ТолькоВБазе = 0;
	ТолькоВФайле = 0;
	Расхождений = 0;
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		ВсегоВБазе = ВсегоВБазе + СтрокаСтатистики.ЗаписейВБазе;
		ВсегоВФайле = ВсегоВФайле + СтрокаСтатистики.ЗаписейВФайле;
		ТолькоВБазе = ТолькоВБазе + СтрокаСтатистики.ТолькоВБазе;
		ТолькоВФайле = ТолькоВФайле + СтрокаСтатистики.ТолькоВФайле;
		Расхождений = Расхождений + СтрокаСтатистики.Расхождений;
	КонецЦикла;
	
	Сообщение = "Дата остатков: " + Бух_ТекстДатыОстатков(ДатаОстатков) + "."
		+ Символы.ПС + "Дата файла: " + Бух_ТекстДатыОстатков(КэшФайла.ДатаОстатков) + "."
		+ Символы.ПС + "Строк остатков в этой базе: " + Бух_ФорматЧисла(ВсегоВБазе) + ", в файле: " + Бух_ФорматЧисла(ВсегоВФайле) + "."
		+ Символы.ПС + "Только в этой базе: " + Бух_ФорматЧисла(ТолькоВБазе)
		+ ", только в файле: " + Бух_ФорматЧисла(ТолькоВФайле)
		+ ", расхождений по колонкам: " + Бух_ФорматЧисла(Расхождений) + ".";
	
	Если Счетчик.Всего = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Отличий не найдено.";
	КонецЕсли;
	
	Если Счетчик.Обрезано Тогда
		Сообщение = Сообщение + Символы.ПС + "В таблицу выведены первые " + Бух_ФорматЧисла(Бух_МаксимальноеКоличествоСтрокРезультата())
			+ " строк отличий из " + Бух_ФорматЧисла(Счетчик.Всего) + ".";
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + Бух_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отличия", Отличия);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Бух_ЗаписатьФайлОстатков(ИмяФайла, ИменаРегистров, ДатаОстатков, Статистика, Предупреждения)
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьКомментарий("Остатки на конец дня. Ключ строки: счет, субконто и балансовые измерения. Ссылки: тип XML и UUID.");
	Запись.ЗаписатьНачалоЭлемента("AccountingRegisterBalanceComparison");
	Запись.ЗаписатьАтрибут("formatVersion", "1");
	Запись.ЗаписатьАтрибут("configuration", Метаданные.Имя);
	Запись.ЗаписатьАтрибут("configurationVersion", Метаданные.Версия);
	Запись.ЗаписатьАтрибут("exportedAt", XMLСтрока(ТекущаяДата()));
	Запись.ЗаписатьАтрибут("balanceDate", Бух_ДатаВАтрибут(ДатаОстатков));
	
	КоличествоСтрок = 0;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		
		Попытка
			Описание = Бух_ОписаниеОстатков(ИмяРегистра);
			Выборка = Бух_ВыбратьОстатки(Описание, ДатаОстатков);
		Исключение
			ТекстОшибки = Бух_КраткийТекстОшибки(ОписаниеОшибки());
			Бух_ЗаписатьОшибку(Запись, ИмяРегистра, ТекстОшибки);
			Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			Бух_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
			Продолжить;
		КонецПопытки;
		
		КоличествоРегистра = Бух_ЗаписатьОстаткиРегистра(Запись, Описание, Выборка, Предупреждения);
		КоличествоСтрок = КоличествоСтрок + КоличествоРегистра;
		Бух_ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, КоличествоРегистра, 0, 0, 0, 0);
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	
	Возврат КоличествоСтрок;
	
КонецФункции

Функция Бух_ОписаниеОстатков(ИмяРегистра)
	
	Мета = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		ВызватьИсключение "Регистр бухгалтерии """ + ИмяРегистра + """ не найден в конфигурации.";
	КонецЕсли;
	
	Поля = Новый Массив;
	Измерения = Новый Массив;
	
	Бух_ДобавитьПоле(Поля, "Счет", "Счет");
	Бух_ДобавитьПоле(Измерения, "Счет", "Счет");
	
	КоличествоСубконто = Бух_МаксимальноеКоличествоСубконто(Мета);
	Для Номер = 1 По КоличествоСубконто Цикл
		ИмяСубконто = "Субконто" + Бух_ФорматЧисла(Номер);
		Бух_ДобавитьПоле(Поля, ИмяСубконто, "Субконто");
		Бух_ДобавитьПоле(Измерения, ИмяСубконто, "Субконто");
	КонецЦикла;
	
	Для Каждого Измерение Из Мета.Измерения Цикл
		Если Измерение.Балансовый Тогда
			Бух_ДобавитьПоле(Поля, Измерение.Имя, "Измерение");
			Бух_ДобавитьПоле(Измерения, Измерение.Имя, "Измерение");
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Ресурс Из Мета.Ресурсы Цикл
		Бух_ДобавитьПоле(Поля, Ресурс.Имя + "Остаток", "Ресурс");
		Бух_ДобавитьПоле(Поля, Ресурс.Имя + "ОстатокДт", "Ресурс");
		Бух_ДобавитьПоле(Поля, Ресурс.Имя + "ОстатокКт", "Ресурс");
		Бух_ДобавитьПоле(Поля, Ресурс.Имя + "РазвернутыйОстатокДт", "Ресурс");
		Бух_ДобавитьПоле(Поля, Ресурс.Имя + "РазвернутыйОстатокКт", "Ресурс");
	КонецЦикла;
	
	Если Поля.Количество() = 0 Тогда
		ВызватьИсключение "У регистра """ + ИмяРегистра + """ нет колонок остатка.";
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Синоним", Бух_СинонимМетаданных(Мета));
	Описание.Вставить("Поля", Поля);
	Описание.Вставить("Измерения", Измерения);
	Возврат Описание;
	
КонецФункции

Функция Бух_ВыбратьОстатки(Описание, ДатаОстатков)
	
	Запрос = Новый Запрос;
	Запрос.Текст = Бух_ТекстЗапросаОстатков(Описание);
	Запрос.УстановитьПараметр("Момент", Бух_МоментОстатков(ДатаОстатков));
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция Бух_ТекстЗапросаОстатков(Описание)
	
	ЧастиПолей = Новый Массив;
	Для Каждого Поле Из Описание.Поля Цикл
		ЧастиПолей.Добавить("Остатки." + Поле.Имя + " КАК " + Поле.Имя);
	КонецЦикла;
	
	Текст = "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + Бух_СоединитьСтроки(ЧастиПолей, "," + Символы.ПС + Символы.Таб)
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + "РегистрБухгалтерии." + Описание.Имя + ".Остатки(&Момент, , , ) КАК Остатки";
	
	Если Описание.Измерения.Количество() > 0 Тогда
		ЧастиПорядка = Новый Массив;
		Для Каждого Поле Из Описание.Измерения Цикл
			ЧастиПорядка.Добавить("Остатки." + Поле.Имя);
		КонецЦикла;
		Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО"
			+ Символы.ПС + Символы.Таб + Бух_СоединитьСтроки(ЧастиПорядка, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция Бух_МоментОстатков(ДатаОстатков)
	
	Возврат Новый Граница(КонецДня(ДатаОстатков), ВидГраницы.Включая);
	
КонецФункции

Функция Бух_ЗаписатьОстаткиРегистра(Запись, Описание, Выборка, Предупреждения)
	
	Запись.ЗаписатьНачалоЭлемента("Register");
	Запись.ЗаписатьАтрибут("name", Описание.Имя);
	Запись.ЗаписатьАтрибут("synonym", Бух_ТекстXML(Описание.Синоним));
	
	Ключи = Новый Соответствие;
	Количество = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Ключ = Бух_КлючОстатка(Выборка, Описание.Измерения);
		Если Ключи.Получить(Ключ) <> Неопределено Тогда
			Предупреждения.Добавить(Описание.Имя + ": повторяющаяся строка остатка, в файл записана первая.");
			Продолжить;
		КонецЕсли;
		
		Ключи.Вставить(Ключ, Истина);
		Бух_ЗаписатьСтрокуОстатка(Запись, Выборка, Описание, Ключ);
		Количество = Количество + 1;
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Возврат Количество;
	
КонецФункции

Процедура Бух_ЗаписатьСтрокуОстатка(Запись, Выборка, Описание, Ключ)
	
	Запись.ЗаписатьНачалоЭлемента("Record");
	Запись.ЗаписатьАтрибут("key", Ключ);
	Запись.ЗаписатьАтрибут("dimensions", Бух_ПредставлениеИзмеренийВыборки(Выборка, Описание.Измерения));
	
	Для Каждого Поле Из Описание.Поля Цикл
		Значение = Выборка[Поле.Имя];
		Запись.ЗаписатьНачалоЭлемента("Field");
		Запись.ЗаписатьАтрибут("name", Поле.Имя);
		Запись.ЗаписатьАтрибут("role", Поле.Роль);
		Запись.ЗаписатьАтрибут("canonical", Бух_КаноническоеЗначение(Значение));
		Запись.ЗаписатьАтрибут("presentation", Бух_ПредставлениеЗначения(Значение));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция Бух_КлючОстатка(Выборка, Измерения)
	
	Части = Новый Массив;
	Для Каждого Поле Из Измерения Цикл
		Канон = Бух_КаноническоеЗначение(Выборка[Поле.Имя]);
		Части.Добавить(Бух_ФорматЧисла(СтрДлина(Канон)) + ":" + Канон);
	КонецЦикла;
	
	Возврат Бух_СоединитьСтроки(Части, ";");
	
КонецФункции

Функция Бух_ПредставлениеИзмеренийВыборки(Выборка, Измерения)
	
	Если Измерения.Количество() = 0 Тогда
		Возврат "(без измерений)";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого Поле Из Измерения Цикл
		Части.Добавить(Поле.Имя + " = " + Бух_ПредставлениеЗначения(Выборка[Поле.Имя]));
	КонецЦикла;
	
	Возврат Бух_СоединитьСтроки(Части, "; ");
	
КонецФункции

Функция Бух_ПрочитатьФайлОстатков(ИмяФайла, ИменаРегистров)
	
	Выбранные = Новый Соответствие;
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Выбранные.Вставить(ИмяРегистра, Истина);
	КонецЦикла;
	
	Кэш = Новый Структура;
	Кэш.Вставить("ВерсияФормата", "");
	Кэш.Вставить("Конфигурация", "");
	Кэш.Вставить("ВерсияКонфигурации", "");
	Кэш.Вставить("ДатаОстатков", '00010101');
	Кэш.Вставить("Регистры", Новый Соответствие);
	Кэш.Вставить("Ошибки", Новый Соответствие);
	Кэш.Вставить("Виденные", Новый Соответствие);
	Кэш.Вставить("Предупреждения", Новый Массив);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ТекущиеЗаписи = Неопределено;
	ТекущаяЗапись = Неопределено;
	ТекущийРегистр = "";
	ЧитатьЗаписи = Ложь;
	КореньНайден = Ложь;
	
	Попытка
		
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Record" Тогда
			Бух_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ТекущийРегистр, Кэш.Предупреждения);
			ТекущаяЗапись = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = Чтение.Имя;
		
		Если ИмяУзла = "AccountingRegisterBalanceComparison" Тогда
			
			КореньНайден = Истина;
			Кэш.ВерсияФормата = Бух_Атрибут(Чтение, "formatVersion");
			Если Кэш.ВерсияФормата <> "1" Тогда
				ВызватьИсключение "Неподдерживаемая версия файла остатков: " + Кэш.ВерсияФормата + ".";
			КонецЕсли;
			Кэш.Конфигурация = Бух_Атрибут(Чтение, "configuration");
			Кэш.ВерсияКонфигурации = Бух_Атрибут(Чтение, "configurationVersion");
			Кэш.ДатаОстатков = Бух_ДатаИзАтрибута(Бух_Атрибут(Чтение, "balanceDate"));
			
		ИначеЕсли ИмяУзла = "AccountingRegisterComparison" Тогда
			
			ВызватьИсключение "Этот файл содержит записи регистров бухгалтерии за период, а не остатки на дату.";
			
		ИначеЕсли ИмяУзла = "AccumulationRegisterComparison" Или ИмяУзла = "AccumulationRegisterBalanceComparison" Тогда
			
			ВызватьИсключение "Этот файл выгружен обработкой сравнения регистров накопления.";
			
		ИначеЕсли ИмяУзла = "Register" Тогда
			
			Бух_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ТекущийРегистр, Кэш.Предупреждения);
			ТекущаяЗапись = Неопределено;
			ТекущийРегистр = Бух_Атрибут(Чтение, "name");
			Кэш.Виденные.Вставить(ТекущийРегистр, Истина);
			ЧитатьЗаписи = Выбранные.Получить(ТекущийРегистр) <> Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущиеЗаписи = Новый Соответствие;
				Кэш.Регистры.Вставить(ТекущийРегистр, ТекущиеЗаписи);
			Иначе
				ТекущиеЗаписи = Неопределено;
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Record" Тогда
			
			Бух_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ТекущийРегистр, Кэш.Предупреждения);
			ТекущаяЗапись = Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущаяЗапись = Бух_НоваяЗаписьОстатка(Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Field" Тогда
			
			Если ТекущаяЗапись <> Неопределено Тогда
				ИмяПоля = Бух_Атрибут(Чтение, "name");
				Поле = Новый Структура("Канон, Представление", Бух_НормализоватьКанон(Бух_Атрибут(Чтение, "canonical")), Бух_Атрибут(Чтение, "presentation"));
				ТекущаяЗапись.Поля.Вставить(ИмяПоля, Поле);
				ТекущаяЗапись.ПорядокПолей.Добавить(ИмяПоля);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Error" Тогда
			
			ИмяРегистра = Бух_Атрибут(Чтение, "register");
			ТекстОшибки = Бух_Атрибут(Чтение, "text");
			Кэш.Виденные.Вставить(ИмяРегистра, Истина);
			Кэш.Ошибки.Вставить(ИмяРегистра, ТекстОшибки);
			Кэш.Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Бух_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ТекущийРегистр, Кэш.Предупреждения);
	Чтение.Закрыть();
	
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если Не КореньНайден Тогда
		ВызватьИсключение "Файл не является выгрузкой остатков регистров бухгалтерии.";
	КонецЕсли;
	
	Возврат Кэш;
	
КонецФункции

Функция Бух_НоваяЗаписьОстатка(Чтение)
	
	ЗаписьФайла = Новый Структура;
	ЗаписьФайла.Вставить("Ключ", Бух_НормализоватьКлючОстатка(Бух_Атрибут(Чтение, "key")));
	ЗаписьФайла.Вставить("Измерения", Бух_Атрибут(Чтение, "dimensions"));
	ЗаписьФайла.Вставить("Поля", Новый Соответствие);
	ЗаписьФайла.Вставить("ПорядокПолей", Новый Массив);
	Возврат ЗаписьФайла;
	
КонецФункции

Процедура Бух_ЗафиксироватьОстаток(ТекущиеЗаписи, ТекущаяЗапись, ИмяРегистра, Предупреждения)
	
	Если ТекущаяЗапись = Неопределено Или ТекущиеЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеЗаписи.Получить(ТекущаяЗапись.Ключ) <> Неопределено Тогда
		Предупреждения.Добавить(ИмяРегистра + ": повторяющаяся строка остатка в файле, оставлена первая.");
		Возврат;
	КонецЕсли;
	
	ТекущиеЗаписи.Вставить(ТекущаяЗапись.Ключ, ТекущаяЗапись);
	
КонецПроцедуры

Процедура Бух_СравнитьОстаткиРегистра(ИмяРегистра, ДатаОстатков, КэшФайла, Отличия, Статистика, Предупреждения, Счетчик)
	
	ТекстОшибкиФайла = КэшФайла.Ошибки.Получить(ИмяРегистра);
	Если ТекстОшибкиФайла <> Неопределено Тогда
		Бух_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
		Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, ИмяРегистра, "Ошибка", "", "(выгрузка)", "", ТекстОшибкиФайла);
		Возврат;
	КонецЕсли;
	
	Если КэшФайла.Виденные.Получить(ИмяРегистра) = Неопределено Тогда
		Предупреждения.Добавить(ИмяРегистра + ": регистр отсутствует в файле выгрузки. Строки файла приняты пустыми.");
	КонецЕсли;
	
	ЗаписиФайла = КэшФайла.Регистры.Получить(ИмяРегистра);
	Если ЗаписиФайла = Неопределено Тогда
		ЗаписиФайла = Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Описание = Бух_ОписаниеОстатков(ИмяРегистра);
	Исключение
		ТекстОшибки = Бух_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
		Бух_ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, ЗаписиФайла.Количество(), 0, 0, 0);
		Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, ИмяРегистра, "Ошибка", "", "(метаданные)", "", ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	СтрокаСтатистики = Бух_ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, 0, ЗаписиФайла.Количество(), 0, 0, 0);
	ИменаПолейБазы = Новый Соответствие;
	Для Каждого Поле Из Описание.Поля Цикл
		ИменаПолейБазы.Вставить(Поле.Имя, Истина);
	КонецЦикла;
	
	Попытка
		Выборка = Бух_ВыбратьОстатки(Описание, ДатаОстатков);
	Исключение
		ТекстОшибки = Бух_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(Описание.Имя + ": " + ТекстОшибки);
		Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Ошибка", "", "(запрос)", "", ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	КоличествоБазы = 0;
	ВиденныеКлючи = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Ключ = Бух_КлючОстатка(Выборка, Описание.Измерения);
		ПредставлениеИзмерений = Бух_ПредставлениеИзмеренийВыборки(Выборка, Описание.Измерения);
		
		Если ВиденныеКлючи.Получить(Ключ) <> Неопределено Тогда
			Предупреждения.Добавить(Описание.Имя + ": повторяющаяся строка остатка в этой базе.");
			Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Ошибка", ПредставлениеИзмерений, "(ключ)", ПредставлениеИзмерений, "");
			Продолжить;
		КонецЕсли;
		ВиденныеКлючи.Вставить(Ключ, Истина);
		
		КоличествоБазы = КоличествоБазы + 1;
		ЗаписьФайла = ЗаписиФайла.Получить(Ключ);
		
		Если ЗаписьФайла = Неопределено Тогда
			СтрокаСтатистики.ТолькоВБазе = СтрокаСтатистики.ТолькоВБазе + 1;
			Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Только в этой базе", ПредставлениеИзмерений,
				"(вся строка)", Бух_ПредставлениеВыборки(Выборка, Описание.Поля), "");
			Продолжить;
		КонецЕсли;
		
		Для Каждого Поле Из Описание.Поля Цикл
			КанонБазы = Бух_КаноническоеЗначение(Выборка[Поле.Имя]);
			ПолеФайла = ЗаписьФайла.Поля.Получить(Поле.Имя);
			Если ПолеФайла = Неопределено Тогда
				КанонФайла = "<нет поля>";
				ПредставлениеФайла = "";
			Иначе
				КанонФайла = ПолеФайла.Канон;
				ПредставлениеФайла = ПолеФайла.Представление;
			КонецЕсли;
			
			Если Бух_НормализоватьКанон(КанонБазы) <> Бух_НормализоватьКанон(КанонФайла) Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Расхождение", ПредставлениеИзмерений,
					Поле.Имя, Бух_ПредставлениеЗначения(Выборка[Поле.Имя]), ПредставлениеФайла);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлементПоля Из ЗаписьФайла.Поля Цикл
			Если ИменаПолейБазы.Получить(ЭлементПоля.Ключ) = Неопределено Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Расхождение", ПредставлениеИзмерений,
					ЭлементПоля.Ключ, "", ЭлементПоля.Значение.Представление);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписиФайла.Удалить(Ключ);
		
	КонецЦикла;
	
	СтрокаСтатистики.ЗаписейВБазе = КоличествоБазы;
	
	Для Каждого ЭлементЗаписи Из ЗаписиФайла Цикл
		ЗаписьФайла = ЭлементЗаписи.Значение;
		СтрокаСтатистики.ТолькоВФайле = СтрокаСтатистики.ТолькоВФайле + 1;
		Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, Описание.Имя, "Только в файле", ЗаписьФайла.Измерения,
			"(вся строка)", "", Бух_ПредставлениеЗаписиФайла(ЗаписьФайла));
	КонецЦикла;
	
КонецПроцедуры

Функция Бух_НоваяТаблицаОтличийОстатков()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Регистр", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ВидОтличия", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Измерения", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВБазе", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
	
КонецФункции

Процедура Бух_ДобавитьОтличиеОстатка(Отличия, Счетчик, Регистр, ВидОтличия, Измерения, ИмяПоля, ЗначениеВБазе, ЗначениеВФайле)
	
	Счетчик.Всего = Счетчик.Всего + 1;
	Если Отличия.Количество() >= Бух_МаксимальноеКоличествоСтрокРезультата() Тогда
		Счетчик.Обрезано = Истина;
		Возврат;
	КонецЕсли;
	
	СтрокаОтличия = Отличия.Добавить();
	СтрокаОтличия.Регистр = Регистр;
	СтрокаОтличия.ВидОтличия = ВидОтличия;
	СтрокаОтличия.Измерения = Измерения;
	СтрокаОтличия.ИмяПоля = ИмяПоля;
	СтрокаОтличия.ЗначениеВБазе = ЗначениеВБазе;
	СтрокаОтличия.ЗначениеВФайле = ЗначениеВФайле;
	
КонецПроцедуры

Функция Бух_ТекстДатыОстатков(ДатаОстатков)
	
	Если Не ЗначениеЗаполнено(ДатаОстатков) Тогда
		Возврат "не задана";
	КонецЕсли;
	
	Возврат Формат(ДатаОстатков, "ДЛФ=D") + ", конец дня";
	
КонецФункции

// --- Сравнение ссылочных объектов ---
// Сравнение ссылочных объектов двух баз УТ 10.3 и трех ранее выгруженных файлов.
// В одной базе выбранные объекты выгружаются в XML, во второй сравниваются с этим файлом.
// Три файла сравниваются между собой по порядку: файл 1, файл 2, файл 3.
// Ключ объекта — UUID ссылки. Сравнивается каждая колонка шапки и каждая колонка строки табличной части.
// Отчет — дерево: строка объекта, под ней различия по колонкам.
// Ссылки сравниваются по типу XML и UUID. Период ограничивает только документы.
// Переводы строк и табуляция в строках записываются как #x10#, #x13# и #x9#: в атрибуте XML они иначе читаются как пробел.
// Отбор с пустым объектом применяется ко всем выбранным типам, у которых есть такое поле.
//
// Код рассчитан на режим совместимости 8.2.13.


Функция Ссыл_Выгрузить(ПолныеИмена, Отборы, НачалоПериода, КонецПериода) Экспорт
	
	Если ПолныеИмена.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны ссылочные объекты.";
	КонецЕсли;
	
	Если Отборы = Неопределено Тогда
		Отборы = Новый Массив;
	КонецЕсли;
	
	Ссыл_ИнициализироватьКэшТипов();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Статистика = Ссыл_НоваяСтатистика();
	Предупреждения = Новый Массив;
	КоличествоОбъектов = 0;
	
	Попытка
		КоличествоОбъектов = Ссыл_ЗаписатьФайлВыгрузки(ИмяФайла, ПолныеИмена, Отборы, НачалоПериода, КонецПериода, Статистика, Предупреждения);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		Ссыл_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Ссыл_УдалитьВременныйФайл(ИмяФайла);
	
	Сообщение = "Выгружено объектов: " + Ссыл_ФорматЧисла(КоличествоОбъектов) + "."
		+ Символы.ПС + "Период документов: " + Ссыл_ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Типов в файле: " + Ссыл_ФорматЧисла(Статистика.Количество()) + "."
		+ Символы.ПС + "Отборов: " + Ссыл_ФорматЧисла(Ссыл_КоличествоЗаданныхОтборов(Отборы)) + "."
		+ Символы.ПС + "Данные этой базы не изменялись.";
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = "Выгрузка завершена с ошибками." + Символы.ПС + Сообщение
			+ Символы.ПС + Ссыл_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Ссыл_Сравнить(АдресФайла, ПолныеИмена, Отборы, НачалоПериода, КонецПериода) Экспорт
	
	Если ПолныеИмена.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны ссылочные объекты.";
	КонецЕсли;
	
	Если Отборы = Неопределено Тогда
		Отборы = Новый Массив;
	КонецЕсли;
	
	Ссыл_ИнициализироватьКэшТипов();
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл сравнения.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ИмяФайла);
	
	Попытка
		КэшФайла = Ссыл_ПрочитатьФайлВыгрузки(ИмяФайла, ПолныеИмена);
	Исключение
		Ссыл_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Ссыл_УдалитьВременныйФайл(ИмяФайла);
	
	Отличия = Ссыл_НоваяТаблицаОтличий();
	Статистика = Ссыл_НоваяСтатистика();
	Предупреждения = КэшФайла.Предупреждения;
	Обрезано = Ложь;
	ВсегоОтличий = 0;
	
	Если Ссыл_ДатаВАтрибут(НачалоПериода) <> Ссыл_ДатаВАтрибут(КэшФайла.ПериодНачало)
		Или Ссыл_ДатаВАтрибут(КонецПериода) <> Ссыл_ДатаВАтрибут(КэшФайла.ПериодКонец) Тогда
		Предупреждения.Добавить("Период документов на форме (" + Ссыл_ТекстПериодаСравнения(НачалоПериода, КонецПериода)
			+ ") отличается от периода файла (" + Ссыл_ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец)
			+ "). Объекты этой базы отобраны по периоду формы.");
	КонецЕсли;
	
	ТекстОтбораФормы = Ссыл_ТекстXML(Ссыл_ТекстОтборов(Отборы));
	Если ТекстОтбораФормы <> КэшФайла.ТекстОтборов Тогда
		Предупреждения.Добавить("Отборы на форме отличаются от отборов файла. Объекты этой базы отобраны по отборам формы.");
	КонецЕсли;
	
	Если КэшФайла.Конфигурация <> "" И КэшФайла.Конфигурация <> Метаданные.Имя Тогда
		Предупреждения.Добавить("Файл выгружен из конфигурации """ + КэшФайла.Конфигурация
			+ """, текущая конфигурация """ + Метаданные.Имя + """.");
	КонецЕсли;
	
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Ссыл_СравнитьОбъектМетаданных(ПолноеИмя, Отборы, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано);
	КонецЦикла;
	
	Отличия.Сортировать("Объект, Ссылка, ИмяПоля");
	ДеревоОтличий = Ссыл_ДеревоДвухСторон(Отличия);
	
	ВсегоВБазе = 0;
	ВсегоВФайле = 0;
	ТолькоВБазе = 0;
	ТолькоВФайле = 0;
	Расхождений = 0;
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		ВсегоВБазе = ВсегоВБазе + СтрокаСтатистики.ЗаписейВБазе;
		ВсегоВФайле = ВсегоВФайле + СтрокаСтатистики.ЗаписейВФайле;
		ТолькоВБазе = ТолькоВБазе + СтрокаСтатистики.ТолькоВБазе;
		ТолькоВФайле = ТолькоВФайле + СтрокаСтатистики.ТолькоВФайле;
		Расхождений = Расхождений + СтрокаСтатистики.Расхождений;
	КонецЦикла;
	
	Сообщение = "Период документов: " + Ссыл_ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Период файла: " + Ссыл_ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец) + "."
		+ Символы.ПС + "Объектов в этой базе: " + Ссыл_ФорматЧисла(ВсегоВБазе) + ", в файле: " + Ссыл_ФорматЧисла(ВсегоВФайле) + "."
		+ Символы.ПС + "Только в этой базе: " + Ссыл_ФорматЧисла(ТолькоВБазе)
		+ ", только в файле: " + Ссыл_ФорматЧисла(ТолькоВФайле)
		+ ", расхождений по колонкам: " + Ссыл_ФорматЧисла(Расхождений) + ".";
	
	Если ВсегоОтличий = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Отличий не найдено.";
	КонецЕсли;
	
	Если Обрезано Тогда
		Сообщение = Сообщение + Символы.ПС + "В таблицу выведены первые " + Ссыл_ФорматЧисла(Ссыл_МаксимальноеКоличествоСтрокРезультата())
			+ " строк отличий из " + Ссыл_ФорматЧисла(ВсегоОтличий) + ".";
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + Ссыл_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отличия", ДеревоОтличий);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Ссыл_СравнитьТриФайла(АдресФайла1, АдресФайла2, АдресФайла3, ПолныеИмена) Экспорт
	
	Если ПолныеИмена = Неопределено Тогда
		ПолныеИмена = Новый Массив;
	КонецЕсли;
	
	Ссыл_ИнициализироватьКэшТипов();
	
	Кэш1 = Ссыл_КэшИзАдреса(АдресФайла1, ПолныеИмена);
	Кэш2 = Ссыл_КэшИзАдреса(АдресФайла2, ПолныеИмена);
	Кэш3 = Ссыл_КэшИзАдреса(АдресФайла3, ПолныеИмена);
	
	Имена = Ссыл_ИменаМетаданныхТрехФайлов(ПолныеИмена, Кэш1, Кэш2, Кэш3);
	Дерево = Ссыл_НовоеДеревоОтличий();
	Статистика = Ссыл_НоваяСтатистика();
	Предупреждения = Новый Массив;
	Ссыл_ДобавитьПредупрежденияТрехФайлов(Кэш1, Кэш2, Кэш3, Предупреждения);
	Ссыл_ДобавитьПредупрежденияКэша(Предупреждения, "Файл 1", Кэш1);
	Ссыл_ДобавитьПредупрежденияКэша(Предупреждения, "Файл 2", Кэш2);
	Ссыл_ДобавитьПредупрежденияКэша(Предупреждения, "Файл 3", Кэш3);
	
	Счетчик = Новый Структура("Строк, Всего, Обрезано", 0, 0, Ложь);
	Итоги = Новый Структура("ОдинРаз, ДваРаза, БезОтличий, ВФайле1, ВФайле2, ВФайле3", 0, 0, 0, 0, 0, 0);
	
	Для Каждого ПолноеИмя Из Имена Цикл
		Ссыл_СравнитьТипТрехФайлов(ПолноеИмя, Кэш1, Кэш2, Кэш3, Дерево, Статистика, Предупреждения, Счетчик, Итоги);
	КонецЦикла;
	
	Дерево.Строки.Сортировать("Объект, Представление");
	
	Сообщение = "Сравнение трех файлов по порядку: файл 1, файл 2, файл 3."
		+ Символы.ПС + "Объектов в файле 1: " + Ссыл_ФорматЧисла(Итоги.ВФайле1)
		+ ", в файле 2: " + Ссыл_ФорматЧисла(Итоги.ВФайле2)
		+ ", в файле 3: " + Ссыл_ФорматЧисла(Итоги.ВФайле3) + "."
		+ Символы.ПС + "Изменено один раз: " + Ссыл_ФорматЧисла(Итоги.ОдинРаз)
		+ ", два раза: " + Ссыл_ФорматЧисла(Итоги.ДваРаза)
		+ ", без отличий: " + Ссыл_ФорматЧисла(Итоги.БезОтличий) + "."
		+ Символы.ПС + "Число изменений считается по соседним файлам: от файла 1 к файлу 2 и от файла 2 к файлу 3."
		+ Символы.ПС + "Строка отчета — объект. Раскройте ее, чтобы увидеть колонки, значения в трех файлах и где значение изменилось.";
	
	Если Итоги.ОдинРаз + Итоги.ДваРаза = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Отличий не найдено.";
	КонецЕсли;
	
	Если Счетчик.Обрезано Тогда
		Сообщение = Сообщение + Символы.ПС + "В таблицу выведены первые " + Ссыл_ФорматЧисла(Ссыл_МаксимальноеКоличествоСтрокРезультата())
			+ " строк из " + Ссыл_ФорматЧисла(Счетчик.Всего) + ".";
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + Ссыл_ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отличия", Дерево);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Ссыл_ТаблицаМетаданных() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Синоним", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЕстьВБазе", Новый ОписаниеТипов("Булево"));
	
	Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Метаданные.Справочники, "Справочник");
	Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Метаданные.Документы, "Документ");
	Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик");
	Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Метаданные.ПланыСчетов, "ПланСчетов");
	Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Метаданные.ПланыВидовРасчета, "ПланВидовРасчета");
	Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Метаданные.ПланыОбмена, "ПланОбмена");
	Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Метаданные.БизнесПроцессы, "БизнесПроцесс");
	Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Метаданные.Задачи, "Задача");
	
	Таблица.Сортировать("Вид, Имя");
	Возврат Таблица;
	
КонецФункции

Функция Ссыл_ИменаПолейОтбора(ПолноеИмя) Экспорт
	
	Ссыл_ИнициализироватьКэшТипов();
	Описание = Ссыл_ОписаниеОбъекта(ПолноеИмя);
	Имена = Новый Массив;
	
	Для Каждого Поле Из Описание.Поля Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
		Для Каждого Поле Из ТабличнаяЧасть.Поля Цикл
			Имена.Добавить(ТабличнаяЧасть.Имя + "." + Поле.Имя);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

Функция Ссыл_ЗаписатьФайлВыгрузки(ИмяФайла, ПолныеИмена, Отборы, НачалоПериода, КонецПериода, Статистика, Предупреждения)
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьКомментарий("Ключ объекта: UUID ссылки. Ссылки сравниваются по типу XML и UUID. Строки табличных частей сопоставляются по номеру строки.");
	Запись.ЗаписатьНачалоЭлемента("ReferenceObjectComparison");
	Запись.ЗаписатьАтрибут("formatVersion", "1");
	Запись.ЗаписатьАтрибут("configuration", Метаданные.Имя);
	Запись.ЗаписатьАтрибут("configurationVersion", Метаданные.Версия);
	Запись.ЗаписатьАтрибут("exportedAt", XMLСтрока(ТекущаяДата()));
	Запись.ЗаписатьАтрибут("periodFrom", Ссыл_ДатаВАтрибут(НачалоПериода));
	Запись.ЗаписатьАтрибут("periodTo", Ссыл_ДатаВАтрибут(КонецПериода));
	Запись.ЗаписатьАтрибут("filterText", Ссыл_ТекстXML(Ссыл_ТекстОтборов(Отборы)));
	
	Ссыл_ПредупредитьОНевыбранныхОтборах(ПолныеИмена, Отборы, Предупреждения);
	
	КоличествоОбъектов = 0;
	
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		
		Попытка
			Описание = Ссыл_ОписаниеОбъекта(ПолноеИмя);
			КоличествоТипа = Ссыл_ЗаписатьОбъектыТипа(Запись, Описание, Отборы, НачалоПериода, КонецПериода);
		Исключение
			ТекстОшибки = Ссыл_КраткийТекстОшибки(ОписаниеОшибки());
			Ссыл_ЗаписатьОшибку(Запись, ПолноеИмя, ТекстОшибки);
			Предупреждения.Добавить(ПолноеИмя + ": " + ТекстОшибки);
			Ссыл_ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, 0, 0, 0, 0, 0);
			Продолжить;
		КонецПопытки;
		
		КоличествоОбъектов = КоличествоОбъектов + КоличествоТипа;
		Ссыл_ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, КоличествоТипа, 0, 0, 0, 0);
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	Возврат КоличествоОбъектов;
	
КонецФункции

Функция Ссыл_ЗаписатьОбъектыТипа(Запись, Описание, Отборы, НачалоПериода, КонецПериода)
	
	Подготовка = Ссыл_ПодготовитьЗапрос(Описание, Отборы, НачалоПериода, КонецПериода);
	СтрокиТабличныхЧастей = Ссыл_ПрочитатьСтрокиТабличныхЧастей(Описание, Подготовка.Запрос, Подготовка.ТекстГде);
	
	Подготовка.Запрос.Текст = Ссыл_ТекстЗапросаШапки(Описание, Подготовка.ТекстГде);
	Выборка = Подготовка.Запрос.Выполнить().Выбрать();
	
	Запись.ЗаписатьНачалоЭлемента("Metadata");
	Запись.ЗаписатьАтрибут("name", Описание.ПолноеИмя);
	Запись.ЗаписатьАтрибут("synonym", Ссыл_ТекстXML(Описание.Синоним));
	
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = XMLСтрока(Выборка.Ссылка);
		Ссыл_ЗаписатьОбъект(Запись, Выборка, Описание, Ключ, СтрокиТабличныхЧастей.Получить(Ключ));
		Количество = Количество + 1;
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Возврат Количество;
	
КонецФункции

Процедура Ссыл_ЗаписатьОбъект(Запись, Выборка, Описание, Ключ, СтрокиОбъекта)
	
	ЗначенияШапки = Ссыл_КартаЗначенийВыборки(Выборка, Описание.Поля);
	Представление = Ссыл_ПредставлениеОбъекта(ЗначенияШапки, Ключ, Описание.Синоним);
	
	Запись.ЗаписатьНачалоЭлемента("Object");
	Запись.ЗаписатьАтрибут("uuid", Ключ);
	Запись.ЗаписатьАтрибут("presentation", Ссыл_ТекстXML(Представление));
	
	Ссыл_ЗаписатьКартуПолей(Запись, Описание.Поля, ЗначенияШапки);
	
	Если СтрокиОбъекта <> Неопределено Тогда
		Для Каждого ЭлементСтроки Из СтрокиОбъекта Цикл
			СтрокаТаблицы = ЭлементСтроки.Значение;
			Запись.ЗаписатьНачалоЭлемента("Row");
			Запись.ЗаписатьАтрибут("table", СтрокаТаблицы.ИмяТаблицы);
			Запись.ЗаписатьАтрибут("line", Ссыл_ФорматЧисла(СтрокаТаблицы.НомерСтроки));
			Ссыл_ЗаписатьКартуПолей(Запись, СтрокаТаблицы.ПорядокПолей, СтрокаТаблицы.Поля);
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
	КонецЕсли;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура Ссыл_ЗаписатьКартуПолей(Запись, ПорядокПолей, КартаПолей)
	
	Для Каждого Поле Из ПорядокПолей Цикл
		ИмяПоля = Ссыл_ИмяЭлементаПорядка(Поле);
		ЗначениеПоля = КартаПолей.Получить(ИмяПоля);
		Если ЗначениеПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьНачалоЭлемента("Field");
		Запись.ЗаписатьАтрибут("name", ИмяПоля);
		Запись.ЗаписатьАтрибут("canonical", ЗначениеПоля.Канон);
		Запись.ЗаписатьАтрибут("presentation", ЗначениеПоля.Представление);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
КонецПроцедуры

Функция Ссыл_ИмяЭлементаПорядка(Поле)
	
	Если ТипЗнч(Поле) = Тип("Строка") Тогда
		Возврат Поле;
	КонецЕсли;
	
	Возврат Поле.Имя;
	
КонецФункции

Функция Ссыл_ПрочитатьСтрокиТабличныхЧастей(Описание, Запрос, Ссыл_ТекстГде)
	
	Результат = Новый Соответствие;
	
	Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
		Запрос.Текст = Ссыл_ТекстЗапросаТабличнойЧасти(Описание, ТабличнаяЧасть, Ссыл_ТекстГде);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			КлючОбъекта = XMLСтрока(Выборка.Ссылка);
			СтрокиОбъекта = Результат.Получить(КлючОбъекта);
			Если СтрокиОбъекта = Неопределено Тогда
				СтрокиОбъекта = Новый Соответствие;
				Результат.Вставить(КлючОбъекта, СтрокиОбъекта);
			КонецЕсли;
			КлючСтроки = ТабличнаяЧасть.Имя + "|" + Ссыл_ФорматЧисла(Выборка.НомерСтроки);
			СтрокаТаблицы = Ссыл_НоваяСтрокаТаблицы(ТабличнаяЧасть.Имя, Выборка.НомерСтроки);
			Ссыл_ЗаполнитьКартуВыборки(Выборка, ТабличнаяЧасть.Поля, СтрокаТаблицы.Поля, СтрокаТаблицы.ПорядокПолей);
			СтрокиОбъекта.Вставить(КлючСтроки, СтрокаТаблицы);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Ссыл_ПодготовитьЗапрос(Описание, Отборы, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Условия = Новый Массив;
	Счетчик = Новый Структура("Номер", 0);
	ОтборыОбъекта = Ссыл_ОтборыЭтогоОбъекта(Описание, Отборы);
	
	Для Каждого Отбор Из ОтборыОбъекта Цикл
		Условия.Добавить(Ссыл_ТекстУсловияОтбора(Описание, Отбор, Запрос, Счетчик));
	КонецЦикла;
	
	Если Описание.Вид = "Документ" Тогда
		Если ЗначениеЗаполнено(НачалоПериода) Тогда
			Условия.Добавить("Объект.Дата >= &НачалоПериода");
		КонецЕсли;
		Если ЗначениеЗаполнено(КонецПериода) Тогда
			Условия.Добавить("Объект.Дата <= &КонецПериода");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("Запрос, ТекстГде", Запрос, Ссыл_ТекстГде(Условия));
	
КонецФункции

Функция Ссыл_ТекстЗапросаШапки(Описание, Ссыл_ТекстГде)
	
	Возврат "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + Ссыл_ТекстПолейВыборки(Описание.Поля, "Объект", "Объект.Ссылка КАК Ссылка")
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + Описание.ПолноеИмя + " КАК Объект"
		+ Ссыл_ТекстГде;
	
КонецФункции

Функция Ссыл_ТекстЗапросаТабличнойЧасти(Описание, ТабличнаяЧасть, Ссыл_ТекстГде)
	
	Возврат "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + Ссыл_ТекстПолейВыборки(ТабличнаяЧасть.Поля, "СтрокаТЧ", "СтрокаТЧ.Ссылка КАК Ссылка")
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + Описание.ПолноеИмя + "." + ТабличнаяЧасть.Имя + " КАК СтрокаТЧ"
		+ Символы.ПС + Символы.Таб + "ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + Описание.ПолноеИмя + " КАК Объект"
		+ Символы.ПС + Символы.Таб + "ПО СтрокаТЧ.Ссылка = Объект.Ссылка"
		+ Ссыл_ТекстГде;
	
КонецФункции

Функция Ссыл_ТекстПолейВыборки(Поля, Префикс, ПервоеПоле)
	
	Части = Новый Массив;
	Части.Добавить(ПервоеПоле);
	Для Каждого Поле Из Поля Цикл
		Части.Добавить(Префикс + "." + Поле.Имя + " КАК " + Поле.Имя);
	КонецЦикла;
	Возврат Ссыл_СоединитьСтроки(Части, "," + Символы.ПС + Символы.Таб);
	
КонецФункции

Функция Ссыл_ТекстГде(Условия)
	
	Если Условия.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб + Ссыл_СоединитьСтроки(Условия, Символы.ПС + Символы.Таб + "И ");
	
КонецФункции

Функция Ссыл_ОписаниеОбъекта(ПолноеИмя)
	
	Мета = Ссыл_МетаданныеПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет объекта " + ПолноеИмя + ".";
	КонецЕсли;
	
	Вид = Ссыл_ВидПоПолномуИмени(ПолноеИмя);
	Синоним = Строка(Мета.Синоним);
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("ПолноеИмя", ПолноеИмя);
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Вид", Вид);
	Описание.Вставить("Синоним", Синоним);
	Описание.Вставить("Поля", Новый Массив);
	Описание.Вставить("ТабличныеЧасти", Новый Массив);
	
	Ссыл_ДобавитьСтандартныеПоля(Мета, Описание);
	
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Ссыл_ДобавитьПоле(Описание.Поля, Реквизит.Имя, "Реквизит", Реквизит.Тип, "");
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из Мета.ТабличныеЧасти Цикл
		Поля = Новый Массив;
		Ссыл_ДобавитьПоле(Поля, "НомерСтроки", "Стандартный", Новый ОписаниеТипов("Число"), "");
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			Ссыл_ДобавитьПоле(Поля, Реквизит.Имя, "Реквизит", Реквизит.Тип, "");
		КонецЦикла;
		Описание.ТабличныеЧасти.Добавить(Новый Структура("Имя, Поля", ТабличнаяЧасть.Имя, Поля));
	КонецЦикла;
	
	Ссыл_ДобавитьСтандартныеТабличныеЧасти(Мета, Описание);
	Возврат Описание;
	
КонецФункции

Процедура Ссыл_ДобавитьСтандартныеПоля(Мета, Описание)
	
	Ссыл_ДобавитьПоле(Описание.Поля, "ПометкаУдаления", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	
	Если Описание.Вид = "Справочник" Или Описание.Вид = "ПланВидовХарактеристик" Тогда
		Ссыл_ДобавитьКодИНаименование(Мета, Описание.Поля);
		Ссыл_ДобавитьПоляИерархии(Мета, Описание);
		Ссыл_ДобавитьПолеВладельца(Мета, Описание.Поля);
		Ссыл_ДобавитьПоле(Описание.Поля, "Предопределенный", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "Документ" Тогда
		Ссыл_ДобавитьПоле(Описание.Поля, "Дата", "Стандартный", Новый ОписаниеТипов("Дата"), "");
		Ссыл_ДобавитьПолеНомера(Мета, Описание.Поля);
		Ссыл_ДобавитьПоле(Описание.Поля, "Проведен", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "ПланСчетов" Тогда
		Ссыл_ДобавитьКодИНаименование(Мета, Описание.Поля);
		Ссыл_ДобавитьПоляИерархии(Мета, Описание);
		Ссыл_ДобавитьПоле(Описание.Поля, "Вид", "Стандартный", Неопределено, "AccountType");
		Ссыл_ДобавитьПоле(Описание.Поля, "Забалансовый", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		Ссыл_ДобавитьПоле(Описание.Поля, "Порядок", "Стандартный", Новый ОписаниеТипов("Строка"), "");
		Ссыл_ДобавитьПоле(Описание.Поля, "Предопределенный", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "ПланВидовРасчета" Тогда
		Ссыл_ДобавитьКодИНаименование(Мета, Описание.Поля);
		Ссыл_ДобавитьПоле(Описание.Поля, "Предопределенный", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "ПланОбмена" Тогда
		Ссыл_ДобавитьКодИНаименование(Мета, Описание.Поля);
		Ссыл_ДобавитьПоле(Описание.Поля, "НомерОтправленного", "Стандартный", Новый ОписаниеТипов("Число"), "");
		Ссыл_ДобавитьПоле(Описание.Поля, "НомерПринятого", "Стандартный", Новый ОписаниеТипов("Число"), "");
		Ссыл_ДобавитьПоле(Описание.Поля, "Предопределенный", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	ИначеЕсли Описание.Вид = "БизнесПроцесс" Тогда
		Ссыл_ДобавитьПоле(Описание.Поля, "Дата", "Стандартный", Новый ОписаниеТипов("Дата"), "");
		Ссыл_ДобавитьПолеНомера(Мета, Описание.Поля);
		Ссыл_ДобавитьПоле(Описание.Поля, "Стартован", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		Ссыл_ДобавитьПоле(Описание.Поля, "Завершен", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		Ссыл_ДобавитьПоле(Описание.Поля, "ВедущаяЗадача", "Стандартный", Неопределено, "");
	ИначеЕсли Описание.Вид = "Задача" Тогда
		Ссыл_ДобавитьПоле(Описание.Поля, "Дата", "Стандартный", Новый ОписаниеТипов("Дата"), "");
		Ссыл_ДобавитьПолеНомера(Мета, Описание.Поля);
		Если Мета.ДлинаНаименования > 0 Тогда
			Ссыл_ДобавитьПоле(Описание.Поля, "Наименование", "Стандартный", Новый ОписаниеТипов("Строка"), "");
		КонецЕсли;
		Ссыл_ДобавитьПоле(Описание.Поля, "Выполнена", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		Ссыл_ДобавитьПоле(Описание.Поля, "БизнесПроцесс", "Стандартный", Неопределено, "");
		Ссыл_ДобавитьПоле(Описание.Поля, "ТочкаМаршрута", "Стандартный", Неопределено, "");
	КонецЕсли;
	
КонецПроцедуры

Процедура Ссыл_ДобавитьПолеНомера(Мета, Поля)
	
	Если Мета.ДлинаНомера = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Мета.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Число Тогда
		Ссыл_ДобавитьПоле(Поля, "Номер", "Стандартный", Новый ОписаниеТипов("Число"), "");
	Иначе
		Ссыл_ДобавитьПоле(Поля, "Номер", "Стандартный", Новый ОписаниеТипов("Строка"), "");
	КонецЕсли;
	
КонецПроцедуры

Процедура Ссыл_ДобавитьКодИНаименование(Мета, Поля)
	
	Если Мета.ДлинаКода > 0 Тогда
		Ссыл_ДобавитьПоле(Поля, "Код", "Стандартный", Новый ОписаниеТипов("Строка"), "");
	КонецЕсли;
	
	Если Мета.ДлинаНаименования > 0 Тогда
		Ссыл_ДобавитьПоле(Поля, "Наименование", "Стандартный", Новый ОписаниеТипов("Строка"), "");
	КонецЕсли;
	
КонецПроцедуры

Процедура Ссыл_ДобавитьПоляИерархии(Мета, Описание)
	
	Если Не Мета.Иерархический Тогда
		Возврат;
	КонецЕсли;
	
	Ссыл_ДобавитьПоле(Описание.Поля, "Родитель", "Стандартный", Ссыл_ТипСсылкиЭтогоОбъекта(Описание), "");
	
	Если Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Ссыл_ДобавитьПоле(Описание.Поля, "ЭтоГруппа", "Стандартный", Новый ОписаниеТипов("Булево"), "");
	КонецЕсли;
	
КонецПроцедуры

Процедура Ссыл_ДобавитьПолеВладельца(Мета, Поля)
	
	Если Мета.Владельцы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Типы = Новый Массив;
	Для Каждого Владелец Из Мета.Владельцы Цикл
		Типы.Добавить(Тип(Ссыл_ИмяТипаСсылкиМетаданных(Владелец)));
	КонецЦикла;
	
	Ссыл_ДобавитьПоле(Поля, "Владелец", "Стандартный", Новый ОписаниеТипов(Типы), "");
	
КонецПроцедуры

Процедура Ссыл_ДобавитьСтандартныеТабличныеЧасти(Мета, Описание)
	
	Если Описание.Вид <> "ПланСчетов" И Описание.Вид <> "ПланВидовРасчета" Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТабличнаяЧасть Из Мета.СтандартныеТабличныеЧасти Цикл
		Поля = Ссыл_ПоляСтандартнойТабличнойЧасти(Мета, ТабличнаяЧасть.Имя);
		Если Поля <> Неопределено Тогда
			Описание.ТабличныеЧасти.Добавить(Новый Структура("Имя, Поля", ТабличнаяЧасть.Имя, Поля));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Ссыл_ПоляСтандартнойТабличнойЧасти(Мета, Имя)
	
	Поля = Новый Массив;
	Ссыл_ДобавитьПоле(Поля, "НомерСтроки", "Стандартный", Новый ОписаниеТипов("Число"), "");
	
	Если Имя = "ВидыСубконто" Тогда
		Если Мета.ВидыСубконто = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Ссыл_ДобавитьПоле(Поля, "ВидСубконто", "Стандартный", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка." + Мета.ВидыСубконто.Имя), "");
		Ссыл_ДобавитьПоле(Поля, "Предопределенное", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		Ссыл_ДобавитьПоле(Поля, "ТолькоОбороты", "Стандартный", Новый ОписаниеТипов("Булево"), "");
		Возврат Поля;
	КонецЕсли;
	
	Если Имя = "БазовыеВидыРасчета" Или Имя = "ВедущиеВидыРасчета" Или Имя = "ВытесняющиеВидыРасчета" Тогда
		Ссыл_ДобавитьПоле(Поля, "ВидРасчета", "Стандартный", Новый ОписаниеТипов("ПланВидовРасчетаСсылка." + Мета.Имя), "");
		Возврат Поля;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура Ссыл_ДобавитьПоле(Поля, Имя, Роль, ОписаниеТипов, ИмяТипаXML)
	
	Поля.Добавить(Новый Структура("Имя, Роль, ОписаниеТипов, ИмяТипаXML", Имя, Роль, ОписаниеТипов, ИмяТипаXML));
	
КонецПроцедуры

Функция Ссыл_ТипСсылкиЭтогоОбъекта(Описание)
	
	Возврат Новый ОписаниеТипов(Описание.Вид + "Ссылка." + Описание.Имя);
	
КонецФункции

Функция Ссыл_ОтборыЭтогоОбъекта(Описание, Отборы)
	
	Результат = Новый Массив;
	
	Для Каждого Отбор Из Отборы Цикл
		Если Не ЗначениеЗаполнено(Отбор.Поле) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Отбор.ПолноеИмя) И Отбор.ПолноеИмя <> Описание.ПолноеИмя Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Отбор.ПолноеИмя) И Ссыл_НайтиПолеОтбора(Описание, Отбор.Поле, Ложь) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Отбор);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Ссыл_ТекстУсловияОтбора(Описание, Отбор, Запрос, Счетчик)
	
	Найденное = Ссыл_НайтиПолеОтбора(Описание, Отбор.Поле, Истина);
	Вид = Ссыл_НормализоватьВидСравнения(Отбор.ВидСравнения);
	Путь = Ссыл_ПутьПоляОтбора(Отбор.Поле);
	ИмяПараметра = "Отбор" + Ссыл_ФорматЧисла(Счетчик.Номер);
	Счетчик.Номер = Счетчик.Номер + 1;
	
	Если Вид = "заполнено" Тогда
		УсловиеПоля = Ссыл_ТекстУсловияЗаполнено(Путь, Найденное.Поле);
	ИначеЕсли Вид = "не заполнено" Тогда
		УсловиеПоля = "НЕ (" + Ссыл_ТекстУсловияЗаполнено(Путь, Найденное.Поле) + ")";
	ИначеЕсли Вид = "содержит" Тогда
		Ссыл_ПроверитьСтроковоеПоле(Найденное.Поле, Отбор.Поле);
		Запрос.УстановитьПараметр(ИмяПараметра, "%" + СокрЛП(Строка(Отбор.Значение)) + "%");
		УсловиеПоля = Путь + " ПОДОБНО &" + ИмяПараметра;
	ИначеЕсли Вид = "в списке" Или Вид = "не в списке" Тогда
		Запрос.УстановитьПараметр(ИмяПараметра, Ссыл_ЗначенияСписка(Найденное.Поле, Отбор.Значение));
		Если Вид = "в списке" Тогда
			УсловиеПоля = Путь + " В (&" + ИмяПараметра + ")";
		Иначе
			УсловиеПоля = "НЕ (" + Путь + " В (&" + ИмяПараметра + "))";
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр(ИмяПараметра, Ссыл_ЗначениеПоляОтбора(Найденное.Поле, Отбор.Значение));
		УсловиеПоля = Путь + " " + Вид + " &" + ИмяПараметра;
	КонецЕсли;
	
	Если Найденное.ИмяТабличнойЧасти = "" Тогда
		Возврат УсловиеПоля;
	КонецЕсли;
	
	Возврат "СУЩЕСТВУЕТ (ВЫБРАТЬ 1 ИЗ " + Описание.ПолноеИмя + "." + Найденное.ИмяТабличнойЧасти
		+ " КАК СтрокаТЧ ГДЕ СтрокаТЧ.Ссылка = Объект.Ссылка И " + УсловиеПоля + ")";
	
КонецФункции

Функция Ссыл_ПутьПоляОтбора(ИмяПоля)
	
	Позиция = Найти(ИмяПоля, ".");
	Если Позиция = 0 Тогда
		Возврат "Объект." + СокрЛП(ИмяПоля);
	КонецЕсли;
	
	Возврат "СтрокаТЧ." + СокрЛП(Сред(ИмяПоля, Позиция + 1));
	
КонецФункции

Функция Ссыл_НайтиПолеОтбора(Описание, ИмяПоля, Обязательно)
	
	ИмяПоля = СокрЛП(ИмяПоля);
	Позиция = Найти(ИмяПоля, ".");
	
	Если Позиция = 0 Тогда
		Для Каждого Поле Из Описание.Поля Цикл
			Если Поле.Имя = ИмяПоля Тогда
				Возврат Новый Структура("Поле, ИмяТабличнойЧасти", Поле, "");
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИмяТаблицы = Лев(ИмяПоля, Позиция - 1);
		ИмяРеквизита = СокрЛП(Сред(ИмяПоля, Позиция + 1));
		Для Каждого ТабличнаяЧасть Из Описание.ТабличныеЧасти Цикл
			Если ТабличнаяЧасть.Имя <> ИмяТаблицы Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Поле Из ТабличнаяЧасть.Поля Цикл
				Если Поле.Имя = ИмяРеквизита Тогда
					Возврат Новый Структура("Поле, ИмяТабличнойЧасти", Поле, ИмяТаблицы);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если Обязательно Тогда
		ВызватьИсключение Описание.ПолноеИмя + ": нет поля отбора """ + ИмяПоля + """.";
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция Ссыл_НормализоватьВидСравнения(Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Если Ключ = "" Или Ключ = "равно" Или Ключ = "=" Тогда
		Возврат "=";
	ИначеЕсли Ключ = "не равно" Или Ключ = "<>" Тогда
		Возврат "<>";
	ИначеЕсли Ключ = "больше" Или Ключ = ">" Тогда
		Возврат ">";
	ИначеЕсли Ключ = "больше или равно" Или Ключ = ">=" Тогда
		Возврат ">=";
	ИначеЕсли Ключ = "меньше" Или Ключ = "<" Тогда
		Возврат "<";
	ИначеЕсли Ключ = "меньше или равно" Или Ключ = "<=" Тогда
		Возврат "<=";
	ИначеЕсли Ключ = "содержит" Тогда
		Возврат "содержит";
	ИначеЕсли Ключ = "в списке" Тогда
		Возврат "в списке";
	ИначеЕсли Ключ = "не в списке" Тогда
		Возврат "не в списке";
	ИначеЕсли Ключ = "заполнено" Тогда
		Возврат "заполнено";
	ИначеЕсли Ключ = "не заполнено" Тогда
		Возврат "не заполнено";
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный вид сравнения """ + Текст + """.";
	
КонецФункции

Функция Ссыл_ТекстУсловияЗаполнено(Путь, Поле)
	
	Если Поле.ИмяТипаXML = "AccountType" Тогда
		Возврат Путь + " <> НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	Если Поле.ОписаниеТипов = Неопределено Тогда
		Возврат Путь + " <> НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого ТипЗначения Из Поле.ОписаниеТипов.Типы() Цикл
		Фрагмент = Ссыл_ТекстЗаполненоТипа(Путь, ТипЗначения);
		Если Фрагмент <> "" Тогда
			Части.Добавить(Фрагмент);
		КонецЕсли;
	КонецЦикла;
	
	Если Части.Количество() = 0 Тогда
		Возврат Путь + " <> НЕОПРЕДЕЛЕНО";
	ИначеЕсли Части.Количество() = 1 Тогда
		Возврат Части[0];
	КонецЕсли;
	
	Возврат "(" + Ссыл_СоединитьСтроки(Части, " ИЛИ ") + ")";
	
КонецФункции

Функция Ссыл_ТекстЗаполненоТипа(Путь, ТипЗначения)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Путь + " <> """"";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Путь + " <> 0";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Путь + " <> ДАТАВРЕМЯ(1, 1, 1)";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Путь + " = ИСТИНА";
	КонецЕсли;
	
	ИмяТаблицы = Ссыл_ИмяТаблицыПоТипу(ТипЗначения);
	Если ИмяТаблицы = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "(" + Путь + " ССЫЛКА " + ИмяТаблицы + " И " + Путь + " <> ЗНАЧЕНИЕ(" + ИмяТаблицы + ".ПустаяСсылка))";
	
КонецФункции

Процедура Ссыл_ПроверитьСтроковоеПоле(Поле, ИмяПоля)
	
	Если Поле.ОписаниеТипов = Неопределено Или Не Поле.ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		ВызватьИсключение "Сравнение «Содержит» доступно только для строки. Поле: " + ИмяПоля + ".";
	КонецЕсли;
	
КонецПроцедуры

Функция Ссыл_ЗначенияСписка(Поле, Текст)
	
	Части = Ссыл_РазделитьСтроку(Строка(Текст), ";");
	Значения = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если СокрЛП(Часть) = "" Тогда
			Продолжить;
		КонецЕсли;
		Значения.Добавить(Ссыл_ЗначениеПоляОтбора(Поле, Часть));
	КонецЦикла;
	
	Если Значения.Количество() = 0 Тогда
		ВызватьИсключение "Для сравнения «В списке» укажите хотя бы одно значение.";
	КонецЕсли;
	
	Возврат Значения;
	
КонецФункции

Функция Ссыл_ЗначениеПоляОтбора(Поле, Текст)
	
	Текст = СокрЛП(Строка(Текст));
	
	Если Поле.ИмяТипаXML = "AccountType" Тогда
		Если Текст = "" Тогда
			ВызватьИсключение "Для вида счета укажите Активный, Пассивный или АктивноПассивный.";
		КонецЕсли;
		Возврат Ссыл_ЗначениеВидаСчета(Текст);
	КонецЕсли;
	
	Если Ссыл_ЭтоЯвноеЗначениеXML(Текст, Поле.ОписаниеТипов) Тогда
		Возврат Ссыл_ЗначениеИзXMLТекста(Текст);
	КонецЕсли;
	
	Если Поле.ОписаниеТипов = Неопределено Тогда
		ВызватьИсключение "Для поля составного типа укажите значение в виде ИмяТипаXML:значение.";
	КонецЕсли;
	
	Типы = Поле.ОписаниеТипов.Типы();
	Если Типы.Количество() <> 1 Тогда
		Если Текст = "" Тогда
			ВызватьИсключение "Для поля составного типа укажите значение в виде ИмяТипаXML:значение.";
		КонецЕсли;
		ВызватьИсключение "У поля несколько типов. Укажите значение в виде ИмяТипаXML:значение, например CatalogRef.Контрагенты:uuid или string:текст.";
	КонецЕсли;
	
	Если Текст = "" Тогда
		Возврат Ссыл_ПустоеЗначениеТипа(Типы[0]);
	КонецЕсли;
	
	Возврат Ссыл_ЗначениеОдногоТипа(Типы[0], Текст);
	
КонецФункции

Функция Ссыл_ЭтоЯвноеЗначениеXML(Текст, ОписаниеТипов)
	
	Позиция = Найти(Текст, ":");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОписаниеТипов <> Неопределено И ОписаниеТипов.Типы().Количество() = 1 И ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяТипа = Лев(Текст, Позиция - 1);
	Если ИмяТипа = "string" Или ИмяТипа = "decimal" Или ИмяТипа = "boolean" Или ИмяТипа = "dateTime" Или Найти(ИмяТипа, ".") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция Ссыл_ЗначениеИзXMLТекста(Текст)
	
	Позиция = Найти(Текст, ":");
	ИмяТипа = Лев(Текст, Позиция - 1);
	Тело = Сред(Текст, Позиция + 1);
	
	Если ИмяТипа = "string" Тогда
		Возврат Тело;
	ИначеЕсли ИмяТипа = "boolean" Тогда
		Возврат Ссыл_БулевоИзТекста(Тело);
	ИначеЕсли ИмяТипа = "decimal" Тогда
		Возврат Ссыл_ЧислоИзТекста(Тело);
	ИначеЕсли ИмяТипа = "dateTime" Тогда
		Возврат Ссыл_ДатаИзТекста(Тело);
	КонецЕсли;
	
	ТипЗначения = ИзXMLТипа(ИмяТипа, "");
	Если ТипЗначения = Неопределено Тогда
		ВызватьИсключение "Неизвестный тип значения отбора " + ИмяТипа + ".";
	КонецЕсли;
	
	Возврат XMLЗначение(ТипЗначения, Тело);
	
КонецФункции

Функция Ссыл_ЗначениеОдногоТипа(ТипЗначения, Текст)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Текст;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Ссыл_ЧислоИзТекста(Текст);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Ссыл_ДатаИзТекста(Текст);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Ссыл_БулевоИзТекста(Текст);
	КонецЕсли;
	
	ИмяТаблицы = Ссыл_ИмяТаблицыПоТипу(ТипЗначения);
	Если Ссыл_ЛевИмениТипа(ТипЗначения) = "EnumRef" Тогда
		Возврат Ссыл_ЗначениеПеречисления(ТипЗначения, Текст);
	КонецЕсли;
	
	Если ИмяТаблицы <> "" Тогда
		Возврат XMLЗначение(ТипЗначения, Текст);
	КонецЕсли;
	
	ВызватьИсключение "Нельзя разобрать значение отбора """ + Текст + """.";
	
КонецФункции

Функция Ссыл_ПустоеЗначениеТипа(ТипЗначения)
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат 0;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат '00010101';
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Ссыл_ЛевИмениТипа(ТипЗначения) = "EnumRef" Тогда
		Имя = Ссыл_ИмяОбъектаТипа(ТипЗначения);
		Возврат Перечисления[Имя].ПустаяСсылка();
	КонецЕсли;
	
	ИмяТаблицы = Ссыл_ИмяТаблицыПоТипу(ТипЗначения);
	Если ИмяТаблицы <> "" Тогда
		Возврат XMLЗначение(ТипЗначения, "00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция Ссыл_ЗначениеПеречисления(ТипЗначения, Текст)
	
	Имя = Ссыл_ИмяОбъектаТипа(ТипЗначения);
	ИмяЗначения = СокрЛП(Текст);
	Позиция = Найти(ИмяЗначения, ".");
	Если Позиция > 0 Тогда
		Части = Ссыл_РазделитьСтроку(ИмяЗначения, ".");
		ИмяЗначения = Части[Части.Количество() - 1];
	КонецЕсли;
	
	Попытка
		Возврат Перечисления[Имя][ИмяЗначения];
	Исключение
		ВызватьИсключение "Нет значения перечисления " + Имя + "." + ИмяЗначения + ".";
	КонецПопытки;
	
КонецФункции

Функция Ссыл_ЗначениеВидаСчета(Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Ключ = СтрЗаменить(Ключ, " ", "");
	Ключ = СтрЗаменить(Ключ, "-", "");
	
	Если Ключ = "активный" Или Ключ = "active" Тогда
		Возврат ВидСчета.Активный;
	ИначеЕсли Ключ = "пассивный" Или Ключ = "passive" Тогда
		Возврат ВидСчета.Пассивный;
	ИначеЕсли Ключ = "активнопассивный" Или Ключ = "activepassive" Тогда
		Возврат ВидСчета.АктивноПассивный;
	КонецЕсли;
	
	ВызватьИсключение "Некорректный вид счета """ + Текст + """. Укажите Активный, Пассивный или АктивноПассивный.";
	
КонецФункции

Функция Ссыл_БулевоИзТекста(Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Если Ключ = "истина" Или Ключ = "да" Или Ключ = "true" Или Ключ = "1" Тогда
		Возврат Истина;
	ИначеЕсли Ключ = "ложь" Или Ключ = "нет" Или Ключ = "false" Или Ключ = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВызватьИсключение "Некорректное булево значение """ + Текст + """.";
	
КонецФункции

Функция Ссыл_ЧислоИзТекста(Текст)
	
	Нормализованный = СтрЗаменить(СокрЛП(Текст), " ", "");
	Нормализованный = СтрЗаменить(Нормализованный, Символ(160), "");
	Нормализованный = СтрЗаменить(Нормализованный, ",", ".");
	
	Попытка
		Возврат XMLЗначение(Тип("Число"), Нормализованный);
	Исключение
		ВызватьИсключение "Некорректное число """ + Текст + """.";
	КонецПопытки;
	
КонецФункции

Функция Ссыл_ДатаИзТекста(Текст)
	
	Текст = СокрЛП(Текст);
	Если Текст = "" Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Если Найти(Текст, "-") > 0 Тогда
		Нормализованный = Текст;
		Если Найти(Нормализованный, "T") = 0 И СтрДлина(Нормализованный) >= 10 Тогда
			Нормализованный = Лев(Нормализованный, 10) + "T00:00:00";
		КонецЕсли;
		Попытка
			Возврат XMLЗначение(Тип("Дата"), Нормализованный);
		Исключение
			ВызватьИсключение "Некорректная дата """ + Текст + """.";
		КонецПопытки;
	КонецЕсли;
	
	ТекстДаты = Текст;
	ТекстВремени = "";
	ПозицияПробела = Найти(Текст, " ");
	Если ПозицияПробела > 0 Тогда
		ТекстДаты = Лев(Текст, ПозицияПробела - 1);
		ТекстВремени = СокрЛП(Сред(Текст, ПозицияПробела + 1));
	КонецЕсли;
	
	ЧастиДаты = Ссыл_РазделитьСтроку(ТекстДаты, ".");
	Если ЧастиДаты.Количество() <> 3 Тогда
		ВызватьИсключение "Некорректная дата """ + Текст + """. Укажите ДД.ММ.ГГГГ или ГГГГ-ММ-ДД.";
	КонецЕсли;
	
	Час = 0;
	Минута = 0;
	Секунда = 0;
	Если ТекстВремени <> "" Тогда
		ЧастиВремени = Ссыл_РазделитьСтроку(ТекстВремени, ":");
		Час = Число(ЧастиВремени[0]);
		Если ЧастиВремени.Количество() > 1 Тогда
			Минута = Число(ЧастиВремени[1]);
		КонецЕсли;
		Если ЧастиВремени.Количество() > 2 Тогда
			Секунда = Число(ЧастиВремени[2]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Дата(Число(ЧастиДаты[2]), Число(ЧастиДаты[1]), Число(ЧастиДаты[0]), Час, Минута, Секунда);
	
КонецФункции

Функция Ссыл_ИмяТаблицыПоТипу(ТипЗначения)
	
	Префикс = Ссыл_ЛевИмениТипа(ТипЗначения);
	Имя = Ссыл_ИмяОбъектаТипа(ТипЗначения);
	Если Префикс = "" Или Имя = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Если Префикс = "CatalogRef" Тогда
		Возврат "Справочник." + Имя;
	ИначеЕсли Префикс = "DocumentRef" Тогда
		Возврат "Документ." + Имя;
	ИначеЕсли Префикс = "EnumRef" Тогда
		Возврат "Перечисление." + Имя;
	ИначеЕсли Префикс = "ChartOfCharacteristicTypesRef" Тогда
		Возврат "ПланВидовХарактеристик." + Имя;
	ИначеЕсли Префикс = "ChartOfAccountsRef" Тогда
		Возврат "ПланСчетов." + Имя;
	ИначеЕсли Префикс = "ChartOfCalculationTypesRef" Тогда
		Возврат "ПланВидовРасчета." + Имя;
	ИначеЕсли Префикс = "ExchangePlanRef" Тогда
		Возврат "ПланОбмена." + Имя;
	ИначеЕсли Префикс = "BusinessProcessRef" Тогда
		Возврат "БизнесПроцесс." + Имя;
	ИначеЕсли Префикс = "TaskRef" Тогда
		Возврат "Задача." + Имя;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция Ссыл_ЛевИмениТипа(ТипЗначения)
	
	ТипXML = XMLТип(ТипЗначения);
	Если ТипXML = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Позиция = Найти(ТипXML.ИмяТипа, ".");
	Если Позиция = 0 Тогда
		Возврат ТипXML.ИмяТипа;
	КонецЕсли;
	
	Возврат Лев(ТипXML.ИмяТипа, Позиция - 1);
	
КонецФункции

Функция Ссыл_ИмяОбъектаТипа(ТипЗначения)
	
	ТипXML = XMLТип(ТипЗначения);
	Если ТипXML = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Позиция = Найти(ТипXML.ИмяТипа, ".");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(ТипXML.ИмяТипа, Позиция + 1);
	
КонецФункции

Процедура Ссыл_СравнитьОбъектМетаданных(ПолноеИмя, Отборы, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано)
	
	ТекстОшибкиФайла = КэшФайла.Ошибки.Получить(ПолноеИмя);
	Если ТекстОшибкиФайла <> Неопределено Тогда
		Ссыл_ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, 0, 0, 0, 0, 0);
		Ссыл_ДобавитьОтличие(Отличия, ПолноеИмя, "Ошибка", "", "(выгрузка)", "", ТекстОшибкиФайла, ВсегоОтличий, Обрезано);
		Возврат;
	КонецЕсли;
	
	Если КэшФайла.Виденные.Получить(ПолноеИмя) = Неопределено Тогда
		Предупреждения.Добавить(ПолноеИмя + ": объекта нет в файле выгрузки. Данные файла приняты пустыми.");
	КонецЕсли;
	
	ОбъектыФайла = КэшФайла.Объекты.Получить(ПолноеИмя);
	Если ОбъектыФайла = Неопределено Тогда
		ОбъектыФайла = Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Описание = Ссыл_ОписаниеОбъекта(ПолноеИмя);
		Подготовка = Ссыл_ПодготовитьЗапрос(Описание, Отборы, НачалоПериода, КонецПериода);
		СтрокиБазы = Ссыл_ПрочитатьСтрокиТабличныхЧастей(Описание, Подготовка.Запрос, Подготовка.ТекстГде);
		Подготовка.Запрос.Текст = Ссыл_ТекстЗапросаШапки(Описание, Подготовка.ТекстГде);
		Выборка = Подготовка.Запрос.Выполнить().Выбрать();
	Исключение
		ТекстОшибки = Ссыл_КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(ПолноеИмя + ": " + ТекстОшибки);
		Ссыл_ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, 0, ОбъектыФайла.Количество(), 0, 0, 0);
		Ссыл_ДобавитьОтличие(Отличия, ПолноеИмя, "Ошибка", "", "(запрос)", "", ТекстОшибки, ВсегоОтличий, Обрезано);
		Возврат;
	КонецПопытки;
	
	СтрокаСтатистики = Ссыл_ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, 0, ОбъектыФайла.Количество(), 0, 0, 0);
	КоличествоБазы = 0;
	
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоБазы = КоличествоБазы + 1;
		Ключ = XMLСтрока(Выборка.Ссылка);
		ЗначенияШапки = Ссыл_КартаЗначенийВыборки(Выборка, Описание.Поля);
		Представление = Ссыл_ПредставлениеОбъекта(ЗначенияШапки, Ключ, Описание.Синоним);
		ОбъектФайла = ОбъектыФайла.Получить(Ключ);
		
		Если ОбъектФайла = Неопределено Тогда
			СтрокаСтатистики.ТолькоВБазе = СтрокаСтатистики.ТолькоВБазе + 1;
			Ссыл_ДобавитьОтличие(Отличия, ПолноеИмя, "Только в этой базе", Представление, "(весь объект)", Ссыл_ПредставлениеКарты(Описание.Поля, ЗначенияШапки), "", ВсегоОтличий, Обрезано, Ключ);
			Продолжить;
		КонецЕсли;
		
		Ссыл_СравнитьКартыПолей(Описание.Поля, ЗначенияШапки, ОбъектФайла.Поля, "", ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано, Ключ);
		
		СтрокиОбъекта = Неопределено;
		Если СтрокиБазы <> Неопределено Тогда
			СтрокиОбъекта = СтрокиБазы.Получить(Ключ);
		КонецЕсли;
		Ссыл_СравнитьСтрокиОбъекта(СтрокиОбъекта, ОбъектФайла.Строки, ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано, Ключ);
		ОбъектыФайла.Удалить(Ключ);
	КонецЦикла;
	
	СтрокаСтатистики.ЗаписейВБазе = КоличествоБазы;
	
	Для Каждого ЭлементОбъекта Из ОбъектыФайла Цикл
		ОбъектФайла = ЭлементОбъекта.Значение;
		СтрокаСтатистики.ТолькоВФайле = СтрокаСтатистики.ТолькоВФайле + 1;
		ПредставлениеФайла = Ссыл_ПредставлениеИзФайла(ОбъектФайла, Описание.Синоним);
		Ссыл_ДобавитьОтличие(Отличия, ПолноеИмя, "Только в файле", ПредставлениеФайла, "(весь объект)", "", Ссыл_ПредставлениеКарты(ОбъектФайла.ПорядокПолей, ОбъектФайла.Поля), ВсегоОтличий, Обрезано, ОбъектФайла.Ключ);
	КонецЦикла;
	
КонецПроцедуры

Процедура Ссыл_СравнитьСтрокиОбъекта(СтрокиБазы, СтрокиФайла, ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано, Ключ)
	
	Если СтрокиБазы = Неопределено Тогда
		СтрокиБазы = Новый Соответствие;
	КонецЕсли;
	Если СтрокиФайла = Неопределено Тогда
		СтрокиФайла = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого ЭлементСтроки Из СтрокиБазы Цикл
		СтрокаБазы = ЭлементСтроки.Значение;
		СтрокаФайла = СтрокиФайла.Получить(ЭлементСтроки.Ключ);
		ИмяСтроки = СтрокаБазы.ИмяТаблицы + "[" + Ссыл_ФорматЧисла(СтрокаБазы.НомерСтроки) + "]";
		
		Если СтрокаФайла = Неопределено Тогда
			СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
			Ссыл_ДобавитьОтличие(Отличия, ПолноеИмя, "Расхождение", Представление, ИмяСтроки, Ссыл_ПредставлениеКарты(СтрокаБазы.ПорядокПолей, СтрокаБазы.Поля), "(нет строки)", ВсегоОтличий, Обрезано, Ключ);
			Продолжить;
		КонецЕсли;
		
		Ссыл_СравнитьКартыПолей(СтрокаБазы.ПорядокПолей, СтрокаБазы.Поля, СтрокаФайла.Поля, ИмяСтроки + ".", ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано, Ключ);
		СтрокиФайла.Удалить(ЭлементСтроки.Ключ);
	КонецЦикла;
	
	Для Каждого ЭлементСтроки Из СтрокиФайла Цикл
		СтрокаФайла = ЭлементСтроки.Значение;
		ИмяСтроки = СтрокаФайла.ИмяТаблицы + "[" + Ссыл_ФорматЧисла(СтрокаФайла.НомерСтроки) + "]";
		СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
		Ссыл_ДобавитьОтличие(Отличия, ПолноеИмя, "Расхождение", Представление, ИмяСтроки, "(нет строки)", Ссыл_ПредставлениеКарты(СтрокаФайла.ПорядокПолей, СтрокаФайла.Поля), ВсегоОтличий, Обрезано, Ключ);
	КонецЦикла;
	
КонецПроцедуры

Процедура Ссыл_СравнитьКартыПолей(ПорядокБазы, КартаБазы, КартаФайла, Префикс, ПолноеИмя, Представление, Отличия, СтрокаСтатистики, ВсегоОтличий, Обрезано, Ключ)
	
	Виденные = Новый Соответствие;
	
	Для Каждого Поле Из ПорядокБазы Цикл
		ИмяПоля = Ссыл_ИмяЭлементаПорядка(Поле);
		Виденные.Вставить(ИмяПоля, Истина);
		ЗначениеБазы = КартаБазы.Получить(ИмяПоля);
		КанонБазы = "";
		ПредставлениеБазы = "";
		Если ЗначениеБазы <> Неопределено Тогда
			КанонБазы = ЗначениеБазы.Канон;
			ПредставлениеБазы = ЗначениеБазы.Представление;
		КонецЕсли;
		
		ЗначениеФайла = Неопределено;
		Если КартаФайла <> Неопределено Тогда
			ЗначениеФайла = КартаФайла.Получить(ИмяПоля);
		КонецЕсли;
		
		Если ЗначениеФайла = Неопределено Тогда
			КанонФайла = "<нет поля>";
			ПредставлениеФайла = "";
		Иначе
			КанонФайла = ЗначениеФайла.Канон;
			ПредставлениеФайла = ЗначениеФайла.Представление;
		КонецЕсли;
		
		Если Ссыл_НормализоватьКанон(КанонБазы) <> Ссыл_НормализоватьКанон(КанонФайла) Тогда
			СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
			Ссыл_ДобавитьОтличие(Отличия, ПолноеИмя, "Расхождение", Представление, Префикс + ИмяПоля, ПредставлениеБазы, ПредставлениеФайла, ВсегоОтличий, Обрезано, Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Если КартаФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементПоля Из КартаФайла Цикл
		Если Виденные.Получить(ЭлементПоля.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
		Ссыл_ДобавитьОтличие(Отличия, ПолноеИмя, "Расхождение", Представление, Префикс + ЭлементПоля.Ключ, "", ЭлементПоля.Значение.Представление, ВсегоОтличий, Обрезано, Ключ);
	КонецЦикла;
	
КонецПроцедуры

Функция Ссыл_ПрочитатьФайлВыгрузки(ИмяФайла, ПолныеИмена)
	
	Выбранные = Новый Соответствие;
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Выбранные.Вставить(ПолноеИмя, Истина);
	КонецЦикла;
	
	Кэш = Новый Структура;
	Кэш.Вставить("ВерсияФормата", "");
	Кэш.Вставить("Конфигурация", "");
	Кэш.Вставить("ПериодНачало", '00010101');
	Кэш.Вставить("ПериодКонец", '00010101');
	Кэш.Вставить("ТекстОтборов", "");
	Кэш.Вставить("Объекты", Новый Соответствие);
	Кэш.Вставить("Ошибки", Новый Соответствие);
	Кэш.Вставить("Виденные", Новый Соответствие);
	Кэш.Вставить("Синонимы", Новый Соответствие);
	Кэш.Вставить("Предупреждения", Новый Массив);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ТекущиеОбъекты = Неопределено;
	ТекущийОбъект = Неопределено;
	ТекущаяСтрока = Неопределено;
	КореньНайден = Ложь;
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Row" Тогда
			Ссыл_ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Object" Тогда
			Ссыл_ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			Ссыл_ЗафиксироватьОбъект(ТекущиеОбъекты, ТекущийОбъект);
			ТекущийОбъект = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = Чтение.Имя;
		
		Если ИмяУзла = "ReferenceObjectComparison" Тогда
			
			КореньНайден = Истина;
			Кэш.ВерсияФормата = Ссыл_Атрибут(Чтение, "formatVersion");
			Если Кэш.ВерсияФормата <> "1" Тогда
				ВызватьИсключение "Неподдерживаемая версия файла сравнения: " + Кэш.ВерсияФормата + ".";
			КонецЕсли;
			Кэш.Конфигурация = Ссыл_Атрибут(Чтение, "configuration");
			Кэш.ПериодНачало = Ссыл_ДатаИзАтрибута(Ссыл_Атрибут(Чтение, "periodFrom"));
			Кэш.ПериодКонец = Ссыл_ДатаИзАтрибута(Ссыл_Атрибут(Чтение, "periodTo"));
			Кэш.ТекстОтборов = Ссыл_Атрибут(Чтение, "filterText");
			
		ИначеЕсли ИмяУзла = "Metadata" Тогда
			
			Ссыл_ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			Ссыл_ЗафиксироватьОбъект(ТекущиеОбъекты, ТекущийОбъект);
			ТекущийОбъект = Неопределено;
			ИмяМетаданных = Ссыл_Атрибут(Чтение, "name");
			Кэш.Виденные.Вставить(ИмяМетаданных, Истина);
			Кэш.Синонимы.Вставить(ИмяМетаданных, Ссыл_Атрибут(Чтение, "synonym"));
			Если Выбранные.Количество() = 0 Или Выбранные.Получить(ИмяМетаданных) <> Неопределено Тогда
				ТекущиеОбъекты = Новый Соответствие;
				Кэш.Объекты.Вставить(ИмяМетаданных, ТекущиеОбъекты);
			Иначе
				ТекущиеОбъекты = Неопределено;
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Object" Тогда
			
			Ссыл_ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			Ссыл_ЗафиксироватьОбъект(ТекущиеОбъекты, ТекущийОбъект);
			ТекущийОбъект = Неопределено;
			Если ТекущиеОбъекты <> Неопределено Тогда
				ТекущийОбъект = Ссыл_НовыйОбъектФайла(Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Row" Тогда
			
			Ссыл_ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
			ТекущаяСтрока = Неопределено;
			Если ТекущийОбъект <> Неопределено Тогда
				ТекущаяСтрока = Ссыл_НоваяСтрокаТаблицы(Ссыл_Атрибут(Чтение, "table"), Ссыл_ЧислоАтрибута(Ссыл_Атрибут(Чтение, "line")));
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Field" Тогда
			
			Если ТекущаяСтрока <> Неопределено Тогда
				Ссыл_ДобавитьПолеФайла(ТекущаяСтрока.Поля, ТекущаяСтрока.ПорядокПолей, Чтение);
			ИначеЕсли ТекущийОбъект <> Неопределено Тогда
				Ссыл_ДобавитьПолеФайла(ТекущийОбъект.Поля, ТекущийОбъект.ПорядокПолей, Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Error" Тогда
			
			ИмяМетаданных = Ссыл_Атрибут(Чтение, "meta");
			ТекстОшибки = Ссыл_Атрибут(Чтение, "text");
			Кэш.Виденные.Вставить(ИмяМетаданных, Истина);
			Кэш.Ошибки.Вставить(ИмяМетаданных, ТекстОшибки);
			Кэш.Предупреждения.Добавить(ИмяМетаданных + ": " + ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Ссыл_ЗафиксироватьСтроку(ТекущийОбъект, ТекущаяСтрока);
	Ссыл_ЗафиксироватьОбъект(ТекущиеОбъекты, ТекущийОбъект);
	Чтение.Закрыть();
	
	Если Не КореньНайден Тогда
		ВызватьИсключение "Файл не является выгрузкой сравнения ссылочных объектов.";
	КонецЕсли;
	
	Возврат Кэш;
	
КонецФункции

Функция Ссыл_НовыйОбъектФайла(Чтение)
	
	ОбъектФайла = Новый Структура;
	ОбъектФайла.Вставить("Ключ", Ссыл_Атрибут(Чтение, "uuid"));
	ОбъектФайла.Вставить("Представление", Ссыл_Атрибут(Чтение, "presentation"));
	ОбъектФайла.Вставить("Поля", Новый Соответствие);
	ОбъектФайла.Вставить("ПорядокПолей", Новый Массив);
	ОбъектФайла.Вставить("Строки", Новый Соответствие);
	Возврат ОбъектФайла;
	
КонецФункции

Функция Ссыл_НоваяСтрокаТаблицы(ИмяТаблицы, НомерСтроки)
	
	СтрокаТаблицы = Новый Структура;
	СтрокаТаблицы.Вставить("ИмяТаблицы", ИмяТаблицы);
	СтрокаТаблицы.Вставить("НомерСтроки", НомерСтроки);
	СтрокаТаблицы.Вставить("Поля", Новый Соответствие);
	СтрокаТаблицы.Вставить("ПорядокПолей", Новый Массив);
	Возврат СтрокаТаблицы;
	
КонецФункции

Процедура Ссыл_ДобавитьПолеФайла(КартаПолей, ПорядокПолей, Чтение)
	
	ИмяПоля = Ссыл_Атрибут(Чтение, "name");
	КартаПолей.Вставить(ИмяПоля, Новый Структура("Канон, Представление", Ссыл_НормализоватьКанон(Ссыл_Атрибут(Чтение, "canonical")), Ссыл_Атрибут(Чтение, "presentation")));
	ПорядокПолей.Добавить(ИмяПоля);
	
КонецПроцедуры

Процедура Ссыл_ЗафиксироватьСтроку(ОбъектФайла, СтрокаТаблицы)
	
	Если ОбъектФайла = Неопределено Или СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючСтроки = СтрокаТаблицы.ИмяТаблицы + "|" + Ссыл_ФорматЧисла(СтрокаТаблицы.НомерСтроки);
	ОбъектФайла.Строки.Вставить(КлючСтроки, СтрокаТаблицы);
	
КонецПроцедуры

Процедура Ссыл_ЗафиксироватьОбъект(ОбъектыФайла, ОбъектФайла)
	
	Если ОбъектыФайла = Неопределено Или ОбъектФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектыФайла.Вставить(ОбъектФайла.Ключ, ОбъектФайла);
	
КонецПроцедуры

Функция Ссыл_КартаЗначенийВыборки(Выборка, Поля)
	
	Карта = Новый Соответствие;
	Порядок = Новый Массив;
	Ссыл_ЗаполнитьКартуВыборки(Выборка, Поля, Карта, Порядок);
	Возврат Карта;
	
КонецФункции

Процедура Ссыл_ЗаполнитьКартуВыборки(Выборка, Поля, Карта, Порядок)
	
	Для Каждого Поле Из Поля Цикл
		ЗначениеПоля = Новый Структура("Канон, Представление", Ссыл_КаноническоеЗначение(Выборка[Поле.Имя]), Ссыл_ТекстXML(Ссыл_ПредставлениеЗначения(Выборка[Поле.Имя])));
		Карта.Вставить(Поле.Имя, ЗначениеПоля);
		Порядок.Добавить(Поле.Имя);
	КонецЦикла;
	
КонецПроцедуры

Функция Ссыл_ПредставлениеОбъекта(ЗначенияШапки, Ключ, Синоним = "")
	
	Номер = Ссыл_ТекстПоляПредставления(ЗначенияШапки, "Номер");
	Дата = Ссыл_КраткаяДата(Ссыл_ТекстПоляПредставления(ЗначенияШапки, "Дата"));
	Код = Ссыл_ТекстПоляПредставления(ЗначенияШапки, "Код");
	Наименование = Ссыл_ТекстПоляПредставления(ЗначенияШапки, "Наименование");
	
	Если Номер <> "" И Дата <> "" Тогда
		Возврат Ссыл_СклеитьПредставление(Синоним, Номер + " от " + Дата);
	ИначеЕсли Наименование <> "" Тогда
		Возврат Ссыл_СклеитьПредставление(Синоним, Наименование);
	ИначеЕсли Код <> "" Тогда
		Возврат Ссыл_СклеитьПредставление(Синоним, Код);
	ИначеЕсли Номер <> "" Тогда
		Возврат Ссыл_СклеитьПредставление(Синоним, Номер);
	ИначеЕсли Дата <> "" Тогда
		Возврат Ссыл_СклеитьПредставление(Синоним, "от " + Дата);
	ИначеЕсли Ключ <> "" Тогда
		Возврат Ссыл_СклеитьПредставление(Синоним, Ключ);
	КонецЕсли;
	
	Возврат Синоним;
	
КонецФункции

Функция Ссыл_ПредставлениеИзФайла(ОбъектФайла, Синоним)
	
	Если ОбъектФайла = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = Ссыл_ПредставлениеОбъекта(ОбъектФайла.Поля, "", Синоним);
	Если Текст = "" Или Текст = Синоним Тогда
		Если ЗначениеЗаполнено(ОбъектФайла.Представление) Тогда
			Возврат ОбъектФайла.Представление;
		КонецЕсли;
		Возврат ОбъектФайла.Ключ;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция Ссыл_СклеитьПредставление(Синоним, Хвост)
	
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Возврат Хвост;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Хвост) Тогда
		Возврат Синоним;
	КонецЕсли;
	
	Возврат Синоним + " " + Хвост;
	
КонецФункции

Функция Ссыл_ТекстПоляПредставления(ЗначенияШапки, ИмяПоля)
	
	Если ЗначенияШапки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЗначениеПоля = ЗначенияШапки.Получить(ИмяПоля);
	Если ЗначениеПоля = Неопределено Или Не ЗначениеЗаполнено(ЗначениеПоля.Представление) Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = СокрЛП(ЗначениеПоля.Представление);
	Позиция = Найти(Текст, " | ");
	Если Позиция > 0 Тогда
		Текст = СокрЛП(Лев(Текст, Позиция - 1));
	КонецЕсли;
	
	Если СтрДлина(Текст) >= 2 И Лев(Текст, 1) = """" И Прав(Текст, 1) = """" Тогда
		Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция Ссыл_КраткаяДата(Текст)
	
	Суффикс = " 0:00:00";
	Если СтрДлина(Текст) > СтрДлина(Суффикс) И Прав(Текст, СтрДлина(Суффикс)) = Суффикс Тогда
		Возврат Лев(Текст, СтрДлина(Текст) - СтрДлина(Суффикс));
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Процедура Ссыл_ДобавитьЧастьПредставления(Части, ЗначенияШапки, ИмяПоля)
	
	ЗначениеПоля = ЗначенияШапки.Получить(ИмяПоля);
	Если ЗначениеПоля = Неопределено Или Не ЗначениеЗаполнено(ЗначениеПоля.Представление) Тогда
		Возврат;
	КонецЕсли;
	
	Части.Добавить(ЗначениеПоля.Представление);
	
КонецПроцедуры

Функция Ссыл_ПредставлениеКарты(ПорядокПолей, КартаПолей)
	
	Части = Новый Массив;
	Для Каждого Поле Из ПорядокПолей Цикл
		ИмяПоля = Ссыл_ИмяЭлементаПорядка(Поле);
		ЗначениеПоля = КартаПолей.Получить(ИмяПоля);
		Если ЗначениеПоля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(ИмяПоля + " = " + ЗначениеПоля.Представление);
	КонецЦикла;
	
	Текст = Ссыл_СоединитьСтроки(Части, "; ");
	Если СтрДлина(Текст) > 1000 Тогда
		Возврат Лев(Текст, 1000) + "...";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция Ссыл_КаноническоеЗначение(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "undef";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Null") Тогда
		Возврат "null";
	КонецЕсли;
	
	Если Ссыл_ЭтоСсылочныйТип(ТипЗначения) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат ТипXML.ИмяТипа + ":" + XMLСтрока(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "string:" + Ссыл_ТекстXML(Значение);
	КонецЕсли;
	
	Попытка
		ТипXML = XMLТип(ТипЗначения);
		Если ТипXML = Неопределено Тогда
			Возврат Ссыл_ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		КонецЕсли;
		Возврат Ссыл_НормализоватьКанон(ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	Исключение
		Попытка
			Возврат Ссыл_ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		Исключение
			Возврат Ссыл_ТекстXML("string:" + Строка(Значение));
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

Функция Ссыл_ПредставлениеЗначения(Значение)
	
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + Ссыл_ТекстXML(Значение) + """";
	КонецЕсли;
	
	Если Ссыл_ЭтоСсылочныйТип(ТипЗнч(Значение)) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат Ссыл_ТекстXML(Строка(Значение) + " | " + ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	КонецЕсли;
	
	Возврат Ссыл_ТекстXML(Строка(Значение) + " | " + Ссыл_КаноническоеЗначение(Значение));
	
КонецФункции

Функция Ссыл_НормализоватьКанон(Канон)
	
	Префикс = "decimal:";
	Если Лев(Канон, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Канон;
	КонецЕсли;
	
	Текст = СокрЛП(Сред(Канон, СтрДлина(Префикс) + 1));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, Символ(8239), "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если Лев(Текст, 1) = "+" Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	ПозицияТочки = Найти(Текст, ".");
	Если ПозицияТочки > 0 Тогда
		Целая = Лев(Текст, ПозицияТочки - 1);
		Дробная = Сред(Текст, ПозицияТочки + 1);
		Пока Прав(Дробная, 1) = "0" И Дробная <> "" Цикл
			Дробная = Лев(Дробная, СтрДлина(Дробная) - 1);
		КонецЦикла;
		Если Дробная = "" Тогда
			Текст = Целая;
		Иначе
			Текст = Целая + "." + Дробная;
		КонецЕсли;
	КонецЕсли;
	
	Если Текст = "" Или Текст = "-" Или Текст = "-0" Тогда
		Текст = "0";
	КонецЕсли;
	
	Возврат Префикс + Текст;
	
КонецФункции

Процедура Ссыл_ИнициализироватьКэшТипов()
	
	Если Ссыл_ОписанияТиповСсылок <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ссыл_ОписанияТиповСсылок = Новый Массив;
	Ссыл_ОписанияТиповСсылок.Добавить(Справочники.ТипВсеСсылки());
	Ссыл_ОписанияТиповСсылок.Добавить(Документы.ТипВсеСсылки());
	Ссыл_ОписанияТиповСсылок.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки());
	Ссыл_ОписанияТиповСсылок.Добавить(ПланыСчетов.ТипВсеСсылки());
	Ссыл_ОписанияТиповСсылок.Добавить(ПланыВидовРасчета.ТипВсеСсылки());
	Ссыл_ОписанияТиповСсылок.Добавить(ПланыОбмена.ТипВсеСсылки());
	Ссыл_ОписанияТиповСсылок.Добавить(БизнесПроцессы.ТипВсеСсылки());
	Ссыл_ОписанияТиповСсылок.Добавить(Задачи.ТипВсеСсылки());
	Ссыл_КэшСсылочныхТипов = Новый Соответствие;
	
КонецПроцедуры

Функция Ссыл_ЭтоСсылочныйТип(ТипЗначения)
	
	Если Ссыл_ОписанияТиповСсылок = Неопределено Тогда
		Ссыл_ИнициализироватьКэшТипов();
	КонецЕсли;
	
	Признак = Ссыл_КэшСсылочныхТипов.Получить(ТипЗначения);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;
	
	Признак = Ложь;
	Для Каждого ОписаниеТипа Из Ссыл_ОписанияТиповСсылок Цикл
		Если ОписаниеТипа.СодержитТип(ТипЗначения) Тогда
			Признак = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Ссыл_КэшСсылочныхТипов.Вставить(ТипЗначения, Признак);
	Возврат Признак;
	
КонецФункции

Функция Ссыл_КэшИзАдреса(АдресФайла, ПолныеИмена)
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл сравнения.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ИмяФайла);
	
	Попытка
		Кэш = Ссыл_ПрочитатьФайлВыгрузки(ИмяФайла, ПолныеИмена);
	Исключение
		Ссыл_УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Ссыл_УдалитьВременныйФайл(ИмяФайла);
	Возврат Кэш;
	
КонецФункции

Функция Ссыл_НовоеДеревоОтличий()
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Объект", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("ВидОтличия", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("ЗначениеВБазе", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Значение3", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("СколькоРаз", Новый ОписаниеТипов("Число"));
	Дерево.Колонки.Добавить("Где", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Как", Новый ОписаниеТипов("Строка"));
	Возврат Дерево;
	
КонецФункции

Функция Ссыл_ДеревоДвухСторон(Таблица)
	
	Дерево = Ссыл_НовоеДеревоОтличий();
	ТекущийКлюч = "";
	Родитель = Неопределено;
	СчетчикКолонок = 0;
	ГруппаНачата = Ложь;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		КлючГруппы = СтрокаТаблицы.Объект + "|" + СтрокаТаблицы.Ключ + "|" + СтрокаТаблицы.Ссылка;
		Если Не ГруппаНачата Или КлючГруппы <> ТекущийКлюч Тогда
			Если Родитель <> Неопределено Тогда
				Ссыл_ЗавершитьГруппуДвухСторон(Родитель, СчетчикКолонок);
			КонецЕсли;
			ТекущийКлюч = КлючГруппы;
			ГруппаНачата = Истина;
			СчетчикКолонок = 0;
			Родитель = Дерево.Строки.Добавить();
			Ссыл_ЗаполнитьРодителяДвухСторон(Родитель, СтрокаТаблицы);
		КонецЕсли;
		
		Если СтрокаТаблицы.ИмяПоля = "(весь объект)" Или СтрокаТаблицы.ИмяПоля = "(выгрузка)" Или СтрокаТаблицы.ИмяПоля = "(запрос)" Тогда
			Родитель.ВидОтличия = СтрокаТаблицы.ВидОтличия;
			Родитель.ЗначениеВБазе = СтрокаТаблицы.ЗначениеВБазе;
			Родитель.ЗначениеВФайле = СтрокаТаблицы.ЗначениеВФайле;
			Родитель.Как = СтрокаТаблицы.ИмяПоля;
			Родитель.Где = Ссыл_ГдеДвухСторон(СтрокаТаблицы.ВидОтличия);
			Родитель.СколькоРаз = 1;
		Иначе
			СчетчикКолонок = СчетчикКолонок + 1;
			Дочерняя = Родитель.Строки.Добавить();
			Дочерняя.Объект = СтрокаТаблицы.Объект;
			Дочерняя.ВидОтличия = СтрокаТаблицы.ВидОтличия;
			Дочерняя.Представление = СтрокаТаблицы.ИмяПоля;
			Дочерняя.Ссылка = СтрокаТаблицы.Ключ;
			Дочерняя.ИмяПоля = СтрокаТаблицы.ИмяПоля;
			Дочерняя.ЗначениеВБазе = СтрокаТаблицы.ЗначениеВБазе;
			Дочерняя.ЗначениеВФайле = СтрокаТаблицы.ЗначениеВФайле;
			Дочерняя.СколькоРаз = 1;
			Дочерняя.Как = "колонка отличается";
			Дочерняя.Где = Ссыл_ГдеДвухСторон(СтрокаТаблицы.ВидОтличия);
		КонецЕсли;
	КонецЦикла;
	
	Если Родитель <> Неопределено Тогда
		Ссыл_ЗавершитьГруппуДвухСторон(Родитель, СчетчикКолонок);
	КонецЕсли;
	
	Возврат Дерево;
	
КонецФункции

Процедура Ссыл_ЗаполнитьРодителяДвухСторон(Родитель, СтрокаТаблицы)
	
	Родитель.Объект = СтрокаТаблицы.Объект;
	Родитель.ВидОтличия = СтрокаТаблицы.ВидОтличия;
	Если ЗначениеЗаполнено(СтрокаТаблицы.Ссылка) Тогда
		Родитель.Представление = СтрокаТаблицы.Ссылка;
	Иначе
		Родитель.Представление = СтрокаТаблицы.Объект;
	КонецЕсли;
	Родитель.Ссылка = СтрокаТаблицы.Ключ;
	Родитель.СколькоРаз = 1;
	Родитель.Где = Ссыл_ГдеДвухСторон(СтрокаТаблицы.ВидОтличия);
	Родитель.Как = СтрокаТаблицы.ИмяПоля;
	
КонецПроцедуры

Процедура Ссыл_ЗавершитьГруппуДвухСторон(Родитель, СчетчикКолонок)
	
	Если СчетчикКолонок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Родитель.ВидОтличия = "Расхождение";
	Родитель.Где = "в этой базе и в файле";
	Родитель.Как = "колонок: " + Ссыл_ФорматЧисла(СчетчикКолонок);
	Родитель.СколькоРаз = 1;
	Родитель.ИмяПоля = "";
	Родитель.ЗначениеВБазе = "";
	Родитель.ЗначениеВФайле = "";
	
КонецПроцедуры

Функция Ссыл_ГдеДвухСторон(ВидОтличия)
	
	Если ВидОтличия = "Только в этой базе" Тогда
		Возврат "только в этой базе";
	ИначеЕсли ВидОтличия = "Только в файле" Тогда
		Возврат "только в файле";
	ИначеЕсли ВидОтличия = "Ошибка" Тогда
		Возврат "ошибка чтения";
	КонецЕсли;
	
	Возврат "в этой базе и в файле";
	
КонецФункции

Функция Ссыл_ИменаМетаданныхТрехФайлов(ПолныеИмена, Кэш1, Кэш2, Кэш3)
	
	Если ПолныеИмена.Количество() > 0 Тогда
		Возврат ПолныеИмена;
	КонецЕсли;
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Виденные = Новый Соответствие;
	Ссыл_ДобавитьИменаКэша(Таблица, Виденные, Кэш1);
	Ссыл_ДобавитьИменаКэша(Таблица, Виденные, Кэш2);
	Ссыл_ДобавитьИменаКэша(Таблица, Виденные, Кэш3);
	Таблица.Сортировать("Имя");
	
	Имена = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Имена.Добавить(СтрокаТаблицы.Имя);
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

Процедура Ссыл_ДобавитьИменаКэша(Таблица, Виденные, Кэш)
	
	Для Каждого ЭлементИмени Из Кэш.Виденные Цикл
		Если Виденные.Получить(ЭлементИмени.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Виденные.Вставить(ЭлементИмени.Ключ, Истина);
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Имя = ЭлементИмени.Ключ;
	КонецЦикла;
	
КонецПроцедуры

Процедура Ссыл_ДобавитьПредупрежденияТрехФайлов(Кэш1, Кэш2, Кэш3, Предупреждения)
	
	Период1 = Ссыл_ТекстПериодаСравнения(Кэш1.ПериодНачало, Кэш1.ПериодКонец);
	Период2 = Ссыл_ТекстПериодаСравнения(Кэш2.ПериодНачало, Кэш2.ПериодКонец);
	Период3 = Ссыл_ТекстПериодаСравнения(Кэш3.ПериодНачало, Кэш3.ПериодКонец);
	Если Период1 <> Период2 Или Период1 <> Период3 Тогда
		Предупреждения.Добавить("Периоды документов в файлах различаются. Файл 1: " + Период1 + ". Файл 2: " + Период2 + ". Файл 3: " + Период3 + ".");
	КонецЕсли;
	
	Если Кэш1.ТекстОтборов <> Кэш2.ТекстОтборов Или Кэш1.ТекстОтборов <> Кэш3.ТекстОтборов Тогда
		Предупреждения.Добавить("Отборы выгрузки в трех файлах различаются. В каждом файле уже лежат объекты, отобранные при его выгрузке.");
	КонецЕсли;
	
	Если Кэш1.Конфигурация <> "" И Кэш2.Конфигурация <> "" И Кэш1.Конфигурация <> Кэш2.Конфигурация
		Или Кэш1.Конфигурация <> "" И Кэш3.Конфигурация <> "" И Кэш1.Конфигурация <> Кэш3.Конфигурация Тогда
		Предупреждения.Добавить("Файлы выгружены из разных конфигураций: """ + Кэш1.Конфигурация + """, """ + Кэш2.Конфигурация + """, """ + Кэш3.Конфигурация + """.");
	КонецЕсли;
	
КонецПроцедуры

Процедура Ссыл_ДобавитьПредупрежденияКэша(Предупреждения, ИмяФайла, Кэш)
	
	Для Каждого Текст Из Кэш.Предупреждения Цикл
		Предупреждения.Добавить(ИмяФайла + ": " + Текст);
	КонецЦикла;
	
КонецПроцедуры

Процедура Ссыл_СравнитьТипТрехФайлов(ПолноеИмя, Кэш1, Кэш2, Кэш3, Дерево, Статистика, Предупреждения, Счетчик, Итоги)
	
	Карта1 = Ссыл_КартаОбъектовКэша(Кэш1, ПолноеИмя);
	Карта2 = Ссыл_КартаОбъектовКэша(Кэш2, ПолноеИмя);
	Карта3 = Ссыл_КартаОбъектовКэша(Кэш3, ПолноеИмя);
	Итоги.ВФайле1 = Итоги.ВФайле1 + Карта1.Количество();
	Итоги.ВФайле2 = Итоги.ВФайле2 + Карта2.Количество();
	Итоги.ВФайле3 = Итоги.ВФайле3 + Карта3.Количество();
	
	СтрокаСтатистики = Ссыл_ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, Карта1.Количество(), Карта2.Количество(), 0, 0, 0);
	
	Если Кэш1.Виденные.Получить(ПолноеИмя) = Неопределено
		И Кэш2.Виденные.Получить(ПолноеИмя) = Неопределено
		И Кэш3.Виденные.Получить(ПолноеИмя) = Неопределено Тогда
		Предупреждения.Добавить(ПолноеИмя + ": объекта нет ни в одном из трех файлов.");
	КонецЕсли;
	
	ТекстОшибки = Ссыл_ТекстОшибкиТипаТрехФайлов(Кэш1, Кэш2, Кэш3, ПолноеИмя);
	Если ТекстОшибки <> "" Тогда
		Если Ссыл_МожноДобавитьСтрокуОтчета(Счетчик) Тогда
			Родитель = Дерево.Строки.Добавить();
			Родитель.Объект = ПолноеИмя;
			Родитель.ВидОтличия = "Ошибка";
			Родитель.Представление = ПолноеИмя;
			Родитель.Как = ТекстОшибки;
			Родитель.Где = "ошибка чтения";
			Родитель.СколькоРаз = 0;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Синоним = Ссыл_СинонимТрехФайлов(Кэш1, Кэш2, Кэш3, ПолноеИмя);
	Ключи = Ссыл_КлючиТрехКарт(Карта1, Карта2, Карта3);
	
	Для Каждого Ключ Из Ключи Цикл
		Ссыл_ДобавитьОбъектТрехФайлов(ПолноеИмя, Синоним, Ключ, Карта1, Карта2, Карта3, Дерево, СтрокаСтатистики, Счетчик, Итоги);
	КонецЦикла;
	
КонецПроцедуры

Функция Ссыл_КартаОбъектовКэша(Кэш, ПолноеИмя)
	
	Карта = Кэш.Объекты.Получить(ПолноеИмя);
	Если Карта = Неопределено Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат Карта;
	
КонецФункции

Функция Ссыл_ТекстОшибкиТипаТрехФайлов(Кэш1, Кэш2, Кэш3, ПолноеИмя)
	
	Части = Новый Массив;
	Ссыл_ДобавитьОшибкуФайла(Части, "Файл 1", Кэш1, ПолноеИмя);
	Ссыл_ДобавитьОшибкуФайла(Части, "Файл 2", Кэш2, ПолноеИмя);
	Ссыл_ДобавитьОшибкуФайла(Части, "Файл 3", Кэш3, ПолноеИмя);
	Возврат Ссыл_СоединитьСтроки(Части, " ");
	
КонецФункции

Процедура Ссыл_ДобавитьОшибкуФайла(Части, ИмяФайла, Кэш, ПолноеИмя)
	
	Текст = Кэш.Ошибки.Получить(ПолноеИмя);
	Если Текст = Неопределено Или Текст = "" Тогда
		Возврат;
	КонецЕсли;
	Части.Добавить(ИмяФайла + ": " + Текст);
	
КонецПроцедуры

Функция Ссыл_СинонимТрехФайлов(Кэш1, Кэш2, Кэш3, ПолноеИмя)
	
	Текст = Ссыл_СинонимКэша(Кэш1, ПолноеИмя);
	Если Текст = "" Тогда
		Текст = Ссыл_СинонимКэша(Кэш2, ПолноеИмя);
	КонецЕсли;
	Если Текст = "" Тогда
		Текст = Ссыл_СинонимКэша(Кэш3, ПолноеИмя);
	КонецЕсли;
	Если Текст <> "" Тогда
		Возврат Текст;
	КонецЕсли;
	
	Позиция = Найти(ПолноеИмя, ".");
	Если Позиция > 0 Тогда
		Возврат Сред(ПолноеИмя, Позиция + 1);
	КонецЕсли;
	Возврат ПолноеИмя;
	
КонецФункции

Функция Ссыл_СинонимКэша(Кэш, ПолноеИмя)
	
	Текст = Кэш.Синонимы.Получить(ПолноеИмя);
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Текст);
	
КонецФункции

Функция Ссыл_КлючиТрехКарт(Карта1, Карта2, Карта3)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Виденные = Новый Соответствие;
	Ссыл_ДобавитьКлючиКарты(Таблица, Виденные, Карта1);
	Ссыл_ДобавитьКлючиКарты(Таблица, Виденные, Карта2);
	Ссыл_ДобавитьКлючиКарты(Таблица, Виденные, Карта3);
	Таблица.Сортировать("Ключ");
	
	Ключи = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключи.Добавить(СтрокаТаблицы.Ключ);
	КонецЦикла;
	Возврат Ключи;
	
КонецФункции

Процедура Ссыл_ДобавитьКлючиКарты(Таблица, Виденные, Карта)
	
	Для Каждого ЭлементОбъекта Из Карта Цикл
		Если Виденные.Получить(ЭлементОбъекта.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Виденные.Вставить(ЭлементОбъекта.Ключ, Истина);
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Ключ = ЭлементОбъекта.Ключ;
	КонецЦикла;
	
КонецПроцедуры

Процедура Ссыл_ДобавитьОбъектТрехФайлов(ПолноеИмя, Синоним, Ключ, Карта1, Карта2, Карта3, Дерево, СтрокаСтатистики, Счетчик, Итоги)
	
	Версии = Новый Массив;
	Версии.Добавить(Карта1.Получить(Ключ));
	Версии.Добавить(Карта2.Получить(Ключ));
	Версии.Добавить(Карта3.Получить(Ключ));
	
	Индекс = Новый Соответствие;
	Порядок = Новый Массив;
	Ссыл_ИндексПолейТрехВерсий(Версии, Индекс, Порядок);
	
	Шаг12 = Ссыл_ШагТрехФайловИзменился(Версии, Индекс, Порядок, 0, 1);
	Шаг23 = Ссыл_ШагТрехФайловИзменился(Версии, Индекс, Порядок, 1, 2);
	СколькоРаз = 0;
	Если Шаг12 Тогда
		СколькоРаз = СколькоРаз + 1;
	КонецЕсли;
	Если Шаг23 Тогда
		СколькоРаз = СколькоРаз + 1;
	КонецЕсли;
	
	Если СколькоРаз = 0 Тогда
		Итоги.БезОтличий = Итоги.БезОтличий + 1;
		Возврат;
	КонецЕсли;
	
	Если СколькоРаз = 2 Тогда
		Итоги.ДваРаза = Итоги.ДваРаза + 1;
		Вид = "Изменен 2 раза";
		СтрокаСтатистики.ТолькоВФайле = СтрокаСтатистики.ТолькоВФайле + 1;
	Иначе
		Итоги.ОдинРаз = Итоги.ОдинРаз + 1;
		Вид = "Изменен 1 раз";
		СтрокаСтатистики.ТолькоВБазе = СтрокаСтатистики.ТолькоВБазе + 1;
	КонецЕсли;
	
	ЧастиКак = Новый Массив;
	Если Шаг12 Тогда
		ЧастиКак.Добавить(Ссыл_ТекстШагаТрехФайлов(Версии, Индекс, Порядок, 0, 1));
	КонецЕсли;
	Если Шаг23 Тогда
		ЧастиКак.Добавить(Ссыл_ТекстШагаТрехФайлов(Версии, Индекс, Порядок, 1, 2));
	КонецЕсли;
	Если Версии[0] <> Неопределено И Версии[2] <> Неопределено И Версии[1] = Неопределено Тогда
		ЧислоКрая = Ссыл_ЧислоКолонокШага(Версии, Индекс, Порядок, 0, 2);
		Если ЧислоКрая = 0 Тогда
			ЧастиКак.Добавить("в файле 3 содержимое совпало с файлом 1");
		Иначе
			ЧастиКак.Добавить("файл 1 и файл 3 различаются, колонок: " + Ссыл_ФорматЧисла(ЧислоКрая));
		КонецЕсли;
	КонецЕсли;
	
	Если Не Ссыл_МожноДобавитьСтрокуОтчета(Счетчик) Тогда
		Возврат;
	КонецЕсли;
	
	Родитель = Дерево.Строки.Добавить();
	Родитель.Объект = ПолноеИмя;
	Родитель.ВидОтличия = Вид;
	Родитель.Представление = Ссыл_ПредставлениеТрехВерсий(Версии, Синоним);
	Родитель.Ссылка = Ключ;
	Родитель.СколькоРаз = СколькоРаз;
	Родитель.Где = Ссыл_ГдеТрехВерсий(Версии);
	Родитель.Как = Ссыл_СоединитьСтроки(ЧастиКак, "; ");
	
	ЕстьКолонки = Ложь;
	Для Каждого ИмяПоля Из Порядок Цикл
		ОписаниеКолонки = Ссыл_ОписаниеКолонкиТрехФайлов(Версии, Индекс, ИмяПоля);
		Если Не ОписаниеКолонки.Изменилась Тогда
			Продолжить;
		КонецЕсли;
		Если Не Ссыл_МожноДобавитьСтрокуОтчета(Счетчик) Тогда
			Прервать;
		КонецЕсли;
		ЕстьКолонки = Истина;
		Дочерняя = Родитель.Строки.Добавить();
		Дочерняя.Объект = ПолноеИмя;
		Дочерняя.ВидОтличия = Вид;
		Дочерняя.Представление = ИмяПоля;
		Дочерняя.Ссылка = Ключ;
		Дочерняя.ИмяПоля = ИмяПоля;
		Дочерняя.ЗначениеВБазе = ОписаниеКолонки.Значение1;
		Дочерняя.ЗначениеВФайле = ОписаниеКолонки.Значение2;
		Дочерняя.Значение3 = ОписаниеКолонки.Значение3;
		Дочерняя.СколькоРаз = ОписаниеКолонки.СколькоРаз;
		Дочерняя.Как = ОписаниеКолонки.Как;
		Дочерняя.Где = Родитель.Где;
	КонецЦикла;
	
	Если ЕстьКолонки Тогда
		СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура Ссыл_ИндексПолейТрехВерсий(Версии, Индекс, Порядок)
	
	Для НомерВерсии = 0 По 2 Цикл
		ОбъектФайла = Версии[НомерВерсии];
		Если ОбъектФайла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ЭлементПоля Из ОбъектФайла.Поля Цикл
			Ссыл_УчестьПолеВерсии(Индекс, Порядок, ЭлементПоля.Ключ, НомерВерсии + 1, ЭлементПоля.Значение);
		КонецЦикла;
		Для Каждого ЭлементСтроки Из ОбъектФайла.Строки Цикл
			СтрокаТаблицы = ЭлементСтроки.Значение;
			Префикс = СтрокаТаблицы.ИмяТаблицы + "[" + Ссыл_ФорматЧисла(СтрокаТаблицы.НомерСтроки) + "].";
			Для Каждого ЭлементПоля Из СтрокаТаблицы.Поля Цикл
				Ссыл_УчестьПолеВерсии(Индекс, Порядок, Префикс + ЭлементПоля.Ключ, НомерВерсии + 1, ЭлементПоля.Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура Ссыл_УчестьПолеВерсии(Индекс, Порядок, ИмяПоля, НомерВерсии, ЗначениеПоля)
	
	Состояния = Индекс.Получить(ИмяПоля);
	Если Состояния = Неопределено Тогда
		Состояния = Новый Массив;
		Для Номер = 1 По 3 Цикл
			Состояния.Добавить(Новый Структура("ЕстьПоле, Канон, Представление", Ложь, "<нет поля>", ""));
		КонецЦикла;
		Индекс.Вставить(ИмяПоля, Состояния);
		Порядок.Добавить(ИмяПоля);
	КонецЕсли;
	
	Состояние = Состояния[НомерВерсии - 1];
	Состояние.ЕстьПоле = Истина;
	Состояние.Канон = ЗначениеПоля.Канон;
	Состояние.Представление = ЗначениеПоля.Представление;
	
КонецПроцедуры

Функция Ссыл_ШагТрехФайловИзменился(Версии, Индекс, Порядок, Левый, Правый)
	
	ЛевыйЕсть = Версии[Левый] <> Неопределено;
	ПравыйЕсть = Версии[Правый] <> Неопределено;
	Если ЛевыйЕсть <> ПравыйЕсть Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не ЛевыйЕсть Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Ссыл_ЧислоКолонокШага(Версии, Индекс, Порядок, Левый, Правый) > 0;
	
КонецФункции

Функция Ссыл_ЧислоКолонокШага(Версии, Индекс, Порядок, Левый, Правый)
	
	Если Версии[Левый] = Неопределено Или Версии[Правый] = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Количество = 0;
	Для Каждого ИмяПоля Из Порядок Цикл
		Состояния = Индекс.Получить(ИмяПоля);
		Если Ссыл_КанонВерсии(Версии, Состояния, Левый) <> Ссыл_КанонВерсии(Версии, Состояния, Правый) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

Функция Ссыл_КанонВерсии(Версии, Состояния, ИндексВерсии)
	
	Если Версии[ИндексВерсии] = Неопределено Тогда
		Возврат "<нет объекта>";
	КонецЕсли;
	Возврат Состояния[ИндексВерсии].Канон;
	
КонецФункции

Функция Ссыл_ТекстВерсии(Версии, Состояния, ИндексВерсии)
	
	Если Версии[ИндексВерсии] = Неопределено Тогда
		Возврат "нет объекта";
	КонецЕсли;
	Если Не Состояния[ИндексВерсии].ЕстьПоле Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ссыл_РаскрытьПереводыСтрок(Состояния[ИндексВерсии].Представление);
	
КонецФункции

Функция Ссыл_ТекстШагаТрехФайлов(Версии, Индекс, Порядок, Левый, Правый)
	
	Если Версии[Левый] = Неопределено И Версии[Правый] <> Неопределено Тогда
		Если Правый = 1 Тогда
			Возврат "появился в файле 2";
		КонецЕсли;
		Возврат "появился в файле 3";
	КонецЕсли;
	
	Если Версии[Левый] <> Неопределено И Версии[Правый] = Неопределено Тогда
		Если Правый = 1 Тогда
			Возврат "удален в файле 2";
		КонецЕсли;
		Возврат "удален в файле 3";
	КонецЕсли;
	
	ТекстКолонок = Ссыл_ФорматЧисла(Ссыл_ЧислоКолонокШага(Версии, Индекс, Порядок, Левый, Правый));
	Если Левый = 0 Тогда
		Возврат "между файлом 1 и файлом 2 изменено колонок: " + ТекстКолонок;
	КонецЕсли;
	Возврат "между файлом 2 и файлом 3 изменено колонок: " + ТекстКолонок;
	
КонецФункции

Функция Ссыл_ГдеТрехВерсий(Версии)
	
	Части = Новый Массив;
	Если Версии[0] <> Неопределено Тогда
		Части.Добавить("файл 1");
	КонецЕсли;
	Если Версии[1] <> Неопределено Тогда
		Части.Добавить("файл 2");
	КонецЕсли;
	Если Версии[2] <> Неопределено Тогда
		Части.Добавить("файл 3");
	КонецЕсли;
	Возврат Ссыл_СоединитьСтроки(Части, ", ");
	
КонецФункции

Функция Ссыл_ПредставлениеТрехВерсий(Версии, Синоним)
	
	// В 8.2.13 цикл Для идет только вверх, поэтому последняя версия считается как 2 - Номер.
	Для Номер = 0 По 2 Цикл
		ИндексВерсии = 2 - Номер;
		Если Версии[ИндексВерсии] <> Неопределено Тогда
			Возврат Ссыл_ПредставлениеИзФайла(Версии[ИндексВерсии], Синоним);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
	
КонецФункции

Функция Ссыл_ОписаниеКолонкиТрехФайлов(Версии, Индекс, ИмяПоля)
	
	Состояния = Индекс.Получить(ИмяПоля);
	Раз12 = Версии[0] <> Неопределено И Версии[1] <> Неопределено
		И Ссыл_КанонВерсии(Версии, Состояния, 0) <> Ссыл_КанонВерсии(Версии, Состояния, 1);
	Раз23 = Версии[1] <> Неопределено И Версии[2] <> Неопределено
		И Ссыл_КанонВерсии(Версии, Состояния, 1) <> Ссыл_КанонВерсии(Версии, Состояния, 2);
	РазКрай = Версии[0] <> Неопределено И Версии[2] <> Неопределено И Версии[1] = Неопределено
		И Ссыл_КанонВерсии(Версии, Состояния, 0) <> Ссыл_КанонВерсии(Версии, Состояния, 2);
	
	Описание = Новый Структура("Изменилась, СколькоРаз, Как, Значение1, Значение2, Значение3", Ложь, 0, "", "", "", "");
	Если Не Раз12 И Не Раз23 И Не РазКрай Тогда
		Возврат Описание;
	КонецЕсли;
	
	СколькоРаз = 0;
	Части = Новый Массив;
	Если Раз12 Тогда
		СколькоРаз = СколькоРаз + 1;
		Части.Добавить("файл 1 → файл 2");
	КонецЕсли;
	Если Раз23 Тогда
		СколькоРаз = СколькоРаз + 1;
		Части.Добавить("файл 2 → файл 3");
	КонецЕсли;
	Если РазКрай Тогда
		Если СколькоРаз = 0 Тогда
			СколькоРаз = 1;
		КонецЕсли;
		Части.Добавить("файл 1 и файл 3");
	КонецЕсли;
	
	Описание.Изменилась = Истина;
	Описание.СколькоРаз = СколькоРаз;
	Описание.Как = Ссыл_СоединитьСтроки(Части, "; ");
	Описание.Значение1 = Ссыл_ТекстВерсии(Версии, Состояния, 0);
	Описание.Значение2 = Ссыл_ТекстВерсии(Версии, Состояния, 1);
	Описание.Значение3 = Ссыл_ТекстВерсии(Версии, Состояния, 2);
	Возврат Описание;
	
КонецФункции

Функция Ссыл_МожноДобавитьСтрокуОтчета(Счетчик)
	
	Счетчик.Всего = Счетчик.Всего + 1;
	Если Счетчик.Строк >= Ссыл_МаксимальноеКоличествоСтрокРезультата() Тогда
		Счетчик.Обрезано = Истина;
		Возврат Ложь;
	КонецЕсли;
	Счетчик.Строк = Счетчик.Строк + 1;
	Возврат Истина;
	
КонецФункции

Функция Ссыл_НоваяТаблицаОтличий()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Объект", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ВидОтличия", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВБазе", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
	
КонецФункции

Функция Ссыл_НоваяСтатистика()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗаписейВБазе", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ЗаписейВФайле", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ТолькоВБазе", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ТолькоВФайле", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Расхождений", Новый ОписаниеТипов("Число"));
	Возврат Таблица;
	
КонецФункции

Функция Ссыл_ДобавитьСтрокуСтатистики(Статистика, ПолноеИмя, ЗаписейВБазе, ЗаписейВФайле, ТолькоВБазе, ТолькоВФайле, Расхождений)
	
	СтрокаСтатистики = Статистика.Добавить();
	СтрокаСтатистики.ПолноеИмя = ПолноеИмя;
	СтрокаСтатистики.ЗаписейВБазе = ЗаписейВБазе;
	СтрокаСтатистики.ЗаписейВФайле = ЗаписейВФайле;
	СтрокаСтатистики.ТолькоВБазе = ТолькоВБазе;
	СтрокаСтатистики.ТолькоВФайле = ТолькоВФайле;
	СтрокаСтатистики.Расхождений = Расхождений;
	Возврат СтрокаСтатистики;
	
КонецФункции

Процедура Ссыл_ДобавитьОтличие(Отличия, Объект, ВидОтличия, Ссылка, ИмяПоля, ЗначениеВБазе, ЗначениеВФайле, ВсегоОтличий, Обрезано, Ключ = "")
	
	ВсегоОтличий = ВсегоОтличий + 1;
	Если Отличия.Количество() >= Ссыл_МаксимальноеКоличествоСтрокРезультата() Тогда
		Обрезано = Истина;
		Возврат;
	КонецЕсли;
	
	СтрокаОтличия = Отличия.Добавить();
	СтрокаОтличия.Объект = Объект;
	СтрокаОтличия.ВидОтличия = ВидОтличия;
	СтрокаОтличия.Ссылка = Ссыл_РаскрытьПереводыСтрок(Ссылка);
	СтрокаОтличия.ИмяПоля = ИмяПоля;
	СтрокаОтличия.ЗначениеВБазе = Ссыл_РаскрытьПереводыСтрок(ЗначениеВБазе);
	СтрокаОтличия.ЗначениеВФайле = Ссыл_РаскрытьПереводыСтрок(ЗначениеВФайле);
	СтрокаОтличия.Ключ = Ключ;
	
КонецПроцедуры

Функция Ссыл_МаксимальноеКоличествоСтрокРезультата()
	
	Возврат 100000;
	
КонецФункции

Процедура Ссыл_ЗаписатьОшибку(Запись, ПолноеИмя, ТекстОшибки)
	
	Запись.ЗаписатьНачалоЭлемента("Error");
	Запись.ЗаписатьАтрибут("meta", Ссыл_ТекстXML(ПолноеИмя));
	Запись.ЗаписатьАтрибут("text", Ссыл_ТекстXML(ТекстОшибки));
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура Ссыл_ПредупредитьОНевыбранныхОтборах(ПолныеИмена, Отборы, Предупреждения)
	
	Выбранные = Новый Соответствие;
	Для Каждого ПолноеИмя Из ПолныеИмена Цикл
		Выбранные.Вставить(ПолноеИмя, Истина);
	КонецЦикла;
	
	УжеПоказаны = Новый Соответствие;
	Для Каждого Отбор Из Отборы Цикл
		Если Не ЗначениеЗаполнено(Отбор.Поле) Или Не ЗначениеЗаполнено(Отбор.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если Выбранные.Получить(Отбор.ПолноеИмя) <> Неопределено Или УжеПоказаны.Получить(Отбор.ПолноеИмя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеПоказаны.Вставить(Отбор.ПолноеИмя, Истина);
		Предупреждения.Добавить(Отбор.ПолноеИмя + ": отбор не использован, объект не выбран.");
	КонецЦикла;
	
КонецПроцедуры

Функция Ссыл_ТекстОтборов(Отборы)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));
	
	Для Каждого Отбор Из Отборы Цикл
		Если Не ЗначениеЗаполнено(Отбор.Поле) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Текст = СокрЛП(Строка(Отбор.ПолноеИмя)) + " | " + СокрЛП(Строка(Отбор.Поле))
			+ " | " + СокрЛП(Строка(Отбор.ВидСравнения)) + " | " + СокрЛП(Строка(Отбор.Значение));
	КонецЦикла;
	
	Таблица.Сортировать("Текст");
	Части = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Части.Добавить(СтрокаТаблицы.Текст);
	КонецЦикла;
	
	Возврат Ссыл_СоединитьСтроки(Части, Символы.ПС);
	
КонецФункции

Функция Ссыл_КоличествоЗаданныхОтборов(Отборы)
	
	Количество = 0;
	Для Каждого Отбор Из Отборы Цикл
		Если ЗначениеЗаполнено(Отбор.Поле) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

Процедура Ссыл_ДобавитьКоллекциюМетаданных(Таблица, Коллекция, Вид)
	
	Для Каждого Мета Из Коллекция Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Вид = Вид;
		СтрокаТаблицы.Имя = Мета.Имя;
		СтрокаТаблицы.ПолноеИмя = Вид + "." + Мета.Имя;
		Синоним = Строка(Мета.Синоним);
		Если Не ЗначениеЗаполнено(Синоним) Тогда
			Синоним = Мета.Имя;
		КонецЕсли;
		СтрокаТаблицы.Синоним = Синоним;
		СтрокаТаблицы.ЕстьВБазе = Истина;
	КонецЦикла;
	
КонецПроцедуры

Функция Ссыл_МетаданныеПоПолномуИмени(ПолноеИмя)
	
	Позиция = Найти(ПолноеИмя, ".");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Вид = Лев(ПолноеИмя, Позиция - 1);
	Имя = Сред(ПолноеИмя, Позиция + 1);
	
	Если Вид = "Справочник" Тогда
		Возврат Метаданные.Справочники.Найти(Имя);
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Метаданные.Документы.Найти(Имя);
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат Метаданные.ПланыВидовХарактеристик.Найти(Имя);
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат Метаданные.ПланыСчетов.Найти(Имя);
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат Метаданные.ПланыВидовРасчета.Найти(Имя);
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат Метаданные.ПланыОбмена.Найти(Имя);
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат Метаданные.БизнесПроцессы.Найти(Имя);
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Метаданные.Задачи.Найти(Имя);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция Ссыл_ВидПоПолномуИмени(ПолноеИмя)
	
	Позиция = Найти(ПолноеИмя, ".");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Лев(ПолноеИмя, Позиция - 1);
	
КонецФункции

Функция Ссыл_ИмяТипаСсылкиМетаданных(Мета)
	
	ПолноеИмя = Мета.ПолноеИмя();
	Позиция = Найти(ПолноеИмя, ".");
	Возврат Лев(ПолноеИмя, Позиция - 1) + "Ссылка." + Сред(ПолноеИмя, Позиция + 1);
	
КонецФункции

Функция Ссыл_ТекстПериодаСравнения(НачалоПериода, КонецПериода)
	
	Если Не ЗначениеЗаполнено(НачалоПериода) И Не ЗначениеЗаполнено(КонецПериода) Тогда
		Возврат "без ограничения";
	КонецЕсли;
	
	Возврат Формат(НачалоПериода, "ДЛФ=DT") + " — " + Формат(КонецПериода, "ДЛФ=DT");
	
КонецФункции

Функция Ссыл_ДатаВАтрибут(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
