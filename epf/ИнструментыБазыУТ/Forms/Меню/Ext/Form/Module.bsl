
&НаКлиенте
Процедура ОткрытьИнструмент(ИмяФормыНазначения)
	
	Попытка
		ОткрытьФорму(ИмяИнструмента(ИмяФормыНазначения));
	Исключение
		Предупреждение(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ИмяИнструмента(ИмяФормыНазначения)
	
	ИмяТекущей = ЭтаФорма.ИмяФормы;
	Маркер = ".Форма.";
	Позиция = Найти(ИмяТекущей, Маркер);
	Если Позиция = 0 Тогда
		Маркер = ".Form.";
		Позиция = Найти(ИмяТекущей, Маркер);
	КонецЕсли;
	
	Если Позиция = 0 Тогда
		ВызватьИсключение "Не удалось определить имя формы " + ИмяФормыНазначения + ". Текущая форма: " + ИмяТекущей + ".";
	КонецЕсли;
	
	Возврат Лев(ИмяТекущей, Позиция + СтрДлина(Маркер) - 1) + ИмяФормыНазначения;
	
КонецФункции

&НаКлиенте
Процедура СравнениеНакопления(Команда)
	
