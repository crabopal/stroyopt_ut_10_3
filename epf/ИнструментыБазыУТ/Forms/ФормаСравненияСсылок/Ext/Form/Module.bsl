
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьОбъекты();
	ЗаполнитьСпискиОтбора();
	УстановитьУсловноеОформление();
	Элементы.Объекты.НачальноеОтображениеДерева = НачальноеОтображениеДерева.НеРаскрывать;
	Элементы.Результат.НачальноеОтображениеДерева = НачальноеОтображениеДерева.НеРаскрывать;
	НастроитьПодписиСравнения(Ложь);
	ИтогСравнения = "Отметьте ссылочные объекты. В первой базе выгрузите файл, во второй сравните его с этой базой. Три уже выгруженных файла сравниваются кнопкой «Сравнить три файла».";
	
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	
	Если Не ЕстьВыбранныеОбъекты() Тогда
		Предупреждение("Выберите хотя бы один ссылочный объект.");
		Возврат;
	КонецЕсли;
	
	Если Не ПериодПодтвержден("Выгрузить все документы без ограничения по дате?") Тогда
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить файл выгрузки";
	Диалог.Фильтр = "XML-файл сравнения (*.xml)|*.xml";
	Диалог.Расширение = "xml";
	Диалог.ПолноеИмяФайла = "СравнениеСсылочныхОбъектов.xml";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Выгрузка ссылочных объектов...");
	
	Попытка
		Адрес = ВыгрузитьНаСервере();
	Исключение
		Предупреждение(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если Не ПолучитьФайл(Адрес, Диалог.ПолноеИмяФайла, Ложь) Тогда
		Предупреждение("Не удалось сохранить файл.");
		Возврат;
	КонецЕсли;
	
	ИтогСравнения = ИтогСравнения + Символы.ПС + "Файл: " + Диалог.ПолноеИмяФайла;
	
КонецПроцедуры

&НаКлиенте
Процедура Сравнить(Команда)
	
	Если Не ЕстьВыбранныеОбъекты() Тогда
		Предупреждение("Выберите хотя бы один ссылочный объект.");
		Возврат;
	КонецЕсли;
	
	Если Не ПериодПодтвержден("Сравнить все документы без ограничения по дате?") Тогда
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл выгрузки";
	Диалог.Фильтр = "XML-файл сравнения (*.xml)|*.xml";
	Диалог.Расширение = "xml";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = "";
	Если Не ПоместитьФайл(Адрес, Диалог.ПолноеИмяФайла, , Ложь) Тогда
		Предупреждение("Не удалось передать файл для сравнения.");
		Возврат;
	КонецЕсли;
	
	Состояние("Сравнение ссылочных объектов...");
	
	Попытка
		СравнитьНаСервере(Адрес);
	Исключение
		Предупреждение(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ОтборПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СравнитьТриФайла(Команда)
	
	Адрес1 = АдресВыбранногоФайла("Выберите первый файл сравнения");
	Если Адрес1 = "" Тогда
		Возврат;
	КонецЕсли;
	Адрес2 = АдресВыбранногоФайла("Выберите второй файл сравнения");
	Если Адрес2 = "" Тогда
		Возврат;
	КонецЕсли;
	Адрес3 = АдресВыбранногоФайла("Выберите третий файл сравнения");
	Если Адрес3 = "" Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Сравнение трех файлов...");
	
	Попытка
		СравнитьТриНаСервере(Адрес1, Адрес2, Адрес3);
	Исключение
		Предупреждение(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ОтборПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Функция АдресВыбранногоФайла(ЗаголовокДиалога)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = ЗаголовокДиалога;
	Диалог.Фильтр = "XML-файл сравнения (*.xml)|*.xml";
	Диалог.Расширение = "xml";
	Если Не Диалог.Выбрать() Тогда
		Возврат "";
	КонецЕсли;
	
	Адрес = "";
	Если Не ПоместитьФайл(Адрес, Диалог.ПолноеИмяФайла, , Ложь) Тогда
		Предупреждение("Не удалось передать файл для сравнения.");
		Возврат "";
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	УстановитьПометки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	УстановитьПометки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	ПрименитьОтборРезультатаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборРезультатаНаСервере()
	
	// У таблицы дерева значений нет ОтборСтрок. Полное дерево лежит во временном хранилище.
	Если Не ЗначениеЗаполнено(АдресПолногоРезультата) Тогда
		Результат.ПолучитьЭлементы().Очистить();
		Возврат;
	КонецЕсли;
	
	ПолноеДерево = ПолучитьИзВременногоХранилища(АдресПолногоРезультата);
	Если Не ЗначениеЗаполнено(ОтборОбъект) И Не ЗначениеЗаполнено(ОтборВид) Тогда
		ЗначениеВДанныеФормы(ПолноеДерево, Результат);
	Иначе
		ЗначениеВДанныеФормы(ДеревоРезультатаСОтбором(ПолноеДерево), Результат);
	КонецЕсли;
	Элементы.Результат.НачальноеОтображениеДерева = НачальноеОтображениеДерева.НеРаскрывать;
	
КонецПроцедуры

&НаСервере
Функция ДеревоРезультатаСОтбором(ПолноеДерево)
	
	Дерево = Новый ДеревоЗначений;
	Для Каждого Колонка Из ПолноеДерево.Колонки Цикл
		Дерево.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Для Каждого СтрокаИсточника Из ПолноеДерево.Строки Цикл
		ДобавитьСтрокуРезультатаСОтбором(СтрокаИсточника, Дерево.Строки, Ложь);
	КонецЦикла;
	
	Возврат Дерево;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуРезультатаСОтбором(СтрокаИсточника, СтрокиПриемника, КопироватьВсехПотомков)
	
	СамаПодходит = КопироватьВсехПотомков Или СтрокаРезультатаСоответствуетОтбору(СтрокаИсточника);
	Если Не СамаПодходит И Не ВеткаРезультатаСоответствуетОтбору(СтрокаИсточника) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = СтрокиПриемника.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
	Для Каждого Дочерняя Из СтрокаИсточника.Строки Цикл
		ДобавитьСтрокуРезультатаСОтбором(Дочерняя, НоваяСтрока.Строки, СамаПодходит);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СтрокаРезультатаСоответствуетОтбору(СтрокаДерева)
	
	Если ЗначениеЗаполнено(ОтборОбъект) И СтрокаДерева.Объект <> ОтборОбъект Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборВид) И СтрокаДерева.ВидОтличия <> ОтборВид Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ВеткаРезультатаСоответствуетОтбору(СтрокаДерева)
	
	Для Каждого Дочерняя Из СтрокаДерева.Строки Цикл
		Если СтрокаРезультатаСоответствуетОтбору(Дочерняя) Или ВеткаРезультатаСоответствуетОтбору(Дочерняя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ОбъектыВыбранПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Объекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа Тогда
		УстановитьПометкуСтрок(ТекущиеДанные.ПолучитьЭлементы(), ТекущиеДанные.Выбран);
		ТекущиеДанные.Выбран = ГруппаВыбранаЦеликом(ТекущиеДанные);
	Иначе
		Если Не ТекущиеДанные.ЕстьВБазе Тогда
			ТекущиеДанные.Выбран = Ложь;
			Предупреждение("Объект """ + ТекущиеДанные.ПолноеИмя + """ отсутствует в конфигурации.");
		КонецЕсли;
		Родитель = ТекущиеДанные.ПолучитьРодителя();
		Если Родитель <> Неопределено Тогда
			Родитель.Выбран = ГруппаВыбранаЦеликом(Родитель);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуСтрок(Строки, Пометка)
	
	Для Каждого СтрокаОбъекта Из Строки Цикл
		Если Пометка И Не СтрокаОбъекта.ЕстьВБазе Тогда
			СтрокаОбъекта.Выбран = Ложь;
		Иначе
			СтрокаОбъекта.Выбран = Пометка;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ГруппаВыбранаЦеликом(Группа)
	
	ЕстьДоступные = Ложь;
	Для Каждого СтрокаОбъекта Из Группа.ПолучитьЭлементы() Цикл
		Если Не СтрокаОбъекта.ЕстьВБазе Тогда
			Продолжить;
		КонецЕсли;
		ЕстьДоступные = Истина;
		Если Не СтрокаОбъекта.Выбран Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьДоступные;
	
КонецФункции

&НаКлиенте
Процедура ОтборыПриАктивизацииСтроки(Элемент)
	
	ОбновитьСписокПолейОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборыПолноеИмяПриИзменении(Элемент)
	
	ОбновитьСписокПолейОтбора();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьВыбранныеОбъекты()
	
	Для Каждого Группа Из Объекты.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из Группа.ПолучитьЭлементы() Цикл
			Если СтрокаОбъекта.Выбран Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ЕстьВыбранныеДокументы()
	
	Для Каждого Группа Из Объекты.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из Группа.ПолучитьЭлементы() Цикл
			Если СтрокаОбъекта.Выбран И СтрокаОбъекта.Вид = "Документ" Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ПериодПодтвержден(ТекстВопроса)
	
	Если Не ЕстьВыбранныеДокументы() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Период.ДатаНачала) Или ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Ответ = Вопрос("Период документов не задан. " + ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Возврат Ответ = КодВозвратаДиалога.Да;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометки(Пометка)
	
	Для Каждого Группа Из Объекты.ПолучитьЭлементы() Цикл
		УстановитьПометкуСтрок(Группа.ПолучитьЭлементы(), Пометка);
		Группа.Выбран = ГруппаВыбранаЦеликом(Группа);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере()
	
	СброситьСтатистику();
	АдресПолногоРезультата = "";
	Результат.ПолучитьЭлементы().Очистить();
	НастроитьПодписиСравнения(Ложь);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатВыгрузки = ОбработкаОбъект.Ссыл_Выгрузить(ВыбранныеПолныеИмена(), ОтборыДляВызова(), Период.ДатаНачала, Период.ДатаОкончания);
	ПрименитьСтатистику(РезультатВыгрузки.Статистика);
	ИтогСравнения = РезультатВыгрузки.Сообщение;
	
	Возврат ПоместитьВоВременноеХранилище(РезультатВыгрузки.Данные, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура СравнитьНаСервере(АдресФайла)
	
	СброситьСтатистику();
	НастроитьПодписиСравнения(Ложь);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатСравнения = ОбработкаОбъект.Ссыл_Сравнить(АдресФайла, ВыбранныеПолныеИмена(), ОтборыДляВызова(), Период.ДатаНачала, Период.ДатаОкончания);
	АдресПолногоРезультата = ПоместитьВоВременноеХранилище(РезультатСравнения.Отличия, УникальныйИдентификатор);
	ПрименитьОтборРезультатаНаСервере();
	ПрименитьСтатистику(РезультатСравнения.Статистика);
	ИтогСравнения = РезультатСравнения.Сообщение;
	Элементы.Результат.НачальноеОтображениеДерева = НачальноеОтображениеДерева.НеРаскрывать;
	
КонецПроцедуры

&НаСервере
Функция ВыбранныеПолныеИмена()
	
	Имена = Новый Массив;
	Для Каждого Группа Из Объекты.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из Группа.ПолучитьЭлементы() Цикл
			Если СтрокаОбъекта.Выбран И ЗначениеЗаполнено(СтрокаОбъекта.ПолноеИмя) Тогда
				Имена.Добавить(СтрокаОбъекта.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

&НаСервере
Функция ОтборыДляВызова()
	
	ОтборыВызова = Новый Массив;
	Для Каждого СтрокаОтбора Из Отборы Цикл
		Если Не ЗначениеЗаполнено(СтрокаОтбора.Поле) И Не ЗначениеЗаполнено(СтрокаОтбора.ПолноеИмя) И Не ЗначениеЗаполнено(СтрокаОтбора.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаОтбора.Поле) Тогда
			ВызватьИсключение "В отборе укажите поле.";
		КонецЕсли;
		Вид = СтрокаОтбора.ВидСравнения;
		Если Не ЗначениеЗаполнено(Вид) Тогда
			Вид = "Равно";
		КонецЕсли;
		ОтборыВызова.Добавить(Новый Структура("ПолноеИмя, Поле, ВидСравнения, Значение", СокрЛП(СтрокаОтбора.ПолноеИмя), СокрЛП(СтрокаОтбора.Поле), Вид, СтрокаОтбора.Значение));
	КонецЦикла;
	Возврат ОтборыВызова;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОбъекты()
	
	Корни = Объекты.ПолучитьЭлементы();
	Корни.Очистить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТаблицаМетаданных = ОбработкаОбъект.Ссыл_ТаблицаМетаданных();
	
	ТекущийВид = "";
	Группа = Неопределено;
	Для Каждого СтрокаМетаданных Из ТаблицаМетаданных Цикл
		Если Группа = Неопределено Или СтрокаМетаданных.Вид <> ТекущийВид Тогда
			ТекущийВид = СтрокаМетаданных.Вид;
			Группа = Корни.Добавить();
			Группа.ЭтоГруппа = Истина;
			Группа.Выбран = Ложь;
			Группа.Вид = ТекущийВид;
			Группа.Имя = ТекущийВид;
			Группа.ПолноеИмя = "";
			Группа.Синоним = ПредставлениеВидаМетаданных(ТекущийВид);
			Группа.ЕстьВБазе = Истина;
			ОбнулитьСчетчикиСтроки(Группа);
		КонецЕсли;
		
		СтрокаОбъекта = Группа.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОбъекта, СтрокаМетаданных);
		СтрокаОбъекта.Имя = СтрокаОбъекта.ПолноеИмя;
		СтрокаОбъекта.ЭтоГруппа = Ложь;
		СтрокаОбъекта.Выбран = Ложь;
		ОбнулитьСчетчикиСтроки(СтрокаОбъекта);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокПолейОтбора()
	
	Элементы.ОтборыПоле.СписокВыбора.Очистить();
	Если Элементы.Отборы.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОтбора = Отборы.НайтиПоИдентификатору(Элементы.Отборы.ТекущаяСтрока);
	Если СтрокаОтбора = Неопределено Или Не ЗначениеЗаполнено(СтрокаОтбора.ПолноеИмя) Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Попытка
		ИменаПолей = ОбработкаОбъект.Ссыл_ИменаПолейОтбора(СтрокаОтбора.ПолноеИмя);
	Исключение
		Возврат;
	КонецПопытки;
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Элементы.ОтборыПоле.СписокВыбора.Добавить(ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СброситьСтатистику()
	
	Для Каждого Группа Из Объекты.ПолучитьЭлементы() Цикл
		ОбнулитьСчетчикиСтроки(Группа);
		Для Каждого СтрокаОбъекта Из Группа.ПолучитьЭлементы() Цикл
			ОбнулитьСчетчикиСтроки(СтрокаОбъекта);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьСтатистику(Статистика)
	
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		СтрокаОбъекта = НайтиСтрокуОбъекта(СтрокаСтатистики.ПолноеИмя);
		Если СтрокаОбъекта <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаОбъекта, СтрокаСтатистики);
		КонецЕсли;
	КонецЦикла;
	ПересчитатьИтогиГрупп();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиОтбора()
	
	Элементы.ОтборВид.СписокВыбора.Очистить();
	Элементы.ОтборВид.СписокВыбора.Добавить("Расхождение");
	Элементы.ОтборВид.СписокВыбора.Добавить("Только в этой базе");
	Элементы.ОтборВид.СписокВыбора.Добавить("Только в файле");
	Элементы.ОтборВид.СписокВыбора.Добавить("Ошибка");
	Элементы.ОтборВид.СписокВыбора.Добавить("Изменен 1 раз");
	Элементы.ОтборВид.СписокВыбора.Добавить("Изменен 2 раза");
	
	Элементы.ОтборОбъект.СписокВыбора.Очистить();
	Элементы.ОтборыПолноеИмя.СписокВыбора.Очистить();
	Элементы.ОтборыВидСравнения.СписокВыбора.Очистить();
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Равно");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Не равно");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Больше");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Больше или равно");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Меньше");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Меньше или равно");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Содержит");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("В списке");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Не в списке");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Заполнено");
	Элементы.ОтборыВидСравнения.СписокВыбора.Добавить("Не заполнено");
	
	Для Каждого Группа Из Объекты.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из Группа.ПолучитьЭлементы() Цикл
			Если Не ЗначениеЗаполнено(СтрокаОбъекта.ПолноеИмя) Тогда
				Продолжить;
			КонецЕсли;
			Представление = СтрокаОбъекта.Синоним + " (" + СтрокаОбъекта.ПолноеИмя + ")";
			Элементы.ОтборОбъект.СписокВыбора.Добавить(СтрокаОбъекта.ПолноеИмя, Представление);
			Элементы.ОтборыПолноеИмя.СписокВыбора.Добавить(СтрокаОбъекта.ПолноеИмя, Представление);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбнулитьСчетчикиСтроки(СтрокаОбъекта)
	
	СтрокаОбъекта.ЗаписейВБазе = 0;
	СтрокаОбъекта.ЗаписейВФайле = 0;
	СтрокаОбъекта.ТолькоВБазе = 0;
	СтрокаОбъекта.ТолькоВФайле = 0;
	СтрокаОбъекта.Расхождений = 0;
	
КонецПроцедуры

&НаСервере
Функция НайтиСтрокуОбъекта(ПолноеИмя)
	
	Для Каждого Группа Из Объекты.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаОбъекта Из Группа.ПолучитьЭлементы() Цикл
			Если СтрокаОбъекта.ПолноеИмя = ПолноеИмя Тогда
				Возврат СтрокаОбъекта;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ПересчитатьИтогиГрупп()
	
	Для Каждого Группа Из Объекты.ПолучитьЭлементы() Цикл
		ОбнулитьСчетчикиСтроки(Группа);
		Для Каждого СтрокаОбъекта Из Группа.ПолучитьЭлементы() Цикл
			Группа.ЗаписейВБазе = Группа.ЗаписейВБазе + СтрокаОбъекта.ЗаписейВБазе;
			Группа.ЗаписейВФайле = Группа.ЗаписейВФайле + СтрокаОбъекта.ЗаписейВФайле;
			Группа.ТолькоВБазе = Группа.ТолькоВБазе + СтрокаОбъекта.ТолькоВБазе;
			Группа.ТолькоВФайле = Группа.ТолькоВФайле + СтрокаОбъекта.ТолькоВФайле;
			Группа.Расхождений = Группа.Расхождений + СтрокаОбъекта.Расхождений;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеВидаМетаданных(Вид)
	
	Если Вид = "Справочник" Тогда
		Возврат "Справочники";
	ИначеЕсли Вид = "Документ" Тогда
		Возврат "Документы";
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат "Планы видов характеристик";
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат "Планы счетов";
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат "Планы видов расчета";
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат "Планы обмена";
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат "Бизнес-процессы";
	ИначеЕсли Вид = "Задача" Тогда
		Возврат "Задачи";
	КонецЕсли;
	
	Возврат Вид;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ДобавитьОформлениеРезультата("Расхождение", WebЦвета.СветлоЖелтый);
	ДобавитьОформлениеРезультата("Только в этой базе", WebЦвета.ТусклоРозовый);
	ДобавитьОформлениеРезультата("Только в файле", WebЦвета.Голубой);
	ДобавитьОформлениеРезультата("Ошибка", WebЦвета.Лосось);
	ДобавитьОформлениеРезультата("Изменен 1 раз", WebЦвета.СветлоЖелтый);
	ДобавитьОформлениеРезультата("Изменен 2 раза", WebЦвета.Золотой);
	ДобавитьОформлениеОбъектовСОтличиями();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеРезультата(ВидОтличия, ЦветФона)
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Результат");
	Поле.Использование = Истина;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Результат.ВидОтличия");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = ВидОтличия;
	ОтборЭлемента.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	
КонецПроцедуры

&НаСервере
Процедура СравнитьТриНаСервере(Адрес1, Адрес2, Адрес3)
	
	СброситьСтатистику();
	НастроитьПодписиСравнения(Истина);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатСравнения = ОбработкаОбъект.Ссыл_СравнитьТриФайла(Адрес1, Адрес2, Адрес3, ВыбранныеПолныеИмена());
	АдресПолногоРезультата = ПоместитьВоВременноеХранилище(РезультатСравнения.Отличия, УникальныйИдентификатор);
	ПрименитьОтборРезультатаНаСервере();
	ПрименитьСтатистику(РезультатСравнения.Статистика);
	ИтогСравнения = РезультатСравнения.Сообщение;
	Элементы.Результат.НачальноеОтображениеДерева = НачальноеОтображениеДерева.НеРаскрывать;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПодписиСравнения(ТриФайла)
	
	Если ТриФайла Тогда
		Элементы.РезультатЗначениеВБазе.Заголовок = "Файл 1";
		Элементы.РезультатЗначениеВФайле.Заголовок = "Файл 2";
		Элементы.РезультатЗначение3.Видимость = Истина;
		Элементы.ОбъектыЗаписейВБазе.Заголовок = "В файле 1";
		Элементы.ОбъектыЗаписейВФайле.Заголовок = "В файле 2";
		Элементы.ОбъектыТолькоВБазе.Заголовок = "Один раз";
		Элементы.ОбъектыТолькоВФайле.Заголовок = "Два раза";
		Элементы.ОбъектыРасхождений.Заголовок = "С отличием колонок";
	Иначе
		Элементы.РезультатЗначениеВБазе.Заголовок = "В этой базе";
		Элементы.РезультатЗначениеВФайле.Заголовок = "В файле";
		Элементы.РезультатЗначение3.Видимость = Ложь;
		Элементы.ОбъектыЗаписейВБазе.Заголовок = "В базе";
		Элементы.ОбъектыЗаписейВФайле.Заголовок = "В файле";
		Элементы.ОбъектыТолькоВБазе.Заголовок = "Только в базе";
		Элементы.ОбъектыТолькоВФайле.Заголовок = "Только в файле";
		Элементы.ОбъектыРасхождений.Заголовок = "Расхождений";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеОбъектовСОтличиями()
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование = Истина;
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Объекты");
	Поле.Использование = Истина;
	
	Группа = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	Группа.Использование = Истина;
	
	ДобавитьОтборБольшеНоля(Группа, "Объекты.ТолькоВБазе");
	ДобавитьОтборБольшеНоля(Группа, "Объекты.ТолькоВФайле");
	ДобавитьОтборБольшеНоля(Группа, "Объекты.Расхождений");
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоЖелтый);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОтборБольшеНоля(Группа, ИмяПоля)
	
	ОтборЭлемента = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборЭлемента.ПравоеЗначение = 0;
	ОтборЭлемента.Использование = Истина;
	
КонецПроцедуры
