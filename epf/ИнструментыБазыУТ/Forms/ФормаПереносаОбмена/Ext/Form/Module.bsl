
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокУзлов();
	ОбновитьОписаниеУзла();
	Если Не ЗначениеЗаполнено(ИтогОперации) Тогда
		ИтогОперации = "Выберите узел плана обмена ОбменУправлениеТорговлей103БухгалтерияПредприятия30.";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УзелПриИзменении(Элемент)
	
	ОбновитьОписаниеУзла();
	
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Предупреждение("Выберите узел плана обмена.");
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить регистрацию изменений";
	Диалог.Фильтр = "XML-файл регистрации (*.xml)|*.xml";
	Диалог.Расширение = "xml";
	Диалог.ПолноеИмяФайла = "РегистрацияИзмененийУзлаОбмена.xml";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Выгрузка регистрации изменений...");
	
	Попытка
		Адрес = ВыгрузитьНаСервере();
	Исключение
		Предупреждение(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если Не ПолучитьФайл(Адрес, Диалог.ПолноеИмяФайла, Ложь) Тогда
		Предупреждение("Не удалось сохранить файл.");
		Возврат;
	КонецЕсли;
	
	ИтогОперации = ИтогОперации + Символы.ПС + "Файл: " + Диалог.ПолноеИмяФайла;
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл регистрации изменений";
	Диалог.Фильтр = "XML-файл регистрации (*.xml)|*.xml";
	Диалог.Расширение = "xml";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = "";
	Если Не ПоместитьФайл(Адрес, Диалог.ПолноеИмяФайла, , Ложь, УникальныйИдентификатор) Тогда
		Предупреждение("Не удалось передать файл.");
		Возврат;
	КонецЕсли;
	
	Состояние("Проверка файла регистрации...");
	
	Попытка
		ТекстВопроса = ПроверитьФайлНаСервере(Адрес);
	Исключение
		Предупреждение(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Очистка и загрузка регистрации изменений...");
	
	Попытка
		ЗагрузитьНаСервере(Адрес);
	Исключение
		Предупреждение(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ИтогОперации = ИтогОперации + Символы.ПС + "Файл: " + Диалог.ПолноеИмяФайла;
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	РезультатВыгрузки = ОбработкаОбъект.Обмен_Выгрузить(СсылкаУзла(ОбработкаОбъект));
	ЗначениеВДанныеФормы(РезультатВыгрузки.Статистика, Результат);
	ИтогОперации = РезультатВыгрузки.Сообщение;
	ОбновитьОписаниеУзла();
	Возврат ПоместитьВоВременноеХранилище(РезультатВыгрузки.Данные, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ПроверитьФайлНаСервере(АдресФайла)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Итог = ОбработкаОбъект.Обмен_ПроверитьФайл(АдресФайла, СсылкаУзла(ОбработкаОбъект));
	ЗначениеВДанныеФормы(Итог.Статистика, Результат);
	ИтогОперации = "Файл проверен, загрузка еще не выполнена.";
	Возврат Итог.Сообщение;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьНаСервере(АдресФайла)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Итог = ОбработкаОбъект.Обмен_Загрузить(АдресФайла, СсылкаУзла(ОбработкаОбъект));
	ЗначениеВДанныеФормы(Итог.Статистика, Результат);
	Если ЗначениеЗаполнено(Итог.Узел) Тогда
		Узел = XMLСтрока(Итог.Узел);
		Если Элементы.Узел.СписокВыбора.НайтиПоЗначению(Узел) = Неопределено Тогда
			Элементы.Узел.СписокВыбора.Добавить(Узел, СокрЛП(Итог.Узел.Код) + " " + СокрЛП(Итог.Узел.Наименование));
		КонецЕсли;
	КонецЕсли;
	ИтогОперации = Итог.Сообщение;
	ОбновитьОписаниеУзла();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОписаниеУзла()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОписаниеУзла = ОбработкаОбъект.Обмен_ОписаниеВыбранногоУзла(СсылкаУзла(ОбработкаОбъект));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокУзлов()
	
	Элементы.Узел.СписокВыбора.Очистить();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ИмяПлана = ОбработкаОбъект.Обмен_ИмяПланаОбмена();
	
	Если Метаданные.ПланыОбмена.Найти(ИмяПлана) = Неопределено Тогда
		ИтогОперации = "В конфигурации нет плана обмена " + ИмяПлана + ".";
		Возврат;
	КонецЕсли;
	
	ТекущийУзел = ПланыОбмена[ИмяПлана].ЭтотУзел();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + "Узлы.Ссылка КАК Ссылка,"
		+ Символы.ПС + Символы.Таб + "Узлы.Код КАК Код,"
		+ Символы.ПС + Символы.Таб + "Узлы.Наименование КАК Наименование"
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + "ПланОбмена." + ИмяПлана + " КАК Узлы"
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО"
		+ Символы.ПС + Символы.Таб + "Узлы.Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ИдентификаторКорреспондента = "";
	КоличествоКорреспондентов = 0;
	
	Пока Выборка.Следующий() Цикл
		Представление = СокрЛП(СокрЛП(Выборка.Код) + " " + СокрЛП(Выборка.Наименование));
		Если Выборка.Ссылка = ТекущийУзел Тогда
			Представление = Представление + " (этот узел)";
		Иначе
			КоличествоКорреспондентов = КоличествоКорреспондентов + 1;
			ИдентификаторКорреспондента = XMLСтрока(Выборка.Ссылка);
		КонецЕсли;
		Элементы.Узел.СписокВыбора.Добавить(XMLСтрока(Выборка.Ссылка), Представление);
	КонецЦикла;
	
	Если КоличествоКорреспондентов = 1 Тогда
		Узел = ИдентификаторКорреспондента;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СсылкаУзла(ОбработкаОбъект)
	
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяПлана = ОбработкаОбъект.Обмен_ИмяПланаОбмена();
	Если Метаданные.ПланыОбмена.Найти(ИмяПлана) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат XMLЗначение(Тип("ПланОбменаСсылка." + ИмяПлана), Узел);
	
КонецФункции
