// Подбор нескольких ссылок для отбора «В списке» / «Не в списке».
// Код рассчитан на режим совместимости 8.2.13.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИмяТаблицы = "Документ.ЗаказПокупателя";
	Если Параметры.Свойство("ИмяТаблицы") И ЗначениеЗаполнено(Параметры.ИмяТаблицы) Тогда
		ИмяТаблицы = Параметры.ИмяТаблицы;
	КонецЕсли;
	
	Мета = МетаданныеТаблицыПодбора(ИмяТаблицы);
	Если Мета = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет таблицы " + ИмяТаблицы + ".";
	КонецЕсли;
	
	Список.ПроизвольныйЗапрос = Ложь;
	Список.ДинамическоеСчитываниеДанных = Истина;
	Список.ОсновнаяТаблица = ИмяТаблицы;
	
	Элементы.Список.РежимВыбора = Истина;
	Элементы.Список.МножественныйВыбор = Истина;
	Элементы.Список.РежимВыделения = РежимВыделенияТаблицы.Множественный;
	
	ДобавитьКолонкиСписка(Мета);
	
	Синоним = Мета.Синоним;
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	Заголовок = "Подбор: " + Синоним;
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	ЗавершитьПодбор();
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗавершитьПодбор();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПодбор()
	
	Выбранные = Новый Массив;
	УжеЕсть = Новый Соответствие;
	
	Для Каждого СтрокаСписка Из Элементы.Список.ВыделенныеСтроки Цикл
		ДобавитьСтрокуПодбора(Выбранные, УжеЕсть, СтрокаСписка);
	КонецЦикла;
	
	Если Выбранные.Количество() = 0 Тогда
		ДобавитьСтрокуПодбора(Выбранные, УжеЕсть, Элементы.Список.ТекущаяСтрока);
	КонецЕсли;
	
	Если Выбранные.Количество() = 0 Тогда
		Предупреждение("Выделите одну или несколько строк.");
		Возврат;
	КонецЕсли;
	
	Закрыть(Выбранные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуПодбора(Выбранные, УжеЕсть, СтрокаСписка)
	
	Если Не ЗначениеЗаполнено(СтрокаСписка) Тогда
		Возврат;
	КонецЕсли;
	
	Если УжеЕсть.Получить(СтрокаСписка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УжеЕсть.Вставить(СтрокаСписка, Истина);
	Выбранные.Добавить(СтрокаСписка);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкиСписка(Мета)
	
	Если Метаданные.Перечисления.Содержит(Мета) Тогда
		Возврат;
	КонецЕсли;
	
	Если Метаданные.Документы.Содержит(Мета)
		Или Метаданные.БизнесПроцессы.Содержит(Мета)
		Или Метаданные.Задачи.Содержит(Мета) Тогда
		ДобавитьКолонкуСписка("Дата", "Дата", Ложь);
		ДобавитьКолонкуСписка("Номер", "Номер", Ложь);
	КонецЕсли;
	
	Если Метаданные.Задачи.Содержит(Мета) Тогда
		ДобавитьКолонкуСписка("Наименование", "Наименование", Ложь);
	КонецЕсли;
	
	Если Метаданные.Справочники.Содержит(Мета)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(Мета)
		Или Метаданные.ПланыСчетов.Содержит(Мета)
		Или Метаданные.ПланыВидовРасчета.Содержит(Мета)
		Или Метаданные.ПланыОбмена.Содержит(Мета) Тогда
		Если Мета.ДлинаКода > 0 Тогда
			ДобавитьКолонкуСписка("Код", "Код", Ложь);
		КонецЕсли;
		Если Мета.ДлинаНаименования > 0 Тогда
			ДобавитьКолонкуСписка("Наименование", "Наименование", Ложь);
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьКолонкуСписка("ПометкаУдаления", "Пометка удаления", Истина);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуСписка(ИмяПоля, ЗаголовокКолонки, ЭтоФлажок)
	
	Колонка = Элементы.Добавить("Список" + ИмяПоля, Тип("ПолеФормы"), Элементы.Список);
	Если ЭтоФлажок Тогда
		Колонка.Вид = ВидПоляФормы.ПолеФлажка;
	Иначе
		Колонка.Вид = ВидПоляФормы.ПолеНадписи;
	КонецЕсли;
	Колонка.ПутьКДанным = "Список." + ИмяПоля;
	Колонка.Заголовок = ЗаголовокКолонки;
	
КонецПроцедуры

&НаСервере
Функция МетаданныеТаблицыПодбора(ИмяТаблицы)
	
	Позиция = Найти(ИмяТаблицы, ".");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Вид = Лев(ИмяТаблицы, Позиция - 1);
	Имя = Сред(ИмяТаблицы, Позиция + 1);
	Коллекция = КоллекцияМетаданныхПодбора(Вид);
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Коллекция.Найти(Имя);
	
КонецФункции

&НаСервере
Функция КоллекцияМетаданныхПодбора(Вид)
	
	Если Вид = "Справочник" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Метаданные.Перечисления;
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат Метаданные.ПланыВидовХарактеристик;
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат Метаданные.ПланыСчетов;
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат Метаданные.ПланыВидовРасчета;
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат Метаданные.ПланыОбмена;
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат Метаданные.БизнесПроцессы;
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Метаданные.Задачи;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
