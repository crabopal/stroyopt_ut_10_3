// Внешняя обработка сравнения записей регистров накопления УТ 10.3.
//
// В одной базе записи выбранных регистров за период выгружаются в XML-файл.
// В другой базе файл читается и сравнивается с записями этой базы за период на форме.
// Строка регистра сопоставляется по идентификатору регистратора и номеру строки.
// Ссылочные значения сравниваются по типу XML и UUID, без кода, номера и наименования.
// Сравнивается каждая колонка записи: период, активность, вид движения, измерения, ресурсы, реквизиты.
//
// Сборка EPF из каталога epf (платформа 8.3, режим совместимости конфигурации 8.2.13):
// 1cv8 DESIGNER /F "<база>" /DisableStartupDialogs /LoadExternalDataProcessorOrReportFromFiles "<каталог epf>" "<путь к epf>"
//
// Код рассчитан на режим совместимости 8.2.13: без методов платформы 8.3.6 и новее.

Перем ОписанияТиповСсылок;
Перем КэшСсылочныхТипов;

Функция ИменаРегистровПоУмолчанию() Экспорт
	
	Имена = Новый Массив;
	Имена.Добавить("ВзаиморасчетыСКонтрагентами");
	Имена.Добавить("ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов");
	Имена.Добавить("ДенежныеСредства");
	Имена.Добавить("ДенежныеСредстваКПолучению");
	Имена.Добавить("ДенежныеСредстваКСписанию");
	Имена.Добавить("ЗаказыПокупателей");
	Имена.Добавить("ЗаказыПоставщикам");
	Имена.Добавить("НДСНачисленный");
	Имена.Добавить("НДСПредъявленный");
	Имена.Добавить("НДСРасчетыСПокупателями");
	Имена.Добавить("НДСРасчетыСПоставщиками");
	Имена.Добавить("НДСРеализация0");
	Имена.Добавить("ПартииТоваровНаСкладах");
	Имена.Добавить("РазмещениеЗаказовПокупателей");
	Имена.Добавить("РасчетыСКонтрагентами");
	Имена.Добавить("РозничнаяВыручка");
	Имена.Добавить("ТоварыВРезервеНаСкладах");
	Имена.Добавить("ТоварыКПередачеОрганизаций");
	Имена.Добавить("ТоварыКПередачеСоСкладов");
	Имена.Добавить("ТоварыНаСкладах");
	Имена.Добавить("ТоварыОрганизаций");
	Возврат Имена;
	
КонецФункции

Функция Выгрузить(ИменаРегистров, НачалоПериода, КонецПериода) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры накопления.";
	КонецЕсли;
	
	ИнициализироватьКэшТипов();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	Статистика = НоваяСтатистика();
	Предупреждения = Новый Массив;
	КоличествоЗаписей = 0;
	
	Попытка
		КоличествоЗаписей = ЗаписатьФайлВыгрузки(ИмяФайла, ИменаРегистров, НачалоПериода, КонецПериода, Статистика, Предупреждения);
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьВременныйФайл(ИмяФайла);
	
	Сообщение = "Выгружено записей: " + ФорматЧисла(КоличествоЗаписей) + "."
		+ Символы.ПС + "Период: " + ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Регистров в файле: " + ФорматЧисла(Статистика.Количество()) + ".";
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = "Выгрузка завершена с ошибками." + Символы.ПС + Сообщение
			+ Символы.ПС + ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция Сравнить(АдресФайла, НачалоПериода, КонецПериода, ИменаРегистров) Экспорт
	
	Если ИменаРегистров.Количество() = 0 Тогда
		ВызватьИсключение "Не выбраны регистры накопления.";
	КонецЕсли;
	
	ИнициализироватьКэшТипов();
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Не удалось прочитать файл сравнения.";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДанныеФайла.Записать(ИмяФайла);
	
	Попытка
		КэшФайла = ПрочитатьФайлВыгрузки(ИмяФайла, ИменаРегистров);
	Исключение
		УдалитьВременныйФайл(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьВременныйФайл(ИмяФайла);
	
	Отличия = НоваяТаблицаОтличий();
	Статистика = НоваяСтатистика();
	Предупреждения = КэшФайла.Предупреждения;
	Обрезано = Ложь;
	ВсегоОтличий = 0;
	
	Если ДатаВАтрибут(НачалоПериода) <> ДатаВАтрибут(КэшФайла.ПериодНачало)
		Или ДатаВАтрибут(КонецПериода) <> ДатаВАтрибут(КэшФайла.ПериодКонец) Тогда
		Предупреждения.Добавить("Период на форме (" + ТекстПериодаСравнения(НачалоПериода, КонецПериода)
			+ ") отличается от периода файла (" + ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец)
			+ "). Записи этой базы отобраны за период на форме.");
	КонецЕсли;
	
	Если КэшФайла.Конфигурация <> "" И КэшФайла.Конфигурация <> Метаданные.Имя Тогда
		Предупреждения.Добавить("Файл выгружен из конфигурации """ + КэшФайла.Конфигурация
			+ """, текущая конфигурация """ + Метаданные.Имя + """.");
	КонецЕсли;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		СравнитьРегистр(ИмяРегистра, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано);
	КонецЦикла;
	
	Отличия.Сортировать("Регистр, Регистратор, НомерСтроки, ИмяПоля");
	
	ВсегоВБазе = 0;
	ВсегоВФайле = 0;
	ТолькоВБазе = 0;
	ТолькоВФайле = 0;
	Расхождений = 0;
	Для Каждого СтрокаСтатистики Из Статистика Цикл
		ВсегоВБазе = ВсегоВБазе + СтрокаСтатистики.ЗаписейВБазе;
		ВсегоВФайле = ВсегоВФайле + СтрокаСтатистики.ЗаписейВФайле;
		ТолькоВБазе = ТолькоВБазе + СтрокаСтатистики.ТолькоВБазе;
		ТолькоВФайле = ТолькоВФайле + СтрокаСтатистики.ТолькоВФайле;
		Расхождений = Расхождений + СтрокаСтатистики.Расхождений;
	КонецЦикла;
	
	Сообщение = "Период сравнения: " + ТекстПериодаСравнения(НачалоПериода, КонецПериода) + "."
		+ Символы.ПС + "Период файла: " + ТекстПериодаСравнения(КэшФайла.ПериодНачало, КэшФайла.ПериодКонец) + "."
		+ Символы.ПС + "Записей в этой базе: " + ФорматЧисла(ВсегоВБазе) + ", в файле: " + ФорматЧисла(ВсегоВФайле) + "."
		+ Символы.ПС + "Только в этой базе: " + ФорматЧисла(ТолькоВБазе)
		+ ", только в файле: " + ФорматЧисла(ТолькоВФайле)
		+ ", расхождений по колонкам: " + ФорматЧисла(Расхождений) + ".";
	
	Если ВсегоОтличий = 0 Тогда
		Сообщение = Сообщение + Символы.ПС + "Отличий не найдено.";
	КонецЕсли;
	
	Если Обрезано Тогда
		Сообщение = Сообщение + Символы.ПС + "В таблицу выведены первые " + ФорматЧисла(МаксимальноеКоличествоСтрокРезультата())
			+ " строк отличий из " + ФорматЧисла(ВсегоОтличий) + ".";
	КонецЕсли;
	
	Если Предупреждения.Количество() > 0 Тогда
		Сообщение = Сообщение + Символы.ПС + ТекстПредупреждений(Предупреждения);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Отличия", Отличия);
	Результат.Вставить("Статистика", Статистика);
	Результат.Вставить("Сообщение", Сообщение);
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьФайлВыгрузки(ИмяФайла, ИменаРегистров, НачалоПериода, КонецПериода, Статистика, Предупреждения)
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла, "UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьКомментарий("Ключ записи: тип и UUID регистратора и номер строки. Ссылки сравниваются по типу XML и UUID.");
	Запись.ЗаписатьНачалоЭлемента("AccumulationRegisterComparison");
	Запись.ЗаписатьАтрибут("formatVersion", "1");
	Запись.ЗаписатьАтрибут("configuration", Метаданные.Имя);
	Запись.ЗаписатьАтрибут("configurationVersion", Метаданные.Версия);
	Запись.ЗаписатьАтрибут("exportedAt", XMLСтрока(ТекущаяДата()));
	Запись.ЗаписатьАтрибут("periodFrom", ДатаВАтрибут(НачалоПериода));
	Запись.ЗаписатьАтрибут("periodTo", ДатаВАтрибут(КонецПериода));
	
	КоличествоЗаписей = 0;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		
		Попытка
			Описание = ОписаниеРегистра(ИмяРегистра);
			Выборка = ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода);
		Исключение
			ТекстОшибки = КраткийТекстОшибки(ОписаниеОшибки());
			ЗаписатьОшибку(Запись, ИмяРегистра, ТекстОшибки);
			Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
			Продолжить;
		КонецПопытки;
		
		КоличествоРегистра = ЗаписатьРегистр(Запись, Описание, Выборка);
		КоличествоЗаписей = КоличествоЗаписей + КоличествоРегистра;
		ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, КоличествоРегистра, 0, 0, 0, 0);
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	
	Возврат КоличествоЗаписей;
	
КонецФункции

Функция ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса(Описание, НачалоПериода, КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция ЗаписатьРегистр(Запись, Описание, Выборка)
	
	Запись.ЗаписатьНачалоЭлемента("Register");
	Запись.ЗаписатьАтрибут("name", Описание.Имя);
	Запись.ЗаписатьАтрибут("synonym", ТекстXML(Описание.Синоним));
	
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		ЗаписатьЗаписьРегистра(Запись, Выборка, Описание.Поля);
		Количество = Количество + 1;
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Возврат Количество;
	
КонецФункции

Процедура ЗаписатьЗаписьРегистра(Запись, Выборка, Поля)
	
	Ключ = КлючЗаписи(Выборка.Регистратор, Выборка.НомерСтроки);
	Запись.ЗаписатьНачалоЭлемента("Record");
	Запись.ЗаписатьАтрибут("key", Ключ);
	Запись.ЗаписатьАтрибут("line", ФорматЧисла(Выборка.НомерСтроки));
	Запись.ЗаписатьАтрибут("recorder", ПредставлениеЗначения(Выборка.Регистратор));
	
	Для Каждого Поле Из Поля Цикл
		Значение = Выборка[Поле.Имя];
		Запись.ЗаписатьНачалоЭлемента("Field");
		Запись.ЗаписатьАтрибут("name", Поле.Имя);
		Запись.ЗаписатьАтрибут("role", Поле.Роль);
		Запись.ЗаписатьАтрибут("canonical", КаноническоеЗначение(Значение));
		Запись.ЗаписатьАтрибут("presentation", ПредставлениеЗначения(Значение));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Процедура ЗаписатьОшибку(Запись, ИмяРегистра, ТекстОшибки)
	
	Запись.ЗаписатьНачалоЭлемента("Error");
	Запись.ЗаписатьАтрибут("register", ТекстXML(ИмяРегистра));
	Запись.ЗаписатьАтрибут("text", ТекстXML(ТекстОшибки));
	Запись.ЗаписатьКонецЭлемента();
	
КонецПроцедуры

Функция ПрочитатьФайлВыгрузки(ИмяФайла, ИменаРегистров)
	
	Выбранные = Новый Соответствие;
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Выбранные.Вставить(ИмяРегистра, Истина);
	КонецЦикла;
	
	Кэш = Новый Структура;
	Кэш.Вставить("ВерсияФормата", "");
	Кэш.Вставить("Конфигурация", "");
	Кэш.Вставить("ВерсияКонфигурации", "");
	Кэш.Вставить("ПериодНачало", '00010101');
	Кэш.Вставить("ПериодКонец", '00010101');
	Кэш.Вставить("Регистры", Новый Соответствие);
	Кэш.Вставить("Ошибки", Новый Соответствие);
	Кэш.Вставить("Виденные", Новый Соответствие);
	Кэш.Вставить("Предупреждения", Новый Массив);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ТекущиеЗаписи = Неопределено;
	ТекущаяЗапись = Неопределено;
	ЧитатьЗаписи = Ложь;
	КореньНайден = Ложь;
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя = "Record" Тогда
			ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			Продолжить;
		КонецЕсли;
		
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяУзла = Чтение.Имя;
		
		Если ИмяУзла = "AccumulationRegisterComparison" Тогда
			
			КореньНайден = Истина;
			Кэш.ВерсияФормата = Атрибут(Чтение, "formatVersion");
			Если Кэш.ВерсияФормата <> "1" Тогда
				ВызватьИсключение "Неподдерживаемая версия файла сравнения: " + Кэш.ВерсияФормата + ".";
			КонецЕсли;
			Кэш.Конфигурация = Атрибут(Чтение, "configuration");
			Кэш.ВерсияКонфигурации = Атрибут(Чтение, "configurationVersion");
			Кэш.ПериодНачало = ДатаИзАтрибута(Атрибут(Чтение, "periodFrom"));
			Кэш.ПериодКонец = ДатаИзАтрибута(Атрибут(Чтение, "periodTo"));
			
		ИначеЕсли ИмяУзла = "Register" Тогда
			
			ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			ИмяРегистра = Атрибут(Чтение, "name");
			Кэш.Виденные.Вставить(ИмяРегистра, Истина);
			ЧитатьЗаписи = Выбранные.Получить(ИмяРегистра) <> Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущиеЗаписи = Новый Соответствие;
				Кэш.Регистры.Вставить(ИмяРегистра, ТекущиеЗаписи);
			Иначе
				ТекущиеЗаписи = Неопределено;
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Record" Тогда
			
			ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
			ТекущаяЗапись = Неопределено;
			Если ЧитатьЗаписи Тогда
				ТекущаяЗапись = НоваяЗаписьФайла(Чтение);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Field" Тогда
			
			Если ТекущаяЗапись <> Неопределено Тогда
				ИмяПоля = Атрибут(Чтение, "name");
				Поле = Новый Структура("Канон, Представление", Атрибут(Чтение, "canonical"), Атрибут(Чтение, "presentation"));
				ТекущаяЗапись.Поля.Вставить(ИмяПоля, Поле);
				ТекущаяЗапись.ПорядокПолей.Добавить(ИмяПоля);
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Error" Тогда
			
			ИмяРегистра = Атрибут(Чтение, "register");
			ТекстОшибки = Атрибут(Чтение, "text");
			Кэш.Виденные.Вставить(ИмяРегистра, Истина);
			Кэш.Ошибки.Вставить(ИмяРегистра, ТекстОшибки);
			Кэш.Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись);
	ТекущаяЗапись = Неопределено;
	Чтение.Закрыть();
	
	Если Не КореньНайден Тогда
		ВызватьИсключение "Файл не является выгрузкой сравнения регистров накопления.";
	КонецЕсли;
	
	Возврат Кэш;
	
КонецФункции

Процедура ЗафиксироватьТекущуюЗапись(ТекущиеЗаписи, ТекущаяЗапись)
	
	Если ТекущаяЗапись = Неопределено Или ТекущиеЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеЗаписи.Вставить(ТекущаяЗапись.Ключ, ТекущаяЗапись);
	
КонецПроцедуры

Функция НоваяЗаписьФайла(Чтение)
	
	ЗаписьФайла = Новый Структура;
	ЗаписьФайла.Вставить("Ключ", Атрибут(Чтение, "key"));
	ЗаписьФайла.Вставить("НомерСтроки", ЧислоАтрибута(Атрибут(Чтение, "line")));
	ЗаписьФайла.Вставить("Регистратор", Атрибут(Чтение, "recorder"));
	ЗаписьФайла.Вставить("Поля", Новый Соответствие);
	ЗаписьФайла.Вставить("ПорядокПолей", Новый Массив);
	Возврат ЗаписьФайла;
	
КонецФункции

Процедура СравнитьРегистр(ИмяРегистра, НачалоПериода, КонецПериода, КэшФайла, Отличия, Статистика, Предупреждения, ВсегоОтличий, Обрезано)
	
	ТекстОшибкиФайла = КэшФайла.Ошибки.Получить(ИмяРегистра);
	Если ТекстОшибкиФайла <> Неопределено Тогда
		ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, 0, 0, 0, 0);
		ДобавитьОтличие(Отличия, ИмяРегистра, "Ошибка", "", 0, "(выгрузка)", "", ТекстОшибкиФайла, ВсегоОтличий, Обрезано);
		Возврат;
	КонецЕсли;
	
	Если КэшФайла.Виденные.Получить(ИмяРегистра) = Неопределено Тогда
		Предупреждения.Добавить(ИмяРегистра + ": регистр отсутствует в файле выгрузки. Записи файла приняты пустыми.");
	КонецЕсли;
	
	ЗаписиФайла = КэшФайла.Регистры.Получить(ИмяРегистра);
	Если ЗаписиФайла = Неопределено Тогда
		ЗаписиФайла = Новый Соответствие;
	КонецЕсли;
	
	Попытка
		Описание = ОписаниеРегистра(ИмяРегистра);
	Исключение
		ТекстОшибки = КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(ИмяРегистра + ": " + ТекстОшибки);
		ДобавитьСтрокуСтатистики(Статистика, ИмяРегистра, 0, ЗаписиФайла.Количество(), 0, 0, 0);
		ДобавитьОтличие(Отличия, ИмяРегистра, "Ошибка", "", 0, "(метаданные)", "", ТекстОшибки, ВсегоОтличий, Обрезано);
		Возврат;
	КонецПопытки;
	
	СтрокаСтатистики = ДобавитьСтрокуСтатистики(Статистика, Описание.Имя, 0, ЗаписиФайла.Количество(), 0, 0, 0);
	ИменаПолейБазы = Новый Соответствие;
	Для Каждого Поле Из Описание.Поля Цикл
		ИменаПолейБазы.Вставить(Поле.Имя, Истина);
	КонецЦикла;
	
	Попытка
		Выборка = ВыбратьЗаписи(Описание, НачалоПериода, КонецПериода);
	Исключение
		ТекстОшибки = КраткийТекстОшибки(ОписаниеОшибки());
		Предупреждения.Добавить(Описание.Имя + ": " + ТекстОшибки);
		ДобавитьОтличие(Отличия, Описание.Имя, "Ошибка", "", 0, "(запрос)", "", ТекстОшибки, ВсегоОтличий, Обрезано);
		Возврат;
	КонецПопытки;
	
	КоличествоБазы = 0;
	Пока Выборка.Следующий() Цикл
		
		КоличествоБазы = КоличествоБазы + 1;
		Ключ = КлючЗаписи(Выборка.Регистратор, Выборка.НомерСтроки);
		ЗаписьФайла = ЗаписиФайла.Получить(Ключ);
		ПредставлениеРегистратора = ПредставлениеЗначения(Выборка.Регистратор);
		
		Если ЗаписьФайла = Неопределено Тогда
			СтрокаСтатистики.ТолькоВБазе = СтрокаСтатистики.ТолькоВБазе + 1;
			ДобавитьОтличие(Отличия, Описание.Имя, "Только в этой базе", ПредставлениеРегистратора, Выборка.НомерСтроки,
				"(вся запись)", ПредставлениеВыборки(Выборка, Описание.Поля), "", ВсегоОтличий, Обрезано);
			Продолжить;
		КонецЕсли;
		
		Для Каждого Поле Из Описание.Поля Цикл
			КанонБазы = КаноническоеЗначение(Выборка[Поле.Имя]);
			ПолеФайла = ЗаписьФайла.Поля.Получить(Поле.Имя);
			Если ПолеФайла = Неопределено Тогда
				КанонФайла = "<нет поля>";
				ПредставлениеФайла = "";
			Иначе
				КанонФайла = ПолеФайла.Канон;
				ПредставлениеФайла = ПолеФайла.Представление;
			КонецЕсли;
			
			Если КанонБазы <> КанонФайла Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				ДобавитьОтличие(Отличия, Описание.Имя, "Расхождение", ПредставлениеРегистратора, Выборка.НомерСтроки,
					Поле.Имя, ПредставлениеЗначения(Выборка[Поле.Имя]), ПредставлениеФайла, ВсегоОтличий, Обрезано);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлементПоля Из ЗаписьФайла.Поля Цикл
			Если ИменаПолейБазы.Получить(ЭлементПоля.Ключ) = Неопределено Тогда
				СтрокаСтатистики.Расхождений = СтрокаСтатистики.Расхождений + 1;
				ДобавитьОтличие(Отличия, Описание.Имя, "Расхождение", ПредставлениеРегистратора, Выборка.НомерСтроки,
					ЭлементПоля.Ключ, "", ЭлементПоля.Значение.Представление, ВсегоОтличий, Обрезано);
			КонецЕсли;
		КонецЦикла;
		
		ЗаписиФайла.Удалить(Ключ);
		
	КонецЦикла;
	
	СтрокаСтатистики.ЗаписейВБазе = КоличествоБазы;
	
	Для Каждого ЭлементЗаписи Из ЗаписиФайла Цикл
		ЗаписьФайла = ЭлементЗаписи.Значение;
		СтрокаСтатистики.ТолькоВФайле = СтрокаСтатистики.ТолькоВФайле + 1;
		ДобавитьОтличие(Отличия, Описание.Имя, "Только в файле", ЗаписьФайла.Регистратор, ЗаписьФайла.НомерСтроки,
			"(вся запись)", "", ПредставлениеЗаписиФайла(ЗаписьФайла), ВсегоОтличий, Обрезано);
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеРегистра(ИмяРегистра)
	
	Мета = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если Мета = Неопределено Тогда
		ВызватьИсключение "Регистр накопления """ + ИмяРегистра + """ не найден в конфигурации.";
	КонецЕсли;
	
	Поля = Новый Массив;
	ДобавитьПоле(Поля, "Период", "Стандартное");
	ДобавитьПоле(Поля, "Регистратор", "Стандартное");
	ДобавитьПоле(Поля, "НомерСтроки", "Стандартное");
	ДобавитьПоле(Поля, "Активность", "Стандартное");
	
	Если Мета.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
		ДобавитьПоле(Поля, "ВидДвижения", "Стандартное");
	КонецЕсли;
	
	Для Каждого Измерение Из Мета.Измерения Цикл
		ДобавитьПоле(Поля, Измерение.Имя, "Измерение");
	КонецЦикла;
	
	Для Каждого Ресурс Из Мета.Ресурсы Цикл
		ДобавитьПоле(Поля, Ресурс.Имя, "Ресурс");
	КонецЦикла;
	
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		ДобавитьПоле(Поля, Реквизит.Имя, "Реквизит");
	КонецЦикла;
	
	Синоним = Строка(Мета.Синоним);
	Если Не ЗначениеЗаполнено(Синоним) Тогда
		Синоним = Мета.Имя;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", Мета.Имя);
	Описание.Вставить("Синоним", Синоним);
	Описание.Вставить("Поля", Поля);
	Возврат Описание;
	
КонецФункции

Процедура ДобавитьПоле(Поля, Имя, Роль)
	
	Поле = Новый Структура("Имя, Роль", Имя, Роль);
	Поля.Добавить(Поле);
	
КонецПроцедуры

Функция ТекстЗапроса(Описание, НачалоПериода, КонецПериода)
	
	ЧастиПолей = Новый Массив;
	Для Каждого Поле Из Описание.Поля Цикл
		ЧастиПолей.Добавить("Регистр." + Поле.Имя + " КАК " + Поле.Имя);
	КонецЦикла;
	
	Текст = "ВЫБРАТЬ"
		+ Символы.ПС + Символы.Таб + СоединитьСтроки(ЧастиПолей, "," + Символы.ПС + Символы.Таб)
		+ Символы.ПС + "ИЗ"
		+ Символы.ПС + Символы.Таб + "РегистрНакопления." + Описание.Имя + " КАК Регистр";
	
	Условия = Новый Массив;
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Условия.Добавить("Регистр.Период >= &НачалоПериода");
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		Условия.Добавить("Регистр.Период <= &КонецПериода");
	КонецЕсли;
	
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб + СоединитьСтроки(Условия, Символы.ПС + Символы.Таб + "И ");
	КонецЕсли;
	
	Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО"
		+ Символы.ПС + Символы.Таб + "Регистр.Регистратор,"
		+ Символы.ПС + Символы.Таб + "Регистр.НомерСтроки";
	
	Возврат Текст;
	
КонецФункции

Функция КлючЗаписи(Регистратор, НомерСтроки)
	
	Возврат КаноническоеЗначение(Регистратор) + "|" + КаноническоеЗначение(НомерСтроки);
	
КонецФункции

Функция КаноническоеЗначение(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "undef";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Null") Тогда
		Возврат "null";
	КонецЕсли;
	
	Если ЭтоСсылочныйТип(ТипЗначения) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат ТипXML.ИмяТипа + ":" + XMLСтрока(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "string:" + ТекстXML(Значение);
	КонецЕсли;
	
	Попытка
		ТипXML = XMLТип(ТипЗначения);
		Если ТипXML = Неопределено Тогда
			Возврат ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		КонецЕсли;
		Возврат ТипXML.ИмяТипа + ":" + XMLСтрока(Значение);
	Исключение
		Попытка
			Возврат ТекстXML("internal:" + ЗначениеВСтрокуВнутр(Значение));
		Исключение
			Возврат ТекстXML("string:" + Строка(Значение));
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

Функция ПредставлениеЗначения(Значение)
	
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + ТекстXML(Значение) + """";
	КонецЕсли;
	
	Если ЭтоСсылочныйТип(ТипЗнч(Значение)) Тогда
		ТипXML = XMLТипЗнч(Значение);
		Возврат ТекстXML(Строка(Значение) + " | " + ТипXML.ИмяТипа + ":" + XMLСтрока(Значение));
	КонецЕсли;
	
	Возврат ТекстXML(Строка(Значение) + " | " + КаноническоеЗначение(Значение));
	
КонецФункции

Функция ПредставлениеВыборки(Выборка, Поля)
	
	Части = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Части.Добавить(Поле.Имя + " = " + ПредставлениеЗначения(Выборка[Поле.Имя]));
	КонецЦикла;
	Возврат СоединитьСтроки(Части, "; ");
	
КонецФункции

Функция ПредставлениеЗаписиФайла(ЗаписьФайла)
	
	Части = Новый Массив;
	Для Каждого ИмяПоля Из ЗаписьФайла.ПорядокПолей Цикл
		Поле = ЗаписьФайла.Поля.Получить(ИмяПоля);
		Части.Добавить(ИмяПоля + " = " + Поле.Представление);
	КонецЦикла;
	Возврат СоединитьСтроки(Части, "; ");
	
КонецФункции

Процедура ИнициализироватьКэшТипов()
	
	Если ОписанияТиповСсылок <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписанияТиповСсылок = Новый Массив;
	ОписанияТиповСсылок.Добавить(Справочники.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(Документы.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(Перечисления.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(ПланыСчетов.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(ПланыВидовРасчета.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(БизнесПроцессы.ТипВсеСсылки());
	ОписанияТиповСсылок.Добавить(Задачи.ТипВсеСсылки());
	КэшСсылочныхТипов = Новый Соответствие;
	
КонецПроцедуры

Функция ЭтоСсылочныйТип(ТипЗначения)
	
	Если ОписанияТиповСсылок = Неопределено Тогда
		ИнициализироватьКэшТипов();
	КонецЕсли;
	
	Признак = КэшСсылочныхТипов.Получить(ТипЗначения);
	Если Признак <> Неопределено Тогда
		Возврат Признак;
	КонецЕсли;
	
	Признак = Ложь;
	Для Каждого ОписаниеТипа Из ОписанияТиповСсылок Цикл
		Если ОписаниеТипа.СодержитТип(ТипЗначения) Тогда
			Признак = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	КэшСсылочныхТипов.Вставить(ТипЗначения, Признак);
	Возврат Признак;
	
КонецФункции

Функция НоваяТаблицаОтличий()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Регистр", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ВидОтличия", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Регистратор", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВБазе", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
	
КонецФункции

Функция НоваяСтатистика()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЗаписейВБазе", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ЗаписейВФайле", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ТолькоВБазе", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ТолькоВФайле", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Расхождений", Новый ОписаниеТипов("Число"));
	Возврат Таблица;
	
КонецФункции

Функция ДобавитьСтрокуСтатистики(Статистика, Имя, ЗаписейВБазе, ЗаписейВФайле, ТолькоВБазе, ТолькоВФайле, Расхождений)
	
	СтрокаСтатистики = Статистика.Добавить();
	СтрокаСтатистики.Имя = Имя;
	СтрокаСтатистики.ЗаписейВБазе = ЗаписейВБазе;
	СтрокаСтатистики.ЗаписейВФайле = ЗаписейВФайле;
	СтрокаСтатистики.ТолькоВБазе = ТолькоВБазе;
	СтрокаСтатистики.ТолькоВФайле = ТолькоВФайле;
	СтрокаСтатистики.Расхождений = Расхождений;
	Возврат СтрокаСтатистики;
	
КонецФункции

Процедура ДобавитьОтличие(Отличия, Регистр, ВидОтличия, Регистратор, НомерСтроки, ИмяПоля, ЗначениеВБазе, ЗначениеВФайле, ВсегоОтличий, Обрезано)
	
	ВсегоОтличий = ВсегоОтличий + 1;
	Если Отличия.Количество() >= МаксимальноеКоличествоСтрокРезультата() Тогда
		Обрезано = Истина;
		Возврат;
	КонецЕсли;
	
	СтрокаОтличия = Отличия.Добавить();
	СтрокаОтличия.Регистр = Регистр;
	СтрокаОтличия.ВидОтличия = ВидОтличия;
	СтрокаОтличия.Регистратор = Регистратор;
	СтрокаОтличия.НомерСтроки = НомерСтроки;
	СтрокаОтличия.ИмяПоля = ИмяПоля;
	СтрокаОтличия.ЗначениеВБазе = ЗначениеВБазе;
	СтрокаОтличия.ЗначениеВФайле = ЗначениеВФайле;
	
КонецПроцедуры

Функция МаксимальноеКоличествоСтрокРезультата()
	
	Возврат 100000;
	
КонецФункции

Функция ТекстПериодаСравнения(НачалоПериода, КонецПериода)
	
	Если Не ЗначениеЗаполнено(НачалоПериода) И Не ЗначениеЗаполнено(КонецПериода) Тогда
		Возврат "без ограничения";
	КонецЕсли;
	
	Возврат Формат(НачалоПериода, "ДЛФ=DT") + " — " + Формат(КонецПериода, "ДЛФ=DT");
	
КонецФункции

Функция ДатаВАтрибут(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(Дата);
	
КонецФункции

Функция ДатаИзАтрибута(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Возврат XMLЗначение(Тип("Дата"), Текст);
	
КонецФункции

Функция Атрибут(Чтение, Имя)
	
	Значение = Чтение.ПолучитьАтрибут(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ЧислоАтрибута(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Число(Текст);
	
КонецФункции

Функция КраткийТекстОшибки(Текст)
	
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Возврат Лев(СокрЛП(Текст), 1000);
	
КонецФункции

Функция ТекстПредупреждений(Предупреждения)
	
	Возврат "Предупреждения:" + Символы.ПС + СоединитьСтроки(Предупреждения, Символы.ПС);
	
КонецФункции

Функция ТекстXML(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Если Не СимволДопустимВXML(КодСимвола(Текст, Номер)) Тогда
			Возврат ТекстXMLСЗаменой(Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция ТекстXMLСЗаменой(Текст)
	
	Результат = "";
	Длина = СтрДлина(Текст);
	Для Номер = 1 По Длина Цикл
		Код = КодСимвола(Текст, Номер);
		Если СимволДопустимВXML(Код) Тогда
			Результат = Результат + Символ(Код);
		Иначе
			Результат = Результат + "#x" + ФорматЧисла(Код) + "#";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СимволДопустимВXML(Код)
	
	Если Код = 9 Или Код = 10 Или Код = 13 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 32 И Код <= 55295 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Код >= 57344 И Код <= 65533 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция СоединитьСтроки(Части, Разделитель)
	
	Результат = "";
	Индекс = 0;
	Для Каждого Часть Из Части Цикл
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		Результат = Результат + Часть;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ФорматЧисла(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

Процедура УдалитьВременныйФайл(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры
